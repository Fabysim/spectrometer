<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Référence de projet (pas une dépendance de manifeste — ProfilCandidat n'est plus dans
         RequiredModuleCodes, voir son commentaire) : consomme ICandidateProfileService pour la page
         Historique candidat. ProfilEntreprise reste dans RequiredModuleCodes (module tenant réel).
         ProfilCandidat/ProfilEntreprise ne référencent JAMAIS ce projet en retour : ils consomment
         IProfileChangeRecorder (Core), implémenté ici et câblé depuis Host. -->
    <ProjectReference Include="..\Spectrometre.Core\Spectrometre.Core.csproj" />
    <ProjectReference Include="..\Spectrometre.Modules.ProfilCandidat\Spectrometre.Modules.ProfilCandidat.csproj" />
    <ProjectReference Include="..\Spectrometre.Modules.ProfilEntreprise\Spectrometre.Modules.ProfilEntreprise.csproj" />
  </ItemGroup>

</Project>
