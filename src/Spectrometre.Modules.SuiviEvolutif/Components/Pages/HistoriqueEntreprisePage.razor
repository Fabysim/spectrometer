@page "/entreprise/historique"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.ProfilEntreprise.Services
@using Spectrometre.Modules.SuiviEvolutif.Resources
@using Spectrometre.Modules.SuiviEvolutif.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICompanyProfileService CompanyProfileService
@inject ISuiviEvolutifService SuiviEvolutifService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<SuiviEvolutifResource> Localizer

<PageTitle>@Localizer["HistoriqueDuProfilEntrepriseTitle"]</PageTitle>

<div class="historique-page">
@if (_companies is null)
{
    <p class="historique-state">@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <section class="historique-card historique-empty">
        <p class="historique-hint">@Localizer["AucuneEntrepriseAssociee"]</p>
    </section>
}
else
{
    <header class="historique-header">
        <div>
            <h1 class="historique-title">@Localizer["HistoriqueDuProfil"]</h1>
            <p class="historique-subtitle">
                @if (_companies.Count == 1)
                {
                    @_companies[0].Name
                }
                else
                {
                    @Localizer["EntrepriseActive"]
                }
            </p>
        </div>
        @if (_companies.Count > 1)
        {
            <div class="historique-company-select">
                <label for="historique-active">@Localizer["EntrepriseActive"]</label>
                <select id="historique-active" value="@_selectedCompanyId" @onchange="OnCompanyChangedAsync">
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
        }
    </header>

    <p class="historique-intro">@Localizer["HistoriqueEntrepriseHint"]</p>

    @if (_historique is null)
    {
        <p class="historique-state">@Localizer["Chargement"]</p>
    }
    else if (_historique.Count == 0)
    {
        <section class="historique-card historique-empty">
            <div class="historique-empty-icon" aria-hidden="true">
                <i class="bi bi-clock-history"></i>
            </div>
            <p class="historique-hint">@Localizer["AucuneModificationEnregistree"]</p>
        </section>
    }
    else
    {
        <ol class="historique-liste">
            @foreach (var entree in _historique)
            {
                <li class="historique-card historique-entree">
                    <div class="historique-entree-marker" aria-hidden="true"></div>
                    <div class="historique-entree-body">
                        <time class="historique-date" datetime="@entree.Horodatage.UtcDateTime.ToString("o")">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            @entree.Horodatage.LocalDateTime.ToString(Localizer["DateFormat"].Value, CultureInfo.CurrentUICulture)
                        </time>
                        <p class="historique-phrase">@Phrase(entree)</p>
                    </div>
                </li>
            }
        </ol>
    }
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Company>? _companies;
    private int _selectedCompanyId;
    private List<HistoriqueEntreeView>? _historique;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        // Même sélecteur multi-entreprises que /entreprise/profil : la liste ne contient déjà que les
        // entreprises que cet utilisateur gère (GetCompaniesForUserAsync), donc pas de nouveau mécanisme
        // d'accès à inventer — un manager ne peut par construction sélectionner que ses propres entreprises.
        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count > 0)
            await ActivateCompanyAsync(_companies[0]);
    }

    private async Task ActivateCompanyAsync(Company company)
    {
        _selectedCompanyId = company.Id;
        TenantContext.SetActiveCompany(company.Id, company.SchemaName);
        var companyProfileId = await CompanyProfileService.GetOrCreateProfileIdAsync();
        _historique = (await SuiviEvolutifService.GetHistoriqueEntrepriseAsync(companyProfileId)).ToList();
    }

    private async Task OnCompanyChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var company = _companies!.First(c => c.Id == id);
            await ActivateCompanyAsync(company);
        }
    }

    private string Phrase(HistoriqueEntreeView entree)
    {
        var aucun = Localizer["Aucun"].Value;
        var ancien = string.IsNullOrEmpty(entree.AncienneValeur) ? aucun : Tronquer(entree.AncienneValeur);
        var nouveau = string.IsNullOrEmpty(entree.NouvelleValeur) ? aucun : Tronquer(entree.NouvelleValeur);
        return $"{entree.Description} : « {ancien} » → « {nouveau} ».";
    }

    // Voir le commentaire équivalent sur HistoriqueCandidatPage.razor : affichage seulement, jamais la donnée stockée.
    private const int LongueurMaxAffichage = 120;

    private static string Tronquer(string valeur) =>
        valeur.Length <= LongueurMaxAffichage ? valeur : valeur[..LongueurMaxAffichage] + "…";
}
