@page "/candidat/historique"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Modules.ProfilCandidat.Services
@using Spectrometre.Modules.SuiviEvolutif.Resources
@using Spectrometre.Modules.SuiviEvolutif.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICandidateProfileService CandidateProfileService
@inject ISuiviEvolutifService SuiviEvolutifService
@inject IStringLocalizer<SuiviEvolutifResource> Localizer

<PageTitle>@Localizer["HistoriqueDeMonProfil"]</PageTitle>

<div class="historique-page">
    <header class="historique-header">
        <div>
            <h1 class="historique-title">@Localizer["HistoriqueDeMonProfil"]</h1>
            <p class="historique-subtitle">@Localizer["HistoriqueCandidatHint"]</p>
        </div>
    </header>

@if (_historique is null)
{
    <p class="historique-state">@Localizer["Chargement"]</p>
}
else if (_historique.Count == 0)
{
    <section class="historique-card historique-empty">
        <div class="historique-empty-icon" aria-hidden="true">
            <i class="bi bi-clock-history"></i>
        </div>
        <p class="historique-hint">@Localizer["AucuneModificationEnregistree"]</p>
    </section>
}
else
{
    <ol class="historique-liste">
        @foreach (var entree in _historique)
        {
            <li class="historique-card historique-entree">
                <div class="historique-entree-marker" aria-hidden="true"></div>
                <div class="historique-entree-body">
                    <time class="historique-date" datetime="@entree.Horodatage.UtcDateTime.ToString("o")">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        @entree.Horodatage.LocalDateTime.ToString(Localizer["DateFormat"].Value, CultureInfo.CurrentUICulture)
                    </time>
                    <p class="historique-phrase">@Phrase(entree)</p>
                </div>
            </li>
        }
    </ol>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<HistoriqueEntreeView>? _historique;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        // Toujours SON PROPRE profil, résolu depuis les claims de l'utilisateur connecté — même pattern
        // que /candidat/questionnaire, jamais un identifiant pris ailleurs : par construction, un candidat
        // ne peut donc jamais voir l'historique de quelqu'un d'autre.
        var candidateProfileId = await CandidateProfileService.GetOrCreateProfileIdAsync(userId);
        _historique = (await SuiviEvolutifService.GetHistoriqueCandidatAsync(candidateProfileId)).ToList();
    }

    /// <summary>
    /// Phrase en langage courant — jamais de nom de champ technique. Pour un axe à tags, ancienne/nouvelle
    /// valeur sont la liste complète avant/après (pas seulement le tag modifié) : afficher l'état complet
    /// des deux côtés reste honnête et lisible, plutôt que de prétendre isoler « le » changement. Les
    /// réponses au questionnaire étant du texte libre potentiellement long, les valeurs affichées sont
    /// tronquées (voir <see cref="Tronquer"/>) — jamais la donnée stockée elle-même, qui reste complète en base.
    /// AncienneValeur/NouvelleValeur restent toujours dans leur langue de saisie d'origine (contenu
    /// utilisateur, jamais traduit) — seul <c>entree.Description</c> (voir SuiviEvolutifService.LabelPourChamp)
    /// et le mot « (aucun) » sont bilingues.
    /// </summary>
    private string Phrase(HistoriqueEntreeView entree)
    {
        var aucun = Localizer["Aucun"].Value;
        var ancien = string.IsNullOrEmpty(entree.AncienneValeur) ? aucun : Tronquer(entree.AncienneValeur);
        var nouveau = string.IsNullOrEmpty(entree.NouvelleValeur) ? aucun : Tronquer(entree.NouvelleValeur);
        return $"{entree.Description} : « {ancien} » → « {nouveau} ».";
    }

    private const int LongueurMaxAffichage = 120;

    private static string Tronquer(string valeur) =>
        valeur.Length <= LongueurMaxAffichage ? valeur : valeur[..LongueurMaxAffichage] + "…";
}
