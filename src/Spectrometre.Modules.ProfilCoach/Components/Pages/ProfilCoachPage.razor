@page "/coach/profil"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Modules.ProfilCoach.Resources
@using Spectrometre.Modules.ProfilCoach.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICoachProfileService CoachProfileService
@inject IStringLocalizer<ProfilCoachResource> Localizer

<PageTitle>@Localizer["ProfilCoachTitle"]</PageTitle>

<div class="profil-coach-page">
@if (_userId is null || _modele is null)
{
    <p class="pc-state">@Localizer["Chargement"]</p>
}
else
{
    <header class="pc-header">
        <div>
            <h1 class="pc-title">@Localizer["ProfilCoach"]</h1>
            <p class="pc-subtitle">@Localizer["ProfilCoachIntro"]</p>
        </div>
    </header>

    <section class="pc-card">
        <div class="pc-card-icon" aria-hidden="true">
            <i class="bi bi-person-vcard"></i>
        </div>
        <h2 class="pc-section-title">@Localizer["ProfilCoach"]</h2>
        <div class="pc-form">
            <div class="pc-field">
                <label for="pc-nom">@Localizer["NomAffiche"]</label>
                <input id="pc-nom"
                       class="pc-input"
                       @bind="_modele.NomAffiche"
                       @bind:event="oninput"
                       placeholder="@Localizer["NomAffiche"]" />
            </div>
            <div class="pc-field">
                <label for="pc-bio">@Localizer["BioCourte"]</label>
                <textarea id="pc-bio"
                          class="pc-input pc-textarea"
                          rows="4"
                          @bind="_modele.BioCourte"
                          @bind:event="oninput"
                          placeholder="@Localizer["BioCourte"]"></textarea>
            </div>
            <div class="pc-field">
                <label for="pc-specialites">@Localizer["Specialites"]</label>
                <input id="pc-specialites"
                       class="pc-input"
                       @bind="_modele.Specialites"
                       @bind:event="oninput"
                       placeholder="@Localizer["SpecialitesPlaceholder"]" />
            </div>
            <div class="pc-checkbox-field">
                <label class="pc-checkbox">
                    <input type="checkbox" @bind="_modele.VisibleDansAnnuaire" />
                    <span>@Localizer["VisibleDansAnnuaire"]</span>
                </label>
                <p class="pc-hint">@Localizer["VisibleDansAnnuaireHint"]</p>
            </div>

            @if (_messageConfirmation is not null)
            {
                <div class="pc-alert pc-alert-success" role="status">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    @_messageConfirmation
                </div>
            }

            <div class="pc-actions">
                <button type="button"
                        class="pc-btn-primary"
                        @onclick="EnregistrerAsync"
                        disabled="@_enregistrementEnCours">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    @Localizer["EnregistrerLeProfil"]
                </button>
            </div>
        </div>
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _userId;
    private bool _enregistrementEnCours;
    private string? _messageConfirmation;

    private sealed class Modele
    {
        public string NomAffiche { get; set; } = "";
        public string BioCourte { get; set; } = "";
        public string Specialites { get; set; } = "";
        public bool VisibleDansAnnuaire { get; set; }
    }

    private Modele? _modele;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _userId = userId;

        var profil = await CoachProfileService.GetProfilAsync(userId);
        _modele = profil is null
            ? new Modele()
            : new Modele
            {
                NomAffiche = profil.NomAffiche,
                BioCourte = profil.BioCourte,
                Specialites = profil.Specialites,
                VisibleDansAnnuaire = profil.VisibleDansAnnuaire,
            };
    }

    private async Task EnregistrerAsync()
    {
        _enregistrementEnCours = true;
        _messageConfirmation = null;
        try
        {
            var m = _modele!;
            await CoachProfileService.SaveProfilAsync(_userId!, m.NomAffiche, m.BioCourte, m.Specialites, m.VisibleDansAnnuaire);
            _messageConfirmation = Localizer["ProfilEnregistre"];
        }
        finally
        {
            _enregistrementEnCours = false;
        }
    }
}
