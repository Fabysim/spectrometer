@page "/vivier"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Compatibility
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.Vivier.Resources
@using Spectrometre.Modules.Vivier.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IVivierService VivierService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<VivierResource> Localizer

<PageTitle>@Localizer["VivierDeCandidats"]</PageTitle>

<div class="vivier-page">
@if (_companies is null)
{
    <p class="vivier-state">@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <section class="vivier-card vivier-empty">
        <p class="vivier-hint">@Localizer["AucuneEntrepriseAssociee"]</p>
    </section>
}
else
{
    <header class="vivier-header">
        <div>
            <h1 class="vivier-title">@Localizer["VivierDeCandidats"]</h1>
            <p class="vivier-subtitle">
                @if (_companies.Count == 1)
                {
                    @_companies[0].Name
                }
                else
                {
                    @Localizer["EntrepriseActive"]
                }
            </p>
        </div>
        @if (_companies.Count > 1)
        {
            <div class="vivier-company-select">
                <label for="vivier-active">@Localizer["EntrepriseActive"]</label>
                <select id="vivier-active" value="@_selectedCompanyId" @onchange="OnCompanyChangedAsync">
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
        }
    </header>

    <p class="vivier-intro">@Localizer["VivierIntro"]</p>

    @if (_candidatures is null)
    {
        <p class="vivier-state">@Localizer["ChargementDesCandidatures"]</p>
    }
    else
    {
        <div class="vivier-layout">
            <aside class="vivier-card vivier-filtres">
                <div class="vivier-filtres-icon" aria-hidden="true">
                    <i class="bi bi-funnel"></i>
                </div>
                <h2 class="vivier-filtres-title">@Localizer["Filtres"]</h2>

                <div class="filtre-champ">
                    <label for="vivier-score">@string.Format(Localizer["ScoreMinimum"].Value, _scoreMinimum)</label>
                    <input id="vivier-score" class="vivier-range" type="range" min="0" max="100" step="5" value="@_scoreMinimum"
                           @oninput="e => _scoreMinimum = int.Parse(e.Value!.ToString()!)" />
                    <div class="vivier-range-scale" aria-hidden="true">
                        <span>0</span>
                        <span>100</span>
                    </div>
                </div>

                <div class="filtre-champ">
                    <label>@Localizer["CompetencesTagsTechniques"]</label>
                    <div class="tag-checkboxes">
                        @foreach (var tag in CompatibilityVocabulary.TechniqueTags)
                        {
                            <label class="tag-checkbox">
                                <input type="checkbox" checked="@_tagsSelectionnes.Contains(tag)"
                                       @onchange="e => ToggleTagFiltre(tag, (bool)e.Value!)" />
                                <span>@CompatibilityVocabulary.DisplayTag(tag, _english)</span>
                            </label>
                        }
                    </div>
                </div>

                @if (_tagsSelectionnes.Count > 0)
                {
                    <button type="button" class="vivier-btn-secondary" @onclick="() => _tagsSelectionnes.Clear()">
                        @Localizer["ReinitialiserLesTags"]
                    </button>
                }
            </aside>

            <section class="vivier-candidats">
                @if (_candidatures.Count == 0)
                {
                    <div class="vivier-card vivier-empty">
                        <p class="vivier-hint">@Localizer["AucuneCandidatureRecue"]</p>
                    </div>
                }
                else
                {
                    @foreach (var candidature in TriEtFiltre())
                    {
                        var horsFiltre = EstHorsFiltre(candidature);
                        <article class="vivier-card candidat-carte @(horsFiltre ? "hors-filtre" : "")">
                            <div class="candidat-entete">
                                <div class="candidat-entete-main">
                                    <h3 class="candidat-nom">@Localizer["Candidat"] #@candidature.CandidateProfileId</h3>
                                    <span class="poste-origine">
                                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                                        @candidature.PosteTitre
                                    </span>
                                </div>
                                <span class="score @ScoreClasse(candidature.ScoreCompatibilite)">
                                    @(candidature.ScoreCompatibilite is int s ? $"{s}%" : Localizer["ScoreNonCalcule"])
                                </span>
                            </div>
                            @if (candidature.TagsCles.Count > 0)
                            {
                                <div class="tags">
                                    @foreach (var tag in candidature.TagsCles)
                                    {
                                        <span class="tag @(_tagsSelectionnes.Contains(tag) ? "tag-actif" : "")">@CompatibilityVocabulary.DisplayTag(tag, _english)</span>
                                    }
                                </div>
                            }
                            <div class="candidat-pied">
                                <span class="statut">@StatutLabel(candidature.Statut)</span>
                                <div class="candidat-liens">
                                    <a href="@($"/vivier/candidat/{candidature.CandidateProfileId}")">@Localizer["VoirLeProfilDetaille"]</a>
                                    @if (candidature.ScoreCompatibilite is not null)
                                    {
                                        <a href="@($"/compatibilite/resultat/{candidature.CandidateProfileId}")">@Localizer["DetailDuScore"]</a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                }
            </section>
        </div>
    }
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Company>? _companies;
    private int _selectedCompanyId;
    private List<CandidatureVivierView>? _candidatures;

    private int _scoreMinimum;
    private readonly HashSet<string> _tagsSelectionnes = new(StringComparer.OrdinalIgnoreCase);
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    /// <summary>
    /// Traduit le statut (chaîne partagée avec l'index de recrutement, voir CandidatureIndexEntry.Statut) —
    /// duplication volontaire de CandidatureStatutLabels (module PostesRecrutement) pour ne pas créer de
    /// dépendance croisée entre Vivier et PostesRecrutement (voir le commentaire du .csproj).
    /// </summary>
    private string StatutLabel(string statut) => statut switch
    {
        "Recue" => Localizer["Statut_Recue"],
        "EnRevue" => Localizer["Statut_EnRevue"],
        "Entretien" => Localizer["Statut_Entretien"],
        "Rejetee" => Localizer["Statut_Rejetee"],
        "Embauchee" => Localizer["Statut_Embauchee"],
        _ => statut,
    };

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count > 0)
            await ActivateCompanyAsync(_companies[0]);
    }

    private async Task ActivateCompanyAsync(Company company)
    {
        _selectedCompanyId = company.Id;
        TenantContext.SetActiveCompany(company.Id, company.SchemaName);
        _candidatures = (await VivierService.GetCandidaturesAsync()).ToList();
    }

    private async Task OnCompanyChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var company = _companies!.First(c => c.Id == id);
            await ActivateCompanyAsync(company);
        }
    }

    private void ToggleTagFiltre(string tag, bool selectionne)
    {
        if (selectionne) _tagsSelectionnes.Add(tag);
        else _tagsSelectionnes.Remove(tag);
    }

    /// <summary>
    /// Le filtre ne masque jamais un candidat (voir la contrainte du cycle : « le filtre est un confort,
    /// pas une restriction d'accès ») — il sert uniquement à décider le tri et le style grisé.
    /// </summary>
    private bool EstHorsFiltre(CandidatureVivierView c)
    {
        var horsScore = (c.ScoreCompatibilite ?? 0) < _scoreMinimum;
        var horsTags = _tagsSelectionnes.Count > 0 && !c.TagsCles.Any(t => _tagsSelectionnes.Contains(t));
        return horsScore || horsTags;
    }

    private IEnumerable<CandidatureVivierView> TriEtFiltre() =>
        _candidatures!
            .OrderBy(EstHorsFiltre)
            .ThenByDescending(c => c.ScoreCompatibilite ?? -1);

    private static string ScoreClasse(int? score) => score switch
    {
        null => "score-inconnu",
        >= 70 => "score-eleve",
        >= 40 => "score-moyen",
        _ => "score-faible",
    };
}
