@page "/vivier/candidat/{CandidateProfileId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Compatibility
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.ProfilCandidat.Services
@using Spectrometre.Modules.Vivier.Resources
@using Spectrometre.Modules.Vivier.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IVivierService VivierService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<VivierResource> Localizer

<PageTitle>@Localizer["ProfilCandidat"]</PageTitle>

@if (!_resolu)
{
    <p>@Localizer["Chargement"]</p>
}
else if (_criteria is null)
{
    <p class="hint">@Localizer["ProfilIntrouvableHint"]</p>
    <a href="/vivier">&lt; @Localizer["RetourAuVivier"]</a>
}
else
{
    <a href="/vivier">&lt; @Localizer["RetourAuVivier"]</a>
    <h1>@Localizer["ProfilCandidat"] #@CandidateProfileId</h1>
    <p class="hint">@Localizer["CriteresDeclaresHint"]</p>
    <p><a href="@($"/entretien/{CandidateProfileId}")">@Localizer["PreparerLEntretien"]</a></p>

    <div class="grille-champ">
        <label>@Localizer["CompatibiliteTechnique"]</label>
        <div class="tags">@foreach (var tag in _criteria.TechniqueTags) { <span class="tag">@CompatibilityVocabulary.DisplayTag(tag, _english)</span> }</div>
        @if (!string.IsNullOrWhiteSpace(_criteria.TechniqueNotes)) { <p class="notes">@_criteria.TechniqueNotes</p> }
    </div>

    <div class="grille-champ">
        <label>@Localizer["CompatibiliteComportementale"]</label>
        <div class="tags">@foreach (var tag in _criteria.ComportementaleTags) { <span class="tag">@CompatibilityVocabulary.DisplayTag(tag, _english)</span> }</div>
        @if (!string.IsNullOrWhiteSpace(_criteria.ComportementaleNotes)) { <p class="notes">@_criteria.ComportementaleNotes</p> }
    </div>

    <div class="grille-champ">
        <label>@Localizer["CompatibiliteCulturelle"]</label>
        <div class="tags">@foreach (var tag in _criteria.CulturelleTags) { <span class="tag">@CompatibilityVocabulary.DisplayTag(tag, _english)</span> }</div>
        @if (!string.IsNullOrWhiteSpace(_criteria.CulturelleNotes)) { <p class="notes">@_criteria.CulturelleNotes</p> }
    </div>

    <div class="grille-champ">
        <label>@Localizer["RythmeDeTravailTolere"]</label>
        <p>@(_criteria.RythmeTravail is int r ? $"{r} — {CompatibilityVocabulary.DisplayRythmeTravail(r, _english)}" : Localizer["NonRenseigne"])</p>
        @if (!string.IsNullOrWhiteSpace(_criteria.OrganisationnelleNotes)) { <p class="notes">@_criteria.OrganisationnelleNotes</p> }
    </div>

    <div class="grille-champ">
        <label>@Localizer["CompatibiliteMotivationnelle"]</label>
        <div class="tags">@foreach (var tag in _criteria.MotivationnelleTags) { <span class="tag">@CompatibilityVocabulary.DisplayTag(tag, _english)</span> }</div>
        @if (!string.IsNullOrWhiteSpace(_criteria.MotivationnelleNotes)) { <p class="notes">@_criteria.MotivationnelleNotes</p> }
    </div>

    <div class="grille-champ">
        <label>@Localizer["PointsDeVigilance"]</label>
        <div class="tags">@foreach (var tag in _criteria.PointsVigilanceTags) { <span class="tag">@CompatibilityVocabulary.DisplayTag(tag, _english)</span> }</div>
        @if (!string.IsNullOrWhiteSpace(_criteria.PointsVigilanceNotes)) { <p class="notes">@_criteria.PointsVigilanceNotes</p> }
    </div>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int CandidateProfileId { get; set; }

    private bool _resolu;
    private CandidateCompatibilityCriteriaView? _criteria;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    protected override async Task OnInitializedAsync()
    {
        // Même logique que ResultatCompatibilite.razor : résout l'entreprise active si ce n'est pas déjà
        // fait dans ce circuit (accès direct à cette page sans passer par /vivier au préalable).
        if (TenantContext.ActiveCompanyId is null)
        {
            var userId = AuthenticationStateTask is not null
                ? (await AuthenticationStateTask).User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                : null;

            if (string.IsNullOrEmpty(userId)) { _resolu = true; return; }

            var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb);
            if (companies.Count == 0) { _resolu = true; return; }

            TenantContext.SetActiveCompany(companies[0].Id, companies[0].SchemaName);
        }

        // Garde de confidentialité appliquée dans VivierService.GetCandidateDetailAsync : renvoie null si
        // ce candidat n'a pas de candidature vers l'entreprise active, quel que soit l'identifiant tapé.
        _criteria = await VivierService.GetCandidateDetailAsync(CandidateProfileId);
        _resolu = true;
    }
}
