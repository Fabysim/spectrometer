@page "/jeune/mes-missions"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.Missions.Entities
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IMissionService MissionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<MissionsResource> Localizer

<PageTitle>@Localizer["MesMissionsJeune_Title"]</PageTitle>
<link href="_content/Spectrometre.Modules.Missions/missions-page.css" rel="stylesheet" />

<div class="missions-page">
    <h1 class="missions-title">@Localizer["MesMissionsJeune_Heading"]</h1>
    <p><a href="/jeune/missions-disponibles">@Localizer["MissionsDisponibles_Lien"]</a></p>

    @if (_missions.Count == 0)
    {
        <p class="missions-empty">@Localizer["AucuneMissionJeune"]</p>
    }
    else
    {
        @foreach (var m in _missions)
        {
            <div class="missions-card">
                <h3>@m.Titre</h3>
                <p class="missions-meta">
                    @Localizer[$"StatutMission_{m.MissionStatut}"] · @Localizer[$"StatutAcceptation_{m.AcceptationStatut}"]
                </p>
                @if (m.Lieu is not null) { <p class="missions-meta">@m.Lieu</p> }
                <p class="missions-meta">@Localizer["AccepteeLe", m.AccepteeLe.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]</p>
                @if (m.MissionStatut == MissionStatut.Attribuee && m.AcceptationStatut == MissionAcceptationStatut.ValideeParCoach)
                {
                    <div class="missions-actions">
                        <a class="missions-btn missions-btn-secondary" href="/jeune/missions/@m.AcceptationId/preparation">
                            @Localizer["Preparation_Lien"]
                        </a>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string? _userId;
    private IReadOnlyList<MissionJeuneView> _missions = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (_userId is not null)
            _missions = await MissionService.GetMesMissionsAsync(_userId);
    }
}
