@page "/jeune/mes-missions"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.Missions.Entities
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IMissionService MissionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<MissionsResource> Localizer

<PageTitle>@Localizer["MesMissionsJeune_Title"]</PageTitle>
<link href="_content/Spectrometre.Modules.Missions/missions-page.css" rel="stylesheet" />

<div class="missions-page">
    <h1 class="missions-title">@Localizer["MesMissionsJeune_Heading"]</h1>
    <p><a href="/jeune/missions-disponibles">@Localizer["MissionsDisponibles_Lien"]</a></p>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="missions-success" role="status">@_message</div>
    }

    @if (_missions.Count == 0)
    {
        <p class="missions-empty">@Localizer["AucuneMissionJeune"]</p>
    }
    else
    {
        @foreach (var m in _missions)
        {
            <div class="missions-card">
                <h3>@AfficherTitre(m.Categorie, m.Titre)</h3>
                <p class="missions-meta">
                    @Localizer[$"StatutMission_{m.MissionStatut}"] · @Localizer[$"StatutAcceptation_{m.AcceptationStatut}"]
                </p>
                <p class="missions-meta">@Localizer["Mission_NiveauEncadrement"] : @Localizer[$"Encadrement_{m.NiveauEncadrement}"]</p>
                @if (m.PresenceEscaliers || m.PresenceAnimaux || m.PortDeCharge || m.AccesDifficile)
                {
                    <p class="missions-meta">
                        @Localizer["Mission_ConditionsSecurite"] :
                        @{
                            var secs = new List<string>();
                            if (m.PresenceEscaliers) secs.Add(Localizer["Mission_PresenceEscaliers"]);
                            if (m.PresenceAnimaux) secs.Add(Localizer["Mission_PresenceAnimaux"]);
                            if (m.PortDeCharge) secs.Add(Localizer["Mission_PortDeCharge"]);
                            if (m.AccesDifficile) secs.Add(Localizer["Mission_AccesDifficile"]);
                        }
                        @string.Join(" · ", secs)
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(m.RisqueParticulier))
                {
                    <p class="missions-meta">@Localizer["Mission_RisqueParticulier"] : @m.RisqueParticulier</p>
                }
                @if (m.Lieu is not null) { <p class="missions-meta">@m.Lieu</p> }
                <p class="missions-meta">@Localizer["AccepteeLe", m.AccepteeLe.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]</p>
                @if (m.MissionStatut == MissionStatut.Attribuee && m.AcceptationStatut == MissionAcceptationStatut.ValideeParCoach)
                {
                    <div class="missions-actions">
                        <a class="missions-btn missions-btn-secondary" href="/jeune/missions/@m.AcceptationId/preparation">
                            @Localizer["Preparation_Lien"]
                        </a>
                        <button type="button" class="missions-btn missions-btn-primary" disabled="@_busy"
                                @onclick="() => MarquerTermineeAsync(m.AcceptationId)">
                            @Localizer["MarquerTerminee"]
                        </button>
                    </div>
                }
                else if (m.MissionStatut == MissionStatut.Terminee)
                {
                    <div class="missions-actions">
                        <a class="missions-btn missions-btn-secondary" href="/jeune/missions/@m.AcceptationId/retour">
                            @Localizer["Retour_Lien"]
                        </a>
                        <a class="missions-btn missions-btn-secondary" href="/jeune/missions/@m.AcceptationId/evaluation-particulier">
                            @Localizer["EvaluationParticulier_Lire"]
                        </a>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string? _userId;
    private IReadOnlyList<MissionJeuneView> _missions = [];
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_userId is null)
        {
            _missions = [];
            return;
        }

        _missions = await MissionService.GetMesMissionsAsync(_userId);
    }

    private async Task MarquerTermineeAsync(int acceptationId)
    {
        if (_userId is null || _busy)
            return;

        _busy = true;
        try
        {
            var ok = await MissionService.MarquerTermineeAsync(_userId, acceptationId);
            _message = ok ? Localizer["MarquerTerminee_Succes"] : Localizer["Action_Echec"];
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string AfficherTitre(MissionCategorie categorie, string titre)
    {
        if (categorie == MissionCategorie.Autre)
            return string.IsNullOrWhiteSpace(titre) ? Localizer["Categorie_Autre"] : titre;
        var label = Localizer[$"Categorie_{categorie}"].Value;
        return string.IsNullOrWhiteSpace(titre) ? label : $"{label} — {titre}";
    }
}
