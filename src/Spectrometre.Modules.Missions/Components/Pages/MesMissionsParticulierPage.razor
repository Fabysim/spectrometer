@page "/particulier/mes-missions"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.Missions.Entities
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IMissionService MissionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<MissionsResource> Localizer

<PageTitle>@Localizer["MesMissionsParticulier_Title"]</PageTitle>
<link href="_content/Spectrometre.Modules.Missions/missions-page.css" rel="stylesheet" />

<div class="missions-page">
    <h1 class="missions-title">@Localizer["MesMissionsParticulier_Heading"]</h1>
    <p><a href="/particulier/publier-mission">@Localizer["PublierMission_Lien"]</a></p>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="missions-success" role="status">@_message</div>
    }

    @if (_missions.Count == 0)
    {
        <p class="missions-empty">@Localizer["AucuneMission"]</p>
    }
    else
    {
        @foreach (var m in _missions)
        {
            <div class="missions-card">
                <h3>@AfficherTitre(m.Categorie, m.Titre)</h3>
                <p class="missions-meta">@Localizer[$"Statut_{m.Statut}"] · @Localizer[$"Difficulte_{m.Difficulte}"]</p>
                @if (m.Statut == MissionStatut.Annulee && !string.IsNullOrWhiteSpace(m.MotifAnnulation))
                {
                    <p class="missions-meta">@Localizer["Moderation_MotifVisible", m.MotifAnnulation]</p>
                }
                @if ((m.Statut == MissionStatut.Attribuee || m.Statut == MissionStatut.Terminee || m.Statut == MissionStatut.Annulee)
                     && !string.IsNullOrWhiteSpace(m.JeunePrenom))
                {
                    <p class="missions-meta">@Localizer["Mission_RealiseePar", m.JeunePrenom]</p>
                }
                <p class="missions-meta">@Localizer["Mission_NiveauEncadrement"] : @Localizer[$"Encadrement_{m.NiveauEncadrement}"]</p>
                @if (m.Lieu is not null) { <p class="missions-meta">@m.Lieu</p> }
                @if (m.RemunerationMontant is decimal r) { <p class="missions-meta">@MissionAmountFormat.Format(r)</p> }

                @if (m.Statut == MissionStatut.Disponible || m.Statut == MissionStatut.EnAttenteModeration)
                {
                    <div class="missions-actions">
                        <a class="missions-btn missions-btn-secondary" href="/particulier/mes-missions/@m.MissionId/modifier">
                            @Localizer["ModifierMission_Bouton"]
                        </a>
                        <button type="button" class="missions-btn missions-btn-danger" disabled="@_busy"
                                @onclick="() => AnnulerAsync(m.MissionId)">
                            @Localizer["AnnulerMission_Bouton"]
                        </button>
                    </div>
                }
                else if (m.Statut == MissionStatut.Attribuee)
                {
                    <div class="missions-actions">
                        @if (_formulaireAnnulation && _formulaireMissionId == m.MissionId)
                        {
                            <div class="missions-field" style="flex: 1 1 100%">
                                <label>@Localizer["AnnulerMissionAttribuee_Label"]</label>
                                <textarea rows="2" @bind="_formulaireMessage" maxlength="2000"
                                          placeholder="@Localizer["AnnulerMissionAttribuee_Placeholder"]"></textarea>
                            </div>
                            <button type="button" class="missions-btn missions-btn-danger" disabled="@_busy"
                                    @onclick="() => ConfirmerAnnulationAttribueeAsync(m.MissionId)">
                                @Localizer["AnnulerMissionAttribuee_Confirmer"]
                            </button>
                            <button type="button" class="missions-btn missions-btn-secondary" disabled="@_busy"
                                    @onclick="FermerFormulaire">
                                @Localizer["SignalerProbleme_Annuler"]
                            </button>
                        }
                        else if (_formulaireMissionId == m.MissionId)
                        {
                            <div class="missions-field" style="flex: 1 1 100%">
                                <label>@(_formulaireProbleme ? Localizer["SignalerProbleme_Label"] : Localizer["ContactCoach_Label"])</label>
                                <textarea rows="2" @bind="_formulaireMessage" maxlength="500"
                                          placeholder="@(_formulaireProbleme ? Localizer["SignalerProbleme_Placeholder"] : Localizer["ContactCoach_Placeholder"])"></textarea>
                            </div>
                            <button type="button" class="missions-btn @(_formulaireProbleme ? "missions-btn-danger" : "missions-btn-primary")" disabled="@_busy"
                                    @onclick="() => ConfirmerFormulaireParticulierAsync(m.MissionId)">
                                @(_formulaireProbleme ? Localizer["SignalerProbleme_Envoyer"] : Localizer["ContactCoach_Envoyer"])
                            </button>
                            <button type="button" class="missions-btn missions-btn-secondary" disabled="@_busy"
                                    @onclick="FermerFormulaire">
                                @Localizer["SignalerProbleme_Annuler"]
                            </button>
                        }
                        else
                        {
                            <button type="button" class="missions-btn missions-btn-secondary" disabled="@_busy"
                                    @onclick="() => OuvrirFormulaire(m.MissionId, probleme: false)">
                                @Localizer["ContactCoach_Bouton"]
                            </button>
                            <button type="button" class="missions-btn missions-btn-danger" disabled="@_busy"
                                    @onclick="() => OuvrirFormulaire(m.MissionId, probleme: true)">
                                @Localizer["SignalerProbleme_Bouton"]
                            </button>
                            <button type="button" class="missions-btn missions-btn-danger" disabled="@_busy"
                                    @onclick="() => OuvrirFormulaireAnnulation(m.MissionId)">
                                @Localizer["AnnulerMissionAttribuee_Bouton"]
                            </button>
                        }
                    </div>
                }
                else if (m.Statut == MissionStatut.Terminee && m.AcceptationIdPourEvaluation is int acceptationId)
                {
                    <div class="missions-actions">
                        <a class="missions-btn missions-btn-primary" href="/particulier/missions/@acceptationId/evaluation">
                            @Localizer["Evaluation_Lien"]
                        </a>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string? _userId;
    private IReadOnlyList<MissionResumeView> _missions = [];
    private string? _message;
    private bool _busy;
    private int? _formulaireMissionId;
    private bool _formulaireProbleme;
    private bool _formulaireAnnulation;
    private string _formulaireMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_userId is null)
        {
            _missions = [];
            return;
        }

        _missions = await MissionService.GetMesMissionsPublieesAsync(_userId);
    }

    private async Task AnnulerAsync(int missionId)
    {
        if (_userId is null || _busy)
            return;

        _busy = true;
        try
        {
            var ok = await MissionService.AnnulerMissionAsync(_userId, missionId);
            _message = ok ? Localizer["AnnulerMission_Succes"] : Localizer["Action_Echec"];
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OuvrirFormulaire(int missionId, bool probleme)
    {
        _formulaireMissionId = missionId;
        _formulaireProbleme = probleme;
        _formulaireAnnulation = false;
        _formulaireMessage = "";
        _message = null;
    }

    private void OuvrirFormulaireAnnulation(int missionId)
    {
        _formulaireMissionId = missionId;
        _formulaireProbleme = false;
        _formulaireAnnulation = true;
        _formulaireMessage = "";
        _message = null;
    }

    private void FermerFormulaire()
    {
        _formulaireMissionId = null;
        _formulaireProbleme = false;
        _formulaireAnnulation = false;
        _formulaireMessage = "";
    }

    private async Task ConfirmerAnnulationAttribueeAsync(int missionId)
    {
        if (_userId is null || _busy)
            return;

        if (string.IsNullOrWhiteSpace(_formulaireMessage))
        {
            _message = Localizer["AnnulerMissionAttribuee_MotifRequis"];
            return;
        }

        _busy = true;
        try
        {
            var ok = await MissionService.AnnulerMissionAttribueeAsync(_userId, missionId, _formulaireMessage);
            _message = ok ? Localizer["AnnulerMissionAttribuee_Succes"] : Localizer["Action_Echec"];
            if (ok)
            {
                FermerFormulaire();
                await RefreshAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmerFormulaireParticulierAsync(int missionId)
    {
        if (_userId is null || _busy)
            return;

        _busy = true;
        try
        {
            var ok = _formulaireProbleme
                ? await MissionService.SignalerProblemeAsync(_userId, missionId, _formulaireMessage)
                : await MissionService.DemanderContactParticulierAsync(_userId, missionId, _formulaireMessage);
            _message = ok
                ? (_formulaireProbleme ? Localizer["SignalerProbleme_Succes"] : Localizer["ContactCoach_Succes"])
                : (_formulaireProbleme ? Localizer["SignalerProbleme_Echec"] : Localizer["ContactCoach_Echec"]);
            if (ok)
                FermerFormulaire();
        }
        finally
        {
            _busy = false;
        }
    }

    private string AfficherTitre(MissionCategorie categorie, string titre)
    {
        if (categorie == MissionCategorie.Autre)
            return string.IsNullOrWhiteSpace(titre) ? Localizer["Categorie_Autre"] : titre;
        var label = Localizer[$"Categorie_{categorie}"].Value;
        return string.IsNullOrWhiteSpace(titre) ? label : $"{label} — {titre}";
    }
}
