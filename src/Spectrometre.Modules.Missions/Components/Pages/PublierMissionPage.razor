@page "/particulier/publier-mission"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.Missions.Catalog
@using Spectrometre.Modules.Missions.Entities
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IMissionService MissionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<MissionsResource> Localizer

<PageTitle>@Localizer["PublierMission_Title"]</PageTitle>
<link href="_content/Spectrometre.Modules.Missions/missions-page.css" rel="stylesheet" />

<div class="missions-page">
    <h1 class="missions-title">@Localizer["PublierMission_Heading"]</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="missions-success">@_message</div>
    }

    <div class="missions-card">
        <div class="missions-field">
            <label>@Localizer["Mission_Categorie"]</label>
            <select @bind="_categorie" @bind:after="OnCategorieChanged">
                @foreach (var c in Enum.GetValues<MissionCategorie>())
                {
                    <option value="@c">@Localizer[$"Categorie_{c}"]</option>
                }
            </select>
            <p class="missions-meta">@Localizer[MissionCategorieCatalog.ExempleCle(_categorie)]</p>
        </div>
        <div class="missions-field">
            <label>@(_categorie == MissionCategorie.Autre ? Localizer["Mission_TitreObligatoire"] : Localizer["Mission_TitreComplement"])</label>
            <input @bind="_titre" />
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_Description"]</label>
            <textarea rows="4" @bind="_description"></textarea>
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_NiveauEncadrement"]</label>
            <select @bind="_niveauEncadrement">
                @foreach (var n in Enum.GetValues<MissionNiveauEncadrement>())
                {
                    <option value="@n">@Localizer[$"Encadrement_{n}"]</option>
                }
            </select>
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_Lieu"]</label>
            <input @bind="_lieu" />
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_Duree"]</label>
            <input @bind="_duree" placeholder="@Localizer["Mission_DureeHint"]" />
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_Difficulte"]</label>
            <select @bind="_difficulte">
                @foreach (var d in Enum.GetValues<MissionDifficulte>())
                {
                    <option value="@d">@Localizer[$"Difficulte_{d}"]</option>
                }
            </select>
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_Remuneration"]</label>
            <input type="number" step="0.01" @bind="_remuneration" />
        </div>
        <div class="missions-field">
            <label>@Localizer["Mission_Competences"]</label>
            <textarea rows="2" @bind="_competences"></textarea>
        </div>

        <fieldset class="missions-field">
            <legend>@Localizer["Mission_ConditionsSecurite"]</legend>
            <p class="missions-meta">@Localizer["Mission_ConditionsSecurite_Hint"]</p>
            <label class="missions-check"><input type="checkbox" @bind="_presenceEscaliers" /> @Localizer["Mission_PresenceEscaliers"]</label>
            <label class="missions-check"><input type="checkbox" @bind="_presenceAnimaux" /> @Localizer["Mission_PresenceAnimaux"]</label>
            <label class="missions-check"><input type="checkbox" @bind="_portDeCharge" /> @Localizer["Mission_PortDeCharge"]</label>
            <label class="missions-check"><input type="checkbox" @bind="_accesDifficile" /> @Localizer["Mission_AccesDifficile"]</label>
            @if (_presenceEscaliers || _presenceAnimaux || _portDeCharge || _accesDifficile)
            {
                <label>@Localizer["Mission_RisqueParticulier"]</label>
                <textarea rows="2" @bind="_risqueParticulier"></textarea>
            }
        </fieldset>

        <div class="missions-actions">
            <button type="button" class="missions-btn missions-btn-primary" disabled="@_saving" @onclick="PublierAsync">
                @Localizer["PublierMission_Bouton"]
            </button>
            <a href="/particulier/mes-missions" class="missions-btn missions-btn-secondary">@Localizer["MesMissions_Lien"]</a>
        </div>
    </div>
</div>

@code {
    private string? _userId;
    private MissionCategorie _categorie = MissionCategorie.JardinageSimple;
    private string _titre = "";
    private string _description = "";
    private MissionNiveauEncadrement _niveauEncadrement = MissionNiveauEncadrement.PresentPendantMission;
    private string? _lieu;
    private string? _duree;
    private MissionDifficulte _difficulte = MissionDifficulte.Facile;
    private decimal? _remuneration;
    private string? _competences;
    private bool _presenceEscaliers;
    private bool _presenceAnimaux;
    private bool _portDeCharge;
    private bool _accesDifficile;
    private string? _risqueParticulier;
    private bool _saving;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private void OnCategorieChanged()
    {
        // no-op : relance le rendu pour le label titre / exemple
    }

    private async Task PublierAsync()
    {
        if (_userId is null) return;
        _saving = true;
        _message = null;

        var id = await MissionService.PublierMissionAsync(_userId, new PublierMissionInput(
            _titre,
            _description,
            _lieu,
            _duree,
            _difficulte,
            _remuneration,
            _competences,
            _categorie,
            _niveauEncadrement,
            _presenceEscaliers,
            _presenceAnimaux,
            _portDeCharge,
            _accesDifficile,
            _risqueParticulier));

        if (id is null)
            _message = Localizer["Erreur_Publication"];
        else
        {
            _message = Localizer["PublierMission_Succes"];
            _titre = _description = "";
            _lieu = _duree = _competences = _risqueParticulier = null;
            _remuneration = null;
            _presenceEscaliers = _presenceAnimaux = _portDeCharge = _accesDifficile = false;
            _categorie = MissionCategorie.JardinageSimple;
            _niveauEncadrement = MissionNiveauEncadrement.PresentPendantMission;
        }

        _saving = false;
    }
}
