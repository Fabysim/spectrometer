@page "/jeune/missions-disponibles"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.Missions.Entities
@using Spectrometre.Modules.Missions.Services
@using Spectrometre.Modules.JeunesPrestataires.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IMissionService MissionService
@inject IMissionSuggestionsService Suggestions
@inject ICharteService CharteService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<MissionsResource> Localizer

<PageTitle>@Localizer["MissionsDisponibles_Title"]</PageTitle>
<link href="_content/Spectrometre.Modules.Missions/missions-page.css" rel="stylesheet" />

<div class="missions-page">
    <h1 class="missions-title">@Localizer["MissionsDisponibles_Heading"]</h1>
    <p><a href="/jeune/mes-missions">@Localizer["MesMissionsJeune_Lien"]</a></p>

    @if (_charteManquante)
    {
        <p class="missions-meta">
            @Localizer["Acceptation_CharteRequise"]
            <a href="/jeune/charte">@Localizer["Acceptation_CharteLien"]</a>
        </p>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="missions-success">@_message</div>
    }

    @if (_recommandees.Count > 0)
    {
        <h2 class="missions-section-title">@Localizer["MissionsDisponibles_Recommandees_Titre"]</h2>
        @foreach (var m in _recommandees)
        {
            <MissionDisponibleCard Mission="m"
                                   Disabled="@(_acceptingId.HasValue || _charteManquante)"
                                   OnAccepter="AccepterAsync" />
        }
        <h2 class="missions-section-title">@Localizer["MissionsDisponibles_Toutes_Titre"]</h2>
    }

    @if (_missions.Count == 0)
    {
        <p class="missions-empty">@Localizer["AucuneMissionDisponible"]</p>
    }
    else
    {
        @foreach (var m in _missions)
        {
            <MissionDisponibleCard Mission="m"
                                   Disabled="@(_acceptingId.HasValue || _charteManquante)"
                                   OnAccepter="AccepterAsync" />
        }
    }
</div>

@code {
    private string? _userId;
    private IReadOnlyList<MissionResumeView> _missions = [];
    private IReadOnlyList<MissionResumeView> _recommandees = [];
    private int? _acceptingId;
    private string? _message;
    private bool _charteManquante;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (_userId is not null)
            _charteManquante = !await CharteService.EstAccepteeAsync(_userId);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _missions = await MissionService.GetMissionsDisponiblesAsync();
        _recommandees = [];
        if (_userId is not null)
        {
            var recos = await Suggestions.GetRecommandeesAsync(_userId);
            _recommandees = recos ?? [];
        }
    }

    private async Task AccepterAsync(int missionId)
    {
        if (_userId is null) return;
        _acceptingId = missionId;
        _message = null;

        var ok = await MissionService.AccepterMissionAsync(_userId, missionId);
        _message = ok ? Localizer["Acceptation_Succes"] : Localizer["Acceptation_Echec"];
        await RefreshAsync();
        _acceptingId = null;
    }
}
