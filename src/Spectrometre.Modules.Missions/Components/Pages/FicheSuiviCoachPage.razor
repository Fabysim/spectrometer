@page "/coach/suivis/{SuiviUserId}/apercu"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.JeunesPrestataires.Entities
@using Spectrometre.Modules.JeunesPrestataires.Resources
@using Spectrometre.Modules.JeunesPrestataires.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IFicheSuiviCoachService FicheSuiviService
@inject IJeuneProfileService JeuneProfileService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<MissionsResource> Localizer
@inject IStringLocalizer<JeunesPrestatairesResource> JpLocalizer

<PageTitle>@Localizer["FicheSuivi_Title"]</PageTitle>
<link href="_content/Spectrometre.Modules.Missions/missions-page.css" rel="stylesheet" />

<div class="missions-page">
@if (_chargement)
{
    <p>@Localizer["Chargement"]</p>
}
else if (_view is null)
{
    <div class="missions-card">
        <h1 class="missions-title">@Localizer["FicheSuivi_AccesRefuse_Titre"]</h1>
        <p class="missions-meta">@Localizer["FicheSuivi_AccesRefuse_Message"]</p>
        <p><a href="/coach/suivis">@Localizer["RetourSuivis"]</a></p>
    </div>
}
else
{
    <p><a href="/coach/suivis">@Localizer["RetourSuivis"]</a></p>
    <h1 class="missions-title">@Localizer["FicheSuivi_Heading"]</h1>
    <p class="missions-meta">@Localizer["FicheSuivi_Intro"]</p>

    <div class="missions-card">
        <h2 class="missions-section-title">@Localizer["FicheSuivi_Identite_Titre"]</h2>
        <p class="mes-progres-stat">@_view.Prenoms @_view.Nom</p>
        <p class="missions-meta">@Localizer["FicheSuivi_Age", _view.Age]</p>
        <p class="missions-meta">@ConsentementLabel(_view.ConsentementStatut)</p>
        <div class="missions-field" style="margin-top:0.75rem;">
            <label for="profil-accompagnement">@Localizer["FicheSuivi_Profil_Label"]</label>
            <select id="profil-accompagnement" @bind="_profilChoisi">
                <option value="@ProfilAccompagnement.SansExperience">@Localizer["FicheSuivi_Profil_SansExperience"]</option>
                <option value="@ProfilAccompagnement.Autonome">@Localizer["FicheSuivi_Profil_Autonome"]</option>
            </select>
            <p class="missions-meta">@Localizer["FicheSuivi_Profil_Aide"]</p>
            <button type="button" class="missions-btn missions-btn-secondary" @onclick="EnregistrerProfilAsync" disabled="@_saving">
                @Localizer["FicheSuivi_Profil_Enregistrer"]
            </button>
            @if (_profilMessage is not null)
            {
                <p class="missions-meta">@_profilMessage</p>
            }
        </div>
    </div>

    @if (_view.ContactParental is { } contact)
    {
        <div class="missions-card">
            <h2 class="missions-section-title">@Localizer["FicheSuivi_ContactParent_Titre"]</h2>
            <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Aide"]</p>
            <p class="mes-progres-stat">@Localizer["FicheSuivi_ContactParent_Parent1"]</p>
            <p class="missions-meta">@contact.Parent1.Nom</p>
            @if (!string.IsNullOrWhiteSpace(contact.Parent1.Lien))
            {
                <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Lien"] : @contact.Parent1.Lien</p>
            }
            @if (!string.IsNullOrWhiteSpace(contact.Parent1.Telephone))
            {
                <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Telephone"] : @contact.Parent1.Telephone</p>
            }
            @if (!string.IsNullOrWhiteSpace(contact.Parent1.Email))
            {
                <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Email"] : @contact.Parent1.Email</p>
            }
            @if (contact.Parent2 is { } parent2)
            {
                <p class="mes-progres-stat">@Localizer["FicheSuivi_ContactParent_Parent2"]</p>
                <p class="missions-meta">@parent2.Nom</p>
                @if (!string.IsNullOrWhiteSpace(parent2.Lien))
                {
                    <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Lien"] : @parent2.Lien</p>
                }
                @if (!string.IsNullOrWhiteSpace(parent2.Telephone))
                {
                    <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Telephone"] : @parent2.Telephone</p>
                }
                @if (!string.IsNullOrWhiteSpace(parent2.Email))
                {
                    <p class="missions-meta">@Localizer["FicheSuivi_ContactParent_Email"] : @parent2.Email</p>
                }
            }
            <p class="mes-progres-stat">@Localizer["FicheSuivi_ContactParent_Engagements"]</p>
            <ul class="missions-meta">
                @if (contact.EngagementScolariteSanteEquilibre)
                {
                    <li>@JpLocalizer["EngagementScolariteSanteEquilibre"]</li>
                }
                @if (contact.EngagementInformerContraintes)
                {
                    <li>@JpLocalizer["EngagementInformerContraintes"]</li>
                }
                @if (contact.EngagementEncouragerCharte)
                {
                    <li>@JpLocalizer["EngagementEncouragerCharte"]</li>
                }
                @if (contact.EngagementSignalerMissionInadaptee)
                {
                    <li>@JpLocalizer["EngagementSignalerMissionInadaptee"]</li>
                }
                @if (contact.EngagementCollaborerCoach)
                {
                    <li>@JpLocalizer["EngagementCollaborerCoach"]</li>
                }
            </ul>
        </div>
    }

    <div class="missions-card">
        <h2 class="missions-section-title">@Localizer["FicheSuivi_Missions_Titre"]</h2>
        <p class="mes-progres-stat">@Localizer["MesProgres_Missions_Terminees", _view.MissionsTerminees]</p>
        <p class="mes-progres-stat">@Localizer["MesProgres_Missions_EnCours", _view.MissionsEnCours]</p>
        <p><a href="/coach/suivis/@SuiviUserId/missions">@Localizer["FicheSuivi_Lien_Missions"]</a></p>
    </div>

    <div class="missions-card">
        <h2 class="missions-section-title">@Localizer["FicheSuivi_Retours_Titre"]</h2>
        @if (_view.RetoursParticuliersRecents.Count == 0)
        {
            <p class="missions-meta">@Localizer["FicheSuivi_Retours_Vide"]</p>
        }
        else
        {
            @foreach (var r in _view.RetoursParticuliersRecents)
            {
                <p class="mes-progres-stat">@r.MissionTitre</p>
                <p class="missions-meta">@r.EvalueeLe.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</p>
                <p class="missions-meta">
                    @Localizer["Evaluation_Ponctualite"] : @OuiNon(r.Ponctualite)
                    · @Localizer["Evaluation_ConsignesComprises"] : @OuiNon(r.ConsignesComprises)
                    · @Localizer["Evaluation_TacheRealisee"] : @OuiNon(r.TacheRealiseeCorrectement)
                    · @Localizer["Evaluation_AttitudeRespectueuse"] : @OuiNon(r.AttitudeRespectueuse)
                </p>
            }
        }
        <p><a href="/coach/suivis/@SuiviUserId/grille-observation">@Localizer["FicheSuivi_Retours_VoirTout"]</a></p>
    </div>

    <div class="missions-card">
        <h2 class="missions-section-title">@Localizer["FicheSuivi_Grille_Titre"]</h2>
        @if (_view.GrilleDerniereMoyenne is double moyenne && _view.GrilleDerniereEvaluationLe is DateTimeOffset dateEval)
        {
            <p class="mes-progres-stat">
                @Localizer["MesProgres_Grille_Moyenne", moyenne.ToString("0.0", CultureInfo.CurrentCulture)]
            </p>
            <p class="missions-meta">
                @Localizer["MesProgres_Grille_Date", dateEval.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]
            </p>
        }
        else
        {
            <p class="missions-meta">@Localizer["FicheSuivi_Grille_Vide"]</p>
        }
        <p><a href="/coach/suivis/@SuiviUserId/grille-observation">@Localizer["FicheSuivi_Lien_Grille"]</a></p>
    </div>

    <div class="missions-card">
        <h2 class="missions-section-title">@Localizer["FicheSuivi_Guide_Titre"]</h2>
        <p class="missions-meta">
            @(_view.GuideEntrevueRempli ? Localizer["FicheSuivi_Guide_Rempli"] : Localizer["FicheSuivi_Guide_Vide"])
        </p>
        <p><a href="/coach/suivis/@SuiviUserId/guide-entrevue">@Localizer["FicheSuivi_Lien_Guide"]</a></p>
    </div>

    <div class="missions-card">
        <h2 class="missions-section-title">@Localizer["FicheSuivi_Liens_Titre"]</h2>
        <div class="missions-actions">
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/auto-observation">
                @Localizer["FicheSuivi_Lien_AutoObs"]
            </a>
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/cv">
                @Localizer["FicheSuivi_Lien_Cv"]
            </a>
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/cv/pdf" data-enhance-nav="false">
                @Localizer["FicheSuivi_Lien_CvPdf"]
            </a>
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/cv/docx" data-enhance-nav="false">
                @Localizer["FicheSuivi_Lien_CvWord"]
            </a>
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/grille-observation">
                @Localizer["FicheSuivi_Lien_Grille"]
            </a>
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/guide-entrevue">
                @Localizer["FicheSuivi_Lien_Guide"]
            </a>
            <a class="missions-btn missions-btn-secondary" href="/coach/suivis/@SuiviUserId/missions">
                @Localizer["FicheSuivi_Lien_Missions"]
            </a>
            @if (_view.LienCoachingId is int lienId)
            {
                <a class="missions-btn missions-btn-secondary" href="/coach/objectifs/@lienId">
                    @Localizer["FicheSuivi_Lien_Objectifs"]
                </a>
            }
        </div>
    </div>
}
</div>

@code {
    [Parameter] public string? SuiviUserId { get; set; }

    private string? _userId;
    private bool _chargement = true;
    private bool _saving;
    private FicheSuiviCoachView? _view;
    private ProfilAccompagnement _profilChoisi;
    private string? _profilMessage;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (_userId is not null && !string.IsNullOrWhiteSpace(SuiviUserId))
            _view = await FicheSuiviService.GetAsync(_userId, SuiviUserId);
            if (_view is not null)
                _profilChoisi = _view.ProfilAccompagnement;
        _chargement = false;
    }

    private async Task EnregistrerProfilAsync()
    {
        if (_userId is null || string.IsNullOrWhiteSpace(SuiviUserId))
            return;

        _saving = true;
        _profilMessage = null;
        var ok = await JeuneProfileService.MettreAJourProfilAccompagnementAsync(_userId, SuiviUserId, _profilChoisi);
        if (ok)
        {
            _view = await FicheSuiviService.GetAsync(_userId, SuiviUserId);
            _profilMessage = Localizer["FicheSuivi_Profil_Succes"];
        }
        else
        {
            _profilMessage = Localizer["FicheSuivi_Profil_Erreur"];
        }
        _saving = false;
    }

    private string ConsentementLabel(FicheSuiviConsentementStatut statut) => statut switch
    {
        FicheSuiviConsentementStatut.MajeurNonRequis => Localizer["FicheSuivi_Consentement_Majeur"],
        FicheSuiviConsentementStatut.MineurValide => Localizer["FicheSuivi_Consentement_MineurValide"],
        _ => Localizer["FicheSuivi_Consentement_MineurAttente"],
    };

    private string OuiNon(bool? valeur) => valeur switch
    {
        true => Localizer["Evaluation_Oui"],
        false => Localizer["Evaluation_Non"],
        _ => Localizer["Evaluation_NonRenseigne"],
    };
}
