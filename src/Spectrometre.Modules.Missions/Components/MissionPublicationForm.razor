@using Spectrometre.Modules.Missions.Catalog
@using Spectrometre.Modules.Missions.Entities
@inject IStringLocalizer<MissionsResource> Localizer

<div class="missions-card">
    <div class="missions-field">
        <label>@Localizer["Mission_Categorie"]</label>
        <select @bind="Model.Categorie" @bind:after="OnCategorieChanged">
            @foreach (var c in Enum.GetValues<MissionCategorie>())
            {
                <option value="@c">@Localizer[$"Categorie_{c}"]</option>
            }
        </select>
        <p class="missions-meta">@Localizer[MissionCategorieCatalog.ExempleCle(Model.Categorie)]</p>
    </div>
    <div class="missions-field">
        <label>@(Model.Categorie == MissionCategorie.Autre ? Localizer["Mission_TitreObligatoire"] : Localizer["Mission_TitreComplement"])</label>
        <input @bind="Model.Titre" />
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_Description"]</label>
        <textarea rows="4" @bind="Model.Description"></textarea>
        <p class="missions-meta">@Localizer["PublierMission_Confidentialite"]</p>
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_NiveauEncadrement"]</label>
        <select @bind="Model.NiveauEncadrement">
            @foreach (var n in Enum.GetValues<MissionNiveauEncadrement>())
            {
                <option value="@n">@Localizer[$"Encadrement_{n}"]</option>
            }
        </select>
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_Lieu"]</label>
        <input @bind="Model.Lieu" />
        <p class="missions-meta">@Localizer["PublierMission_LieuConfidentialite"]</p>
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_Duree"]</label>
        <input @bind="Model.DureeEstimee" placeholder="@Localizer["Mission_DureeHint"]" />
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_Difficulte"]</label>
        <select @bind="Model.Difficulte">
            @foreach (var d in Enum.GetValues<MissionDifficulte>())
            {
                <option value="@d">@Localizer[$"Difficulte_{d}"]</option>
            }
        </select>
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_Remuneration"]</label>
        <input type="number" step="0.01" @bind="Model.RemunerationMontant" />
    </div>
    <div class="missions-field">
        <label>@Localizer["Mission_Competences"]</label>
        <textarea rows="2" @bind="Model.CompetencesTravaillees"></textarea>
    </div>

    <fieldset class="missions-field">
        <legend>@Localizer["Mission_ConditionsSecurite"]</legend>
        <p class="missions-meta">@Localizer["Mission_ConditionsSecurite_Hint"]</p>
        <label class="missions-check"><input type="checkbox" @bind="Model.PresenceEscaliers" /> @Localizer["Mission_PresenceEscaliers"]</label>
        <label class="missions-check"><input type="checkbox" @bind="Model.PresenceAnimaux" /> @Localizer["Mission_PresenceAnimaux"]</label>
        <label class="missions-check"><input type="checkbox" @bind="Model.PortDeCharge" /> @Localizer["Mission_PortDeCharge"]</label>
        <label class="missions-check"><input type="checkbox" @bind="Model.AccesDifficile" /> @Localizer["Mission_AccesDifficile"]</label>
        @if (Model.PresenceEscaliers || Model.PresenceAnimaux || Model.PortDeCharge || Model.AccesDifficile)
        {
            <label>@Localizer["Mission_RisqueParticulier"]</label>
            <textarea rows="2" @bind="Model.RisqueParticulier"></textarea>
        }
    </fieldset>

    <div class="missions-actions">
        @Actions
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MissionFormModel Model { get; set; } = default!;

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private void OnCategorieChanged()
    {
        // Relance le rendu pour le label titre / exemple de catégorie.
    }
}
