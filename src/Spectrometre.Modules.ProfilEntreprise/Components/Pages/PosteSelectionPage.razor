@page "/entreprise/postes/{PosteId:int}/selection"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.ProfilEntreprise.Entities
@using Spectrometre.Modules.ProfilEntreprise.Resources
@using Spectrometre.Modules.ProfilEntreprise.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IPosteService PosteService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<ProfilEntrepriseResource> Localizer

<PageTitle>@(_poste?.Titre ?? Localizer["SelectionDesCandidats"].Value)</PageTitle>

<div class="postes-page">
@if (_loading)
{
    <p class="postes-state">@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["AucuneEntrepriseAssociee"]</p>
    </section>
}
else if (_poste is null)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["PosteIntrouvable"]</p>
        <a href="/entreprise/postes" class="postes-btn-ghost">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @Localizer["RetourAuxPostes"]
        </a>
    </section>
}
else
{
    <header class="postes-header">
        <div>
            <nav class="postes-breadcrumb" aria-label="breadcrumb">
                <a href="/entreprise/postes">@Localizer["RetourAuxPostes"]</a>
                <span class="postes-breadcrumb-sep" aria-hidden="true">/</span>
                <a href="@($"/entreprise/postes/{PosteId}/candidats")">@_poste.Titre</a>
                <span class="postes-breadcrumb-sep" aria-hidden="true">/</span>
                <span>@Localizer["SelectionDesCandidats"]</span>
            </nav>
            <h1 class="postes-title">@Localizer["SelectionDesCandidats"]</h1>
            <p class="postes-subtitle">@_poste.Titre — @Localizer["SelectionDesCandidatsHint"]</p>
        </div>
        <a href="@($"/entreprise/postes/{PosteId}/candidats")" class="postes-btn-ghost">
            <i class="bi bi-people" aria-hidden="true"></i>
            @Localizer["VoirLesCandidatures"]
        </a>
    </header>

    <section class="postes-card postes-selection-card">
        @if (_lignes.Count == 0)
        {
            <p class="postes-hint">@Localizer["AucuneCandidaturePourPoste"]</p>
        }
        else
        {
            <div class="postes-selection-table-wrap">
                <table class="postes-selection-table">
                    <thead>
                        <tr>
                            <th>@Localizer["CandidatProfil"]</th>
                            <th>@Localizer["Statut"]</th>
                            <th>@Localizer["Compatibilite"]</th>
                            <th>@Localizer["NiveauMoyenEvaluation"]</th>
                            <th>@Localizer["Preselectionne"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ligne in _lignes)
                        {
                            <tr class="@(ligne.Candidature.EstPreselectionne ? "is-preselected" : null)">
                                <td>
                                    <span class="candidat-id">#@ligne.Candidature.CandidateProfileId</span>
                                    @if (ligne.Candidature.EstPreselectionne)
                                    {
                                        <span class="postes-badge-preselect">@Localizer["Preselectionne"]</span>
                                    }
                                </td>
                                <td>@CandidatureStatutLabels.Label(ligne.Candidature.Statut, _english)</td>
                                <td>
                                    @if (ligne.Candidature.ScoreCompatibilite is int score)
                                    {
                                        <span class="score-badge">@score%</span>
                                    }
                                    else
                                    {
                                        <span class="score-empty">—</span>
                                    }
                                </td>
                                <td>
                                    @if (ligne.NiveauMoyen is double moyenne)
                                    {
                                        <span class="score-badge">@moyenne.ToString("0.#", CultureInfo.CurrentUICulture)/4</span>
                                    }
                                    else
                                    {
                                        <span class="score-empty">—</span>
                                    }
                                </td>
                                <td>
                                    <label class="postes-check">
                                        <input type="checkbox"
                                               checked="@ligne.Candidature.EstPreselectionne"
                                               @onchange="e => OnPreselectionChangedAsync(ligne.Candidature.Id, e)" />
                                        <span>@Localizer["Preselectionne"]</span>
                                    </label>
                                </td>
                                <td class="candidature-links">
                                    <a href="@($"/entreprise/postes/{PosteId}/candidats/{ligne.Candidature.Id}")">@Localizer["VoirLeDetail"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public int PosteId { get; set; }

    private bool _loading = true;
    private List<Company> _companies = [];
    private PosteView? _poste;
    private List<SelectionLigne> _lignes = [];
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count == 0)
        {
            _loading = false;
            return;
        }

        await ResolveAsync();
        _loading = false;
    }

    private async Task ResolveAsync()
    {
        var ordered = _companies
            .OrderByDescending(c => TenantContext.ActiveCompanyId == c.Id)
            .ToList();

        foreach (var company in ordered)
        {
            TenantContext.SetActiveCompany(company.Id, company.SchemaName);
            var postes = await PosteService.GetPostesAsync();
            var poste = postes.FirstOrDefault(p => p.Id == PosteId);
            if (poste is null)
                continue;

            _poste = poste;
            await ChargerLignesAsync();
            return;
        }

        _poste = null;
        _lignes = [];
    }

    private async Task ChargerLignesAsync()
    {
        var candidatures = await PosteService.GetCandidaturesAsync(PosteId);
        var lignes = new List<SelectionLigne>(candidatures.Count);
        foreach (var candidature in candidatures)
        {
            var evaluations = await PosteService.GetEvaluationCriteresAsync(candidature.Id);
            var finals = evaluations
                .Where(e => e.NiveauFinal is not null)
                .Select(e => (int)e.NiveauFinal!)
                .ToList();
            double? moyenne = finals.Count > 0 ? finals.Average() : null;
            lignes.Add(new SelectionLigne(candidature, moyenne));
        }

        _lignes = lignes
            .OrderByDescending(l => l.Candidature.EstPreselectionne)
            .ThenByDescending(l => l.Candidature.ScoreCompatibilite ?? -1)
            .ToList();
    }

    private async Task OnPreselectionChangedAsync(int candidatureId, ChangeEventArgs e)
    {
        var checkedState = e.Value is bool b && b
            || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(e.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);

        await PosteService.SetPreselectionAsync(candidatureId, checkedState);
        await ChargerLignesAsync();
    }

    private sealed record SelectionLigne(CandidatureView Candidature, double? NiveauMoyen);
}
