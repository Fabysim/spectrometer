@page "/entreprise/profil"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Spectrometre.Core.Compatibility
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.ProfilEntreprise.Entities
@using Spectrometre.Modules.ProfilEntreprise.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICompanyProfileService CompanyProfileService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb

<PageTitle>Profil entreprise</PageTitle>

@if (_companies is null)
{
    <p>Chargement…</p>
}
else if (_companies.Count == 0)
{
    <p>Aucune entreprise associée à votre compte pour le moment.</p>
}
else
{
    <div class="entreprise-header">
        @if (_companies.Count > 1)
        {
            <label>
                Entreprise active :
                <select value="@_selectedCompanyId" @onchange="OnCompanyChangedAsync">
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </label>
        }
        else
        {
            <strong>@_companies[0].Name</strong>
        }
    </div>

    @if (_questions is not null)
    {
        var themes = Enum.GetValues<CompanyTheme>();

        <div class="entreprise-tabs">
            @foreach (var theme in themes)
            {
                <button class="@(!_showGrilleK && theme == _activeTheme ? "active" : "")" @onclick="() => { _showGrilleK = false; _activeTheme = theme; }">
                    @CompanyThemeLabels.TabLabel(theme)
                </button>
            }
            <button class="@(_showGrilleK ? "active" : "")" @onclick="() => _showGrilleK = true">
                @(GrilleComplete ? "✅" : "◯") K. Grille compatibilité
            </button>
        </div>

        @if (!_showGrilleK)
        {
            <div class="entreprise-body">
                <section class="entreprise-form">
                    <h3>@CompanyThemeLabels.Label(_activeTheme)</h3>
                    @foreach (var question in _questions.Where(q => q.Theme == _activeTheme))
                    {
                        <div class="question">
                            <label>@question.Text</label>
                            <textarea value="@question.AnswerText" @onchange="e => SaveAnswerAsync(question.QuestionId, e.Value?.ToString())" rows="2"></textarea>
                        </div>
                    }
                </section>

                <aside class="entreprise-synthese">
                    <h3>SYNTHÈSE ENTREPRISE</h3>
                    <p class="hint">La synthèse (section J) est renseignée directement par l'entreprise dans l'onglet « J. Synthèse ».</p>
                </aside>
            </div>
        }
        else
        {
            <div class="entreprise-body">
                <section class="entreprise-form">
                    <h3>K. Grille complémentaire des critères pour le moteur de compatibilité</h3>
                    <p class="hint">
                        Transforme les informations qualitatives du profil en critères directement
                        comparables avec le profil du candidat.
                    </p>

                    <div class="grille-champ">
                        <label>Compatibilité technique</label>
                        <p class="grille-question">Sélectionnez les compétences indispensables dès l'entrée en fonction.</p>
                        <div class="tag-checkboxes">
                            @foreach (var tag in CompatibilityVocabulary.TechniqueTags)
                            {
                                <label class="tag-checkbox">
                                    <input type="checkbox" checked="@_grille.TechniqueTags.Contains(tag)"
                                           @onchange="e => ToggleTagAsync(CriteriaField.Technique, _grille.TechniqueTags, tag, (bool)e.Value!)" />
                                    @tag
                                </label>
                            }
                        </div>
                        <textarea @bind="_grille.TechniqueNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Technique, e.Value?.ToString())"
                                  placeholder="Notes libres (optionnel — sert à l'entretien, n'entre pas dans le calcul)" rows="2"></textarea>
                    </div>

                    <div class="grille-champ">
                        <label>Compatibilité comportementale</label>
                        <p class="grille-question">Sélectionnez les comportements professionnels attendus au quotidien.</p>
                        <div class="tag-checkboxes">
                            @foreach (var tag in CompatibilityVocabulary.ComportementaleTags)
                            {
                                <label class="tag-checkbox">
                                    <input type="checkbox" checked="@_grille.ComportementaleTags.Contains(tag)"
                                           @onchange="e => ToggleTagAsync(CriteriaField.Comportementale, _grille.ComportementaleTags, tag, (bool)e.Value!)" />
                                    @tag
                                </label>
                            }
                        </div>
                        <textarea @bind="_grille.ComportementaleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Comportementale, e.Value?.ToString())"
                                  placeholder="Notes libres (optionnel)" rows="2"></textarea>
                    </div>

                    <div class="grille-champ">
                        <label>Compatibilité culturelle</label>
                        <p class="grille-question">Sélectionnez les valeurs réellement pratiquées dans l'entreprise.</p>
                        <div class="tag-checkboxes">
                            @foreach (var tag in CompatibilityVocabulary.CulturelleTags)
                            {
                                <label class="tag-checkbox">
                                    <input type="checkbox" checked="@_grille.CulturelleTags.Contains(tag)"
                                           @onchange="e => ToggleTagAsync(CriteriaField.Culturelle, _grille.CulturelleTags, tag, (bool)e.Value!)" />
                                    @tag
                                </label>
                            }
                        </div>
                        <textarea @bind="_grille.CulturelleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Culturelle, e.Value?.ToString())"
                                  placeholder="Notes libres (optionnel)" rows="2"></textarea>
                    </div>

                    <div class="grille-champ">
                        <label>Compatibilité organisationnelle — rythme de travail</label>
                        <p class="grille-question">Quel rythme de travail le poste exige-t-il réellement ?</p>
                        <select value="@(_grille.RythmeTravail?.ToString() ?? "")" @onchange="OnRythmeChangedAsync">
                            <option value="">— Choisir —</option>
                            @foreach (var (valeur, libelle) in CompatibilityVocabulary.RythmeTravailLabels)
                            {
                                <option value="@valeur">@valeur — @libelle</option>
                            }
                        </select>
                        <textarea @bind="_grille.OrganisationnelleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Organisationnelle, e.Value?.ToString())"
                                  placeholder="Notes libres (optionnel)" rows="2"></textarea>
                    </div>

                    <div class="grille-champ">
                        <label>Compatibilité motivationnelle</label>
                        <p class="grille-question">Sélectionnez ce qui motive généralement les collaborateurs dans cette entreprise.</p>
                        <div class="tag-checkboxes">
                            @foreach (var tag in CompatibilityVocabulary.MotivationnelleTags)
                            {
                                <label class="tag-checkbox">
                                    <input type="checkbox" checked="@_grille.MotivationnelleTags.Contains(tag)"
                                           @onchange="e => ToggleTagAsync(CriteriaField.Motivationnelle, _grille.MotivationnelleTags, tag, (bool)e.Value!)" />
                                    @tag
                                </label>
                            }
                        </div>
                        <textarea @bind="_grille.MotivationnelleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Motivationnelle, e.Value?.ToString())"
                                  placeholder="Notes libres (optionnel)" rows="2"></textarea>
                    </div>

                    <div class="grille-champ">
                        <label>Points de vigilance</label>
                        <p class="grille-question">Sélectionnez les situations qui peuvent créer de la fatigue, du stress ou des départs prématurés.</p>
                        <div class="tag-checkboxes">
                            @foreach (var tag in CompatibilityVocabulary.PointsVigilanceTags)
                            {
                                <label class="tag-checkbox">
                                    <input type="checkbox" checked="@_grille.PointsVigilanceTags.Contains(tag)"
                                           @onchange="e => ToggleTagAsync(CriteriaField.PointsVigilance, _grille.PointsVigilanceTags, tag, (bool)e.Value!)" />
                                    @tag
                                </label>
                            }
                        </div>
                        <textarea @bind="_grille.PointsVigilanceNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.PointsVigilance, e.Value?.ToString())"
                                  placeholder="Notes libres (optionnel)" rows="2"></textarea>
                    </div>
                </section>

                <aside class="entreprise-synthese">
                    <h3>SYNTHÈSE ENTREPRISE</h3>
                    <p class="hint">@(GrilleComplete ? "✅ Grille de compatibilité complète." : "◯ Grille de compatibilité incomplète.")</p>
                </aside>
            </div>
        }
    }
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Company>? _companies;
    private int _selectedCompanyId;
    private int _companyProfileId;
    private List<CompanyQuestionView>? _questions;
    private CompanyTheme _activeTheme = CompanyTheme.Identification;
    private bool _showGrilleK;
    private readonly GrilleModel _grille = new();

    private bool GrilleComplete =>
        _grille.TechniqueTags.Count > 0
        && _grille.ComportementaleTags.Count > 0
        && _grille.CulturelleTags.Count > 0
        && _grille.RythmeTravail is not null
        && _grille.MotivationnelleTags.Count > 0
        && _grille.PointsVigilanceTags.Count > 0;

    private sealed class GrilleModel
    {
        public List<string> TechniqueTags { get; set; } = [];
        public List<string> ComportementaleTags { get; set; } = [];
        public List<string> CulturelleTags { get; set; } = [];
        public int? RythmeTravail { get; set; }
        public List<string> MotivationnelleTags { get; set; } = [];
        public List<string> PointsVigilanceTags { get; set; } = [];

        public string? TechniqueNotes { get; set; }
        public string? ComportementaleNotes { get; set; }
        public string? CulturelleNotes { get; set; }
        public string? OrganisationnelleNotes { get; set; }
        public string? MotivationnelleNotes { get; set; }
        public string? PointsVigilanceNotes { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count > 0)
        {
            await ActivateCompanyAsync(_companies[0]);
        }
    }

    private async Task ActivateCompanyAsync(Company company)
    {
        _selectedCompanyId = company.Id;
        _showGrilleK = false;
        TenantContext.SetActiveCompany(company.Id, company.SchemaName);
        _companyProfileId = await CompanyProfileService.GetOrCreateProfileIdAsync();
        _questions = (await CompanyProfileService.GetQuestionnaireAsync(_companyProfileId)).ToList();

        // La grille K est propre au tenant actif : on la recharge à chaque changement d'entreprise.
        var criteria = await CompanyProfileService.GetCompatibilityCriteriaAsync(_companyProfileId);
        _grille.TechniqueTags = criteria?.TechniqueTags.ToList() ?? [];
        _grille.ComportementaleTags = criteria?.ComportementaleTags.ToList() ?? [];
        _grille.CulturelleTags = criteria?.CulturelleTags.ToList() ?? [];
        _grille.RythmeTravail = criteria?.RythmeTravail;
        _grille.MotivationnelleTags = criteria?.MotivationnelleTags.ToList() ?? [];
        _grille.PointsVigilanceTags = criteria?.PointsVigilanceTags.ToList() ?? [];
        _grille.TechniqueNotes = criteria?.TechniqueNotes;
        _grille.ComportementaleNotes = criteria?.ComportementaleNotes;
        _grille.CulturelleNotes = criteria?.CulturelleNotes;
        _grille.OrganisationnelleNotes = criteria?.OrganisationnelleNotes;
        _grille.MotivationnelleNotes = criteria?.MotivationnelleNotes;
        _grille.PointsVigilanceNotes = criteria?.PointsVigilanceNotes;
    }

    private async Task OnCompanyChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var company = _companies!.First(c => c.Id == id);
            await ActivateCompanyAsync(company);
        }
    }

    private async Task SaveAnswerAsync(int questionId, string? answerText)
    {
        await CompanyProfileService.SaveAnswerAsync(_companyProfileId, questionId, answerText);
        var index = _questions!.FindIndex(q => q.QuestionId == questionId);
        _questions[index] = _questions[index] with { AnswerText = answerText, UpdatedAt = DateTimeOffset.UtcNow };
    }

    /// <summary>Voir le commentaire équivalent côté QuestionnaireCandidat.razor : mutation ciblée, pas un instantané complet de la grille.</summary>
    private async Task ToggleTagAsync(CriteriaField field, List<string> tags, string tag, bool isChecked)
    {
        if (isChecked) { if (!tags.Contains(tag)) tags.Add(tag); }
        else tags.Remove(tag);
        await CompanyProfileService.ToggleTagAsync(_companyProfileId, field, tag, isChecked);
    }

    private async Task OnRythmeChangedAsync(ChangeEventArgs e)
    {
        _grille.RythmeTravail = int.TryParse(e.Value?.ToString(), out var v) ? v : null;
        await CompanyProfileService.SetRythmeTravailAsync(_companyProfileId, _grille.RythmeTravail);
    }

    private async Task SaveNotesAsync(CriteriaField field, string? notes)
    {
        await CompanyProfileService.SetNotesAsync(_companyProfileId, field, notes);
    }
}
