@page "/entreprise/postes/{PosteId:int}/profil"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.ProfilEntreprise.Entities
@using Spectrometre.Modules.ProfilEntreprise.Resources
@using Spectrometre.Modules.ProfilEntreprise.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IPosteService PosteService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<ProfilEntrepriseResource> Localizer

<PageTitle>@(_poste?.Titre ?? Localizer["ProfilDuPoste"].Value)</PageTitle>

<div class="postes-page">
@if (_loading)
{
    <p class="postes-state">@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["AucuneEntrepriseAssociee"]</p>
    </section>
}
else if (_poste is null)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["PosteIntrouvable"]</p>
        <a href="/entreprise/postes" class="postes-btn-ghost">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @Localizer["RetourAuxPostes"]
        </a>
    </section>
}
else
{
    <header class="postes-header">
        <div>
            <nav class="postes-breadcrumb" aria-label="breadcrumb">
                <a href="/entreprise/postes">@Localizer["RetourAuxPostes"]</a>
                <span class="postes-breadcrumb-sep" aria-hidden="true">/</span>
                <a href="@($"/entreprise/postes/{PosteId}/candidats")">@_poste.Titre</a>
                <span class="postes-breadcrumb-sep" aria-hidden="true">/</span>
                <span>@Localizer["ProfilDuPoste"]</span>
            </nav>
            <h1 class="postes-title">@Localizer["ProfilDuPoste"]</h1>
            <p class="postes-subtitle">@_poste.Titre — @Localizer["ProfilDuPosteHint"]</p>
        </div>
        <div class="postes-header-actions">
            <button type="button"
                    class="postes-btn-primary"
                    disabled="@_iaEnCours"
                    @onclick="OnGenererIaAsync">
                @if (_iaEnCours)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>@Localizer["GenererCriteresIaEnCours"]</span>
                }
                else
                {
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    <span>@Localizer["GenererCriteresIa"]</span>
                }
            </button>
            <button type="button"
                    class="postes-btn-secondary"
                    @onclick="AfficherFormulaireManuel">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                @Localizer["GenererManuellement"]
            </button>
            <button type="button"
                    class="postes-btn-secondary"
                    @onclick="ToggleSuggestions">
                <i class="bi bi-collection" aria-hidden="true"></i>
                @Localizer["Suggestions"]
            </button>
            <a href="@($"/entreprise/postes/{PosteId}/candidats")" class="postes-btn-ghost">
                <i class="bi bi-people" aria-hidden="true"></i>
                @Localizer["VoirLesCandidatures"]
            </a>
        </div>
    </header>

    @if (_suggestionsVisibles)
    {
        <section class="postes-card postes-suggestions-card">
            <div class="postes-card-icon tone-primary" aria-hidden="true">
                <i class="bi bi-collection"></i>
            </div>
            <h2 class="postes-section-title">@Localizer["Suggestions"]</h2>
            <p class="postes-hint">@Localizer["SuggestionsHint"]</p>

            <div class="postes-suggestions-categories">
                <h3 class="postes-critere-categorie">@Localizer["SuggestionsCategories"]</h3>
                <p class="postes-hint postes-hint-compact">@Localizer["SuggestionsCategoriesHint"]</p>
                <ul class="postes-suggestions-categories-liste">
                    @foreach (var categorie in CatalogueCriteresSuggeres.Tous.Select(i => i.Categorie).Distinct())
                    {
                        <li>
                            <label class="postes-suggestions-label">
                                <input type="checkbox"
                                       checked="@(_categoriesCochees.Contains(categorie))"
                                       @onchange="e => OnCategorieCheckChanged(categorie, e)" />
                                <span class="postes-critere-libelle">@categorie</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            @if (_categoriesCochees.Count > 0)
            {
                <div class="postes-suggestions-items">
                    <h3 class="postes-critere-categorie">@Localizer["SuggestionsItemsInclus"]</h3>
                    @foreach (var categorie in CatalogueCriteresSuggeres.Tous
                                  .Select(i => i.Categorie)
                                  .Distinct()
                                  .Where(c => _categoriesCochees.Contains(c)))
                    {
                        <details class="postes-suggestions-accordeon" open>
                            <summary class="postes-suggestions-accordeon-summary">
                                <span>@categorie</span>
                            </summary>
                            <ul class="postes-suggestions-liste">
                                @foreach (var item in CatalogueCriteresSuggeres.Tous.Where(i => i.Categorie == categorie))
                                {
                                    var cle = CleSuggestion(item.Categorie, item.Libelle);
                                    var dejaPresent = EstDejaPresent(item.Categorie, item.Libelle);
                                    <li class="postes-suggestions-item @(dejaPresent ? "is-present" : "")">
                                        <label class="postes-suggestions-label">
                                            <input type="checkbox"
                                                   checked="@(_suggestionsCochees.Contains(cle))"
                                                   disabled="@dejaPresent"
                                                   @onchange="e => OnSuggestionCheckChanged(cle, e)" />
                                            <span class="postes-suggestions-texte">
                                                <span class="postes-critere-libelle">@item.Libelle</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <span class="postes-suggestions-desc">@item.Description</span>
                                                }
                                                @if (dejaPresent)
                                                {
                                                    <span class="postes-suggestions-badge">@Localizer["SuggestionDejaAjoutee"]</span>
                                                }
                                            </span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            }

            <div class="postes-form-actions">
                <button type="button" class="postes-btn-secondary" @onclick="MasquerSuggestions">@Localizer["Annuler"]</button>
                <button type="button"
                        class="postes-btn-primary"
                        disabled="@(_suggestionsEnCours || !PeutAjouterSelection)"
                        @onclick="AjouterSelectionSuggestionsAsync">
                    @if (_suggestionsEnCours)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    @Localizer["AjouterLaSelection"]
                </button>
            </div>
        </section>
    }

    @if (_formulaireVisible)
    {
        <section class="postes-card postes-form-card">
            <div class="postes-card-icon tone-primary" aria-hidden="true">
                <i class="bi bi-list-check"></i>
            </div>
            <h2 class="postes-section-title">@(_editId is null ? Localizer["AjouterUnCritere"] : Localizer["ModifierUnCritere"])</h2>
            <div class="postes-form postes-profil-form">
                <div class="postes-field">
                    <label for="critere-categorie">@Localizer["Categorie"]</label>
                    <input id="critere-categorie" class="postes-input" @bind="_categorie" @bind:event="oninput" maxlength="200" />
                </div>
                <div class="postes-field">
                    <label for="critere-libelle">@Localizer["Libelle"]</label>
                    <input id="critere-libelle" class="postes-input" @bind="_libelle" @bind:event="oninput" maxlength="500" />
                </div>
                <div class="postes-field">
                    <label for="critere-niveau">@Localizer["NiveauRequis"]</label>
                    <select id="critere-niveau" class="postes-select" value="@_niveauRequis" @onchange="OnNiveauChanged">
                        @foreach (var niveau in Enum.GetValues<NiveauEvaluation>())
                        {
                            <option value="@((int)niveau)">@NiveauEvaluationLabels.Label(niveau, _english)</option>
                        }
                    </select>
                </div>
                <div class="postes-field">
                    <label for="critere-ordre">@Localizer["OrdreAffichage"]</label>
                    <input id="critere-ordre" type="number" class="postes-input" @bind="_ordreAffichage" />
                </div>
                <div class="postes-form-actions">
                    <button type="button" class="postes-btn-secondary" @onclick="MasquerFormulaire">@Localizer["Annuler"]</button>
                    <button type="button" class="postes-btn-primary" disabled="@(!PeutEnregistrer)" @onclick="EnregistrerAsync">
                        @(_editId is null ? Localizer["Ajouter"] : Localizer["Enregistrer"])
                    </button>
                </div>
            </div>
        </section>
    }

    <section class="postes-card postes-criteres-card">
        <h2 class="postes-section-title">@Localizer["CriteresDuPoste"]</h2>

        @if (!string.IsNullOrEmpty(_iaMessage))
        {
            <p class="@(_iaEchec ? "postes-ia-error-inline" : "postes-ia-success-inline")">@_iaMessage</p>
            @if (_iaEchec)
            {
                <button type="button" class="postes-btn-secondary postes-btn-compact" @onclick="AfficherFormulaireManuel">
                    @Localizer["IgnorerEtDefinirManuellement"]
                </button>
            }
        }
        @if (!string.IsNullOrEmpty(_suggestionsMessage))
        {
            <p class="postes-ia-success-inline">@_suggestionsMessage</p>
        }

        @if (_criteres.Count == 0)
        {
            <p class="postes-hint">@Localizer["AucunCritere"]</p>
        }
        else
        {
            @foreach (var groupe in _criteres.GroupBy(c => c.Categorie))
            {
                <div class="postes-critere-groupe">
                    <h3 class="postes-critere-categorie">@groupe.Key</h3>
                    <ul class="postes-critere-liste">
                        @foreach (var critere in groupe)
                        {
                            <li class="postes-critere-item">
                                <div class="postes-critere-body">
                                    <span class="postes-critere-libelle">@critere.Libelle</span>
                                    <span class="postes-critere-niveau">@NiveauEvaluationLabels.Label(critere.NiveauRequis, _english)</span>
                                </div>
                                <div class="postes-critere-actions">
                                    <button type="button" class="postes-btn-ghost postes-btn-compact" @onclick="() => Editer(critere)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        @Localizer["Modifier"]
                                    </button>
                                    <button type="button" class="postes-btn-danger postes-btn-compact" @onclick="() => SupprimerAsync(critere.Id)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                        @Localizer["Supprimer"]
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public int PosteId { get; set; }

    private bool _loading = true;
    private bool _formulaireVisible;
    private bool _suggestionsVisibles;
    private bool _suggestionsEnCours;
    private string? _suggestionsMessage;
    private readonly HashSet<string> _categoriesCochees = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _suggestionsCochees = new(StringComparer.OrdinalIgnoreCase);
    private bool _iaEnCours;
    private string? _iaMessage;
    private bool _iaEchec;
    private List<Company> _companies = [];
    private PosteView? _poste;
    private List<CritereEvaluationView> _criteres = [];
    private int? _editId;
    private string _categorie = "";
    private string _libelle = "";
    private int _niveauRequis = (int)NiveauEvaluation.Moyen;
    private int _ordreAffichage;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    private bool PeutEnregistrer =>
        !string.IsNullOrWhiteSpace(_categorie) && !string.IsNullOrWhiteSpace(_libelle);

    private bool PeutAjouterSelection =>
        _suggestionsCochees.Any(c => !EstDejaPresentCle(c));

    private static string CleSuggestion(string categorie, string libelle) =>
        $"{categorie.Trim()}|{libelle.Trim()}";

    private bool EstDejaPresent(string categorie, string libelle) =>
        _criteres.Any(c =>
            string.Equals(c.Categorie.Trim(), categorie.Trim(), StringComparison.OrdinalIgnoreCase)
            && string.Equals(c.Libelle.Trim(), libelle.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool EstDejaPresentCle(string cle)
    {
        var sep = cle.IndexOf('|');
        if (sep <= 0) return false;
        return EstDejaPresent(cle[..sep], cle[(sep + 1)..]);
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count == 0)
        {
            _loading = false;
            return;
        }

        await ResolvePosteEtCriteresAsync();
        AnnulerEdition();
        _loading = false;
    }

    private async Task ResolvePosteEtCriteresAsync()
    {
        var ordered = _companies
            .OrderByDescending(c => TenantContext.ActiveCompanyId == c.Id)
            .ToList();

        foreach (var company in ordered)
        {
            TenantContext.SetActiveCompany(company.Id, company.SchemaName);
            var postes = await PosteService.GetPostesAsync();
            var poste = postes.FirstOrDefault(p => p.Id == PosteId);
            if (poste is null)
                continue;

            _poste = poste;
            _criteres = (await PosteService.GetCriteresAsync(PosteId)).ToList();
            return;
        }

        _poste = null;
        _criteres = [];
    }

    private async Task OnGenererIaAsync()
    {
        if (_iaEnCours || _poste is null)
            return;

        _iaEnCours = true;
        _iaMessage = null;
        _iaEchec = false;
        try
        {
            var ajoutes = await PosteService.GenererCriteresIaAsync(PosteId, forcerRegeneration: false);
            _criteres = (await PosteService.GetCriteresAsync(PosteId)).ToList();

            if (ajoutes < 0)
            {
                _iaEchec = true;
                _iaMessage = Localizer["GenererCriteresIaEchec"].Value;
            }
            else if (ajoutes == 0)
            {
                _iaMessage = Localizer["CriteresIaAucunChangement"].Value;
            }
            else
            {
                _iaMessage = string.Format(
                    CultureInfo.CurrentUICulture,
                    Localizer["CriteresIaAjoutes"].Value,
                    ajoutes);
            }
        }
        finally
        {
            _iaEnCours = false;
        }
    }

    private void AfficherFormulaireManuel()
    {
        _suggestionsVisibles = false;
        _formulaireVisible = true;
        if (_editId is null)
            AnnulerEdition();
    }

    private void MasquerFormulaire()
    {
        AnnulerEdition();
        _formulaireVisible = false;
    }

    private void ToggleSuggestions()
    {
        _suggestionsVisibles = !_suggestionsVisibles;
        if (_suggestionsVisibles)
        {
            _formulaireVisible = false;
            _suggestionsMessage = null;
            _categoriesCochees.Clear();
            _suggestionsCochees.Clear();
        }
    }

    private void MasquerSuggestions()
    {
        _suggestionsVisibles = false;
        _categoriesCochees.Clear();
        _suggestionsCochees.Clear();
    }

    private void OnCategorieCheckChanged(string categorie, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b
                 || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        if (on)
        {
            _categoriesCochees.Add(categorie);
            foreach (var item in CatalogueCriteresSuggeres.Tous.Where(i =>
                         string.Equals(i.Categorie, categorie, StringComparison.OrdinalIgnoreCase)))
            {
                _suggestionsCochees.Add(CleSuggestion(item.Categorie, item.Libelle));
            }
        }
        else
        {
            _categoriesCochees.Remove(categorie);
            foreach (var item in CatalogueCriteresSuggeres.Tous.Where(i =>
                         string.Equals(i.Categorie, categorie, StringComparison.OrdinalIgnoreCase)))
            {
                _suggestionsCochees.Remove(CleSuggestion(item.Categorie, item.Libelle));
            }
        }
    }

    private void OnSuggestionCheckChanged(string cle, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b
                 || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (on)
            _suggestionsCochees.Add(cle);
        else
            _suggestionsCochees.Remove(cle);
    }

    private async Task AjouterSelectionSuggestionsAsync()
    {
        if (_suggestionsEnCours || _poste is null)
            return;

        var aAjouter = CatalogueCriteresSuggeres.Tous
            .Where(i => _suggestionsCochees.Contains(CleSuggestion(i.Categorie, i.Libelle)))
            .Where(i => !EstDejaPresent(i.Categorie, i.Libelle))
            .ToList();

        if (aAjouter.Count == 0)
            return;

        _suggestionsEnCours = true;
        try
        {
            var prochainOrdre = _criteres.Count == 0 ? 0 : _criteres.Max(c => c.OrdreAffichage) + 1;
            var ajoutes = 0;
            foreach (var item in aAjouter)
            {
                await PosteService.UpsertCritereAsync(
                    PosteId,
                    id: null,
                    item.Categorie,
                    item.Libelle,
                    (int)NiveauEvaluation.Moyen,
                    prochainOrdre);
                prochainOrdre++;
                ajoutes++;
            }

            _criteres = (await PosteService.GetCriteresAsync(PosteId)).ToList();
            _suggestionsCochees.Clear();
            _suggestionsMessage = string.Format(
                CultureInfo.CurrentUICulture,
                Localizer["SuggestionsAjoutees"].Value,
                ajoutes);
        }
        finally
        {
            _suggestionsEnCours = false;
        }
    }

    private void OnNiveauChanged(ChangeEventArgs e)
    {
        if (e.Value is not null && int.TryParse(e.Value.ToString(), out var niveau))
            _niveauRequis = Math.Clamp(niveau, 0, 4);
    }

    private async Task EnregistrerAsync()
    {
        if (!PeutEnregistrer)
            return;

        await PosteService.UpsertCritereAsync(
            PosteId,
            _editId,
            _categorie,
            _libelle,
            _niveauRequis,
            _ordreAffichage);

        _criteres = (await PosteService.GetCriteresAsync(PosteId)).ToList();
        AnnulerEdition();
        _formulaireVisible = false;
    }

    private void Editer(CritereEvaluationView critere)
    {
        _suggestionsVisibles = false;
        _formulaireVisible = true;
        _editId = critere.Id;
        _categorie = critere.Categorie;
        _libelle = critere.Libelle;
        _niveauRequis = (int)critere.NiveauRequis;
        _ordreAffichage = critere.OrdreAffichage;
    }

    private void AnnulerEdition()
    {
        _editId = null;
        _categorie = "";
        _libelle = "";
        _niveauRequis = (int)NiveauEvaluation.Moyen;
        _ordreAffichage = _criteres.Count == 0 ? 0 : _criteres.Max(c => c.OrdreAffichage) + 1;
    }

    private async Task SupprimerAsync(int critereId)
    {
        await PosteService.DeleteCritereAsync(critereId);
        _criteres = (await PosteService.GetCriteresAsync(PosteId)).ToList();
        if (_editId == critereId)
            AnnulerEdition();
    }
}
