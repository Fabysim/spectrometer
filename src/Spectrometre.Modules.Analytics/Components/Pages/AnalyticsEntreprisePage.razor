@page "/entreprise/analytics"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Compatibility
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.Analytics.Resources
@using Spectrometre.Modules.Analytics.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IAnalyticsService AnalyticsService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<AnalyticsResource> Localizer

<PageTitle>@Localizer["AnalyticsDecideurs"]</PageTitle>

<h1>@Localizer["AnalyticsDecideurs"]</h1>
<p class="hint">@Localizer["Intro"]</p>

@if (_companies is null)
{
    <p>@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <p>@Localizer["AucuneEntrepriseAssociee"]</p>
}
else
{
    <div class="entreprise-header">
        @if (_companies.Count > 1)
        {
            <label>
                @Localizer["EntrepriseActive"]
                <select value="@_selectedCompanyId" @onchange="OnCompanyChangedAsync">
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </label>
        }
        else
        {
            <strong>@_companies[0].Name</strong>
        }
    </div>

    @if (_dashboard is null)
    {
        <p>@Localizer["ChargementTableauDeBord"]</p>
    }
    else if (_dashboard.TotalCandidatures == 0)
    {
        <div class="analytics-etat-vide">
            <p>
                @Localizer["AucuneCandidature"]
                @(_dashboard.PostesOuverts + _dashboard.PostesFermes > 0
                    ? string.Format(Localizer["PostesOuvertsFermes"].Value, _dashboard.PostesOuverts, _dashboard.PostesFermes)
                    : Localizer["AucunPosteCree"].Value)
            </p>
            <p class="hint">@Localizer["ChiffresApparaitront"]</p>
        </div>
    }
    else
    {
        <section class="analytics-cartes">
            <div class="analytics-carte">
                <span class="valeur">@_dashboard.PostesOuverts</span>
                <span class="libelle">@Localizer["PostesOuverts"]</span>
            </div>
            <div class="analytics-carte">
                <span class="valeur">@_dashboard.PostesFermes</span>
                <span class="libelle">@Localizer["PostesFermes"]</span>
            </div>
            <div class="analytics-carte">
                <span class="valeur">@_dashboard.TotalCandidatures</span>
                <span class="libelle">@Localizer["CandidaturesRecues"]</span>
            </div>
            <div class="analytics-carte">
                <span class="valeur">@(_dashboard.ScoreMoyenGlobal is int s ? $"{s}%" : "—")</span>
                <span class="libelle">@Localizer["ScoreCompatibiliteMoyen"]</span>
            </div>
            <div class="analytics-carte">
                <span class="valeur">@(_dashboard.TauxCompletionGrilleH is double t ? $"{t:F0}%" : "—")</span>
                <span class="libelle">@string.Format(Localizer["GrillesHCompletes"].Value, _dashboard.CandidatsAvecGrilleComplete, _dashboard.CandidatsUniques)</span>
            </div>
        </section>

        <div class="analytics-layout">
            <section class="analytics-bloc">
                <h3>@Localizer["FunnelCandidatures"]</h3>
                @foreach (var etape in _dashboard.Funnel)
                {
                    <div class="barre-ligne">
                        <span class="barre-libelle">@etape.Libelle</span>
                        <div class="barre-piste">
                            <div class="barre-remplissage" style="width:@LargeurPourcentage(etape.Nombre, _dashboard.TotalCandidatures)%"></div>
                        </div>
                        <span class="barre-valeur">@etape.Nombre</span>
                    </div>
                }
            </section>

            <section class="analytics-bloc">
                <h3>@Localizer["ScoreMoyenParAxe"]</h3>
                @foreach (var axe in _dashboard.MoyennesParAxe)
                {
                    <div class="barre-ligne">
                        <span class="barre-libelle">@axe.Axe</span>
                        <div class="barre-piste">
                            <div class="barre-remplissage" style="width:@(axe.Moyenne ?? 0)%"></div>
                        </div>
                        <span class="barre-valeur">@(axe.Moyenne is double m ? $"{m:F1}%" : "—")</span>
                    </div>
                }
            </section>

            <section class="analytics-bloc">
                <h3>@Localizer["PointsVigilanceFrequents"]</h3>
                @if (_dashboard.TopPointsDeVigilance.Count == 0)
                {
                    <p class="hint">@Localizer["AucunPointVigilance"]</p>
                }
                else
                {
                    <ul class="vigilance-liste">
                        @foreach (var tag in _dashboard.TopPointsDeVigilance)
                        {
                            <li><span class="tag">@CompatibilityVocabulary.DisplayTag(tag.Tag, _english)</span> <span class="compte">× @tag.Nombre</span></li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Company>? _companies;
    private int _selectedCompanyId;
    private AnalyticsDashboardView? _dashboard;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count > 0)
            await ActivateCompanyAsync(_companies[0]);
    }

    private async Task ActivateCompanyAsync(Company company)
    {
        _selectedCompanyId = company.Id;
        TenantContext.SetActiveCompany(company.Id, company.SchemaName);
        _dashboard = await AnalyticsService.GetDashboardAsync();
    }

    private async Task OnCompanyChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var company = _companies!.First(c => c.Id == id);
            await ActivateCompanyAsync(company);
        }
    }

    private static int LargeurPourcentage(int nombre, int total) => total == 0 ? 0 : (int)Math.Round(100.0 * nombre / total);
}
