                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_Obstacles"]</div>
                            <div class="gdt-chips">
                                @foreach (var obs in ChipObstacles)
                                {
                                    <button type="button" class="gdt-chip gdt-chip--warn @(_modele.Obstacles.Contains(obs) ? "gdt-chip--on" : "")"
                                            @onclick="() => ToggleObstacle(obs)">@Chip(obs)</button>
                                }
                            </div>
