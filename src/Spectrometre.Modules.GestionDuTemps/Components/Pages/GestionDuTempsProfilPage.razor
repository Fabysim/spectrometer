@page "/gestion-du-temps/profil"
@page "/gestion-du-temps/profil/{Suivi}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Spectrometre.Core.Modules
@using Spectrometre.Modules.GestionDuTemps.Entities
@using Spectrometre.Modules.GestionDuTemps.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IGestionDuTempsService GdtService
@inject IGestionDuTempsAccessService AccessService
@inject ICoachingAccessChecker CoachingAccessChecker
@inject IStringLocalizer<GestionDuTempsResource> Localizer
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@Localizer["ProfilPsychosocialTitle"]</PageTitle>

<div class="gdt-page">
    <h1 class="gdt-title">@Localizer["ProfilPsychosocial"]</h1>
    <p class="hint">
        @Localizer["Page2_IntroDebut"] <a href="@Href("/gestion-du-temps/synthese")">@Localizer["NavSynthese"]</a>
        @Localizer["Page2_IntroMilieu"] <a href="@Href("/gestion-du-temps")">@Localizer["NavRetourAuxRituels"]</a>.
    </p>

    @if (_userId is null)
    {
        <p>@Localizer["Chargement"]</p>
    }
    else if (!_hasAccess)
    {
        <p class="hint">@Localizer["ModuleNonActive"]</p>
    }
    else if (_modele is null)
    {
        <p>@Localizer["Chargement"]</p>
    }
    else
    {
        <p class="gdt-step-progress">@string.Format(Localizer["GdtProfil_StepProgress"].Value, _currentStep + 1, TotalSteps)</p>

        <div class="timeline-navigation">
            <div class="timeline-container">
                @for (var i = 0; i < TotalSteps; i++)
                {
                    var idx = i;
                    var isActive = idx == _currentStep;
                    var isCompleted = idx < _currentStep;
                    var isClickable = idx <= _maxReachedStep;

                    <div class="timeline-item @(isActive ? "active" : "") @(isCompleted ? "completed" : "") @(isClickable ? "clickable" : "")"
                         role="tab"
                         aria-selected="@isActive"
                         aria-label="@Localizer[$"GdtProfil_Step{idx}_Title"]"
                         @onclick="() => GoToStep(idx)">
                        <div class="timeline-marker">
                            @if (isCompleted)
                            {
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            }
                            else
                            {
                                <span class="timeline-number">@(idx + 1)</span>
                            }
                        </div>
                        <div class="timeline-label">@Localizer[$"GdtProfil_Step{idx}_Short"]</div>
                        @if (idx < TotalSteps - 1)
                        {
                            <div class="timeline-connector"></div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="section-card gdt-step-panel" role="tabpanel">
            <div class="gdt-step-header">
                <div class="gdt-step-icon"><i class="bi @_stepIcons[_currentStep]" aria-hidden="true"></i></div>
                <div>
                    <h2 class="gdt-step-title">@Localizer[$"GdtProfil_Step{_currentStep}_Title"]</h2>
                    <p class="gdt-step-sub">@Localizer[$"GdtProfil_Step{_currentStep}_Sub"]</p>
                </div>
            </div>

            <div class="gdt-step-body">
                @if (_currentStep == 6)
                {
                    <div class="gdt-synthese-ready">
                        <p>@Localizer["GdtProfil_SyntheseStepHint"]</p>
                        @if (_messageConfirmation is not null)
                        {
                            <p class="gdt-confirmation">@_messageConfirmation</p>
                        }
                    </div>
                }
                else
                {
                <fieldset disabled="@_readOnly">

                    @if (_currentStep == 0)
                    {
                        <div class="gdt-section">
                            <div class="gdt-section__label">
                                <span class="gdt-time-dot" style="background:#4a3f6b"></span>
                                @Localizer["GdtProfil_Type_sommeil_extended"]
                            </div>
                            <div class="gdt-form-grid">
                                <div class="gdt-field">
                                    <label class="gdt-label">@Localizer["GdtProfil_Lbl_SommeilCoucher"]</label>
                                    <div class="gdt-time-wrap">
                                        <input type="time" class="gdt-input gdt-fi--time"
                                               id="sommeil-coucher"
                                               data-gdt-sommeil-time="coucher"
                                               value="@SommeilCoucherValue"
                                               @onchange="OnSommeilCoucherChanged"
                                               @oninput="OnSommeilCoucherChanged" />
                                        <button type="button" class="gdt-time-icon"
                                                tabindex="-1" aria-hidden="true"
                                                data-gdt-time-for="sommeil-coucher">
                                            <svg width="14" height="14" viewBox="0 0 20 20" fill="none"
                                                 stroke="currentColor" stroke-width="1.6">
                                                <circle cx="10" cy="10" r="7.5"/>
                                                <path d="M10 6v4l2.5 1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="gdt-field">
                                    <label class="gdt-label">@Localizer["GdtProfil_Lbl_SommeilLever"]</label>
                                    <div class="gdt-time-wrap">
                                        <input type="time" class="gdt-input gdt-fi--time"
                                               id="sommeil-lever"
                                               data-gdt-sommeil-time="lever"
                                               value="@SommeilLeverValue"
                                               @onchange="OnSommeilLeverChanged"
                                               @oninput="OnSommeilLeverChanged" />
                                        <button type="button" class="gdt-time-icon"
                                                tabindex="-1" aria-hidden="true"
                                                data-gdt-time-for="sommeil-lever">
                                            <svg width="14" height="14" viewBox="0 0 20 20" fill="none"
                                                 stroke="currentColor" stroke-width="1.6">
                                                <circle cx="10" cy="10" r="7.5"/>
                                                <path d="M10 6v4l2.5 1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_SommeilReparateur"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptSommeilReparateur)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.SommeilReparateur == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.SommeilReparateur = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_ReveilsNocturnes"]</label>
                                <div class="gdt-toggle-row">
                                    <button type="button" class="gdt-toggle @(_modele.ReveilsNocturnes == true ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.ReveilsNocturnes = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                    <button type="button" class="gdt-toggle @(_modele.ReveilsNocturnes == false ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.ReveilsNocturnes = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_EcransAvantSommeil"]</label>
                                <div class="gdt-toggle-row">
                                    <button type="button" class="gdt-toggle @(_modele.EcransAvantSommeil == true ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.EcransAvantSommeil = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                    <button type="button" class="gdt-toggle @(_modele.EcransAvantSommeil == false ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.EcransAvantSommeil = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                </div>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">
                                <span class="gdt-time-dot" style="background:#345f6d"></span>
                                @Localizer["GdtProfil_Section_TempsPerso"]
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_TempsPersoQuotidien"]</label>
                                <div class="gdt-toggle-row">
                                    <button type="button" class="gdt-toggle @(_modele.TempsPersoQuotidien == true ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.TempsPersoQuotidien = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                    <button type="button" class="gdt-toggle @(_modele.TempsPersoQuotidien == false ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.TempsPersoQuotidien = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_ManqueTempsPerso"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptManqueTempsPerso)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.ManqueTempsPerso == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.ManqueTempsPerso = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_ActivitesRessourcantes"]</label>
                                <textarea class="gdt-textarea" rows="2" placeholder="@Localizer["GdtProfil_Ph_ActivitesRessourcantes"]"
                                          @bind="_modele.ActivitesRessourcantes"></textarea>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">
                                <span class="gdt-time-dot" style="background:#1e6b4a"></span>
                                @Localizer["GdtProfil_Section_TempsPro"]
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_HoraireTravail"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptHoraireTravail)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.HoraireTravail == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.HoraireTravail = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_SurchargePrevisible"]</label>
                                <div class="gdt-toggle-row">
                                    <button type="button" class="gdt-toggle @(_modele.SurchargePrevisible == true ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.SurchargePrevisible = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                    <button type="button" class="gdt-toggle @(_modele.SurchargePrevisible == false ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.SurchargePrevisible = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_TravailHorsHeures"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptTravailHorsHeures)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.TravailHorsHeures == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.TravailHorsHeures = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">
                                <span class="gdt-time-dot" style="background:#7a5c1e"></span>
                                @Localizer["GdtProfil_Section_TempsAdmin"]
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_GestionAdmin"]</label>
                                <div class="gdt-radio-group gdt-radio-group--wrap">
                                    @foreach (var opt in OptGestionAdmin)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.GestionAdmin == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.GestionAdmin = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_StressAdmin"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptStressAdmin)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.StressAdmin == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.StressAdmin = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    else if (_currentStep == 1)
                    {
                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_Deplacements"]</div>
                            <div class="gdt-form-grid">
                                <div class="gdt-field">
                                    <label class="gdt-label">@Localizer["GdtProfil_Lbl_DureeTrajets"]</label>
                                    <div class="gdt-radio-group">
                                        @foreach (var opt in OptDureeTrajets)
                                        {
                                            <button type="button" class="gdt-radio-btn @(_modele.DureeTrajets == opt ? "gdt-radio-btn--on" : "")"
                                                    @onclick="() => _modele.DureeTrajets = opt">@Opt(opt)</button>
                                        }
                                    </div>
                                </div>
                                <div class="gdt-field">
                                    <label class="gdt-label">@Localizer["GdtProfil_Lbl_DeplacementsImprevus"]</label>
                                    <div class="gdt-toggle-row">
                                        <button type="button" class="gdt-toggle @(_modele.DeplacementsImprevus == true ? "gdt-toggle--on" : "")"
                                                @onclick="() => _modele.DeplacementsImprevus = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                        <button type="button" class="gdt-toggle @(_modele.DeplacementsImprevus == false ? "gdt-toggle--on" : "")"
                                                @onclick="() => _modele.DeplacementsImprevus = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_Responsabilites"]</div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_EngagementCommunautaire"]</label>
                                <div class="gdt-toggle-row">
                                    <button type="button" class="gdt-toggle @(_modele.EngagementCommunautaire == true ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.EngagementCommunautaire = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                    <button type="button" class="gdt-toggle @(_modele.EngagementCommunautaire == false ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.EngagementCommunautaire = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                </div>
                            </div>
                            @if (_modele.EngagementCommunautaire == true)
                            {
                                <div class="gdt-field gdt-field--indent">
                                    <label class="gdt-label">@Localizer["GdtProfil_Lbl_EngagementNature"]</label>
                                    <div class="gdt-radio-group">
                                        <button type="button" class="gdt-radio-btn @(_modele.EngagementNature == "Choix" ? "gdt-radio-btn--on" : "")"
                                                @onclick='() => _modele.EngagementNature = "Choix"'>@Opt("Choix")</button>
                                        <button type="button" class="gdt-radio-btn @(_modele.EngagementNature == "Contrainte" ? "gdt-radio-btn--on" : "")"
                                                @onclick='() => _modele.EngagementNature = "Contrainte"'>@Opt("Contrainte")</button>
                                    </div>
                                </div>
                            }
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_ProcheMalade"]</label>
                                <div class="gdt-toggle-row">
                                    <button type="button" class="gdt-toggle @(_modele.ProcheMalade == true ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.ProcheMalade = true">@Localizer["GdtProfil_Opt_Oui"]</button>
                                    <button type="button" class="gdt-toggle @(_modele.ProcheMalade == false ? "gdt-toggle--on" : "")"
                                            @onclick="() => _modele.ProcheMalade = false">@Localizer["GdtProfil_Opt_Non"]</button>
                                </div>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_EnvironnementTravail"]</div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_ModeTravail"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptModeTravail)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.ModeTravail == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.ModeTravail = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_InterruptionsTravail"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptInterruptions)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.InterruptionsTravail == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.InterruptionsTravail = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_AutonomieGestion"]</label>
                                <div class="gdt-slider-wrap">
                                    <input type="range" class="gdt-slider" min="1" max="5"
                                           @bind="_modele.AutonomieGestion" @bind:event="oninput" />
                                    <div class="gdt-slider-labels">
                                        <span>@Localizer["GdtProfil_Lbl_AutonomieMin"]</span>
                                        <span class="gdt-slider-val">@_modele.AutonomieGestion / 5</span>
                                        <span>@Localizer["GdtProfil_Lbl_AutonomieMax"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    else if (_currentStep == 2)
                    {
                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_StressCharge"]</div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_SentimentPression"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptFreq4)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.SentimentPression == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.SentimentPression = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_DifficultesConcentration"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptJamaisToujours)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.DifficultesConcentration == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.DifficultesConcentration = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_DecisionsPrecipitees"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptJamaisToujours)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.DecisionsPrecipitees == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.DecisionsPrecipitees = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_RapportEmotionnel"]</div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_Tendances"]</label>
                                <div class="gdt-chips">
                                    @foreach (var trait in ChipTendances)
                                    {
                                        <button type="button" class="gdt-chip @(_modele.Tendances.Contains(trait) ? "gdt-chip--on" : "")"
                                                @onclick="() => ToggleTendance(trait)">@Chip(trait)</button>
                                    }
                                </div>
                            </div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_Culpabilite"]</label>
                                <div class="gdt-radio-group">
                                    @foreach (var opt in OptJamaisToujours)
                                    {
                                        <button type="button" class="gdt-radio-btn @(_modele.Culpabilite == opt ? "gdt-radio-btn--on" : "")"
                                                @onclick="() => _modele.Culpabilite = opt">@Opt(opt)</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="gdt-section">
                            <div class="gdt-section__label">@Localizer["GdtProfil_Section_ToleranceImprevu"]</div>
                            <div class="gdt-field">
                                <label class="gdt-label">@Localizer["GdtProfil_Lbl_ToleranceImprevu"]</label>
                                <div class="gdt-imprev-cards">
                                    <button type="button" class="gdt-imprev-card @(_modele.ToleranceImprevu == "Anxieux" ? "gdt-imprev-card--on" : "")"
                                            @onclick='() => _modele.ToleranceImprevu = "Anxieux"'>
                                        <div class="gdt-imprev-icon">😰</div>
                                        <strong>@Localizer["GdtProfil_Imprev_Anxieux_Title"]</strong>
                                        <p>@Localizer["GdtProfil_Imprev_Anxieux_Desc"]</p>
                                    </button>
                                    <button type="button" class="gdt-imprev-card @(_modele.ToleranceImprevu == "Adaptatif" ? "gdt-imprev-card--on" : "")"
                                            @onclick='() => _modele.ToleranceImprevu = "Adaptatif"'>
                                        <div class="gdt-imprev-icon">🔄</div>
                                        <strong>@Localizer["GdtProfil_Imprev_Adaptatif_Title"]</strong>
                                        <p>@Localizer["GdtProfil_Imprev_Adaptatif_Desc"]</p>
                                    </button>
                                    <button type="button" class="gdt-imprev-card @(_modele.ToleranceImprevu == "Souple" ? "gdt-imprev-card--on" : "")"
                                            @onclick='() => _modele.ToleranceImprevu = "Souple"'>
                                        <div class="gdt-imprev-icon">🌊</div>
                                        <strong>@Localizer["GdtProfil_Imprev_Souple_Title"]</strong>
                                        <p>@Localizer["GdtProfil_Imprev_Souple_Desc"]</p>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    else if (_currentStep == 3)
                    {
                        <div class="gdt-maturity-widget">
                            <div class="gdt-maturity-score">
                                <span class="gdt-maturity-num">@MaturiteScore</span>
                                <span class="gdt-maturity-max">/ 5</span>
                            </div>
