                    }
                </fieldset>
                }
            </div>

            <div class="section-navigation">
                @if (_currentStep > 0)
                {
                    <button type="button" class="btn-prev-section" @onclick="PrevStep">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i> @Localizer["GdtProfil_Back"]
                    </button>
                }
                else
                {
                    <div></div>
                }

                @if (_currentStep < TotalSteps - 1)
                {
                    <button type="button" class="btn-next-section" disabled="@_enregistrementEnCours" @onclick="NextStepAsync">
                        @Localizer["GdtProfil_Continue"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <div class="gdt-synthese-actions">
                        <button type="button" class="btn-next-section btn-next-section--outline" disabled="@_enregistrementEnCours" @onclick="GoToSyntheseAsync">
