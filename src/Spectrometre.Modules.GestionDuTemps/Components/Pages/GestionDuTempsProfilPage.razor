                        <button type="button" class="btn-next-section" disabled="@_enregistrementEnCours" @onclick="GoToReflexionAsync">
                            @Localizer["GdtProfil_GoToReflexion"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private const int TotalSteps = 7;

    private static readonly string[] _stepIcons =
    [
        "bi-clock",
        "bi-sliders",
        "bi-heart-pulse",
        "bi-calendar3",
        "bi-bar-chart",
        "bi-bullseye",
        "bi-stars",
    ];

    private static readonly string[] OptSommeilReparateur = ["Toujours", "Souvent", "Rarement", "Jamais"];
    private static readonly string[] OptManqueTempsPerso = ["Jamais", "Parfois", "Souvent", "Toujours"];
    private static readonly string[] OptHoraireTravail = ["Fixe", "Variable", "Mixte"];
    private static readonly string[] OptTravailHorsHeures = ["Jamais", "Parfois", "Souvent", "Quotidiennement"];
    private static readonly string[] OptGestionAdmin = ["Au gré des circonstances", "Au jour le jour", "Hebdomadaire", "Mensuelle"];
    private static readonly string[] OptStressAdmin = ["Non", "Un peu", "Beaucoup"];
    private static readonly string[] OptDureeTrajets = ["< 15 min", "15–30 min", "30–60 min", "> 1 heure"];
    private static readonly string[] OptModeTravail = ["Présentiel", "Hybride", "Télétravail"];
    private static readonly string[] OptInterruptions = ["Rarement", "Parfois", "Souvent", "Constamment"];
    private static readonly string[] OptFreq4 = ["Rarement", "Parfois", "Souvent", "Constamment"];
    private static readonly string[] OptJamaisToujours = ["Jamais", "Parfois", "Souvent", "Toujours"];
    private static readonly string[] OptRarementToujours = ["Rarement", "Parfois", "Souvent", "Toujours"];
    private static readonly string[] OptPlanification = ["Jamais", "Parfois", "Souvent", "Systématiquement"];
    private static readonly string[] OptCapaciteNon = ["Jamais", "Parfois", "Souvent", "Facilement"];
    private static readonly string[] OptObjectifDirection = ["Augmenter", "Stable", "Réduire"];
    private static readonly string[] ChipTendances = ["Procrastination", "Perfectionnisme", "Sur-engagement", "Difficulté à dire non", "Hyper-disponibilité", "Évitement administratif"];
    private static readonly string[] ChipDesequilibres = ["Trop de temps professionnel", "Pas assez de temps personnel", "Temps familial insuffisant", "Temps social inexistant", "Sommeil insuffisant", "Temps administratif négligé"];
    private static readonly string[] ChipEmotionsNeg = ["Fatigue", "Irritabilité", "Colère", "Insatisfaction", "Frustration", "Sentiment d'échec", "Baisse de performance"];
    private static readonly string[] ChipEmotionsPos = ["Joie", "Satisfaction", "Bien-être", "Sérénité", "Acceptation", "Épanouissement"];
    private static readonly string[] ChipObjectifsPro = ["Mieux gérer mes priorités", "Réduire ma charge mentale", "Améliorer mon efficacité", "Déléguer davantage", "Améliorer le support managérial"];
    private static readonly string[] ChipObstacles = ["Manque de temps", "Manque d'outils", "Manque de discipline", "Pressions externes", "Difficulté à déléguer"];

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public string? Suivi { get; set; }
    private bool _readOnly => !string.IsNullOrEmpty(Suivi);

    private string Href(string basePath) => _readOnly ? $"{basePath}/{Suivi}" : basePath;

    private string? _userId;
    private bool _hasAccess;
    private bool _enregistrementEnCours;
    private string? _messageConfirmation;
    private int _currentStep;
    private int _maxReachedStep;
    private DotNetObjectReference<GestionDuTempsProfilPage>? _gdtDotNetRef;
    private bool _gdtBridgeReady;

    private sealed class Modele
    {
        public TimeOnly? SommeilCoucher { get; set; }
        public TimeOnly? SommeilLever { get; set; }
        public string? SommeilReparateur { get; set; }
        public bool? ReveilsNocturnes { get; set; }
        public bool? EcransAvantSommeil { get; set; }
        public bool? TempsPersoQuotidien { get; set; }
        public string? ManqueTempsPerso { get; set; }
        public string? ActivitesRessourcantes { get; set; }
        public string? HoraireTravail { get; set; }
        public bool? SurchargePrevisible { get; set; }
        public string? TravailHorsHeures { get; set; }
        public string? DureeTrajets { get; set; }
        public bool? DeplacementsImprevus { get; set; }
        public bool? EngagementCommunautaire { get; set; }
        public string? EngagementNature { get; set; }
        public bool? ProcheMalade { get; set; }
        public string? ModeTravail { get; set; }
        public string? InterruptionsTravail { get; set; }
        public int AutonomieGestion { get; set; } = 3;
        public string? SentimentPression { get; set; }
        public string? DifficultesConcentration { get; set; }
        public string? DecisionsPrecipitees { get; set; }
        public string? Culpabilite { get; set; }
        public string? ToleranceImprevu { get; set; }
        public bool? UtiliseAgenda { get; set; }
        public string? PlanificationAvance { get; set; }
        public bool? RituelsQuotidiens { get; set; }
        public string? OuiTropFacile { get; set; }
        public string? CapaciteNon { get; set; }
        public string? GestionAdmin { get; set; }
        public string? StressAdmin { get; set; }
        public List<string> Tendances { get; set; } = [];
        public List<string> Desequilibres { get; set; } = [];
        public List<string> EmotionsNegatives { get; set; } = [];
        public List<string> EmotionsPositives { get; set; } = [];
        public List<string> ObjectifsProfessionnels { get; set; } = [];
        public List<string> Obstacles { get; set; } = [];
        public int SatisfactionSommeil { get; set; } = 2;
        public int SatisfactionPerso { get; set; } = 2;
        public int SatisfactionPro { get; set; } = 2;
        public int SatisfactionAdmin { get; set; } = 2;
        public int SatisfactionFamille { get; set; } = 2;
        public int SatisfactionSocial { get; set; } = 2;
        public string DirectionSommeil { get; set; } = "Stable";
        public string DirectionPerso { get; set; } = "Stable";
        public string DirectionPro { get; set; } = "Stable";
        public string DirectionAdmin { get; set; } = "Stable";
        public string DirectionFamille { get; set; } = "Stable";
        public string DirectionSocial { get; set; } = "Stable";
    }

    private Modele? _modele;

    private record TimeType(string Key, string Label, string Color);

    private TimeType[] TimeTypes =>
    [
        new("sommeil", Localizer["GdtProfil_Type_sommeil"], "#4a3f6b"),
        new("perso", Localizer["GdtProfil_Type_perso"], "#345f6d"),
        new("pro", Localizer["GdtProfil_Type_pro"], "#1e6b4a"),
        new("admin", Localizer["GdtProfil_Type_admin"], "#7a5c1e"),
        new("famille", Localizer["GdtProfil_Type_famille"], "#7a3f2d"),
        new("social", Localizer["GdtProfil_Type_social"], "#3d4f8a"),
    ];

    private string[] SatisfactionLabels =>
    [
        Localizer["GdtProfil_Satisfaction_VeryUnsatisfied"],
        Localizer["GdtProfil_Satisfaction_Unsatisfied"],
        Localizer["GdtProfil_Satisfaction_Neutral"],
        Localizer["GdtProfil_Satisfaction_Satisfied"],
        Localizer["GdtProfil_Satisfaction_VerySatisfied"],
    ];

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        if (_readOnly)
        {
            var autorise = await CoachingAccessChecker.GetSuiviUserIdSiAutoriseAsync(Suivi!, userId);
            _userId = autorise ?? userId;
            _hasAccess = autorise is not null;
        }
        else
        {
            _userId = userId;
            _hasAccess = await AccessService.HasAccessAsync(userId);
        }

        if (!_hasAccess)
            return;

        var profil = await GdtService.GetProfilPsychosocialAsync(_userId);
        _modele = profil is null ? new Modele() : DepuisEntite(profil);
        if (profil is not null || _readOnly)
            _maxReachedStep = TotalSteps - 1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentStep == TotalSteps - 1 || _gdtBridgeReady || _modele is null)
            return;

        try
        {
            _gdtDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("gdtInitProfilPsychosocialBridge", _gdtDotNetRef);
            _gdtBridgeReady = true;
        }
        catch (JSException)
        {
            // Bridge optional if script not loaded yet
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_gdtDotNetRef is not null)
        {
            try { await JS.InvokeVoidAsync("gdtDisposeProfilPsychosocialBridge"); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            _gdtDotNetRef.Dispose();
            _gdtDotNetRef = null;
        }
    }

    [JSInvokable]
    public Task GdtUpdateSommeilTimeFromJs(string field, string value)
    {
        if (_modele is null)
            return Task.CompletedTask;

        var normalized = NormalizeTimeStr(value);
        if (string.IsNullOrWhiteSpace(normalized))
            return Task.CompletedTask;

        if (!TimeOnly.TryParse(normalized, CultureInfo.InvariantCulture, DateTimeStyles.None, out var time)
            && !TimeOnly.TryParse(normalized, out time))
            return Task.CompletedTask;

        if (string.Equals(field, "coucher", StringComparison.Ordinal))
            _modele.SommeilCoucher = time;
        else if (string.Equals(field, "lever", StringComparison.Ordinal))
            _modele.SommeilLever = time;
        else
            return Task.CompletedTask;

        return InvokeAsync(StateHasChanged);
    }

    private string SommeilCoucherValue => _modele?.SommeilCoucher?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "";
    private string SommeilLeverValue => _modele?.SommeilLever?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "";

    private void OnSommeilCoucherChanged(ChangeEventArgs e)
    {
        var value = NormalizeTimeStr(e.Value?.ToString());
        if (string.IsNullOrWhiteSpace(value))
            return;
        if (TimeOnly.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
            || TimeOnly.TryParse(value, out t))
            _modele!.SommeilCoucher = t;
    }

    private void OnSommeilLeverChanged(ChangeEventArgs e)
    {
        var value = NormalizeTimeStr(e.Value?.ToString());
        if (string.IsNullOrWhiteSpace(value))
            return;
        if (TimeOnly.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
            || TimeOnly.TryParse(value, out t))
            _modele!.SommeilLever = t;
    }

    private static string NormalizeTimeStr(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return string.Empty;

        if (TimeOnly.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var invariant))
            return invariant.ToString("HH:mm", CultureInfo.InvariantCulture);

        if (TimeOnly.TryParse(raw, out var local))
            return local.ToString("HH:mm", CultureInfo.InvariantCulture);

        return raw.Trim();
    }

    private void GoToStep(int idx)
    {
        if (idx <= _maxReachedStep)
            _currentStep = idx;
    }

    private void PrevStep()
    {
        if (_currentStep > 0)
            _currentStep--;
        if (_currentStep < TotalSteps - 1)
            _gdtBridgeReady = false;
    }

    private async Task NextStepAsync()
    {
        if (_currentStep >= TotalSteps - 1)
            return;

        if (!_readOnly)
        {
            var ok = await EnregistrerAsync();
            if (!ok)
                return;
        }

        _currentStep++;
        _maxReachedStep = Math.Max(_maxReachedStep, _currentStep);
    }

    private async Task GoToSyntheseAsync()
    {
        if (!_readOnly)
        {
            var ok = await EnregistrerAsync();
            if (!ok)
                return;
        }

        NavigationManager.NavigateTo(Href("/gestion-du-temps/synthese"));
    }

    private async Task GoToReflexionAsync()
    {
        if (!_readOnly)
        {
            var ok = await EnregistrerAsync();
            if (!ok)
                return;
        }

        NavigationManager.NavigateTo(Href("/gestion-du-temps/reflexion"));
    }

    private void ToggleTendance(string t) { if (!_modele!.Tendances.Remove(t)) _modele.Tendances.Add(t); }
    private void ToggleDesequilibre(string t) { if (!_modele!.Desequilibres.Remove(t)) _modele.Desequilibres.Add(t); }
    private void ToggleEmoNeg(string e) { if (!_modele!.EmotionsNegatives.Remove(e)) _modele.EmotionsNegatives.Add(e); }
    private void ToggleEmoPos(string e) { if (!_modele!.EmotionsPositives.Remove(e)) _modele.EmotionsPositives.Add(e); }
    private void ToggleObjPro(string o) { if (!_modele!.ObjectifsProfessionnels.Remove(o)) _modele.ObjectifsProfessionnels.Add(o); }
    private void ToggleObstacle(string o) { if (!_modele!.Obstacles.Remove(o)) _modele.Obstacles.Add(o); }

    private int GetSatisfactionScore(string key) => key switch
    {
        "sommeil" => Math.Clamp(_modele!.SatisfactionSommeil, 0, 4),
        "perso" => Math.Clamp(_modele!.SatisfactionPerso, 0, 4),
        "pro" => Math.Clamp(_modele!.SatisfactionPro, 0, 4),
        "admin" => Math.Clamp(_modele!.SatisfactionAdmin, 0, 4),
        "famille" => Math.Clamp(_modele!.SatisfactionFamille, 0, 4),
        "social" => Math.Clamp(_modele!.SatisfactionSocial, 0, 4),
        _ => 2,
    };

    private void SetSatisfaction(string key, object? val)
    {
        if (!int.TryParse(val?.ToString(), out var v))
            return;
        v = Math.Clamp(v, 0, 4);
        switch (key)
        {
            case "sommeil": _modele!.SatisfactionSommeil = v; break;
            case "perso": _modele!.SatisfactionPerso = v; break;
            case "pro": _modele!.SatisfactionPro = v; break;
            case "admin": _modele!.SatisfactionAdmin = v; break;
            case "famille": _modele!.SatisfactionFamille = v; break;
            case "social": _modele!.SatisfactionSocial = v; break;
        }
    }

    private string GetObjectifDirection(string key) => key switch
    {
        "sommeil" => _modele!.DirectionSommeil,
        "perso" => _modele!.DirectionPerso,
        "pro" => _modele!.DirectionPro,
        "admin" => _modele!.DirectionAdmin,
        "famille" => _modele!.DirectionFamille,
        "social" => _modele!.DirectionSocial,
        _ => "Stable",
    };

    private void SetObjectifDirection(string key, string direction)
    {
        switch (key)
        {
            case "sommeil": _modele!.DirectionSommeil = direction; break;
            case "perso": _modele!.DirectionPerso = direction; break;
            case "pro": _modele!.DirectionPro = direction; break;
            case "admin": _modele!.DirectionAdmin = direction; break;
            case "famille": _modele!.DirectionFamille = direction; break;
            case "social": _modele!.DirectionSocial = direction; break;
        }
    }

    private int MaturiteScore
    {
        get
        {
            if (_modele is null) return 1;
            var s = 1;
            if (_modele.UtiliseAgenda == true) s++;
            if (_modele.PlanificationAvance is "Souvent" or "Systématiquement") s++;
            if (_modele.RituelsQuotidiens == true) s++;
            if (_modele.CapaciteNon is "Souvent" or "Facilement") s++;
            return Math.Min(s, 5);
        }
    }

    private string MaturiteLabel => MaturiteScore switch
    {
        1 => Localizer["GdtProfil_Maturite_Chaotique"],
        2 => Localizer["GdtProfil_Maturite_Instable"],
        3 => Localizer["GdtProfil_Maturite_Fonctionnel"],
        4 => Localizer["GdtProfil_Maturite_Structure"],
        5 => Localizer["GdtProfil_Maturite_Maitrise"],
        _ => "—",
    };

