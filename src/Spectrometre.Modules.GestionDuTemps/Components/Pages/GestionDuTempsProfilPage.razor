@page "/gestion-du-temps/profil"
@page "/gestion-du-temps/profil/{Suivi}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Modules
@using Spectrometre.Modules.GestionDuTemps.Entities
@using Spectrometre.Modules.GestionDuTemps.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IGestionDuTempsService GdtService
@inject IGestionDuTempsAccessService AccessService
@inject ICoachingAccessChecker CoachingAccessChecker
@inject IStringLocalizer<GestionDuTempsResource> Localizer

<PageTitle>@Localizer["ProfilPsychosocialTitle"]</PageTitle>

<h1>@Localizer["ProfilPsychosocial"]</h1>
<p class="hint">
    @Localizer["Page2_IntroDebut"] <a href="@Href("/gestion-du-temps/synthese")">@Localizer["NavSynthese"]</a>
    @Localizer["Page2_IntroMilieu"] <a href="@Href("/gestion-du-temps")">@Localizer["NavRetourAuxRituels"]</a>.
</p>

@if (_userId is null)
{
    <p>@Localizer["Chargement"]</p>
}
else if (!_hasAccess)
{
    <p class="hint">@Localizer["ModuleNonActive"]</p>
}
else if (_modele is null)
{
    <p>@Localizer["Chargement"]</p>
}
else
{
    <fieldset class="gdt-form-large" disabled="@_readOnly">
        <h3>@Localizer["Section_Sommeil"]</h3>
        <div class="champ"><label>@Localizer["HeureDeCoucher"]</label><input type="time" @bind="_modele.SommeilCoucher" /></div>
        <div class="champ"><label>@Localizer["HeureDeLever"]</label><input type="time" @bind="_modele.SommeilLever" /></div>
        <div class="champ"><label>@Localizer["SommeilReparateur"]</label><input @bind="_modele.SommeilReparateur" @bind:event="oninput" /></div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.ReveilsNocturnes" /> @Localizer["ReveilsNocturnesFrequents"]</label></div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.EcransAvantSommeil" /> @Localizer["EcransAvantLeSommeil"]</label></div>

        <h3>@Localizer["Section_TempsPersonnel"]</h3>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.TempsPersoQuotidien" /> @Localizer["UnMomentPersonnelChaqueJour"]</label></div>
        <div class="champ"><label>@Localizer["SentimentDeManqueDeTempsPerso"]</label><input @bind="_modele.ManqueTempsPerso" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["ActivitesRessourcantes"]</label><input @bind="_modele.ActivitesRessourcantes" @bind:event="oninput" /></div>

        <h3>@Localizer["Section_Travail"]</h3>
        <div class="champ"><label>@Localizer["HoraireDeTravail"]</label><input @bind="_modele.HoraireTravail" @bind:event="oninput" /></div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.SurchargePrevisible" /> @Localizer["SurchargePrevisible"]</label></div>
        <div class="champ"><label>@Localizer["TravailHorsHeuresPrevues"]</label><input @bind="_modele.TravailHorsHeures" @bind:event="oninput" /></div>

        <h3>@Localizer["Section_Contraintes"]</h3>
        <div class="champ"><label>@Localizer["DureeDesTrajets"]</label><input @bind="_modele.DureeTrajets" @bind:event="oninput" /></div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.DeplacementsImprevus" /> @Localizer["DeplacementsImprevisibles"]</label></div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.EngagementCommunautaire" /> @Localizer["EngagementCommunautaire"]</label></div>
        <div class="champ"><label>@Localizer["NatureDeLEngagement"]</label><input @bind="_modele.EngagementNature" @bind:event="oninput" /></div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.ProcheMalade" /> @Localizer["ProcheMaladeACharge"]</label></div>

        <h3>@Localizer["Section_ModeDeTravail"]</h3>
        <div class="champ"><label>@Localizer["ModeDeTravail"]</label><input @bind="_modele.ModeTravail" @bind:event="oninput" /></div>
        <div class="champ">
            <label>@Localizer["Interruptions"]</label>
            <select @bind="_modele.InterruptionsTravail">
                <option value="">@Localizer["NonRenseigne"]</option>
                <option value="Jamais">@Localizer["Jamais"]</option>
                <option value="Parfois">@Localizer["Parfois"]</option>
                <option value="Souvent">@Localizer["Souvent"]</option>
                <option value="Constamment">@Localizer["Constamment"]</option>
            </select>
        </div>
        <div class="champ"><label>@Localizer["AutonomieDansLaGestionDuTemps"]</label><input type="number" min="1" max="5" @bind="_modele.AutonomieGestion" /></div>

        <h3>@Localizer["Section_EtatPsychosocial"]</h3>
        <div class="champ">
            <label>@Localizer["SentimentDePression"]</label>
            <select @bind="_modele.SentimentPression">
                <option value="">@Localizer["NonRenseigne"]</option>
                <option value="Jamais">@Localizer["Jamais"]</option>
                <option value="Parfois">@Localizer["Parfois"]</option>
                <option value="Souvent">@Localizer["Souvent"]</option>
                <option value="Constamment">@Localizer["Constamment"]</option>
            </select>
        </div>
        <div class="champ"><label>@Localizer["DifficultesDeConcentration"]</label><input @bind="_modele.DifficultesConcentration" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["DecisionsPrecipitees"]</label><input @bind="_modele.DecisionsPrecipitees" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["CulpabiliteLieeAuTempsPerso"]</label><input @bind="_modele.Culpabilite" @bind:event="oninput" /></div>
        <div class="champ">
            <label>@Localizer["ToleranceALImprevu"]</label>
            <select @bind="_modele.ToleranceImprevu">
                <option value="">@Localizer["NonRenseigne"]</option>
                <option value="Anxieux">@Localizer["Anxieux"]</option>
                <option value="Adaptatif">@Localizer["Adaptatif"]</option>
                <option value="Souple">@Localizer["Souple"]</option>
            </select>
        </div>

        <h3>@Localizer["Section_Organisation"]</h3>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.UtiliseAgenda" /> @Localizer["UtiliseUnAgenda"]</label></div>
        <div class="champ">
            <label>@Localizer["PlanificationALAvance"]</label>
            <select @bind="_modele.PlanificationAvance">
                <option value="">@Localizer["NonRenseigne"]</option>
                <option value="Jamais">@Localizer["Jamais"]</option>
                <option value="Parfois">@Localizer["Parfois"]</option>
                <option value="Souvent">@Localizer["Souvent"]</option>
                <option value="Systématiquement">@Localizer["Systematiquement"]</option>
            </select>
        </div>
        <div class="champ-case"><label><input type="checkbox" @bind="_modele.RituelsQuotidiens" /> @Localizer["RituelsQuotidiens"]</label></div>
        <div class="champ">
            <label>@Localizer["DitOuiTropFacilement"]</label>
            <select @bind="_modele.OuiTropFacile">
                <option value="">@Localizer["NonRenseigne"]</option>
                <option value="Jamais">@Localizer["Jamais"]</option>
                <option value="Parfois">@Localizer["Parfois"]</option>
                <option value="Souvent">@Localizer["Souvent"]</option>
                <option value="Toujours">@Localizer["Toujours"]</option>
            </select>
        </div>
        <div class="champ">
            <label>@Localizer["CapaciteARefuser"]</label>
            <select @bind="_modele.CapaciteNon">
                <option value="">@Localizer["NonRenseigne"]</option>
                <option value="Difficilement">@Localizer["Difficilement"]</option>
                <option value="Parfois">@Localizer["Parfois"]</option>
                <option value="Souvent">@Localizer["Souvent"]</option>
                <option value="Facilement">@Localizer["Facilement"]</option>
            </select>
        </div>
        <div class="champ"><label>@Localizer["GestionAdministrative"]</label><input @bind="_modele.GestionAdmin" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["StressAdministratif"]</label><input @bind="_modele.StressAdmin" @bind:event="oninput" /></div>

        <h3>@Localizer["Section_TagsLibres"]</h3>
        <div class="champ"><label>@Localizer["Tendances"]</label><input @bind="_modele.Tendances" @bind:event="oninput" placeholder="@Localizer["TendancesPlaceholder"]" /></div>
        <div class="champ"><label>@Localizer["DesequilibresIdentifies"]</label><input @bind="_modele.Desequilibres" @bind:event="oninput" placeholder="@Localizer["DesequilibresPlaceholder"]" /></div>
        <div class="champ"><label>@Localizer["EmotionsNegatives"]</label><input @bind="_modele.EmotionsNegatives" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["EmotionsPositives"]</label><input @bind="_modele.EmotionsPositives" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["ObjectifsProfessionnels"]</label><input @bind="_modele.ObjectifsProfessionnels" @bind:event="oninput" /></div>
        <div class="champ"><label>@Localizer["ObstaclesPercus"]</label><input @bind="_modele.Obstacles" @bind:event="oninput" /></div>

        <h3>@Localizer["Section_SatisfactionParCategorie"]</h3>
        <div class="gdt-satisfaction-grille">
            <div class="champ"><label>@Localizer["CategorieSommeil"]</label><input type="number" min="0" max="4" @bind="_modele.SatisfactionSommeil" /></div>
            <div class="champ"><label>@Localizer["CategoriePersonnel"]</label><input type="number" min="0" max="4" @bind="_modele.SatisfactionPerso" /></div>
            <div class="champ"><label>@Localizer["CategorieProfessionnel"]</label><input type="number" min="0" max="4" @bind="_modele.SatisfactionPro" /></div>
            <div class="champ"><label>@Localizer["CategorieAdministratif"]</label><input type="number" min="0" max="4" @bind="_modele.SatisfactionAdmin" /></div>
            <div class="champ"><label>@Localizer["CategorieFamilial"]</label><input type="number" min="0" max="4" @bind="_modele.SatisfactionFamille" /></div>
            <div class="champ"><label>@Localizer["CategorieSocial"]</label><input type="number" min="0" max="4" @bind="_modele.SatisfactionSocial" /></div>
        </div>

        <h3>@Localizer["Section_DirectionSouhaitee"]</h3>
        <div class="gdt-satisfaction-grille">
            <div class="champ"><label>@Localizer["CategorieSommeil"]</label><input @bind="_modele.DirectionSommeil" @bind:event="oninput" /></div>
            <div class="champ"><label>@Localizer["CategoriePersonnel"]</label><input @bind="_modele.DirectionPerso" @bind:event="oninput" /></div>
            <div class="champ"><label>@Localizer["CategorieProfessionnel"]</label><input @bind="_modele.DirectionPro" @bind:event="oninput" /></div>
            <div class="champ"><label>@Localizer["CategorieAdministratif"]</label><input @bind="_modele.DirectionAdmin" @bind:event="oninput" /></div>
            <div class="champ"><label>@Localizer["CategorieFamilial"]</label><input @bind="_modele.DirectionFamille" @bind:event="oninput" /></div>
            <div class="champ"><label>@Localizer["CategorieSocial"]</label><input @bind="_modele.DirectionSocial" @bind:event="oninput" /></div>
        </div>

        @if (!_readOnly)
        {
            <button @onclick="EnregistrerAsync" disabled="@_enregistrementEnCours">@Localizer["EnregistrerLeProfil"]</button>
            @if (_messageConfirmation is not null)
            {
                <span class="gdt-confirmation">@_messageConfirmation</span>
            }
        }
    </fieldset>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public string? Suivi { get; set; }
    private bool _readOnly => !string.IsNullOrEmpty(Suivi);

    /// <summary>Ajoute le segment Suivi aux liens croisés vers les autres écrans du module, pour qu'un coach en mode lecture seule reste sur les données de la personne suivie en naviguant.</summary>
    private string Href(string basePath) => _readOnly ? $"{basePath}/{Suivi}" : basePath;

    private string? _userId;
    private bool _hasAccess;
    private bool _enregistrementEnCours;
    private string? _messageConfirmation;

    private sealed class Modele
    {
        public TimeOnly? SommeilCoucher { get; set; }
        public TimeOnly? SommeilLever { get; set; }
        public string? SommeilReparateur { get; set; }
        public bool ReveilsNocturnes { get; set; }
        public bool EcransAvantSommeil { get; set; }
        public bool TempsPersoQuotidien { get; set; }
        public string? ManqueTempsPerso { get; set; }
        public string? ActivitesRessourcantes { get; set; }
        public string? HoraireTravail { get; set; }
        public bool SurchargePrevisible { get; set; }
        public string? TravailHorsHeures { get; set; }
        public string? DureeTrajets { get; set; }
        public bool DeplacementsImprevus { get; set; }
        public bool EngagementCommunautaire { get; set; }
        public string? EngagementNature { get; set; }
        public bool ProcheMalade { get; set; }
        public string? ModeTravail { get; set; }
        public string? InterruptionsTravail { get; set; }
        public int? AutonomieGestion { get; set; }
        public string? SentimentPression { get; set; }
        public string? DifficultesConcentration { get; set; }
        public string? DecisionsPrecipitees { get; set; }
        public string? Culpabilite { get; set; }
        public string? ToleranceImprevu { get; set; }
        public bool UtiliseAgenda { get; set; }
        public string? PlanificationAvance { get; set; }
        public bool RituelsQuotidiens { get; set; }
        public string? OuiTropFacile { get; set; }
        public string? CapaciteNon { get; set; }
        public string? GestionAdmin { get; set; }
        public string? StressAdmin { get; set; }
        public string? Tendances { get; set; }
        public string? Desequilibres { get; set; }
        public string? EmotionsNegatives { get; set; }
        public string? EmotionsPositives { get; set; }
        public string? ObjectifsProfessionnels { get; set; }
        public string? Obstacles { get; set; }
        public int? SatisfactionSommeil { get; set; }
        public int? SatisfactionPerso { get; set; }
        public int? SatisfactionPro { get; set; }
        public int? SatisfactionAdmin { get; set; }
        public int? SatisfactionFamille { get; set; }
        public int? SatisfactionSocial { get; set; }
        public string? DirectionSommeil { get; set; }
        public string? DirectionPerso { get; set; }
        public string? DirectionPro { get; set; }
        public string? DirectionAdmin { get; set; }
        public string? DirectionFamille { get; set; }
        public string? DirectionSocial { get; set; }
    }

    private Modele? _modele;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        if (_readOnly)
        {
            var autorise = await CoachingAccessChecker.GetSuiviUserIdSiAutoriseAsync(Suivi!, userId);
            _userId = autorise ?? userId;
            _hasAccess = autorise is not null;
        }
        else
        {
            _userId = userId;
            _hasAccess = await AccessService.HasAccessAsync(userId);
        }

        if (!_hasAccess)
            return;

        var profil = await GdtService.GetProfilPsychosocialAsync(_userId);
        _modele = profil is null ? new Modele() : DepuisEntite(profil);
    }

    private static Modele DepuisEntite(ProfilPsychosocial p) => new()
    {
        SommeilCoucher = p.SommeilCoucher,
        SommeilLever = p.SommeilLever,
        SommeilReparateur = p.SommeilReparateur,
        ReveilsNocturnes = p.ReveilsNocturnes ?? false,
        EcransAvantSommeil = p.EcransAvantSommeil ?? false,
        TempsPersoQuotidien = p.TempsPersoQuotidien ?? false,
        ManqueTempsPerso = p.ManqueTempsPerso,
        ActivitesRessourcantes = p.ActivitesRessourcantes,
        HoraireTravail = p.HoraireTravail,
        SurchargePrevisible = p.SurchargePrevisible ?? false,
        TravailHorsHeures = p.TravailHorsHeures,
        DureeTrajets = p.DureeTrajets,
        DeplacementsImprevus = p.DeplacementsImprevus ?? false,
        EngagementCommunautaire = p.EngagementCommunautaire ?? false,
        EngagementNature = p.EngagementNature,
        ProcheMalade = p.ProcheMalade ?? false,
        ModeTravail = p.ModeTravail,
        InterruptionsTravail = p.InterruptionsTravail,
        AutonomieGestion = p.AutonomieGestion,
        SentimentPression = p.SentimentPression,
        DifficultesConcentration = p.DifficultesConcentration,
        DecisionsPrecipitees = p.DecisionsPrecipitees,
        Culpabilite = p.Culpabilite,
        ToleranceImprevu = p.ToleranceImprevu,
        UtiliseAgenda = p.UtiliseAgenda ?? false,
        PlanificationAvance = p.PlanificationAvance,
        RituelsQuotidiens = p.RituelsQuotidiens ?? false,
        OuiTropFacile = p.OuiTropFacile,
        CapaciteNon = p.CapaciteNon,
        GestionAdmin = p.GestionAdmin,
        StressAdmin = p.StressAdmin,
        Tendances = string.Join(", ", p.Tendances),
        Desequilibres = string.Join(", ", p.Desequilibres),
        EmotionsNegatives = string.Join(", ", p.EmotionsNegatives),
        EmotionsPositives = string.Join(", ", p.EmotionsPositives),
        ObjectifsProfessionnels = string.Join(", ", p.ObjectifsProfessionnels),
        Obstacles = string.Join(", ", p.Obstacles),
        SatisfactionSommeil = p.SatisfactionSommeil,
        SatisfactionPerso = p.SatisfactionPerso,
        SatisfactionPro = p.SatisfactionPro,
        SatisfactionAdmin = p.SatisfactionAdmin,
        SatisfactionFamille = p.SatisfactionFamille,
        SatisfactionSocial = p.SatisfactionSocial,
        DirectionSommeil = p.DirectionSommeil,
        DirectionPerso = p.DirectionPerso,
        DirectionPro = p.DirectionPro,
        DirectionAdmin = p.DirectionAdmin,
        DirectionFamille = p.DirectionFamille,
        DirectionSocial = p.DirectionSocial,
    };

    private static List<string> Tags(string? valeur) =>
        (valeur ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task EnregistrerAsync()
    {
        _enregistrementEnCours = true;
        _messageConfirmation = null;
        try
        {
            var m = _modele!;
            var entite = new ProfilPsychosocial
            {
                UserId = _userId!,
                SommeilCoucher = m.SommeilCoucher,
                SommeilLever = m.SommeilLever,
                SommeilReparateur = m.SommeilReparateur,
                ReveilsNocturnes = m.ReveilsNocturnes,
                EcransAvantSommeil = m.EcransAvantSommeil,
                TempsPersoQuotidien = m.TempsPersoQuotidien,
                ManqueTempsPerso = m.ManqueTempsPerso,
                ActivitesRessourcantes = m.ActivitesRessourcantes,
                HoraireTravail = m.HoraireTravail,
                SurchargePrevisible = m.SurchargePrevisible,
                TravailHorsHeures = m.TravailHorsHeures,
                DureeTrajets = m.DureeTrajets,
                DeplacementsImprevus = m.DeplacementsImprevus,
                EngagementCommunautaire = m.EngagementCommunautaire,
                EngagementNature = m.EngagementNature,
                ProcheMalade = m.ProcheMalade,
                ModeTravail = m.ModeTravail,
                InterruptionsTravail = m.InterruptionsTravail,
                AutonomieGestion = m.AutonomieGestion,
                SentimentPression = m.SentimentPression,
                DifficultesConcentration = m.DifficultesConcentration,
                DecisionsPrecipitees = m.DecisionsPrecipitees,
                Culpabilite = m.Culpabilite,
                ToleranceImprevu = m.ToleranceImprevu,
                UtiliseAgenda = m.UtiliseAgenda,
                PlanificationAvance = m.PlanificationAvance,
                RituelsQuotidiens = m.RituelsQuotidiens,
                OuiTropFacile = m.OuiTropFacile,
                CapaciteNon = m.CapaciteNon,
                GestionAdmin = m.GestionAdmin,
                StressAdmin = m.StressAdmin,
                Tendances = Tags(m.Tendances),
                Desequilibres = Tags(m.Desequilibres),
                EmotionsNegatives = Tags(m.EmotionsNegatives),
                EmotionsPositives = Tags(m.EmotionsPositives),
                ObjectifsProfessionnels = Tags(m.ObjectifsProfessionnels),
                Obstacles = Tags(m.Obstacles),
                SatisfactionSommeil = m.SatisfactionSommeil,
                SatisfactionPerso = m.SatisfactionPerso,
                SatisfactionPro = m.SatisfactionPro,
                SatisfactionAdmin = m.SatisfactionAdmin,
                SatisfactionFamille = m.SatisfactionFamille,
                SatisfactionSocial = m.SatisfactionSocial,
                DirectionSommeil = m.DirectionSommeil,
                DirectionPerso = m.DirectionPerso,
                DirectionPro = m.DirectionPro,
                DirectionAdmin = m.DirectionAdmin,
                DirectionFamille = m.DirectionFamille,
                DirectionSocial = m.DirectionSocial,
            };

            await GdtService.SaveProfilPsychosocialAsync(_userId!, entite);
            _messageConfirmation = Localizer["ProfilEnregistre"];
        }
        finally
        {
            _enregistrementEnCours = false;
        }
    }
}
