@page "/gestion-du-temps/reflexion"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Modules.GestionDuTemps.Entities
@using Spectrometre.Modules.GestionDuTemps.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IGestionDuTempsService GdtService
@inject IGestionDuTempsAccessService AccessService
@inject IStringLocalizer<GestionDuTempsResource> Localizer

<PageTitle>@Localizer["ReflexionTitle"]</PageTitle>

<h1>@Localizer["NavReflexionConsciente"]</h1>
<p class="hint">
    @Localizer["ReflexionHint"] <a href="/gestion-du-temps">@Localizer["NavRetourAuxRituels"]</a>.
</p>

@if (_userId is null)
{
    <p>@Localizer["Chargement"]</p>
}
else if (!_hasAccess)
{
    <p class="hint">@Localizer["ModuleNonActive"]</p>
}
else if (_modele is null)
{
    <p>@Localizer["Chargement"]</p>
}
else
{
    <div class="gdt-form">
        <div class="champ">
            <label>@Localizer["QuelleEstVotreSituation"]</label>
            <textarea rows="4" @bind="_modele.SituationActuelle" @bind:event="oninput"></textarea>
        </div>
        <div class="champ-case">
            <label><input type="checkbox" @bind="_modele.SourceIdentifiee" /> @Localizer["JaiIdentifieLaSource"]</label>
        </div>
        <div class="champ">
            <label>@Localizer["DateDeRetourSurReflexion"]</label>
            <input type="date" @bind="_modele.DateEcheance" />
        </div>
        <div class="champ">
            <label>@Localizer["Ressentis"]</label>
            <input @bind="_modele.Ressentis" @bind:event="oninput" placeholder="@Localizer["RessentisPlaceholder"]" />
        </div>
        <div class="champ">
            <label>@Localizer["SourcesPossibles"]</label>
            <input @bind="_modele.Sources" @bind:event="oninput" placeholder="@Localizer["SourcesPlaceholder"]" />
        </div>
        <button @onclick="EnregistrerAsync" disabled="@_enregistrementEnCours">@Localizer["EnregistrerLaReflexion"]</button>
        @if (_messageConfirmation is not null)
        {
            <span class="gdt-confirmation">@_messageConfirmation</span>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _userId;
    private bool _hasAccess;
    private bool _enregistrementEnCours;
    private string? _messageConfirmation;

    private sealed class Modele
    {
        public string? SituationActuelle { get; set; }
        public bool SourceIdentifiee { get; set; }
        public DateOnly? DateEcheance { get; set; }
        public string? Ressentis { get; set; }
        public string? Sources { get; set; }
    }

    private Modele? _modele;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _userId = userId;
        _hasAccess = await AccessService.HasAccessAsync(userId);
        if (!_hasAccess)
            return;

        var reflexion = await GdtService.GetReflexionConscienteAsync(userId);
        _modele = reflexion is null
            ? new Modele()
            : new Modele
            {
                SituationActuelle = reflexion.SituationActuelle,
                SourceIdentifiee = reflexion.SourceIdentifiee ?? false,
                DateEcheance = reflexion.DateEcheance,
                Ressentis = string.Join(", ", reflexion.Ressentis),
                Sources = string.Join(", ", reflexion.Sources),
            };
    }

    private static List<string> Tags(string? valeur) =>
        (valeur ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task EnregistrerAsync()
    {
        _enregistrementEnCours = true;
        _messageConfirmation = null;
        try
        {
            var m = _modele!;
            await GdtService.SaveReflexionConscienteAsync(_userId!, new ReflexionConsciente
            {
                UserId = _userId!,
                SituationActuelle = m.SituationActuelle,
                SourceIdentifiee = m.SourceIdentifiee,
                DateEcheance = m.DateEcheance,
                Ressentis = Tags(m.Ressentis),
                Sources = Tags(m.Sources),
            });
            _messageConfirmation = Localizer["ReflexionEnregistree"];
        }
        finally
        {
            _enregistrementEnCours = false;
        }
    }
}
