@page "/gestion-du-temps/kanban"
@page "/gestion-du-temps/kanban/{Suivi}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Modules
@using Spectrometre.Modules.GestionDuTemps.Entities
@using Spectrometre.Modules.GestionDuTemps.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@implements IDisposable
@inject IGestionDuTempsService GdtService
@inject IGestionDuTempsAccessService AccessService
@inject ICoachingAccessChecker CoachingAccessChecker
@inject IStringLocalizer<GestionDuTempsResource> Localizer
@inject NavigationManager NavigationManager

<PageTitle>@Localizer["KanbanTitle"]</PageTitle>

<div class="gdt-page plan-page">
    <h1 class="gdt-title">@Localizer["KanbanDuCycleActif"]</h1>
    <p class="hint">
        @Localizer["KanbanHint1"] <a href="@Href("/gestion-du-temps")">@Localizer["NavRetourAuxRituels"]</a>.
    </p>

@if (_loading)
{
    <div class="p-4 text-muted small">@Localizer["Chargement"]</div>
}
else if (!_hasAccess)
{
    <p class="hint">@Localizer["ModuleNonActive"]</p>
}
else
{
    @if (_cycle is not null)
    {
        <div class="gdt-cycle-bandeau">
            <span>@string.Format(Localizer["CycleBandeau"].Value, _cycle.NumeroCycle, _cycle.DemarreLe.ToLocalTime().ToString("dd/MM/yyyy"))</span>
            @if (!_readOnly)
            {
                <button type="button" @onclick="ClotureCycleAsync" disabled="@(_busy || _clotureEnCours)">
                    @Localizer["ClotureCycleBouton"]
                </button>
            }
        </div>
        <p class="hint gdt-cycle-hint">@Localizer["ClotureCycleHint"]</p>
    }

    @if (!Cards.Any())
    {
        <div class="plan-empty">
            @Localizer["AucunRappelDansCeCycle"] <a href="@Href("/gestion-du-temps/organisation")">@Localizer["NavOrganisation"]</a>.
        </div>
    }

    <div class="plan-kanban">
        @foreach (var col in Columns)
        {
            <div class="plan-column">
                <div class="plan-column__head">
                    <span>@col.Label</span>
                    <span class="plan-column__count">@GetCards(col.Statut).Count()</span>
                </div>
                    <div class="plan-column__body @(_dragOverColumn == col.Statut ? "plan-column__body--drag" : "")"
                     @ondragover="() => OnDragOver(col.Statut)"
                     @ondragover:preventDefault="true"
                     @ondragleave="OnDragLeave"
                     @ondrop="() => OnDropAsync(col.Statut)"
                     @ondrop:preventDefault="true">
                    @foreach (var card in GetCards(col.Statut))
                    {
                        <div class="plan-card @(card.EnDepassement ? "plan-card--over" : "")"
                             draggable="@(!_readOnly)"
                             @ondragstart="() => OnDragStart(card.ActiviteId)"
                             @ondragend="OnDragEnd">
                            <h3 class="plan-card__title">@card.Nom</h3>
                            <div class="plan-card__meta">
                                <span class="plan-card__dot" style="background:@card.TypeCouleur"></span>
                                <span>@card.TypeLibelle · @card.DureeMinutes min</span>
                            </div>
                            @if (card.ShowTimer)
                            {
                                var elapsed = GetElapsedMs(card);
                                <div class="plan-card__timer @(card.EnDepassement ? "plan-card__timer--over" : "plan-card__timer--ok")">
                                    @KanbanTimer.Format(elapsed)
                                </div>
                            }
                            @* Boutons de déplacement — mobile uniquement (touch), comme MVP *@
                            @if (!_readOnly)
                            {
                                <div class="plan-card__quick-move d-flex d-md-none gap-1 flex-wrap mt-2">
                                    @foreach (var targetCol in Columns.Where(c => c.Statut != col.Statut))
                                    {
                                        <button type="button"
                                                class="plan-card__move-btn"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => MoveCardToColumnAsync(card.ActiviteId, targetCol.Statut)">
                                            @targetCol.Label <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning mt-3 py-2 small" role="alert">@_error</div>
    }

    <div class="plan-footer">
        <button type="button" class="btn-prev-section" @onclick="GoOrganisation">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> @Localizer["NavOrganisation"]
        </button>
        <button type="button" class="btn-next-section" disabled="@_busy" @onclick="GoMoniteur">
            @Localizer["NavRetourAuxRituels"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
    </div>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public string? Suivi { get; set; }
    private bool _readOnly => !string.IsNullOrEmpty(Suivi);
    private string Href(string basePath) => _readOnly ? $"{basePath}/{Suivi}" : basePath;

    private bool _loading = true;
    private bool _hasAccess;
    private bool _busy;
    private bool _clotureEnCours;
    private string? _error;
    private string? _userId;
    private CycleView? _cycle;
    private int? _draggedActiviteId;
    private string? _dragOverColumn;
    private Timer? _uiTimer;
    private DateTimeOffset _derniereActualisation = DateTimeOffset.UtcNow;

    private sealed record KanbanColumn(string Statut, string Label);

    private sealed record KanbanCardVm(
        int ActiviteId,
        string Nom,
        int DureeMinutes,
        string TypeLibelle,
        string TypeCouleur,
        string Statut,
        long TempsReelMs,
        bool EnDepassement,
        bool ShowTimer);

    private List<KanbanColumn> Columns =>
    [
        new(KanbanColonnes.AFaire, Localizer["ColonneAFaire"]),
        new(KanbanColonnes.EnCours, Localizer["ColonneEnCours"]),
        new(KanbanColonnes.Termine, Localizer["ColonneTermine"]),
    ];

    private List<KanbanCardVm> Cards { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        if (_readOnly)
        {
            var autorise = await CoachingAccessChecker.GetSuiviUserIdSiAutoriseAsync(Suivi!, userId);
            _userId = autorise ?? userId;
            _hasAccess = autorise is not null;
        }
        else
        {
            _userId = userId;
            _hasAccess = await AccessService.HasAccessAsync(userId);
        }

        if (_hasAccess)
        {
            await RefreshAsync();
            _uiTimer = new Timer(_ =>
            {
                if (_busy || _draggedActiviteId is not null) return;
                _ = InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }

        _loading = false;
    }

    private async Task RefreshAsync()
    {
        try
        {
            if (!_readOnly)
                await GdtService.GetOrCreateCycleActifAsync(_userId!);

            _cycle = await GdtService.GetCycleActifAsync(_userId!);
            var cartes = await GdtService.GetKanbanAsync(_userId!);
            _derniereActualisation = DateTimeOffset.UtcNow;

            Cards = cartes.Select(c => new KanbanCardVm(
                c.ActiviteId,
                c.Nom,
                c.DureeMinutes,
                c.TypeLibelle,
                c.TypeCouleur,
                c.Statut,
                c.TempsReelMs,
                c.EnDepassement,
                c.Statut is KanbanColonnes.EnCours or KanbanColonnes.Termine)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private IEnumerable<KanbanCardVm> GetCards(string statut) =>
        Cards.Where(c => c.Statut == statut);

    private long GetElapsedMs(KanbanCardVm card) =>
        card.Statut == KanbanColonnes.EnCours
            ? card.TempsReelMs + (long)(DateTimeOffset.UtcNow - _derniereActualisation).TotalMilliseconds
            : card.TempsReelMs;

    private void OnDragStart(int activiteId)
    {
        if (_readOnly) return;
        _draggedActiviteId = activiteId;
    }

    private void OnDragEnd()
    {
        _draggedActiviteId = null;
        _dragOverColumn = null;
    }

    private void OnDragOver(string statut)
    {
        if (_readOnly) return;
        _dragOverColumn = statut;
    }

    private void OnDragLeave() => _dragOverColumn = null;

    /// <summary>Déplace une carte vers une colonne — utilisé par les boutons mobiles (MVP).</summary>
    private async Task MoveCardToColumnAsync(int activiteId, string targetStatut)
    {
        _draggedActiviteId = activiteId;
        await OnDropAsync(targetStatut);
    }

    private async Task OnDropAsync(string targetStatut)
    {
        _dragOverColumn = null;
        if (_readOnly || _draggedActiviteId is not int activiteId)
            return;

        var card = Cards.FirstOrDefault(c => c.ActiviteId == activiteId);
        if (card is null || card.Statut == targetStatut)
        {
            _draggedActiviteId = null;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            switch (targetStatut)
            {
                case KanbanColonnes.AFaire:
                    await GdtService.MarquerPauseAsync(_userId!, activiteId);
                    break;
                case KanbanColonnes.EnCours:
                    await GdtService.MarquerDebutAsync(_userId!, activiteId);
                    break;
                case KanbanColonnes.Termine:
                    await GdtService.MarquerTermineAsync(_userId!, activiteId);
                    break;
            }

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _draggedActiviteId = null;
        }
    }

    private async Task ClotureCycleAsync()
    {
        if (_readOnly) return;
        _clotureEnCours = true;
        _error = null;
        try
        {
            _cycle = await GdtService.ClotureEtDemarrerNouveauCycleAsync(_userId!);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _clotureEnCours = false;
        }
    }

    private void GoOrganisation() => NavigationManager.NavigateTo(Href("/gestion-du-temps/organisation"));
    private void GoMoniteur() => NavigationManager.NavigateTo(Href("/gestion-du-temps"));

    public void Dispose() => _uiTimer?.Dispose();
}
