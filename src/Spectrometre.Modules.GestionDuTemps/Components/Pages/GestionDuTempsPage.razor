@page "/gestion-du-temps"
@page "/gestion-du-temps/{Suivi}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Spectrometre.Core.Modules
@using Spectrometre.Modules.GestionDuTemps.Entities
@using Spectrometre.Modules.GestionDuTemps.Helpers
@using Spectrometre.Modules.GestionDuTemps.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@implements IDisposable
@inject IGestionDuTempsService GdtService
@inject IGestionDuTempsAccessService AccessService
@inject ICoachingAccessChecker CoachingAccessChecker
@inject IStringLocalizer<GestionDuTempsResource> Localizer
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>@Localizer["NavMoniteur"]</PageTitle>

<div class="gdt-page">
@if (_userId is null)
{
    <p>@Localizer["Chargement"]</p>
}
else if (!_hasAccess)
{
    <p class="hint">@Localizer["ModuleNonActiveDetail"]</p>
}
else if (_loading)
{
    <p>@Localizer["Chargement"]</p>
}
else
{
<div class="tdb-page">
    <h1 class="gdt-title">@Localizer["NavMoniteur"]</h1>

    <div class="tdb-panel">
        <div class="tdb-period-header small text-muted mb-2">@_periodHeaderLabel</div>
        <div class="tdb-legend">
            <span class="tdb-legend-item">
                <span class="tdb-legend-swatch tdb-legend-swatch--alloc"></span> @Localizer["Gdt_Tdb_Theoretical"]
            </span>
            <span class="tdb-legend-item">
                <span class="tdb-legend-swatch tdb-legend-swatch--used"></span> @Localizer["Gdt_Tdb_Real"]
            </span>
        </div>

        <div class="tdb-charts">
            <div class="tdb-chart-box">
                <canvas id="gdt-bar-chart" aria-label="@Localizer["Gdt_Tdb_BarChartAria"]"></canvas>
            </div>
            <div class="tdb-chart-box">
                <canvas id="gdt-radar-chart" aria-label="@Localizer["Gdt_Tdb_RadarChartAria"]"></canvas>
            </div>
        </div>
    </div>

    <div class="tdb-panel">
        <h2 class="tdb-section-title">@Localizer["Gdt_Tdb_DetailTitle"]</h2>
        @foreach (var row in _typeRows)
        {
            <div class="tdb-type-row">
                <div class="tdb-type-label">
                    <span class="tdb-swatch" style="background:@row.Color"></span>
                    @row.Label
                </div>
                <div class="tdb-progress-track">
                    <div class="tdb-progress-fill" style="width:@(row.ProgressPct)%; background:@row.Color"></div>
                </div>
                <div class="tdb-ratio @row.RatioClass">
                    @row.RatioText
                </div>
            </div>
        }
    </div>

    <div class="tdb-stats">
        <div class="tdb-stat tdb-stat--done">
            <div class="tdb-stat__value">@_statsTerminees</div>
            <div class="tdb-stat__label">@Localizer["Dashboard_GdtStatutTermine"]</div>
        </div>
        <div class="tdb-stat tdb-stat--progress">
            <div class="tdb-stat__value">@_statsEnCours</div>
            <div class="tdb-stat__label">@Localizer["Dashboard_GdtStatutEnCours"]</div>
        </div>
        <div class="tdb-stat tdb-stat--todo">
            <div class="tdb-stat__value">@_statsAFaire</div>
            <div class="tdb-stat__label">@Localizer["Dashboard_GdtStatutAFaire"]</div>
        </div>
    </div>

    <div class="tdb-reco">@_recommandation</div>

    <div class="tdb-panel">
        <div class="tdb-cycle-progress__label">@_resetLabel</div>
        <div class="tdb-cycle-bar" role="progressbar" aria-valuenow="@_cycleProgressPct" aria-valuemin="0" aria-valuemax="100">
            <div class="tdb-cycle-bar__fill" style="width:@(_cycleProgressPct)%"></div>
        </div>
        <div class="tdb-cycle-progress__ends">
            <span>@_cycleLeftLabel</span>
            <span>@_cycleRightLabel</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning py-2 small" role="alert">@_error</div>
    }

    <div class="tdb-footer">
        <button type="button" class="btn-prev-section" @onclick="GoPlanification">
            <i class="bi bi-arrow-left"></i> @Localizer["NavPlanification"]
        </button>
    </div>
</div>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>Segment de route optionnel — présent quand un coach consulte le Gestion du temps d'une personne suivie (voir ICoachingAccessChecker) : lecture seule.</summary>
    [Parameter] public string? Suivi { get; set; }
    private bool _readOnly => !string.IsNullOrEmpty(Suivi);

    private string Href(string basePath) => _readOnly ? $"{basePath}/{Suivi}" : basePath;

    private string? _userId;
    private bool _hasAccess;
    private bool _loading = true;
    private bool _dataReady;
    private bool _chartsInitialized;
    private int _chartGeneration;
    private string? _error;
    private int _cycleId;

    private int _statsTerminees;
    private int _statsEnCours;
    private int _statsAFaire;
    private string _recommandation = "";
    private const string PeriodeReset = "Hebdomadaire";
    private DateTimeOffset _cycleStartedAt;
    private string _periodHeaderLabel = "";
    private string _resetLabel = "";
    private int _cycleProgressPct;
    private string _cycleLeftLabel = "";
    private string _cycleRightLabel = "";

    private List<TypeRow> _typeRows = new();
    private string[] _chartLabels = Array.Empty<string>();
    private double[] _allocData = Array.Empty<double>();
    private double[] _usedData = Array.Empty<double>();
    private string[] _colors = Array.Empty<string>();
    private string[] _axisColors = Array.Empty<string>();

    private Timer? _refreshTimer;
    private CultureInfo DisplayCulture => CultureInfo.CurrentCulture;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    private sealed record TypeRow(
        string Label,
        string Color,
        double ProgressPct,
        string RatioText,
        string RatioClass);

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        if (_readOnly)
        {
            var autorise = await CoachingAccessChecker.GetSuiviUserIdSiAutoriseAsync(Suivi!, userId);
            _userId = autorise ?? userId;
            _hasAccess = autorise is not null;
            if (!_hasAccess)
            {
                _loading = false;
                return;
            }
        }
        else
        {
            _userId = userId;
            _hasAccess = await AccessService.HasAccessAsync(userId);
            if (!_hasAccess)
            {
                _loading = false;
                return;
            }
        }

        await LoadDataAsync();
        _refreshTimer = new Timer(_ => _ = InvokeAsync(RefreshLiveDataAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dataReady || _loading || _chartsInitialized)
            return;

        try
        {
            await InitChartsAsync();
            _chartsInitialized = true;
        }
        catch
        {
            /* Chart.js ou canvas pas encore prêt — nouvel essai au prochain rendu */
        }
    }

    private async Task InitChartsAsync()
    {
        _chartGeneration++;
        var gen = _chartGeneration;
        await JS.InvokeVoidAsync("gdtCharts.initBarChart",
            "gdt-bar-chart", _chartLabels, _allocData, _usedData, _colors, gen);
        await JS.InvokeVoidAsync("gdtCharts.initRadarChart",
            "gdt-radar-chart", _chartLabels, _allocData, _usedData, _axisColors, gen);
    }

    private async Task LoadDataAsync()
    {
        try
        {
            if (!_readOnly)
                await GdtService.GetOrCreateCycleActifAsync(_userId!);

            var cycle = await GdtService.GetCycleActifAsync(_userId!);
            if (cycle is null)
            {
                _dataReady = false;
                return;
            }

            _cycleId = cycle.Id;
            _cycleStartedAt = cycle.DemarreLe;

            var types = (await GdtService.GetTypesDeTempsAsync(_userId!)).ToList();
            var cartes = (await GdtService.GetKanbanAsync(_userId!)).ToList();

            ComputeDashboard(types, cartes);
            _dataReady = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RefreshLiveDataAsync()
    {
        if (!_dataReady || _cycleId == 0 || _userId is null)
            return;

        try
        {
            var types = (await GdtService.GetTypesDeTempsAsync(_userId)).ToList();
            var cartes = (await GdtService.GetKanbanAsync(_userId)).ToList();
            ComputeDashboard(types, cartes);

            if (_chartsInitialized)
            {
                await JS.InvokeVoidAsync("gdtCharts.updateCharts", _allocData, _usedData, _axisColors);
            }

            StateHasChanged();
        }
        catch
        {
            /* ignore refresh errors */
        }
    }

    private void ComputeDashboard(List<TypeDeTempsView> types, List<KanbanCarteView> cartes)
    {
        var ordered = types.OrderBy(t => t.OrdreAffichage).ThenBy(t => t.Cle).ToList();
        if (ordered.Count == 0)
            ordered = BuildFallbackTypes();

        _chartLabels = ordered.Select(ChartLabel).ToArray();
        _colors = ordered.Select(t => CouleurCategorie(t.Cle)).ToArray();
        _allocData = ordered.Select(t => GetHeuresTheoriques(t, PeriodeReset)).ToArray();
        _usedData = ordered.Select(t => GetHeuresReelles(t.Id, cartes)).ToArray();

        _periodHeaderLabel = string.Format(
            Localizer["Gdt_TdbPeriodLabel"].Value,
            LocalizePeriod(PeriodeReset),
            _cycleStartedAt.ToLocalTime().ToString("d MMMM yyyy", DisplayCulture));

        _axisColors = ordered.Select((_, i) => AxisColor(_allocData[i], _usedData[i])).ToArray();

        _typeRows = ordered.Select((t, i) =>
        {
            var theo = _allocData[i];
            var real = _usedData[i];
            var pct = theo <= 0 ? 0 : real / theo * 100;
            return new TypeRow(
                ChartLabel(t),
                CouleurCategorie(t.Cle),
                Math.Min(100, pct),
                $"{FormatH(real)} / {FormatH(theo)} ({pct:0}%)",
                RatioClass(pct));
        }).ToList();

        _statsTerminees = cartes.Count(c => c.Statut == KanbanColonnes.Termine);
        _statsEnCours = cartes.Count(c => c.Statut == KanbanColonnes.EnCours);
        _statsAFaire = cartes.Count(c => c.Statut == KanbanColonnes.AFaire);

        var underUsed = ordered
            .Select((t, i) => (Label: ChartLabel(t), Theo: _allocData[i], Real: _usedData[i]))
            .Where(x => x.Theo > 0 && x.Real / x.Theo < 0.5)
            .Select(x => x.Label)
            .ToList();

        _recommandation = underUsed.Count > 0
            ? string.Format(Localizer["Gdt_Tdb_RecoUnderused"].Value, string.Join(", ", underUsed))
            : Localizer["Gdt_Tdb_RecoBalanced"].Value;

        ComputeCycleProgress(_cycleStartedAt, PeriodeReset);
    }

    private static int CountJoursActifs(TypeDeTempsView type)
    {
        if (string.IsNullOrWhiteSpace(type.RecurrenceJours))
            return 7;

        return type.RecurrenceJours
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Length;
    }

    private static double GetHeuresTheoriques(TypeDeTempsView type, string periodeReset)
    {
        var durJour = TypeDuration.GetDurationHours(type.HeureDebut, type.HeureFin);
        var joursActifs = CountJoursActifs(type);

        var multiplicateur = periodeReset switch
        {
            "Journalier" => joursActifs / 7.0,
            "Hebdomadaire" => joursActifs,
            "Mensuel" => joursActifs * 4.33,
            "Trimestriel" => joursActifs * 13.0,
            "Annuel" => joursActifs * 52.0,
            _ => joursActifs
        };

        return durJour * multiplicateur;
    }

    private double GetHeuresReelles(int typeId, List<KanbanCarteView> cartes) =>
        MoniteurChartMath.SumHeuresReelles(typeId, cartes, _cycleStartedAt, PeriodeReset);

    private void ComputeCycleProgress(DateTimeOffset cycleStartedAt, string periodeReset)
    {
        _resetLabel = periodeReset.Equals("Hebdomadaire", StringComparison.OrdinalIgnoreCase)
            ? Localizer["Gdt_Tdb_ResetWeekly"].Value
            : string.Format(Localizer["Gdt_Tdb_ResetGeneric"].Value, LocalizePeriod(periodeReset).ToLower(DisplayCulture));

        var duree = periodeReset switch
        {
            "Journalier" => 1,
            "Hebdomadaire" => 7,
            "Mensuel" => 30,
            "Trimestriel" => 90,
            "Annuel" => 365,
            _ => 7
        };

        var startedAt = cycleStartedAt.ToLocalTime().Date;
        var elapsed = (DateTime.Today - startedAt).Days + 1;
        if (elapsed < 1)
            elapsed = 1;

        _cycleProgressPct = Math.Min(100, (int)((double)elapsed / duree * 100));
        _cycleLeftLabel = string.Format(Localizer["Gdt_TdbCycleDay"].Value, elapsed);
        _cycleRightLabel = startedAt.AddDays(duree).ToString("dddd d MMMM", DisplayCulture);
    }

    private string LocalizePeriod(string periodeReset) => periodeReset switch
    {
        "Journalier" => Localizer["Gdt_Period_Journalier"].Value,
        "Hebdomadaire" => Localizer["Gdt_Period_Hebdomadaire"].Value,
        "Mensuel" => Localizer["Gdt_Period_Mensuel"].Value,
        "Trimestriel" => Localizer["Gdt_Period_Trimestriel"].Value,
        "Annuel" => Localizer["Gdt_Period_Annuel"].Value,
        _ => periodeReset
    };

    private static List<TypeDeTempsView> BuildFallbackTypes() =>
    [
        new(0, "sommeil", "Sommeil", new TimeOnly(22, 30), new TimeOnly(6, 30), "L,M,Me,J,V,S,D", 0, null),
        new(0, "perso", "Personnel", new TimeOnly(7, 0), new TimeOnly(8, 0), "L,M,Me,J,V,S,D", 1, null),
        new(0, "pro", "Professionnel", new TimeOnly(8, 0), new TimeOnly(17, 0), "L,M,Me,J,V", 2, null),
        new(0, "admin", "Administratif", new TimeOnly(17, 0), new TimeOnly(18, 0), "L,M,Me,J,V", 3, null),
        new(0, "famille", "Familial", new TimeOnly(18, 0), new TimeOnly(21, 0), "L,M,Me,J,V,S,D", 4, null),
        new(0, "social", "Social", new TimeOnly(19, 0), new TimeOnly(21, 0), "L,M,Me,J,V,S,D", 5, null),
    ];

    private string ChartLabel(TypeDeTempsView type)
    {
        var display = DefaultCategoryLabels.Display(type.Cle, type.Libelle, _english);
        return display.Split('·', ' ')[0].Trim();
    }

    private string FormatH(double h) =>
        h.ToString("0.#", DisplayCulture) + "h";

    private static string RatioClass(double pct) => pct switch
    {
        > 110 => "tdb-ratio--bad",
        < 90 => "tdb-ratio--warn",
        _ => "tdb-ratio--good"
    };

    private static string AxisColor(double theo, double real)
    {
        if (theo <= 0)
            return "#9ca3af";
        if (real > theo * 1.1)
            return "#c44440";
        if (real < theo * 0.9)
            return "#345f6d";
        return "#9ca3af";
    }

    private static string CouleurCategorie(string cle) => cle switch
    {
        "sommeil" => "#4a3f6b",
        "perso" => "#345f6d",
        "pro" => "#1e6b4a",
        "admin" => "#7a5c1e",
        "famille" => "#7a3f2d",
        "social" => "#3d4f8a",
        _ => "#6b5248",
    };

    private void GoPlanification() =>
        NavigationManager.NavigateTo(Href("/gestion-du-temps/kanban"));

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        try
        {
            // destroyIf ignore les appels retardés d'une instance précédente (évite d'effacer
            // les graphiques du moniteur au retour depuis le kanban).
            _ = JS.InvokeVoidAsync("gdtCharts.destroyIf", _chartGeneration);
        }
        catch
        {
            /* ignore */
        }
    }
}
