@page "/gestion-du-temps/synthese"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Modules.GestionDuTemps.Entities
@using Spectrometre.Modules.GestionDuTemps.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IGestionDuTempsService GdtService
@inject IGestionDuTempsAccessService AccessService
@inject IStringLocalizer<GestionDuTempsResource> Localizer

<PageTitle>@Localizer["SyntheseTitle"]</PageTitle>

<h1>@Localizer["SyntheseDuCycle"]</h1>
<p class="hint">
    @Localizer["Synthese_IntroDebut"] <a href="/gestion-du-temps/profil">@Localizer["Synthese_IntroMilieu1"]</a>@Localizer["Synthese_IntroMilieu2"]
    <a href="/gestion-du-temps/reflexion">@Localizer["Synthese_IntroMilieu3"]</a> @Localizer["Synthese_IntroFin"]
    <a href="/gestion-du-temps">@Localizer["NavRetourAuxRituels"]</a>.
</p>

@if (_userId is null)
{
    <p>@Localizer["Chargement"]</p>
}
else if (!_hasAccess)
{
    <p class="hint">@Localizer["ModuleNonActive"]</p>
}
else
{
    <button @onclick="GenererAsync" disabled="@_generationEnCours">
        @(_synthese is null ? Localizer["GenererLaSynthese"] : Localizer["RegenererLaSynthese"])
    </button>
    @if (_generationEnCours)
    {
        <p class="hint">@Localizer["GenerationEnCours"]</p>
    }

    @if (_erreur is not null)
    {
        <p class="erreur">@_erreur</p>
    }

    @if (_synthese is not null)
    {
        <div class="gdt-synthese">
            @if (_synthese.GenereeParIa)
            {
                <p class="gdt-tag-ia">@Localizer["SyntheseGintIa"]</p>
            }
            else
            {
                <p class="gdt-tag-repli">@Localizer["SyntheseRepli"]</p>
            }

            <h3>@Localizer["Profil"] : @SyntheseProfilTypeLabels.Display(_synthese.ProfilType, _english)</h3>
            @if (!string.IsNullOrWhiteSpace(_synthese.ProfilTexte))
            {
                <p>@_synthese.ProfilTexte</p>
            }

            <div class="gdt-indicateurs">
                <div><strong>@Localizer["IndiceDEquilibre"]</strong> : @_synthese.IndiceEquilibre / 100</div>
                @if (!string.IsNullOrWhiteSpace(_synthese.IndiceCommentaire))
                {
                    <p>@_synthese.IndiceCommentaire</p>
                }
                <div><strong>@Localizer["NiveauDeMaturiteOrganisationnelle"]</strong> : @_synthese.NiveauMaturite / 5</div>
                @if (!string.IsNullOrWhiteSpace(_synthese.MaturiteCommentaire))
                {
                    <p>@_synthese.MaturiteCommentaire</p>
                }
            </div>

            @if (_synthese.Recommandations.Count > 0)
            {
                <h4>@Localizer["Recommandations"]</h4>
                <ul>
                    @foreach (var reco in _synthese.Recommandations.OrderBy(r => r.Priorite))
                    {
                        <li><strong>[@DomaineLabel(reco.Domaine)]</strong> @reco.Texte</li>
                    }
                </ul>
            }

            @if (_synthese.Alertes.Count > 0)
            {
                <h4>@Localizer["PointsDAttention"]</h4>
                <ul>
                    @foreach (var alerte in _synthese.Alertes)
                    {
                        <li>@alerte</li>
                    }
                </ul>
            }

            <p class="gdt-date">@string.Format(Localizer["CalculeeLe"].Value, _synthese.CalculatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</p>
        </div>
    }
    else if (!_generationEnCours)
    {
        <p class="hint">@Localizer["AucuneSyntheseHint"]</p>
    }
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _userId;
    private bool _hasAccess;
    private bool _generationEnCours;
    private string? _erreur;
    private SyntheseView? _synthese;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    /// <summary>"organisation" n'est pas une clé de <see cref="TypeDeTemps"/> (ce n'est pas une vraie catégorie de temps) : traduite séparément, les 6 autres domaines réutilisent <see cref="DefaultCategoryLabels"/> avec le domaine comme clé ET repli (déjà en minuscule canonique, ex. "pro"/"perso").</summary>
    private string DomaineLabel(string domaine) =>
        domaine == "organisation" ? Localizer["DomaineOrganisation"] : DefaultCategoryLabels.Display(domaine, domaine, _english);

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _userId = userId;
        _hasAccess = await AccessService.HasAccessAsync(userId);
        if (!_hasAccess)
            return;

        _synthese = await GdtService.GetSyntheseAsync(userId);
    }

    private async Task GenererAsync()
    {
        _generationEnCours = true;
        _erreur = null;
        StateHasChanged();
        try
        {
            _synthese = await GdtService.GenererSyntheseAsync(_userId!);
        }
        catch (Exception ex)
        {
            // Ne devrait normalement jamais arriver (IAiSynthesisService ne lève pas) — filet de sécurité
            // pour toute autre erreur inattendue (ex. base de données), toujours avec un message clair.
            _erreur = string.Format(Localizer["ImpossibleDeGenererLaSynthese"].Value, ex.Message);
        }
        finally
        {
            _generationEnCours = false;
        }
    }
}
