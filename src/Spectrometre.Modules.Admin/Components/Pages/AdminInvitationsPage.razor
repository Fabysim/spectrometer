@page "/admin/invitations"
@attribute [Authorize(Roles = PlatformRoles.Admin)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IAdminService AdminService
@inject IStringLocalizer<AdminResource> Localizer

<PageTitle>@Localizer["AdminInvitationsTitle"]</PageTitle>

<div class="admin-page">
    <header class="admin-header">
        <div>
            <h1 class="admin-title">@Localizer["AdminNavInvitations"]</h1>
            <p class="admin-subtitle">@Localizer["AdminInvitationsTitle"]</p>
        </div>
    </header>

    <AdminListSearch Barre="@_recherche" OnSearch="OnSearchAsync" />

    @if (_invitations is null)
    {
        <p class="admin-state">@Localizer["Chargement"]</p>
    }
    else if (_totalCount == 0)
    {
        <section class="admin-card">
            <p class="admin-hint">@Localizer["AucuneInvitation"]</p>
        </section>
    }
    else
    {
        <section class="admin-card admin-table-card">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@Localizer["ColEmetteur"]</th>
                            <th>@Localizer["ColEmailInvite"]</th>
                            <th>@Localizer["ColType"]</th>
                            <th>@Localizer["ColStatut"]</th>
                            <th>@Localizer["ColDateCreation"]</th>
                            <th>@Localizer["ColExpiration"]</th>
                            <th>@Localizer["ColAcceptee"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in _invitations)
                        {
                            <tr>
                                <td>@i.EmetteurEmail</td>
                                <td>@i.EmailInvite</td>
                                <td>@i.Type</td>
                                <td><span class="admin-badge @StatutClass(i.Statut)">@i.Statut</span></td>
                                <td>@i.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>@i.ExpireLe.ToString("yyyy-MM-dd")</td>
                                <td>@(i.AccepteeLe?.ToString("yyyy-MM-dd") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <PaginationControls Page="_page" PageSize="_pageSize" TotalCount="_totalCount" OnChange="OnPagingChanged" />
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private int _page = 1;
    private int _pageSize = AdminPaging.DefaultPageSize;
    private int _totalCount;
    private string? _recherche;
    private IReadOnlyList<AdminInvitationSummary>? _invitations;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static string StatutClass(string statut) => statut switch
    {
        nameof(Spectrometre.Core.Invitations.InvitationStatus.EnAttente) => "is-pending",
        nameof(Spectrometre.Core.Invitations.InvitationStatus.Acceptee) => "is-active",
        nameof(Spectrometre.Core.Invitations.InvitationStatus.Expiree) => "is-expired",
        nameof(Spectrometre.Core.Invitations.InvitationStatus.Revoquee) => "is-inactive",
        _ => "is-neutral"
    };

    private async Task LoadAsync()
    {
        var caller = AuthenticationStateTask is null ? new ClaimsPrincipal() : (await AuthenticationStateTask).User;
        var result = await AdminService.GetInvitationsAsync(caller, _page, _pageSize, _recherche);
        _invitations = result.Items;
        _totalCount = result.TotalCount;
        _page = result.Page;
        _pageSize = result.PageSize;
    }

    private async Task OnSearchAsync(string? term)
    {
        _recherche = term;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPagingChanged((int page, int pageSize) args)
    {
        _page = args.page;
        _pageSize = args.pageSize;
        await LoadAsync();
    }
}
