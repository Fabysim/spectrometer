@page "/admin/candidats"
@attribute [Authorize(Roles = PlatformRoles.Admin)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IAdminService AdminService
@inject IStringLocalizer<AdminResource> Localizer

<PageTitle>@Localizer["AdminCandidatsTitle"]</PageTitle>

<div class="admin-page">
    <header class="admin-header">
        <div>
            <h1 class="admin-title">@Localizer["AdminNavCandidats"]</h1>
            <p class="admin-subtitle">@Localizer["AdminCandidatsTitle"]</p>
        </div>
    </header>

    <AdminListSearch Barre="@_recherche" OnSearch="OnSearchAsync" />

    @if (_candidats is null)
    {
        <p class="admin-state">@Localizer["Chargement"]</p>
    }
    else if (_totalCount == 0)
    {
        <section class="admin-card">
            <p class="admin-hint">@Localizer["AucunCandidat"]</p>
        </section>
    }
    else
    {
        <section class="admin-card admin-table-card">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@Localizer["ColEmail"]</th>
                            <th>@Localizer["ColStatutAbonnement"]</th>
                            <th>@Localizer["ColPlan"]</th>
                            <th>@Localizer["ColModulesActifs"]</th>
                            <th>@Localizer["ColDateCreation"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _candidats)
                        {
                            <tr>
                                <td>@(c.Email ?? "—")</td>
                                <td>@c.StatutAbonnement</td>
                                <td>@(c.PlanCode ?? "—")</td>
                                <td>@string.Join(", ", c.ModulesActifs)</td>
                                <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td><a href="@($"/admin/sujets/Candidate/{c.CandidateProfileId}/modules")">@Localizer["AdminModulesTitre"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <PaginationControls Page="_page" PageSize="_pageSize" TotalCount="_totalCount" OnChange="OnPagingChanged" />
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private int _page = 1;
    private int _pageSize = AdminPaging.DefaultPageSize;
    private int _totalCount;
    private string? _recherche;
    private IReadOnlyList<AdminCandidateSummary>? _candidats;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var caller = AuthenticationStateTask is null ? new ClaimsPrincipal() : (await AuthenticationStateTask).User;
        var result = await AdminService.GetCandidatsAsync(caller, _page, _pageSize, _recherche);
        _candidats = result.Items;
        _totalCount = result.TotalCount;
        _page = result.Page;
        _pageSize = result.PageSize;
    }

    private async Task OnSearchAsync(string? term)
    {
        _recherche = term;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPagingChanged((int page, int pageSize) args)
    {
        _page = args.page;
        _pageSize = args.pageSize;
        await LoadAsync();
    }
}
