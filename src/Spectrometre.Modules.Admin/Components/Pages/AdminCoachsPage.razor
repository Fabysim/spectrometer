@page "/admin/coachs"
@attribute [Authorize(Roles = PlatformRoles.Admin)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IAdminService AdminService
@inject IStringLocalizer<AdminResource> Localizer

<PageTitle>@Localizer["AdminCoachsTitle"]</PageTitle>

<div class="admin-page">
    <header class="admin-header">
        <div>
            <h1 class="admin-title">@Localizer["AdminNavCoachs"]</h1>
            <p class="admin-subtitle">@Localizer["AdminCoachsTitle"]</p>
        </div>
    </header>

    @if (_coachs is null)
    {
        <p class="admin-state">@Localizer["Chargement"]</p>
    }
    else if (_coachs.Count == 0)
    {
        <section class="admin-card">
            <p class="admin-hint">@Localizer["AucunCoach"]</p>
        </section>
    }
    else
    {
        <section class="admin-card admin-table-card">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@Localizer["ColNomAffiche"]</th>
                            <th>@Localizer["ColEmail"]</th>
                            <th>@Localizer["ColVisibleAnnuaire"]</th>
                            <th>@Localizer["ColNombreSuivis"]</th>
                            <th>@Localizer["ColDateCreation"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _coachs)
                        {
                            <tr>
                                <td>@c.NomAffiche</td>
                                <td>@(c.Email ?? "—")</td>
                                <td>@(c.VisibleDansAnnuaire ? Localizer["Oui"] : Localizer["Non"])</td>
                                <td>@c.NombrePersonnesSuivies</td>
                                <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<AdminCoachSummary>? _coachs;

    protected override async Task OnInitializedAsync()
    {
        var caller = AuthenticationStateTask is null ? new ClaimsPrincipal() : (await AuthenticationStateTask).User;
        _coachs = await AdminService.GetCoachsAsync(caller);
    }
}
