@page "/admin/entreprises"
@attribute [Authorize(Roles = PlatformRoles.Admin)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IAdminService AdminService
@inject IStringLocalizer<AdminResource> Localizer

<PageTitle>@Localizer["AdminEntreprisesTitle"]</PageTitle>

<div class="admin-page">
    <header class="admin-header">
        <div>
            <h1 class="admin-title">@Localizer["AdminNavEntreprises"]</h1>
            <p class="admin-subtitle">@Localizer["AdminEntreprisesTitle"]</p>
        </div>
    </header>

    @if (_entreprises is null)
    {
        <p class="admin-state">@Localizer["Chargement"]</p>
    }
    else if (_entreprises.Count == 0)
    {
        <section class="admin-card">
            <p class="admin-hint">@Localizer["AucuneEntreprise"]</p>
        </section>
    }
    else
    {
        <section class="admin-card admin-table-card">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@Localizer["ColNom"]</th>
                            <th>@Localizer["ColProprietaire"]</th>
                            <th>@Localizer["ColStatutAbonnement"]</th>
                            <th>@Localizer["ColPlan"]</th>
                            <th>@Localizer["ColModulesActifs"]</th>
                            <th>@Localizer["ColDateCreation"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _entreprises)
                        {
                            <tr>
                                <td>@e.Name</td>
                                <td>@(e.OwnerEmail ?? "—")</td>
                                <td>@e.StatutAbonnement</td>
                                <td>@e.PlanCode</td>
                                <td>@string.Join(", ", e.ModulesActifs)</td>
                                <td>@e.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td><a href="@($"/admin/sujets/Company/{e.Id}/modules")">@Localizer["AdminModulesTitre"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<AdminCompanySummary>? _entreprises;

    protected override async Task OnInitializedAsync()
    {
        var caller = AuthenticationStateTask is null ? new ClaimsPrincipal() : (await AuthenticationStateTask).User;
        _entreprises = await AdminService.GetEntreprisesAsync(caller);
    }
}
