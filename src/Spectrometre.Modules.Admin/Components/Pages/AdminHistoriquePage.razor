@page "/admin/historique"
@attribute [Authorize(Roles = PlatformRoles.Admin)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IAdminService AdminService
@inject IStringLocalizer<AdminResource> Localizer

<PageTitle>@Localizer["AdminHistoriqueTitre"]</PageTitle>

<div class="admin-page">
    <header class="admin-header">
        <div>
            <h1 class="admin-title">@Localizer["AdminHistoriqueTitre"]</h1>
            <p class="admin-subtitle">@Localizer["AdminHistoriqueLead"]</p>
        </div>
    </header>

    @if (_entries is null)
    {
        <p class="admin-state">@Localizer["Chargement"]</p>
    }
    else if (_totalCount == 0)
    {
        <section class="admin-card">
            <p class="admin-hint">@Localizer["AdminHistoriqueAucuneEntree"]</p>
        </section>
    }
    else
    {
        <section class="admin-card admin-table-card">
            <div class="admin-section-head admin-section-head-pad">
                <div class="admin-card-icon tone-primary" aria-hidden="true">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h2 class="admin-section-title">@Localizer["AdminHistoriqueTitre"]</h2>
                    <p class="admin-section-meta">@_totalCount @Localizer["AdminHistoriqueEntrees"]</p>
                </div>
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@Localizer["ColEmail"]</th>
                            <th>@Localizer["AdminHistoriqueAction"]</th>
                            <th>@Localizer["AdminHistoriqueCible"]</th>
                            <th>@Localizer["ColDateCreation"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr>
                                <td>
                                    <span class="admin-email">@entry.AdminEmail</span>
                                </td>
                                <td>
                                    <span class="admin-action-pill @ActionTone(entry.Action)">@entry.Action</span>
                                </td>
                                <td>
                                    <span class="admin-cible">@entry.Cible</span>
                                </td>
                                <td class="admin-date">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <PaginationControls Page="_page" PageSize="_pageSize" TotalCount="_totalCount" OnChange="OnPagingChanged" />
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private int _page = 1;
    private int _pageSize = AdminPaging.DefaultPageSize;
    private int _totalCount;
    private IReadOnlyList<AdminAuditEntryView>? _entries;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var caller = AuthenticationStateTask is null ? new ClaimsPrincipal() : (await AuthenticationStateTask).User;
        var result = await AdminService.GetHistoriqueAsync(caller, _page, _pageSize);
        _entries = result.Items;
        _totalCount = result.TotalCount;
        _page = result.Page;
        _pageSize = result.PageSize;
    }

    private async Task OnPagingChanged((int page, int pageSize) args)
    {
        _page = args.page;
        _pageSize = args.pageSize;
        await LoadAsync();
    }

    private static string ActionTone(string action)
    {
        if (action.Contains("Suspend", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Retrait", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Retrograd", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Desactiv", StringComparison.OrdinalIgnoreCase))
            return "tone-danger";
        if (action.Contains("Activ", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Ajout", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Promouv", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Enregistrer", StringComparison.OrdinalIgnoreCase)
            || action.Contains("Set", StringComparison.OrdinalIgnoreCase))
            return "tone-success";
        return "tone-neutral";
    }
}
