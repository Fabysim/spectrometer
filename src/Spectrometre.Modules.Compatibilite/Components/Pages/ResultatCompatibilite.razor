@page "/compatibilite/resultat/{CandidateProfileId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Compatibility
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.Compatibilite.Entities
@using Spectrometre.Modules.Compatibilite.Resources
@using Spectrometre.Modules.Compatibilite.Services
@using Spectrometre.Modules.ProfilEntreprise.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICompatibiliteService CompatibiliteService
@inject ICompanyProfileService CompanyProfileService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<CompatibiliteResource> Localizer

<PageTitle>@Localizer["ResultatCompatibilite"]</PageTitle>

<div class="compat-page">
@if (!_resolu)
{
    <p class="compat-state">@Localizer["CalculEnCours"]</p>
}
else if (_result is null)
{
    @* Réponse volontairement générique : ne jamais confirmer à un tiers qu'un résultat existe pour cet
       identifiant candidat s'il n'y a pas droit — voir CompatibiliteService.GetResultatAutorisePourUtilisateurAsync. *@
    <section class="compat-card compat-empty">
        <p class="compat-hint">@Localizer["ResultatIntrouvable"]</p>
    </section>
}
else
{
    <header class="compat-header">
        <div>
            <h1 class="compat-title">@Localizer["ResultatCompatibilite"]</h1>
            <p class="compat-subtitle">@Localizer["ScoreGlobal"]</p>
        </div>
    </header>

    <div class="compat-layout">
        <section class="compat-card compat-score-card">
            @{
                var circumference = 2 * Math.PI * 80;
                var offset = circumference * (1 - _result.ScoreGlobal / 100.0);
            }
            <div class="compat-score-ring" aria-hidden="true">
                <svg viewBox="0 0 200 200" width="180" height="180">
                    <circle cx="100" cy="100" r="80" fill="none" stroke="#e2e8f0" stroke-width="18" />
                    <circle cx="100" cy="100" r="80" fill="none" stroke="url(#compatScoreGrad)" stroke-width="18"
                            stroke-dasharray="@circumference.ToString(CultureInfo.InvariantCulture)"
                            stroke-dashoffset="@offset.ToString(CultureInfo.InvariantCulture)"
                            stroke-linecap="round" transform="rotate(-90 100 100)" />
                    <defs>
                        <linearGradient id="compatScoreGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#345f6d" />
                            <stop offset="100%" stop-color="hsl(18, 80%, 54%)" />
                        </linearGradient>
                    </defs>
                    <text x="100" y="96" text-anchor="middle" font-size="36" font-weight="800" fill="#0f172a">@(_result.ScoreGlobal)%</text>
                    <text x="100" y="120" text-anchor="middle" font-size="12" font-weight="600" fill="#64748b">@Localizer["Compatibilite"]</text>
                </svg>
            </div>
            <p class="compat-score-label">@Localizer["ScoreGlobal"]</p>
        </section>

        <section class="compat-card compat-axes-card">
            <h2 class="compat-bloc-title">@Localizer["CompatibilitesParAxe"]</h2>
            @foreach (var axisScore in _result.ScoresParAxe)
            {
                <div class="barre-ligne">
                    <span class="barre-libelle">@CompatibilityAxisLabels.Label(axisScore.Axis, _english)</span>
                    <div class="barre-piste">
                        <div class="barre-remplissage" style="width:@(axisScore.Score)%"></div>
                    </div>
                    <span class="barre-valeur">@(axisScore.Score)%</span>
                </div>
            }

            @if (_result.PointsDeVigilance.Count > 0)
            {
                <div class="compat-vigilance">
                    <h3 class="compat-vigilance-title">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        @Localizer["PointsDeVigilance"]
                    </h3>
                    <ul class="compat-vigilance-liste">
                        @foreach (var point in _result.PointsDeVigilance)
                        {
                            <li>@CompatibilityVocabulary.DisplayTag(point, _english)</li>
                        }
                    </ul>
                </div>
            }
        </section>
    </div>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int CandidateProfileId { get; set; }

    private bool _resolu;
    private CompatibiliteResultView? _result;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    protected override async Task OnInitializedAsync()
    {
        var userId = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            : null;

        if (string.IsNullOrEmpty(userId))
        {
            _resolu = true;
            return;
        }

        // Résout une entreprise active si ce n'est pas déjà fait dans ce circuit (ex. accès direct à cette
        // page sans passer d'abord par /entreprise/profil) — simple confort d'navigation : la décision
        // d'autorisation elle-même est prise par CompatibiliteService, qui recherche au besoin PARMI TOUTES
        // les entreprises gérées par l'utilisateur, pas seulement celle-ci.
        if (TenantContext.ActiveCompanyId is null)
        {
            var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb);
            if (companies.Count > 0)
                TenantContext.SetActiveCompany(companies[0].Id, companies[0].SchemaName);
        }

        // Garde de confidentialité : ne renvoie un résultat que si l'utilisateur est le candidat concerné,
        // ou gère une entreprise pour laquelle une candidature réelle existe pour ce candidat — null dans
        // tous les autres cas (voir CompatibiliteService.GetResultatAutorisePourUtilisateurAsync).
        _result = await CompatibiliteService.GetResultatAutorisePourUtilisateurAsync(CandidateProfileId, userId);
        _resolu = true;
    }
}
