@page "/compatibilite/resultat/{CandidateProfileId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.Compatibilite.Entities
@using Spectrometre.Modules.Compatibilite.Services
@using Spectrometre.Modules.ProfilEntreprise.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICompatibiliteService CompatibiliteService
@inject ICompanyProfileService CompanyProfileService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb

<PageTitle>Résultat de compatibilité</PageTitle>

@if (_result is null)
{
    <p>Calcul en cours…</p>
}
else
{
    <div class="resultat-compatibilite">
        <div class="score-global">
            @{
                var circumference = 2 * Math.PI * 80;
                var offset = circumference * (1 - _result.ScoreGlobal / 100.0);
            }
            <svg viewBox="0 0 200 200" width="200" height="200">
                <circle cx="100" cy="100" r="80" fill="none" stroke="#e6e6e6" stroke-width="20" />
                <circle cx="100" cy="100" r="80" fill="none" stroke="#3a8a5a" stroke-width="20"
                        stroke-dasharray="@circumference.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        stroke-dashoffset="@offset.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        stroke-linecap="round" transform="rotate(-90 100 100)" />
                <text x="100" y="95" text-anchor="middle" font-size="34" font-weight="bold">@(_result.ScoreGlobal)%</text>
                <text x="100" y="120" text-anchor="middle" font-size="12">compatibilité</text>
            </svg>
            <p class="score-label">SCORE GLOBAL</p>
        </div>

        <div class="scores-par-axe">
            <h3>COMPATIBILITÉ PAR AXE</h3>
            @foreach (var axisScore in _result.ScoresParAxe)
            {
                <div class="axe-row">
                    <span class="axe-nom">@CompatibilityAxisLabels.Label(axisScore.Axis)</span>
                    <div class="barre">
                        <div class="barre-remplie" style="width:@(axisScore.Score)%"></div>
                    </div>
                    <span class="axe-score">@(axisScore.Score)%</span>
                </div>
            }

            @if (_result.PointsDeVigilance.Count > 0)
            {
                <div class="points-vigilance">
                    <strong>POINTS DE VIGILANCE</strong>
                    <ul>
                        @foreach (var point in _result.PointsDeVigilance)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int CandidateProfileId { get; set; }

    private CompatibiliteResultView? _result;

    protected override async Task OnInitializedAsync()
    {
        // Résout l'entreprise active si ce n'est pas déjà fait dans ce circuit (ex. accès direct à cette
        // page sans passer d'abord par /entreprise/profil) — même logique que ProfilEntreprisePage.
        if (TenantContext.ActiveCompanyId is null)
        {
            var userId = AuthenticationStateTask is not null
                ? (await AuthenticationStateTask).User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                : null;

            if (string.IsNullOrEmpty(userId))
                return;

            var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb);
            if (companies.Count == 0)
                return;

            TenantContext.SetActiveCompany(companies[0].Id, companies[0].SchemaName);
        }

        var companyProfileId = await CompanyProfileService.GetOrCreateProfileIdAsync();
        _result = await CompatibiliteService.CalculerCompatibiliteAsync(CandidateProfileId, companyProfileId);
    }
}
