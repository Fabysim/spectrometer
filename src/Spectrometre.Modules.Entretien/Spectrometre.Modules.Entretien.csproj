         de compatibilité déjà calculé (et son accès déjà autorisé, voir EntretienService). -->
    <ProjectReference Include="..\Spectrometre.Core\Spectrometre.Core.csproj" />
    <ProjectReference Include="..\Spectrometre.Modules.Compatibilite\Spectrometre.Modules.Compatibilite.csproj" />
  </ItemGroup>

</Project>
