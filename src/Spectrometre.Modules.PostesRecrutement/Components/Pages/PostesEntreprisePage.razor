@page "/entreprise/postes"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.PostesRecrutement.Entities
@using Spectrometre.Modules.PostesRecrutement.Resources
@using Spectrometre.Modules.PostesRecrutement.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IPosteService PosteService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject IStringLocalizer<PostesRecrutementResource> Localizer

<PageTitle>@Localizer["PostesRecrutement"]</PageTitle>

<div class="postes-page">
@if (_companies is null)
{
    <p class="postes-state">@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["AucuneEntrepriseAssociee"]</p>
    </section>
}
else
{
    <header class="postes-header">
        <div>
            <h1 class="postes-title">@Localizer["PostesRecrutement"]</h1>
            <p class="postes-subtitle">
                @if (_companies.Count == 1)
                {
                    @_companies[0].Name
                }
                else
                {
                    @Localizer["EntrepriseActive"]
                }
            </p>
        </div>
        @if (_companies.Count > 1)
        {
            <div class="postes-company-select">
                <label for="postes-active">@Localizer["EntrepriseActive"]</label>
                <select id="postes-active" value="@_selectedCompanyId" @onchange="OnCompanyChangedAsync">
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
        }
    </header>

    <section class="postes-card postes-form-card">
        <div class="postes-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-briefcase"></i>
        </div>
        <h2 class="postes-section-title">@Localizer["NouveauPoste"]</h2>
        <div class="postes-form">
            <div class="postes-field">
                <label for="poste-titre">@Localizer["Titre"]</label>
                <input id="poste-titre" class="postes-input" @bind="_nouveauTitre" @bind:event="oninput" placeholder="@Localizer["Titre"]" />
            </div>
            <div class="postes-field">
                <label for="poste-dept">@Localizer["Departement"]</label>
                <input id="poste-dept" class="postes-input" @bind="_nouveauDepartement" @bind:event="oninput" placeholder="@Localizer["Departement"]" />
            </div>
            <div class="postes-field">
                <label for="poste-desc">@Localizer["Description"]</label>
                <textarea id="poste-desc" class="postes-input postes-textarea" @bind="_nouvelleDescription" @bind:event="oninput" rows="3" placeholder="@Localizer["Description"]"></textarea>
            </div>
            <div class="postes-form-actions">
                <button type="button" class="postes-btn-primary" @onclick="CreerPosteAsync" disabled="@string.IsNullOrWhiteSpace(_nouveauTitre)">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    @Localizer["CreerLePoste"]
                </button>
            </div>
        </div>
    </section>

    @if (_postes is not null)
    {
        <section class="postes-liste">
            <h2 class="postes-liste-title">@Localizer["PostesDeLEntreprise"]</h2>
            @if (_postes.Count == 0)
            {
                <p class="postes-hint">@Localizer["AucunPosteCree"]</p>
            }
            else
            {
                <div class="postes-grid">
                    @foreach (var poste in _postes)
                    {
                        <article class="postes-card poste-carte @(_posteIdOuvert == poste.Id ? "is-expanded" : "") @(poste.Statut == PosteStatut.Ferme ? "is-closed" : "")">
                            <div class="poste-entete">
                                <div class="poste-entete-main">
                                    <h3 class="poste-titre">@poste.Titre</h3>
                                    <span class="statut @(poste.Statut == PosteStatut.Ouvert ? "ouvert" : "ferme")">
                                        @PosteStatutLabels.Label(poste.Statut, _english)
                                    </span>
                                </div>
                                <div class="poste-actions">
                                    <button type="button" class="postes-btn-secondary" @onclick="() => ToggleStatutAsync(poste)">
                                        @(poste.Statut == PosteStatut.Ouvert ? Localizer["Fermer"] : Localizer["Rouvrir"])
                                    </button>
                                    <button type="button" class="postes-btn-ghost" @onclick="() => ToggleCandidaturesAsync(poste.Id)">
                                        <i class="bi @(_posteIdOuvert == poste.Id ? "bi-chevron-up" : "bi-people")" aria-hidden="true"></i>
                                        @(_posteIdOuvert == poste.Id ? Localizer["MasquerLesCandidatures"] : Localizer["VoirLesCandidatures"])
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(poste.Departement))
                            {
                                <p class="poste-departement">
                                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                                    @poste.Departement
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(poste.Description))
                            {
                                <p class="poste-description">@poste.Description</p>
                            }

                            @if (_posteIdOuvert == poste.Id)
                            {
                                <div class="candidatures">
                                    <h4 class="candidatures-title">@Localizer["VoirLesCandidatures"]</h4>
                                    @if (_candidatures is null)
                                    {
                                        <p class="postes-hint">@Localizer["ChargementDesCandidatures"]</p>
                                    }
                                    else if (_candidatures.Count == 0)
                                    {
                                        <p class="postes-hint">@Localizer["AucuneCandidaturePourPoste"]</p>
                                    }
                                    else
                                    {
                                        <div class="candidatures-table-wrap">
                                            <table class="candidatures-table">
                                                <thead>
                                                    <tr>
                                                        <th>@Localizer["CandidatProfil"]</th>
                                                        <th>@Localizer["Statut"]</th>
                                                        <th>@Localizer["Compatibilite"]</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var candidature in _candidatures)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="candidat-id">#@candidature.CandidateProfileId</span>
                                                            </td>
                                                            <td>
                                                                <select class="postes-select" value="@candidature.Statut" @onchange="e => ChangerStatutCandidatureAsync(candidature.Id, e.Value)">
                                                                    @foreach (var statut in Enum.GetValues<CandidatureStatut>())
                                                                    {
                                                                        <option value="@statut">@CandidatureStatutLabels.Label(statut, _english)</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                @if (candidature.ScoreCompatibilite is int score)
                                                                {
                                                                    <span class="score-badge">@score%</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="score-empty">—</span>
                                                                }
                                                            </td>
                                                            <td class="candidature-links">
                                                                @if (candidature.ScoreCompatibilite is not null)
                                                                {
                                                                    <a href="@($"/compatibilite/resultat/{candidature.CandidateProfileId}")">@Localizer["Detail"]</a>
                                                                    <a href="@($"/entretien/{candidature.CandidateProfileId}")">@Localizer["PreparerLEntretien"]</a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Company>? _companies;
    private int _selectedCompanyId;
    private List<PosteView>? _postes;
    private int? _posteIdOuvert;
    private List<CandidatureView>? _candidatures;

    private string _nouveauTitre = "";
    private string? _nouveauDepartement;
    private string? _nouvelleDescription;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb)).ToList();
        if (_companies.Count > 0)
            await ActivateCompanyAsync(_companies[0]);
    }

    private async Task ActivateCompanyAsync(Company company)
    {
        _selectedCompanyId = company.Id;
        _posteIdOuvert = null;
        _candidatures = null;
        TenantContext.SetActiveCompany(company.Id, company.SchemaName);
        _postes = (await PosteService.GetPostesAsync()).ToList();
    }

    private async Task OnCompanyChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var company = _companies!.First(c => c.Id == id);
            await ActivateCompanyAsync(company);
        }
    }

    private async Task CreerPosteAsync()
    {
        if (string.IsNullOrWhiteSpace(_nouveauTitre)) return;

        await PosteService.CreatePosteAsync(_nouveauTitre, _nouvelleDescription, _nouveauDepartement);
        _nouveauTitre = "";
        _nouveauDepartement = null;
        _nouvelleDescription = null;
        _postes = (await PosteService.GetPostesAsync()).ToList();
    }

    private async Task ToggleStatutAsync(PosteView poste)
    {
        var nouveauStatut = poste.Statut == PosteStatut.Ouvert ? PosteStatut.Ferme : PosteStatut.Ouvert;
        await PosteService.SetPosteStatutAsync(poste.Id, nouveauStatut);
        _postes = (await PosteService.GetPostesAsync()).ToList();
    }

    private async Task ToggleCandidaturesAsync(int posteId)
    {
        if (_posteIdOuvert == posteId)
        {
            _posteIdOuvert = null;
            _candidatures = null;
            return;
        }

        _posteIdOuvert = posteId;
        _candidatures = null;
        _candidatures = (await PosteService.GetCandidaturesAsync(posteId)).ToList();
    }

    private async Task ChangerStatutCandidatureAsync(int candidatureId, object? value)
    {
        if (value is not null && Enum.TryParse<CandidatureStatut>(value.ToString(), out var statut))
        {
            await PosteService.SetCandidatureStatutAsync(candidatureId, statut);
            if (_posteIdOuvert is int posteId)
                _candidatures = (await PosteService.GetCandidaturesAsync(posteId)).ToList();
        }
    }
}
