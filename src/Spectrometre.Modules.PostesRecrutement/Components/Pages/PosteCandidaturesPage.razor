@page "/entreprise/postes/{PosteId:int}/candidats"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Identity
@using Spectrometre.Core.Compatibility
@using Spectrometre.Core.Data
@using Spectrometre.Core.Directory
@using Spectrometre.Core.Identity
@using Spectrometre.Core.Modules
@using Spectrometre.Core.Tenancy
@using Spectrometre.Modules.PostesRecrutement.Entities
@using Spectrometre.Modules.PostesRecrutement.Resources
@using Spectrometre.Modules.PostesRecrutement.Services
@using Spectrometre.Modules.ProfilCandidat.Services
@using Spectrometre.Modules.Vivier.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IPosteService PosteService
@inject IVivierService VivierService
@inject IModuleRegistry ModuleRegistry
@inject ICandidateProfileService CandidateProfileService
@inject ICandidateDirectoryService CandidateDirectory
@inject UserManager<ApplicationUser> UserManager
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ITenantContext TenantContext
@inject CoreDbContext CoreDb
@inject NavigationManager Navigation
@inject IStringLocalizer<PostesRecrutementResource> Localizer

<PageTitle>@(_poste?.Titre ?? Localizer["CandidaturesDuPoste"].Value)</PageTitle>

<div class="postes-page">
@if (_loading)
{
    <p class="postes-state">@Localizer["Chargement"]</p>
}
else if (_companies.Count == 0)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["AucuneEntrepriseAssociee"]</p>
    </section>
}
else if (_poste is null)
{
    <section class="postes-card postes-empty">
        <p class="postes-hint">@Localizer["PosteIntrouvable"]</p>
        <a href="/entreprise/postes" class="postes-btn-ghost">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @Localizer["RetourAuxPostes"]
        </a>
    </section>
}
else
{
    <header class="postes-header">
        <div>
            <nav class="postes-breadcrumb" aria-label="breadcrumb">
                <a href="/entreprise/postes">@Localizer["RetourAuxPostes"]</a>
                <span class="postes-breadcrumb-sep" aria-hidden="true">/</span>
                <span>@_poste.Titre</span>
            </nav>
            <h1 class="postes-title">@Localizer["CandidaturesDuPoste"]</h1>
            <p class="postes-subtitle">@_poste.Titre</p>
        </div>
        <div class="postes-header-actions">
            <a href="@($"/entreprise/postes/{PosteId}/profil")" class="postes-btn-ghost">
                <i class="bi bi-list-check" aria-hidden="true"></i>
                @Localizer["ProfilDuPoste"]
            </a>
            <a href="@($"/entreprise/postes/{PosteId}/guide-entrevue")" class="postes-btn-ghost">
                <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                @Localizer["GuideDeuxiemeEntrevue"]
            </a>
            <a href="@($"/entreprise/postes/{PosteId}/selection")" class="postes-btn-ghost">
                <i class="bi bi-ui-checks" aria-hidden="true"></i>
                @Localizer["SelectionDesCandidats"]
            </a>
        </div>
    </header>

    <div class="postes-invite-layout">
        <section class="postes-card postes-form-card">
            <div class="postes-card-icon tone-primary" aria-hidden="true">
                <i class="bi bi-person-plus"></i>
            </div>
            <h2 class="postes-section-title">@Localizer["NouveauCandidat"]</h2>
            <div class="postes-form postes-form-invite">
                <div class="postes-field">
                    <label for="invite-email">@Localizer["EmailCandidat"]</label>
                    <input id="invite-email"
                           type="email"
                           class="postes-input"
                           @bind="_emailInvitation"
                           placeholder="nom@exemple.com" />
                </div>
                @if (!string.IsNullOrEmpty(_inviteError))
                {
                    <div class="postes-alert postes-alert-error" role="alert">@_inviteError</div>
                }
                @if (!string.IsNullOrEmpty(_inviteMessage))
                {
                    <div class="postes-alert postes-alert-success" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @_inviteMessage
                    </div>
                }
                @if (_lienInvitation is not null)
                {
                    <div class="postes-alert postes-alert-success" role="status">
                        <p class="postes-invite-label">
                            <i class="bi bi-link-45deg" aria-hidden="true"></i>
                            @Localizer["LienDInvitationGenere"]
                        </p>
                        <code class="postes-invite-link">@_lienInvitation</code>
                    </div>
                }
                <div class="postes-form-actions">
                    <button type="button"
                            class="postes-btn-primary"
                            @onclick="InviterCandidatAsync"
                            disabled="@(_envoiEnCours || string.IsNullOrWhiteSpace(_emailInvitation))">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        @Localizer["EnvoyerLInvitation"]
                    </button>
                </div>
            </div>
        </section>

        <section class="postes-card">
            <h2 class="postes-section-title">@Localizer["InvitationsEnCours"]</h2>
            @if (_invitationsEnCours.Count == 0)
            {
                <p class="postes-hint">@Localizer["AucuneInvitationEnCours"]</p>
            }
            else
            {
                <ul class="postes-invite-list">
                    @foreach (var invitation in _invitationsEnCours)
                    {
                        <li class="postes-invite-list-item">
                            <div class="postes-invite-list-main">
                                <span class="postes-invite-email">@invitation.EmailInvite</span>
                                <span class="postes-invite-meta">
                                    @invitation.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentUICulture)
                                </span>
                            </div>
                            <button type="button"
                                    class="postes-btn-secondary"
                                    @onclick="() => RevoquerInvitationAsync(invitation.Id)">
                                @Localizer["RevoquerInvitation"]
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (_vivierActif)
        {
            <details class="postes-card postes-vivier-propose">
                <summary class="postes-vivier-summary">
                    <span class="postes-vivier-summary-main">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        @Localizer["ProposerDepuisLeVivier"]
                    </span>
                    @if (_eligiblesVivier is { Count: > 0 })
                    {
                        <span class="postes-vivier-count">@_eligiblesVivier.Count</span>
                    }
                </summary>

                <p class="postes-vivier-warning" role="note">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    @Localizer["AvertissementScoreCompatibiliteEntreprise"]
                </p>

                @if (!string.IsNullOrEmpty(_vivierError))
                {
                    <div class="postes-alert postes-alert-error" role="alert">@_vivierError</div>
                }
                @if (!string.IsNullOrEmpty(_vivierMessage))
                {
                    <div class="postes-alert postes-alert-success" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @_vivierMessage
                    </div>
                }

                @if (_eligiblesVivier is null)
                {
                    <p class="postes-hint">@Localizer["Chargement"]</p>
                }
                else if (_eligiblesVivier.Count == 0)
                {
                    <p class="postes-hint">@Localizer["AucunCandidatVivierEligible"]</p>
                }
                else
                {
                    <ul class="postes-vivier-list">
                        @foreach (var eligible in _eligiblesVivier)
                        {
                            var info = InfosCandidat(eligible.CandidateProfileId);
                            <li class="postes-vivier-list-item">
                                <div class="postes-vivier-list-main">
                                    <div class="postes-vivier-identity">
                                        <span class="candidat-nom">@info.NomAffiche</span>
                                        <span class="candidat-email">@info.EmailAffiche</span>
                                    </div>
                                    <p class="postes-vivier-origine">
                                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                                        <span>@Localizer["PosteDOrigine"]</span>
                                        <strong>@eligible.PosteTitre</strong>
                                    </p>
                                    <div class="postes-vivier-meta">
                                        @if (eligible.ScoreCompatibilite is int score)
                                        {
                                            <span class="score-badge" title="@Localizer["ScoreCompatibilite"]">@score%</span>
                                        }
                                        else
                                        {
                                            <span class="score-empty">@Localizer["ScoreNonCalcule"]</span>
                                        }
                                        @if (eligible.TagsCles.Count > 0)
                                        {
                                            <div class="postes-tags">
                                                @foreach (var tag in eligible.TagsCles)
                                                {
                                                    <span class="postes-tag">@CompatibilityVocabulary.DisplayTag(tag, _english)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                                <button type="button"
                                        class="postes-btn-primary"
                                        disabled="@(_rattachementEnCours == eligible.CandidateProfileId)"
                                        @onclick="() => AjouterDepuisVivierAsync(eligible.CandidateProfileId)">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                    @Localizer["AjouterACePoste"]
                                </button>
                            </li>
                        }
                    </ul>
                }
            </details>
        }
    </div>

    <section class="postes-card postes-candidatures-card">
        <div class="candidatures">
            @if (_candidatures is null)
            {
                <p class="postes-hint">@Localizer["ChargementDesCandidatures"]</p>
            }
            else if (_candidatures.Count == 0)
            {
                <p class="postes-hint">@Localizer["AucuneCandidaturePourPoste"]</p>
            }
            else
            {
                <div class="postes-liste-header">
                    <h2 class="postes-liste-title">@Localizer["CandidaturesDuPoste"]</h2>
                    <div class="postes-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="candidats-recherche"
                               type="search"
                               class="postes-input postes-search-input"
                               value="@_recherche"
                               @oninput="OnRechercheChanged"
                               placeholder="@Localizer["RechercherUnCandidat"]"
                               aria-label="@Localizer["RechercherUnCandidat"]" />
                    </div>
                </div>
                @if (!CandidaturesFiltrees.Any())
                {
                    <p class="postes-hint">@Localizer["AucunCandidatPourCetteRecherche"]</p>
                }
                else
                {
                    <div class="candidatures-table-wrap">
                        <table class="candidatures-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["DateCandidature"]</th>
                                    <th>@Localizer["NomCandidat"]</th>
                                    <th>@Localizer["EmailCandidat"]</th>
                                    <th>@Localizer["PremiereGrilleEvaluation"]</th>
                                    <th>@Localizer["GuideDesEntrevues"]</th>
                                    <th>@Localizer["Resultats"]</th>
                                    <th>@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var candidature in CandidaturesFiltrees)
                                {
                                    var info = InfosCandidat(candidature.CandidateProfileId);
                                    <tr>
                                        <td>
                                            <span class="candidature-date">
                                                @candidature.CreatedAt.ToLocalTime().ToString("d", CultureInfo.CurrentUICulture)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="candidat-nom">@info.NomAffiche</span>
                                            @if (candidature.EstPreselectionne)
                                            {
                                                <span class="postes-badge-preselect">@Localizer["Preselectionne"]</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="candidat-email">@info.EmailAffiche</span>
                                        </td>
                                        <td>
                                            @if (candidature.ScoreCompatibilite is not null)
                                            {
                                                <a href="@($"/compatibilite/resultat/{candidature.CandidateProfileId}")"
                                                   class="grille-ok"
                                                   title="@Localizer["PremiereGrilleEvaluation"]">
                                                    <span aria-hidden="true">✅</span>
                                                    <span class="visually-hidden">@Localizer["PremiereGrilleEvaluation"]</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="score-empty">—</span>
                                            }
                                        </td>
                                        <td>
                                            @* Première entrevue : pas de ✅ — IEntretienService génère la grille à la volée
                                               (pas de persistance « guide déjà généré » par candidat/poste, contrairement à mvp FirstInterviewGuideSaved). *@
                                            <div class="guide-entrevue-actions">
                                                <a href="@($"/entretien/{candidature.CandidateProfileId}")"
                                                   class="postes-btn-ghost postes-btn-compact">
                                                    @Localizer["PremiereEntrevue"]
                                                </a>
                                                <a href="@($"/entreprise/postes/{PosteId}/guide-entrevue")"
                                                   class="postes-btn-ghost postes-btn-compact">
                                                    @Localizer["DeuxiemeEntrevue"]
                                                </a>
                                            </div>
                                        </td>
                                        <td>
                                            <a href="@($"/entreprise/postes/{PosteId}/candidats/{candidature.Id}")"
                                               class="resultats-link">
                                                <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                                @Localizer["Resultats"]
                                            </a>
                                        </td>
                                        <td>
                                            <div class="candidature-actions">
                                                <select class="postes-select" value="@candidature.Statut" @onchange="e => ChangerStatutCandidatureAsync(candidature.Id, e.Value)">
                                                    @foreach (var statut in Enum.GetValues<CandidatureStatut>())
                                                    {
                                                        <option value="@statut">@CandidatureStatutLabels.Label(statut, _english)</option>
                                                    }
                                                </select>
                                                <a href="@($"/entreprise/postes/{PosteId}/candidats/{candidature.Id}")"
                                                   class="candidature-detail-link">
                                                    @Localizer["VoirLeDetail"]
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public int PosteId { get; set; }

    private bool _loading = true;
    private List<Company> _companies = [];
    private PosteView? _poste;
    private List<CandidatureView>? _candidatures;
    private readonly Dictionary<int, CandidatInfo> _infosCandidats = [];
    private string _recherche = "";
    private string _userId = "anonymous";
    private string _emailInvitation = "";
    private bool _envoiEnCours;
    private string? _inviteError;
    private string? _inviteMessage;
    private string? _lienInvitation;
    private List<InvitationView> _invitationsEnCours = [];
    private bool _vivierActif;
    private List<CandidatureVivierView>? _eligiblesVivier;
    private int? _rattachementEnCours;
    private string? _vivierError;
    private string? _vivierMessage;
    private bool _english => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "fr";

    private sealed record CandidatInfo(string NomAffiche, string EmailAffiche, string? Prenom, string? Nom, string? Email);

    private IEnumerable<CandidatureView> CandidaturesFiltrees
    {
        get
        {
            if (_candidatures is null)
                return [];

            var q = _recherche.Trim();
            if (q.Length == 0)
                return _candidatures;

            return _candidatures.Where(c =>
            {
                var info = InfosCandidat(c.CandidateProfileId);
                return Contains(info.Prenom, q)
                    || Contains(info.Nom, q)
                    || Contains(info.NomAffiche, q)
                    || Contains(info.Email, q)
                    || Contains(info.EmailAffiche, q);
            });
        }
    }

    private static bool Contains(string? value, string q) =>
        !string.IsNullOrEmpty(value) && value.Contains(q, StringComparison.OrdinalIgnoreCase);

    private CandidatInfo InfosCandidat(int candidateProfileId) =>
        _infosCandidats.TryGetValue(candidateProfileId, out var info)
            ? info
            : new CandidatInfo($"#{candidateProfileId}", "—", null, null, null);

    private void OnRechercheChanged(ChangeEventArgs e) => _recherche = e.Value?.ToString() ?? "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            _userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? _userId;
        }

        _companies = (await CompanyProvisioningService.GetCompaniesForUserAsync(_userId, CoreDb)).ToList();
        if (_companies.Count == 0)
        {
            _loading = false;
            return;
        }

        await ResolvePosteEtCandidaturesAsync();
        _loading = false;
    }

    private async Task ResolvePosteEtCandidaturesAsync()
    {
        // Préférer l'entreprise déjà active dans le circuit (ex. sélection sur /entreprise/postes).
        var ordered = _companies
            .OrderByDescending(c => TenantContext.ActiveCompanyId == c.Id)
            .ToList();

        foreach (var company in ordered)
        {
            TenantContext.SetActiveCompany(company.Id, company.SchemaName);
            var postes = await PosteService.GetPostesAsync();
            var poste = postes.FirstOrDefault(p => p.Id == PosteId);
            if (poste is null)
                continue;

            _poste = poste;
            _candidatures = (await PosteService.GetCandidaturesAsync(PosteId)).ToList();
            await ChargerInfosCandidatsAsync(_candidatures.Select(c => c.CandidateProfileId));
            _invitationsEnCours = (await PosteService.GetInvitationsCandidatEnCoursAsync(PosteId)).ToList();

            // Même réflexe que GestionDuTempsAccessService : IsActiveAsync module par module, jamais GetActiveModuleCodesAsync.
            _vivierActif = await ModuleRegistry.IsActiveAsync(company.Id, "Vivier", CoreDb);
            if (_vivierActif)
                await ChargerEligiblesVivierAsync();
            else
            {
                _eligiblesVivier = null;
                _vivierError = null;
                _vivierMessage = null;
            }

            return;
        }

        _poste = null;
        _candidatures = null;
        _infosCandidats.Clear();
        _invitationsEnCours = [];
        _vivierActif = false;
        _eligiblesVivier = null;
    }

    private async Task ChargerEligiblesVivierAsync()
    {
        _eligiblesVivier = (await VivierService.GetCandidatsEligiblesPourPosteAsync(PosteId)).ToList();
        await ChargerInfosCandidatsAsync(_eligiblesVivier.Select(e => e.CandidateProfileId), clear: false);
    }

    /// <summary>
    /// Nom / email : <see cref="ICandidateProfileService.GetCvAsync"/> (CvCoordonnees), avec repli Identity
    /// (FirstName / LastName / Email) via <see cref="ICandidateDirectoryService"/> — PosteCandidatureDetailPage
    /// n'affiche encore que l'Id ; même source CV que VivierCandidatDetailPage.
    /// </summary>
    private async Task ChargerInfosCandidatsAsync(IEnumerable<int> candidateProfileIds, bool clear = true)
    {
        if (clear)
            _infosCandidats.Clear();

        var ids = candidateProfileIds.Distinct().Where(id => !_infosCandidats.ContainsKey(id)).ToList();
        if (ids.Count == 0)
            return;

        var directory = (await CandidateDirectory.GetAllAsync())
            .ToDictionary(e => e.CandidateProfileId);

        foreach (var candidateProfileId in ids)
        {
            var cv = await CandidateProfileService.GetCvAsync(candidateProfileId);
            var coord = cv.Coordonnees;
            var prenom = coord?.Prenoms;
            var nom = coord?.Nom;
            var email = coord?.Email;

            if (directory.TryGetValue(candidateProfileId, out var entry))
            {
                var user = await UserManager.FindByIdAsync(entry.UserId);
                if (user is not null)
                {
                    if (string.IsNullOrWhiteSpace(prenom))
                        prenom = user.FirstName;
                    if (string.IsNullOrWhiteSpace(nom))
                        nom = user.LastName;
                    if (string.IsNullOrWhiteSpace(email))
                        email = user.Email;
                }
            }

            var nomAffiche = string.Join(" ", new[] { prenom, nom }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim();
            if (nomAffiche.Length == 0)
                nomAffiche = $"#{candidateProfileId}";

            _infosCandidats[candidateProfileId] = new CandidatInfo(
                nomAffiche,
                string.IsNullOrWhiteSpace(email) ? "—" : email!,
                prenom,
                nom,
                email);
        }
    }

    private async Task AjouterDepuisVivierAsync(int candidateProfileId)
    {
        _vivierError = null;
        _vivierMessage = null;
        _rattachementEnCours = candidateProfileId;
        try
        {
            await PosteService.RattacherCandidatDepuisVivierAsync(PosteId, candidateProfileId);
            _candidatures = (await PosteService.GetCandidaturesAsync(PosteId)).ToList();
            await ChargerInfosCandidatsAsync(_candidatures.Select(c => c.CandidateProfileId));
            await ChargerEligiblesVivierAsync();
            _vivierMessage = Localizer["CandidatAjouteDepuisVivier"];
        }
        catch (Exception ex)
        {
            _vivierError = string.IsNullOrWhiteSpace(ex.Message)
                ? Localizer["ErreurRattachementVivier"].Value
                : ex.Message;
        }
        finally
        {
            _rattachementEnCours = null;
        }
    }

    private async Task InviterCandidatAsync()
    {
        _inviteError = null;
        _inviteMessage = null;
        _lienInvitation = null;

        if (string.IsNullOrWhiteSpace(_emailInvitation) || _poste is null)
            return;

        _envoiEnCours = true;
        try
        {
            var invitation = await PosteService.InviterCandidatAsync(PosteId, _emailInvitation.Trim(), _userId);
            _invitationsEnCours = (await PosteService.GetInvitationsCandidatEnCoursAsync(PosteId)).ToList();
            var created = _invitationsEnCours.FirstOrDefault(i => i.Id == invitation.Id);
            _lienInvitation = $"{Navigation.BaseUri.TrimEnd('/')}{(created?.LienRelatif ?? $"/invitations/accepter/{invitation.Token}")}";
            _emailInvitation = "";
            _inviteMessage = Localizer["InvitationEnvoyee"];
        }
        catch (Exception ex)
        {
            _inviteError = string.IsNullOrWhiteSpace(ex.Message)
                ? Localizer["ErreurInvitation"].Value
                : ex.Message;
        }
        finally
        {
            _envoiEnCours = false;
        }
    }

    private async Task RevoquerInvitationAsync(int invitationId)
    {
        await PosteService.RevokerInvitationCandidatAsync(invitationId, _userId);
        _invitationsEnCours = (await PosteService.GetInvitationsCandidatEnCoursAsync(PosteId)).ToList();
        if (_lienInvitation is not null && !_invitationsEnCours.Any(i => _lienInvitation.Contains(i.LienRelatif, StringComparison.Ordinal)))
            _lienInvitation = null;
    }

    private async Task ChangerStatutCandidatureAsync(int candidatureId, object? value)
    {
        if (value is not null && Enum.TryParse<CandidatureStatut>(value.ToString(), out var statut))
        {
            await PosteService.SetCandidatureStatutAsync(candidatureId, statut);
            _candidatures = (await PosteService.GetCandidaturesAsync(PosteId)).ToList();
            await ChargerInfosCandidatsAsync(_candidatures.Select(c => c.CandidateProfileId));
        }
    }
}
