@page "/candidat/postes"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Modules.PostesRecrutement.Resources
@using Spectrometre.Modules.PostesRecrutement.Services
@using Spectrometre.Modules.ProfilCandidat.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IPosteService PosteService
@inject ICandidateProfileService CandidateProfileService
@inject IStringLocalizer<PostesRecrutementResource> Localizer

<PageTitle>@Localizer["PostesOuverts"]</PageTitle>

<div class="postes-page">
    <header class="postes-header">
        <div>
            <h1 class="postes-title">@Localizer["PostesOuverts"]</h1>
            <p class="postes-subtitle">@Localizer["TousLesPostesOuverts"]</p>
        </div>
    </header>

@if (_postes is null)
{
    <p class="postes-state">@Localizer["Chargement"]</p>
}
else if (_postes.Count == 0)
{
    <section class="postes-card postes-empty">
        <div class="postes-empty-icon" aria-hidden="true">
            <i class="bi bi-briefcase"></i>
        </div>
        <p class="postes-hint">@Localizer["AucunPosteOuvert"]</p>
    </section>
}
else
{
    <section class="postes-liste">
        <div class="postes-grid">
            @foreach (var poste in _postes)
            {
                <article class="postes-card poste-carte @(poste.DejaPostule ? "is-applied" : "")">
                    <div class="poste-entete">
                        <div class="poste-entete-main">
                            <h3 class="poste-titre">@poste.Titre</h3>
                            <span class="poste-entreprise">
                                <i class="bi bi-building" aria-hidden="true"></i>
                                @poste.CompanyName
                            </span>
                        </div>
                        @if (poste.DejaPostule)
                        {
                            <span class="deja-postule">
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                @Localizer["CandidatureEnvoyee"]
                            </span>
                        }
                        else
                        {
                            <button type="button" class="postes-btn-primary" @onclick="() => PostulerAsync(poste)">
                                <i class="bi bi-send" aria-hidden="true"></i>
                                @Localizer["Postuler"]
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(poste.Departement))
                    {
                        <p class="poste-departement">
                            <i class="bi bi-diagram-3" aria-hidden="true"></i>
                            @poste.Departement
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(poste.Description))
                    {
                        <p class="poste-description">@poste.Description</p>
                    }
                </article>
            }
        </div>
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<PosteOuvertView>? _postes;
    private int _candidateProfileId;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _candidateProfileId = await CandidateProfileService.GetOrCreateProfileIdAsync(userId);
        _postes = (await PosteService.GetPostesOuvertsAsync(_candidateProfileId)).ToList();
    }

    private async Task PostulerAsync(PosteOuvertView poste)
    {
        await PosteService.PostulerAsync(poste.CompanyId, poste.PosteId, _candidateProfileId);
        _postes = (await PosteService.GetPostesOuvertsAsync(_candidateProfileId)).ToList();
    }
}
