@page "/mon-coach"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Modules.Coaching.Entities
@using Spectrometre.Modules.Coaching.Resources
@using Spectrometre.Modules.Coaching.Services
@using Spectrometre.Modules.GestionDuTemps.Services
@using Spectrometre.Modules.ProfilCoach.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IGestionDuTempsAccessService GestionDuTempsAccessService
@inject ICoachingService CoachingService
@inject ICoachProfileService CoachProfileService
@inject NavigationManager Navigation
@inject IStringLocalizer<CoachingResource> Localizer

<PageTitle>@Localizer["MonCoachTitle"]</PageTitle>

<div class="mon-coach-page">
@if (_userId is null)
{
    <p class="mc-state">@Localizer["Chargement"]</p>
}
else if (!_hasAccess)
{
    <section class="mc-card mc-empty">
        <p class="mc-hint">@Localizer["ModuleNonActive"]</p>
    </section>
}
else
{
    <header class="mc-header">
        <div>
            <h1 class="mc-title">@Localizer["MonCoach"]</h1>
            <p class="mc-subtitle">@Localizer["MesLiens"]</p>
        </div>
    </header>

    <section class="mc-section">
        <h2 class="mc-section-title">@Localizer["MesLiens"]</h2>
        @if (_liens.Count == 0)
        {
            <p class="mc-hint">@Localizer["AucunLien"]</p>
        }
        else
        {
            <div class="mc-grid">
                @foreach (var (lien, nomAffiche) in _liens)
                {
                    <article class="mc-card lien-carte">
                        <div class="lien-entete">
                            <div class="lien-entete-main">
                                <h3 class="lien-nom">@nomAffiche</h3>
                                <span class="statut @StatutClasse(lien.Statut)">@StatutLabel(lien.Statut)</span>
                            </div>
                            @if (lien.Statut is LienCoachingStatut.EnAttente or LienCoachingStatut.Actif)
                            {
                                <button type="button" class="mc-btn-secondary" @onclick="() => RevoquerAsync(lien.Id)">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                                    @Localizer["Revoquer"]
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="mc-section">
        <h2 class="mc-section-title">@Localizer["AnnuaireDesCoachs"]</h2>
        <div class="mc-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="mc-input"
                   @bind="_recherche"
                   @bind:event="oninput"
                   @bind:after="RefreshAnnuaireAsync"
                   placeholder="@Localizer["RechercherUnCoach"]" />
        </div>
        @if (_annuaire.Count == 0)
        {
            <p class="mc-hint">@Localizer["AucunCoachTrouve"]</p>
        }
        else
        {
            <div class="mc-grid">
                @foreach (var entry in _annuaire)
                {
                    <article class="mc-card coach-carte">
                        <div class="coach-entete">
                            <div class="coach-avatar" aria-hidden="true">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div class="coach-entete-main">
                                <h3 class="coach-nom">@entry.NomAffiche</h3>
                                @if (!string.IsNullOrWhiteSpace(entry.Specialites))
                                {
                                    <p class="coach-specialites">
                                        <i class="bi bi-tags" aria-hidden="true"></i>
                                        @entry.Specialites
                                    </p>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.BioCourte))
                        {
                            <p class="coach-bio">@entry.BioCourte</p>
                        }
                        <div class="coach-pied">
                            <button type="button" class="mc-btn-primary" @onclick="() => DemanderAsync(entry.CoachProfileId)">
                                <i class="bi bi-send" aria-hidden="true"></i>
                                @Localizer["EnvoyerUneDemande"]
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
        @if (_messageAnnuaire is not null)
        {
            <div class="mc-alert mc-alert-success" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                @_messageAnnuaire
            </div>
        }
    </section>

    <section class="mc-card mc-invite-card">
        <div class="mc-card-icon" aria-hidden="true">
            <i class="bi bi-envelope-plus"></i>
        </div>
        <h2 class="mc-card-title">@Localizer["InviterUnAutreCoach"]</h2>
        <p class="mc-hint">@Localizer["InviterUnAutreCoachHint"]</p>
        <div class="mc-invite-form">
            <div class="mc-field">
                <label for="mc-email">@Localizer["EmailDuCoach"]</label>
                <input id="mc-email"
                       class="mc-input"
                       type="email"
                       @bind="_emailInvitation"
                       placeholder="@Localizer["EmailDuCoach"]" />
            </div>
            <button type="button" class="mc-btn-primary" @onclick="InviterAsync" disabled="@_invitationEnCours">
                <i class="bi bi-link-45deg" aria-hidden="true"></i>
                @Localizer["EnvoyerLInvitation"]
            </button>
        </div>
        @if (_lienInvitation is not null)
        {
            <div class="mc-alert mc-alert-success mc-invite-result" role="status">
                <div>
                    <p class="mc-invite-label">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["LienDInvitationGenere"]
                    </p>
                    <code class="mc-invite-link">@_lienInvitation</code>
                </div>
            </div>
        }
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _userId;
    private bool _hasAccess;
    private List<(LienCoachingView Lien, string NomAffiche)> _liens = [];
    private List<CoachAnnuaireEntry> _annuaire = [];
    private string _recherche = "";
    private string? _messageAnnuaire;
    private string _emailInvitation = "";
    private bool _invitationEnCours;
    private string? _lienInvitation;

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _userId = userId;
        // Restreint au sujet Candidat — une entreprise n'a pas de coach, même avec Gestion du temps actif
        // pour ses employés (voir la remarque sur IGestionDuTempsAccessService.HasCandidateAccessAsync).
        _hasAccess = await GestionDuTempsAccessService.HasCandidateAccessAsync(userId);
        if (!_hasAccess)
            return;

        await RefreshLiensAsync();
        await RefreshAnnuaireAsync();
    }

    private async Task RefreshLiensAsync()
    {
        var liens = await CoachingService.GetLiensPourSuiviAsync(_userId!);
        var resolved = new List<(LienCoachingView, string)>();
        foreach (var lien in liens)
        {
            var profil = await CoachProfileService.GetProfilAsync(lien.CoachUserId);
            resolved.Add((lien, string.IsNullOrWhiteSpace(profil?.NomAffiche) ? lien.CoachUserId : profil.NomAffiche));
        }
        _liens = resolved;
    }

    private async Task RefreshAnnuaireAsync() =>
        _annuaire = (await CoachProfileService.GetAnnuaireVisibleAsync(_recherche)).ToList();

    private async Task DemanderAsync(int coachProfileId)
    {
        _messageAnnuaire = null;
        var coachUserId = await CoachProfileService.GetUserIdAsync(coachProfileId);
        if (coachUserId is null)
            return;

        var ok = await CoachingService.DemanderCoachDepuisAnnuaireAsync(_userId!, coachUserId);
        _messageAnnuaire = Localizer[ok ? "DemandeEnvoyee" : "DemandeDejaEnvoyee"];
        await RefreshLiensAsync();
    }

    private async Task RevoquerAsync(int lienId)
    {
        await CoachingService.RevoquerAsync(lienId, _userId!);
        await RefreshLiensAsync();
    }

    private async Task InviterAsync()
    {
        if (string.IsNullOrWhiteSpace(_emailInvitation))
            return;

        _invitationEnCours = true;
        try
        {
            var invitation = await CoachingService.InviterCoachParEmailAsync(_userId!, _emailInvitation.Trim());
            _lienInvitation = $"{Navigation.BaseUri}invitations/accepter/{invitation.Token}";
        }
        finally
        {
            _invitationEnCours = false;
        }
    }

    private string StatutLabel(LienCoachingStatut statut) => statut switch
    {
        LienCoachingStatut.EnAttente => Localizer["StatutEnAttente"],
        LienCoachingStatut.Actif => Localizer["StatutActif"],
        LienCoachingStatut.Refuse => Localizer["StatutRefuse"],
        LienCoachingStatut.Revoque => Localizer["StatutRevoque"],
        _ => statut.ToString(),
    };

    private static string StatutClasse(LienCoachingStatut statut) => statut switch
    {
        LienCoachingStatut.EnAttente => "en-attente",
        LienCoachingStatut.Actif => "actif",
        LienCoachingStatut.Refuse => "refuse",
        LienCoachingStatut.Revoque => "revoque",
        _ => "revoque",
    };
}
