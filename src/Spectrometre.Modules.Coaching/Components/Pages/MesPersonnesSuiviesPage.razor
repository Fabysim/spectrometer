@page "/coach/suivis"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Identity
@using Spectrometre.Core.Modules
@using Spectrometre.Modules.Coaching.Entities
@using Spectrometre.Core.JeunesPrestataires
@using Spectrometre.Modules.Coaching.Resources
@using Spectrometre.Modules.Coaching.Services
@using Spectrometre.Modules.SuiviEmployes.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICoachingService CoachingService
@inject IJeunePrestataireInvitationQuery JeunePrestataireInvitationQuery
@inject ISuiviEmployesService SuiviEmployesService
@inject NavigationManager Navigation
@inject ICoachSubjectResolver CoachSubjectResolver
@inject IModuleRegistry ModuleRegistry
@inject IDbContextFactory<CoreDbContext> CoreDbFactory
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<CoachingResource> Localizer

<PageTitle>@Localizer["MesPersonnesSuiviesTitle"]</PageTitle>

<div class="suivis-page">
@if (_userId is null)
{
    <p class="suivis-state">@Localizer["Chargement"]</p>
}
else if (!_hasAccess)
{
    <section class="suivis-card suivis-empty">
        <p class="suivis-hint">@Localizer["ModuleCoachNonActif"]</p>
    </section>
}
else
{
    <header class="suivis-header">
        <div>
            <h1 class="suivis-title">@Localizer["MesPersonnesSuivies"]</h1>
            <p class="suivis-subtitle">
                @_enAttente.Count @Localizer["DemandesEnAttente"] · @_invitationsJeunesEnAttente.Count @Localizer["InvitationsJeunesEnAttente"] · @_actifs.Count @Localizer["LiensActifs"]
            </p>
        </div>
        <a class="suivis-btn-primary suivis-cta" href="/coach/jeunes/inviter">
            <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
            @Localizer["InviterJeunePrestataire"]
        </a>
    </header>

    <section class="suivis-section">
        <h2 class="suivis-section-title">@Localizer["DemandesEnAttente"]</h2>
        @if (_enAttente.Count == 0)
        {
            <p class="suivis-hint">@Localizer["AucuneDemandeEnAttente"]</p>
        }
        else
        {
            <div class="suivis-grid">
                @foreach (var (lien, nom) in _enAttente)
                {
                    <article class="suivis-card demande-carte">
                        <div class="demande-entete">
                            <div class="demande-avatar" aria-hidden="true">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="demande-entete-main">
                                <h3 class="demande-nom">@nom</h3>
                                <span class="statut en-attente">@Localizer["StatutEnAttente"]</span>
                            </div>
                        </div>
                        <div class="demande-actions">
                            <button type="button" class="suivis-btn-primary" @onclick="() => AccepterAsync(lien.Id)">
                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                                @Localizer["Accepter"]
                            </button>
                            <button type="button" class="suivis-btn-secondary" @onclick="() => RefuserAsync(lien.Id)">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                                @Localizer["Refuser"]
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="suivis-section" id="invitations-jeunes">
        <h2 class="suivis-section-title">@Localizer["InvitationsJeunesEnAttente"]</h2>
        @if (_renvoiMessage is not null)
        {
            <div class="suivis-alert @_renvoiMessageCss" role="status">@_renvoiMessage</div>
        }
        @if (_invitationsJeunesEnAttente.Count == 0)
        {
            <p class="suivis-hint">@Localizer["AucuneInvitationJeuneEnAttente"]</p>
        }
        else
        {
            <div class="suivis-grid">
                @foreach (var invitation in _invitationsJeunesEnAttente)
                {
                    <article class="suivis-card invitation-jeune-carte">
                        <div class="demande-entete">
                            <div class="demande-avatar" aria-hidden="true">
                                <i class="bi bi-envelope-paper"></i>
                            </div>
                            <div class="demande-entete-main">
                                <h3 class="demande-nom">@FormatNomJeune(invitation)</h3>
                                <span class="statut @(invitation.EstExpiree ? "expiree" : "invitation-attente")">
                                    @(invitation.EstExpiree ? Localizer["StatutInvitationJeuneExpiree"] : Localizer["StatutInvitationJeuneEnAttente"])
                                </span>
                            </div>
                        </div>
                        <p class="invitation-jeune-email">@invitation.Email</p>
                        <p class="suivis-hint invitation-jeune-meta">
                            @Localizer["InvitationJeuneEnvoyeeLe", invitation.EnvoyeeLe.ToLocalTime().ToString("g")]
                        </p>
                        <div class="demande-actions">
                            <button type="button"
                                    class="suivis-btn-primary"
                                    @onclick="() => RenvoyerInvitationJeuneAsync(invitation.InvitationId)"
                                    disabled="@_renvoiEnCours.Contains(invitation.InvitationId)">
                                <i class="bi @(_renvoiEnCours.Contains(invitation.InvitationId) ? "bi-hourglass-split" : "bi-send")" aria-hidden="true"></i>
                                @Localizer["RenvoyerInvitationJeune"]
                            </button>
                            <button type="button"
                                    class="suivis-btn-secondary"
                                    @onclick="() => AnnulerInvitationJeuneAsync(invitation.InvitationId)"
                                    disabled="@_annulationEnCours.Contains(invitation.InvitationId)">
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                                @Localizer["AnnulerInvitationJeune"]
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="suivis-section">
        <h2 class="suivis-section-title">@Localizer["LiensActifs"]</h2>
        @if (_actifs.Count == 0)
        {
            <p class="suivis-hint">@Localizer["AucunLienActif"]</p>
        }
        else
        {
            <div class="suivis-grid">
                @foreach (var (lien, nom, anamnese, aRattachementEmploye) in _actifs)
                {
                    <article class="suivis-card actif-carte">
                        <div class="actif-entete">
                            <div class="actif-identite">
                                <div class="demande-avatar" aria-hidden="true">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="actif-entete-main">
                                    <h3 class="actif-nom">@nom</h3>
                                    <span class="statut actif">@Localizer["StatutActif"]</span>
                                </div>
                            </div>
                        </div>

                        <nav class="actif-actions" aria-label="@Localizer["ActionsSuivi"]">
                            <p class="actif-actions-label">@Localizer["ActionsSuivi"]</p>
                            <div class="actif-actions-grid">
                                <a class="suivis-action" href="/gestion-du-temps/@lien.SuiviUserId">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
                                    <span class="suivis-action-text">@Localizer["VoirLeSuivi"]</span>
                                </a>
                                <a class="suivis-action" href="/gestion-du-temps/calendrier/@lien.SuiviUserId">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
                                    <span class="suivis-action-text">@Localizer["Calendrier"]</span>
                                </a>
                                <a class="suivis-action" href="/coach/suivis/@lien.SuiviUserId/auto-observation">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-ui-checks"></i></span>
                                    <span class="suivis-action-text">@Localizer["AutoObservationJeune"]</span>
                                </a>
                                <a class="suivis-action" href="/coach/suivis/@lien.SuiviUserId/grille-observation">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-clipboard2-data"></i></span>
                                    <span class="suivis-action-text">@Localizer["GrilleObservationJeune"]</span>
                                </a>
                                <a class="suivis-action" href="/coach/suivis/@lien.SuiviUserId/guide-entrevue">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-chat-quote"></i></span>
                                    <span class="suivis-action-text">@Localizer["GuideEntrevueJeune"]</span>
                                </a>
                                <a class="suivis-action" href="/coach/suivis/@lien.SuiviUserId/missions">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-briefcase"></i></span>
                                    <span class="suivis-action-text">@Localizer["MissionsJeune"]</span>
                                </a>
                                <a class="suivis-action" href="/coach/objectifs/@lien.Id">
                                    <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                                    <span class="suivis-action-text">@Localizer["Objectifs"]</span>
                                </a>
                                @if (aRattachementEmploye)
                                {
                                    <a class="suivis-action" href="/coach/suivi-employes/@lien.SuiviUserId">
                                        <span class="suivis-action-icon" aria-hidden="true"><i class="bi bi-clipboard2-pulse"></i></span>
                                        <span class="suivis-action-text">@Localizer["VoirSuiviEmployes"]</span>
                                    </a>
                                }
                            </div>
                        </nav>

                        <div class="anamnese-bloc">
                            <h4 class="anamnese-title">
                                <i class="bi bi-journal-text" aria-hidden="true"></i>
                                @Localizer["Anamnese"]
                            </h4>
                            @if (anamnese is not null)
                            {
                                <p class="anamnese-contenu">@anamnese.Contenu</p>
                                <p class="suivis-hint anamnese-meta">
                                    @(anamnese.GenereeParIa ? Localizer["AnamneseGenereeParIa"] : Localizer["AnamneseRepli"])
                                </p>
                            }
                            else
                            {
                                <p class="suivis-hint">@Localizer["AucuneAnamnese"]</p>
                            }
                            <button type="button"
                                    class="suivis-btn-secondary"
                                    @onclick="() => GenererAnamneseAsync(lien.Id)"
                                    disabled="@_anamneseEnCours.Contains(lien.Id)">
                                <i class="bi @(_anamneseEnCours.Contains(lien.Id) ? "bi-hourglass-split" : "bi-stars")" aria-hidden="true"></i>
                                @(anamnese is null ? Localizer["GenererLAnamnese"] : Localizer["RegenererLAnamnese"])
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _userId;
    private bool _hasAccess;
    private List<(LienCoachingView Lien, string Nom)> _enAttente = [];
    private List<JeunePrestataireInvitationPendingView> _invitationsJeunesEnAttente = [];
    private List<(LienCoachingView Lien, string Nom, AnamneseCoachingView? Anamnese, bool ARattachementEmploye)> _actifs = [];
    private readonly HashSet<int> _anamneseEnCours = [];
    private readonly HashSet<int> _annulationEnCours = [];
    private readonly HashSet<int> _renvoiEnCours = [];
    private string? _renvoiMessage;
    private string? _renvoiMessageCss;
    private readonly Dictionary<string, bool> _rattachementCache = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _userId = userId;

        // Accès au module Coaching côté coach conditionné à ProfilCoach actif (voir la remarque sur
        // ServiceCollectionExtensions du module Coaching : pas d'activation propre).
        await using var coreDb = await CoreDbFactory.CreateDbContextAsync();
        var coachProfileId = await CoachSubjectResolver.GetOrCreateCoachProfileIdAsync(userId);
        _hasAccess = await ModuleRegistry.IsActiveForCoachAsync(coachProfileId, "ProfilCoach", coreDb);
        if (!_hasAccess)
            return;

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var liens = await CoachingService.GetLiensPourCoachAsync(_userId!);

        var enAttente = new List<(LienCoachingView, string)>();
        var actifs = new List<(LienCoachingView, string, AnamneseCoachingView?, bool)>();
        foreach (var lien in liens)
        {
            if (lien.Statut is not (LienCoachingStatut.EnAttente or LienCoachingStatut.Actif))
                continue;

            var nom = await NomAfficheAsync(lien.SuiviUserId);
            if (lien.Statut == LienCoachingStatut.EnAttente)
            {
                enAttente.Add((lien, nom));
            }
            else
            {
                var anamnese = await CoachingService.GetAnamneseAsync(lien.Id, _userId!);
                var aRattachement = await ARattachementEmployeAsync(lien.SuiviUserId);
                actifs.Add((lien, nom, anamnese, aRattachement));
            }
        }

        _enAttente = enAttente;
        _actifs = actifs;
        _invitationsJeunesEnAttente = (await JeunePrestataireInvitationQuery.GetInvitationsEnvoyeesEnAttenteAsync(_userId!)).ToList();
    }

    /// <summary>
    /// Lecture seule via <see cref="ISuiviEmployesService.ListRattachementsEmployeAsync"/> —
    /// conditionne l'affichage du bouton « Suivi employés » (jamais d'écriture SuiviEmployes).
    /// </summary>
    private async Task<bool> ARattachementEmployeAsync(string suiviUserId)
    {
        if (_rattachementCache.TryGetValue(suiviUserId, out var cached))
            return cached;

        var rattachements = await SuiviEmployesService.ListRattachementsEmployeAsync(suiviUserId);
        var hasAny = rattachements.Count > 0;
        _rattachementCache[suiviUserId] = hasAny;
        return hasAny;
    }

    private async Task<string> NomAfficheAsync(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user is null)
            return userId;
        var nomComplet = $"{user.FirstName} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(nomComplet) ? (user.Email ?? userId) : nomComplet;
    }

    private async Task AccepterAsync(int lienId)
    {
        await CoachingService.AccepterAsync(lienId, _userId!);
        await RefreshAsync();
    }

    private async Task RefuserAsync(int lienId)
    {
        await CoachingService.RefuserAsync(lienId, _userId!);
        await RefreshAsync();
    }

    private static string FormatNomJeune(JeunePrestataireInvitationPendingView invitation)
    {
        var nomComplet = $"{invitation.Prenoms} {invitation.Nom}".Trim();
        return string.IsNullOrWhiteSpace(nomComplet) ? invitation.Email : nomComplet;
    }

    private async Task AnnulerInvitationJeuneAsync(int invitationId)
    {
        _renvoiMessage = null;
        _annulationEnCours.Add(invitationId);
        try
        {
            await JeunePrestataireInvitationQuery.RevoquerInvitationEnvoyeeAsync(invitationId, _userId!);
            await RefreshAsync();
        }
        finally
        {
            _annulationEnCours.Remove(invitationId);
        }
    }

    private async Task RenvoyerInvitationJeuneAsync(int invitationId)
    {
        _renvoiMessage = null;
        _renvoiEnCours.Add(invitationId);
        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var result = await JeunePrestataireInvitationQuery.RenvoyerInvitationAsync(invitationId, _userId!, baseUrl);

            if (!result.Success)
            {
                _renvoiMessageCss = "suivis-alert-error";
                _renvoiMessage = Localizer["RenvoyerInvitationJeune_Echec"];
                return;
            }

            await RefreshAsync();

            if (result.EmailEnvoye)
            {
                _renvoiMessageCss = "suivis-alert-success";
                _renvoiMessage = result.NouvelleInvitationCreee
                    ? Localizer["RenvoyerInvitationJeune_SuccesRenouvelee"]
                    : Localizer["RenvoyerInvitationJeune_Succes"];
            }
            else
            {
                _renvoiMessageCss = "suivis-alert-warn";
                _renvoiMessage = Localizer["RenvoyerInvitationJeune_EmailNonEnvoye"];
            }
        }
        finally
        {
            _renvoiEnCours.Remove(invitationId);
        }
    }

    private async Task GenererAnamneseAsync(int lienId)
    {
        _anamneseEnCours.Add(lienId);
        try
        {
            await CoachingService.GenererAnamneseAsync(lienId, _userId!);
            await RefreshAsync();
        }
        finally
        {
            _anamneseEnCours.Remove(lienId);
        }
    }
}
