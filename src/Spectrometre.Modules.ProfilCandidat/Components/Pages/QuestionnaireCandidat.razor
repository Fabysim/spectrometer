@page "/candidat/questionnaire"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Spectrometre.Core.Compatibility
@using Spectrometre.Modules.ProfilCandidat.Entities
@using Spectrometre.Modules.ProfilCandidat.Services
@inject ICandidateProfileService CandidateProfileService

<PageTitle>Questionnaire candidat</PageTitle>

@if (_questions is null)
{
    <p>Chargement…</p>
}
else
{
    var themes = Enum.GetValues<CandidateTheme>();
    var onGrilleStep = _currentIndex >= _questions.Count;

    <div class="candidat-questionnaire">
        <aside class="progression">
            <h3>PROGRESSION</h3>
            <ul>
                @foreach (var theme in themes)
                {
                    var themeQuestions = _questions.Where(q => q.Theme == theme).ToList();
                    var allAnswered = themeQuestions.Count > 0 && themeQuestions.All(q => !string.IsNullOrWhiteSpace(q.AnswerText));
                    var isActive = !onGrilleStep && _questions[_currentIndex].Theme == theme;
                    <li class="@(isActive ? "active" : "")">
                        @(allAnswered ? "✅" : "◯") @CandidateThemeLabels.ShortLabel(theme)
                    </li>
                }
                <li class="@(onGrilleStep ? "active" : "")">
                    @(GrilleComplete ? "✅" : "◯") Grille de compatibilité
                </li>
            </ul>
        </aside>

        @if (!onGrilleStep)
        {
            var current = _questions[_currentIndex];
            <section class="question-panel">
                <p class="counter">Question @(_currentIndex + 1) / @_questions.Count</p>
                <h2>@current.Text</h2>

                <textarea @bind="_currentAnswer" @bind:event="oninput"
                          placeholder="@ExamplesPlaceholder(current)"
                          rows="5"></textarea>

                <div class="actions">
                    <button @onclick="PreviousAsync" disabled="@(_currentIndex == 0)">&lt; Précédent</button>
                    <button @onclick="NextAsync">Suivant &gt;</button>
                </div>
            </section>
        }
        else
        {
            <section class="question-panel">
                <p class="counter">H. Grille complémentaire de compatibilité candidat</p>
                <h2>Critères pour le moteur de compatibilité</h2>
                <p class="hint">
                    Cette grille transforme vos réponses en critères directement comparables avec ceux de
                    l'entreprise. Elle ne sert pas à vous exclure, mais à préparer un dialogue plus clair
                    en entretien.
                </p>

                <div class="grille-champ">
                    <label>Compatibilité technique</label>
                    <p class="grille-question">Sélectionnez les compétences que vous maîtrisez déjà suffisamment pour être opérationnel.</p>
                    <div class="tag-checkboxes">
                        @foreach (var tag in CompatibilityVocabulary.TechniqueTags)
                        {
                            <label class="tag-checkbox">
                                <input type="checkbox" checked="@_grille.TechniqueTags.Contains(tag)"
                                       @onchange="e => ToggleTagAsync(CriteriaField.Technique, _grille.TechniqueTags, tag, (bool)e.Value!)" />
                                @tag
                            </label>
                        }
                    </div>
                    <textarea @bind="_grille.TechniqueNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Technique, e.Value?.ToString())"
                              placeholder="Notes libres (optionnel — sert à l'entretien, n'entre pas dans le calcul)" rows="2"></textarea>
                </div>

                <div class="grille-champ">
                    <label>Compatibilité comportementale</label>
                    <p class="grille-question">Sélectionnez les comportements professionnels qui vous décrivent.</p>
                    <div class="tag-checkboxes">
                        @foreach (var tag in CompatibilityVocabulary.ComportementaleTags)
                        {
                            <label class="tag-checkbox">
                                <input type="checkbox" checked="@_grille.ComportementaleTags.Contains(tag)"
                                       @onchange="e => ToggleTagAsync(CriteriaField.Comportementale, _grille.ComportementaleTags, tag, (bool)e.Value!)" />
                                @tag
                            </label>
                        }
                    </div>
                    <textarea @bind="_grille.ComportementaleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Comportementale, e.Value?.ToString())"
                              placeholder="Notes libres (optionnel)" rows="2"></textarea>
                </div>

                <div class="grille-champ">
                    <label>Compatibilité culturelle</label>
                    <p class="grille-question">Sélectionnez les valeurs que vous souhaitez retrouver dans une entreprise.</p>
                    <div class="tag-checkboxes">
                        @foreach (var tag in CompatibilityVocabulary.CulturelleTags)
                        {
                            <label class="tag-checkbox">
                                <input type="checkbox" checked="@_grille.CulturelleTags.Contains(tag)"
                                       @onchange="e => ToggleTagAsync(CriteriaField.Culturelle, _grille.CulturelleTags, tag, (bool)e.Value!)" />
                                @tag
                            </label>
                        }
                    </div>
                    <textarea @bind="_grille.CulturelleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Culturelle, e.Value?.ToString())"
                              placeholder="Notes libres (optionnel)" rows="2"></textarea>
                </div>

                <div class="grille-champ">
                    <label>Compatibilité organisationnelle — rythme de travail</label>
                    <p class="grille-question">Quel rythme de travail pouvez-vous accepter durablement ?</p>
                    <select value="@(_grille.RythmeTravail?.ToString() ?? "")" @onchange="OnRythmeChangedAsync">
                        <option value="">— Choisir —</option>
                        @foreach (var (valeur, libelle) in CompatibilityVocabulary.RythmeTravailLabels)
                        {
                            <option value="@valeur">@valeur — @libelle</option>
                        }
                    </select>
                    <textarea @bind="_grille.OrganisationnelleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Organisationnelle, e.Value?.ToString())"
                              placeholder="Notes libres (optionnel)" rows="2"></textarea>
                </div>

                <div class="grille-champ">
                    <label>Compatibilité motivationnelle</label>
                    <p class="grille-question">Sélectionnez ce qui vous donne envie de vous investir durablement.</p>
                    <div class="tag-checkboxes">
                        @foreach (var tag in CompatibilityVocabulary.MotivationnelleTags)
                        {
                            <label class="tag-checkbox">
                                <input type="checkbox" checked="@_grille.MotivationnelleTags.Contains(tag)"
                                       @onchange="e => ToggleTagAsync(CriteriaField.Motivationnelle, _grille.MotivationnelleTags, tag, (bool)e.Value!)" />
                                @tag
                            </label>
                        }
                    </div>
                    <textarea @bind="_grille.MotivationnelleNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.Motivationnelle, e.Value?.ToString())"
                              placeholder="Notes libres (optionnel)" rows="2"></textarea>
                </div>

                <div class="grille-champ">
                    <label>Points de vigilance</label>
                    <p class="grille-question">Sélectionnez les situations qui risquent de vous fatiguer, vous stresser ou vous démotiver.</p>
                    <div class="tag-checkboxes">
                        @foreach (var tag in CompatibilityVocabulary.PointsVigilanceTags)
                        {
                            <label class="tag-checkbox">
                                <input type="checkbox" checked="@_grille.PointsVigilanceTags.Contains(tag)"
                                       @onchange="e => ToggleTagAsync(CriteriaField.PointsVigilance, _grille.PointsVigilanceTags, tag, (bool)e.Value!)" />
                                @tag
                            </label>
                        }
                    </div>
                    <textarea @bind="_grille.PointsVigilanceNotes" @bind:event="oninput" @onchange="e => SaveNotesAsync(CriteriaField.PointsVigilance, e.Value?.ToString())"
                              placeholder="Notes libres (optionnel)" rows="2"></textarea>
                </div>

                <div class="actions">
                    <button @onclick="PreviousAsync">&lt; Précédent</button>
                    <button @onclick="() => _grilleSaved = true">Terminé</button>
                </div>
                @if (_grilleSaved)
                {
                    <p class="hint">Grille enregistrée.</p>
                }
            </section>
        }

        <aside class="synthese">
            <h3>SYNTHÈSE DU PROFIL</h3>
            <p class="grille-statut">@(GrilleComplete ? "✅" : "◯") Grille de compatibilité @(GrilleComplete ? "complète" : "incomplète")</p>
            @if (_synthesis is not null)
            {
                @foreach (var (category, tags) in _synthesis.TagsByCategory)
                {
                    if (tags.Count == 0) continue;
                    <div class="synthese-categorie">
                        <strong>@category</strong>
                        <div class="tags">
                            @foreach (var tag in tags)
                            {
                                <span class="tag">@tag</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="hint">La synthèse apparaît au fil de vos réponses.</p>
            }
        </aside>
    </div>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private int _candidateProfileId;
    private List<CandidateQuestionView>? _questions;
    private int _currentIndex;
    private string _currentAnswer = "";
    private CandidateSynthesisView? _synthesis;
    private readonly GrilleModel _grille = new();
    private bool _grilleSaved;

    private bool GrilleComplete =>
        _grille.TechniqueTags.Count > 0
        && _grille.ComportementaleTags.Count > 0
        && _grille.CulturelleTags.Count > 0
        && _grille.RythmeTravail is not null
        && _grille.MotivationnelleTags.Count > 0
        && _grille.PointsVigilanceTags.Count > 0;

    private sealed class GrilleModel
    {
        public List<string> TechniqueTags { get; set; } = [];
        public List<string> ComportementaleTags { get; set; } = [];
        public List<string> CulturelleTags { get; set; } = [];
        public int? RythmeTravail { get; set; }
        public List<string> MotivationnelleTags { get; set; } = [];
        public List<string> PointsVigilanceTags { get; set; } = [];

        public string? TechniqueNotes { get; set; }
        public string? ComportementaleNotes { get; set; }
        public string? CulturelleNotes { get; set; }
        public string? OrganisationnelleNotes { get; set; }
        public string? MotivationnelleNotes { get; set; }
        public string? PointsVigilanceNotes { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        _candidateProfileId = await CandidateProfileService.GetOrCreateProfileIdAsync(userId);
        _questions = (await CandidateProfileService.GetQuestionnaireAsync(_candidateProfileId)).ToList();
        _synthesis = await CandidateProfileService.GetLastSynthesisAsync(_candidateProfileId);
        _currentAnswer = _questions.Count > 0 ? _questions[0].AnswerText ?? "" : "";

        var criteria = await CandidateProfileService.GetCompatibilityCriteriaAsync(_candidateProfileId);
        if (criteria is not null)
        {
            _grille.TechniqueTags = criteria.TechniqueTags.ToList();
            _grille.ComportementaleTags = criteria.ComportementaleTags.ToList();
            _grille.CulturelleTags = criteria.CulturelleTags.ToList();
            _grille.RythmeTravail = criteria.RythmeTravail;
            _grille.MotivationnelleTags = criteria.MotivationnelleTags.ToList();
            _grille.PointsVigilanceTags = criteria.PointsVigilanceTags.ToList();
            _grille.TechniqueNotes = criteria.TechniqueNotes;
            _grille.ComportementaleNotes = criteria.ComportementaleNotes;
            _grille.CulturelleNotes = criteria.CulturelleNotes;
            _grille.OrganisationnelleNotes = criteria.OrganisationnelleNotes;
            _grille.MotivationnelleNotes = criteria.MotivationnelleNotes;
            _grille.PointsVigilanceNotes = criteria.PointsVigilanceNotes;
        }
    }

    private async Task SaveCurrentAsync()
    {
        if (_questions is null || _currentIndex >= _questions.Count) return;
        var question = _questions[_currentIndex];
        await CandidateProfileService.SaveAnswerAsync(_candidateProfileId, question.QuestionId, _currentAnswer);
        _questions[_currentIndex] = question with { AnswerText = _currentAnswer, UpdatedAt = DateTimeOffset.UtcNow };
        _synthesis = await CandidateProfileService.GenerateSynthesisAsync(_candidateProfileId);
    }

    /// <summary>
    /// Mutation ciblée : met à jour l'état local (pour l'affichage immédiat de la case) puis persiste
    /// UNIQUEMENT ce tag via le service, qui gère lui-même la concurrence (voir CandidateProfileService.
    /// ToggleTagAsync). On ne reconstruit plus un instantané complet de la grille à chaque case cochée —
    /// c'était exactement le mécanisme de la perte de mise à jour corrigée dans ce cycle.
    /// </summary>
    private async Task ToggleTagAsync(CriteriaField field, List<string> tags, string tag, bool isChecked)
    {
        if (isChecked) { if (!tags.Contains(tag)) tags.Add(tag); }
        else tags.Remove(tag);
        await CandidateProfileService.ToggleTagAsync(_candidateProfileId, field, tag, isChecked);
        _grilleSaved = true;
    }

    private async Task OnRythmeChangedAsync(ChangeEventArgs e)
    {
        _grille.RythmeTravail = int.TryParse(e.Value?.ToString(), out var v) ? v : null;
        await CandidateProfileService.SetRythmeTravailAsync(_candidateProfileId, _grille.RythmeTravail);
        _grilleSaved = true;
    }

    private async Task SaveNotesAsync(CriteriaField field, string? notes)
    {
        await CandidateProfileService.SetNotesAsync(_candidateProfileId, field, notes);
        _grilleSaved = true;
    }

    private async Task NextAsync()
    {
        await SaveCurrentAsync();
        if (_questions is null) return;
        if (_currentIndex < _questions.Count)
        {
            _currentIndex++;
            _currentAnswer = _currentIndex < _questions.Count ? _questions[_currentIndex].AnswerText ?? "" : "";
        }
    }

    private async Task PreviousAsync()
    {
        if (_currentIndex >= _questions!.Count)
        {
            // On revient depuis la grille : rien à sauvegarder côté questionnaire.
            _currentIndex--;
            _currentAnswer = _questions[_currentIndex].AnswerText ?? "";
            return;
        }

        await SaveCurrentAsync();
        if (_currentIndex > 0)
        {
            _currentIndex--;
            _currentAnswer = _questions[_currentIndex].AnswerText ?? "";
        }
    }

    private static string ExamplesPlaceholder(CandidateQuestionView question) => string.Join(" · ", question.Examples);
}
