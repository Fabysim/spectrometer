@page "/candidat/cv"
@page "/coach/suivis/{SuiviUserId}/cv"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Spectrometre.Modules.ProfilCandidat.Entities
@using Spectrometre.Modules.ProfilCandidat.Resources
@using Spectrometre.Modules.ProfilCandidat.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ICandidateProfileService CandidateProfileService
@inject ICvCoachQuery CvCoachQuery
@inject ICvImportService CvImportService
@inject IStringLocalizer<ProfilCandidatResource> Localizer

<PageTitle>@Localizer["CurriculumVitae"]</PageTitle>

<div class="cv-page @(_lectureSeule ? "lecture-seule" : null) @(_modeRelectureImport ? "relecture-import" : null)">
@if (_accesRefuse)
{
    <header class="cv-header">
        <div>
            <h1 class="cv-title">@Localizer["Cv_AccesRefuse_Titre"]</h1>
            <p class="cv-subtitle">@Localizer["Cv_AccesRefuse_Message"]</p>
        </div>
    </header>
}
else
{
    <header class="cv-header">
        <div>
            <h1 class="cv-title">@Localizer["CurriculumVitae"]</h1>
            @if (_lectureSeule)
            {
                <p class="cv-subtitle">@Localizer["Cv_ModeCoach"]</p>
            }
            else
            {
                <p class="cv-subtitle">
                    @Localizer["Cv_Intro"]
                    (<a class="cv-link" href="/candidat/questionnaire">@Localizer["Cv_LienQuestionnaire"]</a>)
                </p>
            }
        </div>
        @if (!_lectureSeule)
        {
            <a class="cv-link" href="/candidat/cv/pdf" data-enhance-nav="false">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                @Localizer["Cv_TelechargerPdf"]
            </a>
        }
    </header>

    @if (!_lectureSeule)
    {
        <section class="cv-card cv-import">
            <h2 class="cv-section-title">@Localizer["Cv_Import_Titre"]</h2>
            <p class="cv-subtitle">@Localizer["Cv_Import_Intro"]</p>
            <label class="cv-btn-secondary cv-import-label">
                @Localizer["Cv_Import_Bouton"]
                <InputFile accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                           OnChange="OnImportFichierAsync" />
            </label>
            @if (_importEnCours)
            {
                <p class="cv-state">@Localizer["Cv_Import_EnCours"]</p>
            }
            else if (_importMessage is not null)
            {
                <p class="cv-state">@_importMessage</p>
            }
        </section>
    }

    @if (_modeRelectureImport)
    {
        <div class="cv-import-banner" role="status">
            <p>@Localizer["Cv_Import_Relire"]</p>
            <div class="cv-actions">
                <button type="button" class="cv-btn-primary" @onclick="ConfirmerImportAsync" disabled="@_importEnCours">
                    @Localizer["Cv_Import_Confirmer"]
                </button>
                <button type="button" class="cv-btn-secondary" @onclick="AnnulerImportAsync" disabled="@_importEnCours">
                    @Localizer["Cv_Import_Annuler"]
                </button>
            </div>
        </div>
    }

    @if (_cv is null)
    {
        <p class="cv-state">@Localizer["Chargement"]</p>
    }
    else
    {
        <fieldset class="cv-fieldset" disabled="@_lectureSeule">
    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-person-vcard"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section1"]</h2>
        <div class="cv-form">
            <div class="cv-form-row">
                <div class="cv-field">
                    <label>@Localizer["Nom"]</label>
                    <input class="cv-input" @bind="_coordonnees.Nom" />
                </div>
                <div class="cv-field">
                    <label>@Localizer["Prenoms"]</label>
                    <input class="cv-input" @bind="_coordonnees.Prenoms" />
                </div>
            </div>
            <div class="cv-form-row">
                <div class="cv-field">
                    <label>@Localizer["DateNaissance"]</label>
                    <input class="cv-input" type="date" @bind="_coordonnees.DateNaissance" />
                </div>
                <div class="cv-field">
                    <label>@Localizer["LieuNaissance"]</label>
                    <input class="cv-input" @bind="_coordonnees.LieuNaissance" />
                </div>
            </div>
            <div class="cv-field">
                <label>@Localizer["Nationalite"]</label>
                <input class="cv-input" @bind="_coordonnees.Nationalite" />
            </div>
            <div class="cv-field">
                <label>@Localizer["AdresseComplete"]</label>
                <input class="cv-input" @bind="_coordonnees.AdresseComplete" />
            </div>
            <div class="cv-form-row">
                <div class="cv-field">
                    <label>@Localizer["Telephone"]</label>
                    <input class="cv-input" @bind="_coordonnees.Telephone" />
                </div>
                <div class="cv-field">
                    <label>@Localizer["AdresseElectronique"]</label>
                    <input class="cv-input" @bind="_coordonnees.Email" />
                </div>
            </div>
            <div class="cv-field">
                <label>@Localizer["ProfilOuPosteRecherche"]</label>
                <input class="cv-input" @bind="_coordonnees.ProfilOuPosteRecherche" />
            </div>
            <div class="cv-actions">
                @if (_coordonneesSaved)
                {
                    <span class="cv-confirmation">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["Enregistre"]
                    </span>
                }
                <button type="button" class="cv-btn-primary" @onclick="SaveCoordonneesAsync">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    @Localizer["EnregistrerLesCoordonnees"]
                </button>
            </div>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-mortarboard"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section2"]</h2>
        <div class="cv-rows">
            @foreach (var row in _formations)
            {
                <div class="cv-ligne">
                    <div class="cv-ligne-fields">
                        <input class="cv-input" placeholder="@Localizer["Cv_PeriodeExemple"]" @bind="row.Periode" />
                        <input class="cv-input" placeholder="@Localizer["Etablissement"]" @bind="row.Etablissement" />
                        <input class="cv-input" placeholder="@Localizer["DiplomeCertificatOuNiveau"]" @bind="row.Diplome" />
                        <input class="cv-input" placeholder="@Localizer["DomaineEtudes"]" @bind="row.Domaine" />
                    </div>
                    <div class="cv-ligne-actions">
                        <button type="button" class="cv-btn-primary" @onclick="() => SaveFormationAsync(row)">@Localizer["Enregistrer"]</button>
                        <button type="button" class="cv-btn-secondary" @onclick="() => DeleteFormationAsync(row)">@Localizer["Supprimer"]</button>
                        @if (row.Saved)
                        {
                            <span class="cv-confirmation" title="@Localizer["Enregistre"]">
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="cv-actions cv-actions-start">
            <button type="button" class="cv-btn-ghost" @onclick="AjouterFormation">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                @Localizer["AjouterUneFormation"]
            </button>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-tools"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section3"]</h2>
        <div class="cv-form">
            <div class="cv-field">
                <label>@Localizer["SpecialitePrincipale"]</label>
                <input class="cv-input" @bind="_competencesEtudes.SpecialitePrincipale" />
            </div>
            <div class="cv-field">
                <label>@Localizer["CompetencesTechniquesAcquises"]</label>
                <textarea class="cv-input cv-textarea" @bind="_competencesEtudes.CompetencesTechniques" rows="2"></textarea>
            </div>
            <div class="cv-field">
                <label>@Localizer["ConnaissancesTheoriquesImportantes"]</label>
                <textarea class="cv-input cv-textarea" @bind="_competencesEtudes.ConnaissancesTheoriques" rows="2"></textarea>
            </div>
            <div class="cv-field">
                <label>@Localizer["LanguesMaitrisees"]</label>
                <input class="cv-input" @bind="_competencesEtudes.LanguesMaitrisees" />
            </div>
            <div class="cv-field">
                <label>@Localizer["OutilsLogicielsMethodesEtudies"]</label>
                <input class="cv-input" @bind="_competencesEtudes.OutilsLogicielsMethodes" />
            </div>
            <div class="cv-actions">
                @if (_competencesEtudesSaved)
                {
                    <span class="cv-confirmation">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["Enregistre"]
                    </span>
                }
                <button type="button" class="cv-btn-primary" @onclick="SaveCompetencesEtudesAsync">@Localizer["Enregistrer"]</button>
            </div>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-briefcase"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section4"]</h2>
        <div class="cv-rows">
            @foreach (var row in _experiences)
            {
                <div class="cv-ligne">
                    <div class="cv-ligne-fields">
                        <input class="cv-input" placeholder="@Localizer["Periode"]" @bind="row.Periode" />
                        <input class="cv-input" placeholder="@Localizer["EntrepriseOrganisationOuLieuStage"]" @bind="row.Entreprise" />
                        <input class="cv-input" placeholder="@Localizer["FonctionOuActiviteExercee"]" @bind="row.Fonction" />
                        <input class="cv-input" placeholder="@Localizer["CompetencesDeveloppees"]" @bind="row.Competences" />
                    </div>
                    <div class="cv-ligne-actions">
                        <button type="button" class="cv-btn-primary" @onclick="() => SaveExperienceAsync(row)">@Localizer["Enregistrer"]</button>
                        <button type="button" class="cv-btn-secondary" @onclick="() => DeleteExperienceAsync(row)">@Localizer["Supprimer"]</button>
                        @if (row.Saved)
                        {
                            <span class="cv-confirmation" title="@Localizer["Enregistre"]">
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="cv-actions cv-actions-start">
            <button type="button" class="cv-btn-ghost" @onclick="AjouterExperience">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                @Localizer["AjouterUneExperience"]
            </button>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-emoji-smile"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section5"]</h2>
        <div class="cv-form">
            <div class="cv-field">
                <label>@Localizer["QualitesPersonnelles"]</label>
                <textarea class="cv-input cv-textarea" @bind="_caracteristiques.QualitesPersonnelles" rows="2" placeholder="@Localizer["QualitesPersonnellesExemples"]"></textarea>
            </div>
            <div class="cv-field">
                <label>@Localizer["AptitudesProfessionnelles"]</label>
                <textarea class="cv-input cv-textarea" @bind="_caracteristiques.AptitudesProfessionnelles" rows="2" placeholder="@Localizer["AptitudesProfessionnellesExemples"]"></textarea>
            </div>
            <div class="cv-field">
                <label>@Localizer["AttitudesRelationnelles"]</label>
                <textarea class="cv-input cv-textarea" @bind="_caracteristiques.AttitudesRelationnelles" rows="2" placeholder="@Localizer["AttitudesRelationnellesExemples"]"></textarea>
            </div>
            <div class="cv-form-row">
                <div class="cv-field">
                    <label>@Localizer["CapaciteSousPression"]</label>
                    <input class="cv-input" @bind="_caracteristiques.CapaciteSousPression" />
                </div>
                <div class="cv-field">
                    <label>@Localizer["DisponibiliteMobilite"]</label>
                    <input class="cv-input" @bind="_caracteristiques.DisponibiliteMobilite" />
                </div>
            </div>
            <div class="cv-actions">
                @if (_caracteristiquesSaved)
                {
                    <span class="cv-confirmation">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["Enregistre"]
                    </span>
                }
                <button type="button" class="cv-btn-primary" @onclick="SaveCaracteristiquesAsync">@Localizer["Enregistrer"]</button>
            </div>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-heart"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section6"]</h2>
        <div class="cv-form">
            <div class="cv-field">
                <label>@Localizer["LoisirsPreferes"]</label>
                <input class="cv-input" @bind="_loisirs.LoisirsPreferes" />
            </div>
            <div class="cv-field">
                <label>@Localizer["ActivitesSportivesCulturelles"]</label>
                <input class="cv-input" @bind="_loisirs.ActivitesSportivesCulturelles" />
            </div>
            <div class="cv-field">
                <label>@Localizer["EngagementsAssociatifs"]</label>
                <input class="cv-input" @bind="_loisirs.EngagementsAssociatifs" />
            </div>
            <div class="cv-field">
                <label>@Localizer["AutresCentresInteret"]</label>
                <input class="cv-input" @bind="_loisirs.AutresCentresInteret" />
            </div>
            <div class="cv-actions">
                @if (_loisirsSaved)
                {
                    <span class="cv-confirmation">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["Enregistre"]
                    </span>
                }
                <button type="button" class="cv-btn-primary" @onclick="SaveLoisirsAsync">@Localizer["Enregistrer"]</button>
            </div>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-people"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section7"]</h2>
        <p class="cv-hint">@Localizer["Cv_ReferencesHint"]</p>
        <div class="cv-rows">
            @foreach (var row in _references)
            {
                <div class="cv-ligne">
                    <div class="cv-ligne-fields">
                        <input class="cv-input" placeholder="@Localizer["NomEtPrenom"]" @bind="row.NomPrenom" />
                        <input class="cv-input" placeholder="@Localizer["Fonction"]" @bind="row.Fonction" />
                        <input class="cv-input" placeholder="@Localizer["EntrepriseOuOrganisation"]" @bind="row.Entreprise" />
                        <input class="cv-input" placeholder="@Localizer["TelephoneOuAdresseElectronique"]" @bind="row.Contact" />
                        <input class="cv-input" placeholder="@Localizer["LienAvecLePostulant"]" @bind="row.Lien" />
                    </div>
                    <div class="cv-ligne-actions">
                        <button type="button" class="cv-btn-primary" @onclick="() => SaveReferenceAsync(row)">@Localizer["Enregistrer"]</button>
                        <button type="button" class="cv-btn-secondary" @onclick="() => DeleteReferenceAsync(row)">@Localizer["Supprimer"]</button>
                        @if (row.Saved)
                        {
                            <span class="cv-confirmation" title="@Localizer["Enregistre"]">
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="cv-actions cv-actions-start">
            <button type="button" class="cv-btn-ghost" @onclick="AjouterReference">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                @Localizer["AjouterUneReference"]
            </button>
        </div>
    </section>

    <section class="cv-card">
        <div class="cv-card-icon tone-primary" aria-hidden="true">
            <i class="bi bi-pen"></i>
        </div>
        <h2 class="cv-section-title">@Localizer["Cv_Section8"]</h2>
        <p class="cv-hint">@Localizer["Cv_DeclarationHint1"]</p>
        <p class="cv-hint">@Localizer["Cv_DeclarationHint2"]</p>
        <div class="cv-form">
            <div class="cv-checkbox">
                <label>
                    <input type="checkbox" @bind="_declaration.CertificationExactitude" />
                    @Localizer["Cv_CertificationExactitude"]
                </label>
            </div>
            <div class="cv-checkbox">
                <label>
                    <input type="checkbox" @bind="_declaration.ConsentementConsultation" />
                    @Localizer["Cv_ConsentementConsultation"]
                </label>
            </div>
            <div class="cv-form-row">
                <div class="cv-field">
                    <label>@Localizer["Date"]</label>
                    <input class="cv-input" type="date" @bind="_declaration.Date" />
                </div>
                <div class="cv-field">
                    <label>@Localizer["Cv_SignatureDuPostulant"]</label>
                    <input class="cv-input" @bind="_declaration.NomSignataire" />
                </div>
            </div>
            <div class="cv-actions">
                @if (_declarationSaved)
                {
                    <span class="cv-confirmation">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["Enregistre"]
                    </span>
                }
                <button type="button" class="cv-btn-primary" @onclick="SaveDeclarationAsync">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    @Localizer["EnregistrerLaDeclaration"]
                </button>
            </div>
        </div>
    </section>
        </fieldset>
    }
}
</div>

@code {
    [Parameter] public string? SuiviUserId { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private int _candidateProfileId;
    private CvView? _cv;
    private bool _lectureSeule;
    private bool _accesRefuse;
    private bool _modeRelectureImport;
    private bool _importEnCours;
    private string? _importMessage;

    private readonly CoordonneesModel _coordonnees = new();
    private bool _coordonneesSaved;

    private readonly List<FormationRow> _formations = [];

    private readonly CompetencesEtudesModel _competencesEtudes = new();
    private bool _competencesEtudesSaved;

    private readonly List<ExperienceRow> _experiences = [];

    private readonly CaracteristiquesModel _caracteristiques = new();
    private bool _caracteristiquesSaved;

    private readonly LoisirsModel _loisirs = new();
    private bool _loisirsSaved;

    private readonly List<ReferenceRow> _references = [];

    private readonly DeclarationModel _declaration = new();
    private bool _declarationSaved;

    private sealed class CoordonneesModel
    {
        public string? Nom { get; set; }
        public string? Prenoms { get; set; }
        public DateOnly? DateNaissance { get; set; }
        public string? LieuNaissance { get; set; }
        public string? Nationalite { get; set; }
        public string? AdresseComplete { get; set; }
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public string? ProfilOuPosteRecherche { get; set; }
    }

    private sealed class FormationRow
    {
        public int? Id { get; set; }
        public string? Periode { get; set; }
        public string? Etablissement { get; set; }
        public string? Diplome { get; set; }
        public string? Domaine { get; set; }
        public bool Saved { get; set; }
    }

    private sealed class CompetencesEtudesModel
    {
        public string? SpecialitePrincipale { get; set; }
        public string? CompetencesTechniques { get; set; }
        public string? ConnaissancesTheoriques { get; set; }
        public string? LanguesMaitrisees { get; set; }
        public string? OutilsLogicielsMethodes { get; set; }
    }

    private sealed class ExperienceRow
    {
        public int? Id { get; set; }
        public string? Periode { get; set; }
        public string? Entreprise { get; set; }
        public string? Fonction { get; set; }
        public string? Competences { get; set; }
        public bool Saved { get; set; }
    }

    private sealed class CaracteristiquesModel
    {
        public string? QualitesPersonnelles { get; set; }
        public string? AptitudesProfessionnelles { get; set; }
        public string? AttitudesRelationnelles { get; set; }
        public string? CapaciteSousPression { get; set; }
        public string? DisponibiliteMobilite { get; set; }
    }

    private sealed class LoisirsModel
    {
        public string? LoisirsPreferes { get; set; }
        public string? ActivitesSportivesCulturelles { get; set; }
        public string? EngagementsAssociatifs { get; set; }
        public string? AutresCentresInteret { get; set; }
    }

    private sealed class ReferenceRow
    {
        public int? Id { get; set; }
        public string? NomPrenom { get; set; }
        public string? Fonction { get; set; }
        public string? Entreprise { get; set; }
        public string? Contact { get; set; }
        public string? Lien { get; set; }
        public bool Saved { get; set; }
    }

    private sealed class DeclarationModel
    {
        public bool CertificationExactitude { get; set; }
        public bool ConsentementConsultation { get; set; }
        public DateOnly? Date { get; set; }
        public string? NomSignataire { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = "anonymous";
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? userId;
        }

        if (!string.IsNullOrWhiteSpace(SuiviUserId))
        {
            _lectureSeule = true;
            _cv = await CvCoachQuery.TryGetPourCoachAsync(userId, SuiviUserId);
            if (_cv is null)
            {
                _accesRefuse = true;
                return;
            }
        }
        else
        {
            _candidateProfileId = await CandidateProfileService.GetOrCreateProfileIdAsync(userId);
            _cv = await CandidateProfileService.GetCvAsync(_candidateProfileId);
        }

        ChargerDansFormulaire(_cv);
    }

    private void ChargerDansFormulaire(CvView cv)
    {
        _coordonnees.Nom = cv.Coordonnees?.Nom;
        _coordonnees.Prenoms = cv.Coordonnees?.Prenoms;
        _coordonnees.DateNaissance = cv.Coordonnees?.DateNaissance;
        _coordonnees.LieuNaissance = cv.Coordonnees?.LieuNaissance;
        _coordonnees.Nationalite = cv.Coordonnees?.Nationalite;
        _coordonnees.AdresseComplete = cv.Coordonnees?.AdresseComplete;
        _coordonnees.Telephone = cv.Coordonnees?.Telephone;
        _coordonnees.Email = cv.Coordonnees?.Email;
        _coordonnees.ProfilOuPosteRecherche = cv.Coordonnees?.ProfilOuPosteRecherche;

        _formations.Clear();
        _formations.AddRange(cv.Formations.Select(f => new FormationRow
        {
            Id = f.Id > 0 ? f.Id : null,
            Periode = f.Periode,
            Etablissement = f.Etablissement,
            Diplome = f.DiplomeCertificatOuNiveau,
            Domaine = f.DomaineEtudes,
            Saved = f.Id > 0,
        }));

        _competencesEtudes.SpecialitePrincipale = cv.CompetencesEtudes?.SpecialitePrincipale;
        _competencesEtudes.CompetencesTechniques = cv.CompetencesEtudes?.CompetencesTechniques;
        _competencesEtudes.ConnaissancesTheoriques = cv.CompetencesEtudes?.ConnaissancesTheoriques;
        _competencesEtudes.LanguesMaitrisees = cv.CompetencesEtudes?.LanguesMaitrisees;
        _competencesEtudes.OutilsLogicielsMethodes = cv.CompetencesEtudes?.OutilsLogicielsMethodes;

        _experiences.Clear();
        _experiences.AddRange(cv.Experiences.Select(x => new ExperienceRow
        {
            Id = x.Id > 0 ? x.Id : null,
            Periode = x.Periode,
            Entreprise = x.EntrepriseOrganisationOuStage,
            Fonction = x.FonctionOuActiviteExercee,
            Competences = x.CompetencesDeveloppees,
            Saved = x.Id > 0,
        }));

        _caracteristiques.QualitesPersonnelles = cv.CaracteristiquesPersonnelles?.QualitesPersonnelles;
        _caracteristiques.AptitudesProfessionnelles = cv.CaracteristiquesPersonnelles?.AptitudesProfessionnelles;
        _caracteristiques.AttitudesRelationnelles = cv.CaracteristiquesPersonnelles?.AttitudesRelationnelles;
        _caracteristiques.CapaciteSousPression = cv.CaracteristiquesPersonnelles?.CapaciteSousPression;
        _caracteristiques.DisponibiliteMobilite = cv.CaracteristiquesPersonnelles?.DisponibiliteMobilite;

        _loisirs.LoisirsPreferes = cv.Loisirs?.LoisirsPreferes;
        _loisirs.ActivitesSportivesCulturelles = cv.Loisirs?.ActivitesSportivesCulturelles;
        _loisirs.EngagementsAssociatifs = cv.Loisirs?.EngagementsAssociatifs;
        _loisirs.AutresCentresInteret = cv.Loisirs?.AutresCentresInteret;

        _references.Clear();
        _references.AddRange(cv.References.Select(r => new ReferenceRow
        {
            Id = r.Id > 0 ? r.Id : null,
            NomPrenom = r.NomPrenom,
            Fonction = r.Fonction,
            Entreprise = r.EntrepriseOrganisation,
            Contact = r.TelephoneOuEmail,
            Lien = r.LienAvecPostulant,
            Saved = r.Id > 0,
        }));

        _declaration.CertificationExactitude = cv.Declaration?.CertificationExactitude ?? false;
        _declaration.ConsentementConsultation = cv.Declaration?.ConsentementConsultation ?? false;
        _declaration.Date = cv.Declaration?.Date;
        _declaration.NomSignataire = cv.Declaration?.NomSignataire;
    }

    private async Task OnImportFichierAsync(InputFileChangeEventArgs e)
    {
        if (_lectureSeule || _importEnCours)
            return;

        var file = e.File;
        _importEnCours = true;
        _importMessage = null;
        try
        {
            if (file.Size > ICvDocumentTextExtractor.TailleMaxOctets)
            {
                _importMessage = Localizer["Cv_Import_FichierTropVolumineux"];
                return;
            }

            await using var stream = file.OpenReadStream(ICvDocumentTextExtractor.TailleMaxOctets);
            var result = await CvImportService.ImporterAsync(stream, file.Name, file.ContentType, file.Size);
            _importMessage = Localizer[result.MessageKey];
            if (!result.Success || result.Brouillon is null)
                return;

            ChargerDansFormulaire(result.Brouillon);
            _cv = result.Brouillon;
            _modeRelectureImport = true;
        }
        catch
        {
            _importMessage = Localizer["Cv_Import_IaEchec"];
        }
        finally
        {
            _importEnCours = false;
        }
    }

    private async Task ConfirmerImportAsync()
    {
        if (_lectureSeule || !_modeRelectureImport)
            return;

        _importEnCours = true;
        try
        {
            var actuel = await CandidateProfileService.GetCvAsync(_candidateProfileId);
            foreach (var f in actuel.Formations)
                await CandidateProfileService.DeleteFormationAsync(_candidateProfileId, f.Id);
            foreach (var x in actuel.Experiences)
                await CandidateProfileService.DeleteExperienceAsync(_candidateProfileId, x.Id);
            foreach (var r in actuel.References)
                await CandidateProfileService.DeleteReferenceAsync(_candidateProfileId, r.Id);

            _modeRelectureImport = false;
            await SaveCoordonneesAsync();
            foreach (var row in _formations.ToList())
            {
                row.Id = null;
                await SaveFormationAsync(row);
            }

            await SaveCompetencesEtudesAsync();
            foreach (var row in _experiences.ToList())
            {
                row.Id = null;
                await SaveExperienceAsync(row);
            }

            await SaveCaracteristiquesAsync();
            await SaveLoisirsAsync();
            foreach (var row in _references.ToList())
            {
                row.Id = null;
                await SaveReferenceAsync(row);
            }

            _cv = await CandidateProfileService.GetCvAsync(_candidateProfileId);
            ChargerDansFormulaire(_cv);
            _importMessage = Localizer["Cv_Import_Enregistre"];
        }
        finally
        {
            _importEnCours = false;
        }
    }

    private async Task AnnulerImportAsync()
    {
        if (_lectureSeule)
            return;

        _modeRelectureImport = false;
        _cv = await CandidateProfileService.GetCvAsync(_candidateProfileId);
        ChargerDansFormulaire(_cv);
        _importMessage = Localizer["Cv_Import_Annule"];
    }

