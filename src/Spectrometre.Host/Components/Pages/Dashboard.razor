@page "/dashboard"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Billing
@using Spectrometre.Core.Data
@using Spectrometre.Core.Identity
@using Spectrometre.Core.Modules
@using Spectrometre.Core.Tenancy
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@using Spectrometre.Modules.Admin.Services
@using Spectrometre.Modules.JeunesPrestataires.Services
@using Spectrometre.Modules.Missions.Services
@inject IModuleRegistry ModuleRegistry
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ICandidateSubjectResolver CandidateSubjectResolver
@inject ICoachSubjectResolver CoachSubjectResolver
@inject IAdminService AdminService
@inject IJeuneProfileService JeuneProfileService
@inject IParticulierProfileService ParticulierProfileService
@inject IConsentementParentalService ConsentementParentalService
@inject ICoachDashboardService CoachDashboardService
@inject CoreDbContext CoreDb
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["TableauDeBord"]</PageTitle>

<div class="dashboard-page">
    <div class="header-bar-dashboard">
        <div class="welcome-section-dashboard">
            <h1>@Localizer["TableauDeBord"]</h1>
            <p>@(_isPlatformAdmin ? Localizer["Home_AdminBienvenue"] : Localizer["Home_Bienvenue"])</p>
        </div>
        <div class="header-actions-dashboard">
            @if (!_isAuthenticated)
            {
                <a href="/login" class="btn-secondary-modern-dashboard">@Localizer["SeConnecter"]</a>
                <a href="/inscription" class="btn-primary-modern-dashboard">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    @Localizer["CreerUnCompte"]
                </a>
            }
            else if (_isPlatformAdmin)
            {
                <a href="/admin/facturation" class="btn-primary-modern-dashboard">
                    <i class="bi bi-receipt" aria-hidden="true"></i>
                    @Localizer["Home_AdminVoirFacturation"]
                </a>
            }
            else if (_company is null && !_estCandidatOuCoach && !_estJeune && !_estParticulier)
            {
                <a href="/entreprise/creer" class="btn-primary-modern-dashboard">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    @Localizer["CreerUneEntreprise"]
                </a>
            }
            else if (_company is not null)
            {
                <a href="/entreprise/modules" class="btn-primary-modern-dashboard">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    @Localizer["AjouterUnModule"]
                </a>
            }
        </div>
    </div>

    @if (!_isAuthenticated)
    {
        <section class="card-modern-dashboard dashboard-guest-card">
            <div class="card-header-modern-dashboard">
                <h2 class="card-title-modern-dashboard">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    @Localizer["Connexion"]
                </h2>
            </div>
            <p class="dashboard-hint">@Localizer["Home_Bienvenue"]</p>
            <div class="dashboard-inline-actions">
                <a href="/login" class="btn-primary-modern-dashboard">@Localizer["SeConnecter"]</a>
                <a href="/inscription" class="btn-secondary-modern-dashboard">@Localizer["CreerUnCompte"]</a>
            </div>
        </section>
    }
    else
    {
        <div class="content-grid-dashboard">
            @if (_isPlatformAdmin)
            {
                <section class="card-modern-dashboard">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <span>@Localizer["Home_AdminCompteurs"]</span>
                        </h2>
                        <a href="/admin" class="card-action-dashboard">
                            @Localizer["Home_AdminVoirTout"]
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>
                    <div class="dashboard-admin-stats">
                        <a href="/admin/entreprises" class="dashboard-admin-stat">
                            <span class="dashboard-admin-stat-value">@(_compteurs?.TotalEntreprises ?? 0)</span>
                            <span class="dashboard-admin-stat-label">@Localizer["Home_AdminEntreprises"]</span>
                        </a>
                        <a href="/admin/candidats" class="dashboard-admin-stat">
                            <span class="dashboard-admin-stat-value">@(_compteurs?.TotalCandidats ?? 0)</span>
                            <span class="dashboard-admin-stat-label">@Localizer["Home_AdminCandidats"]</span>
                        </a>
                        <a href="/admin/coachs" class="dashboard-admin-stat">
                            <span class="dashboard-admin-stat-value">@(_compteurs?.TotalCoachs ?? 0)</span>
                            <span class="dashboard-admin-stat-label">@Localizer["Home_AdminCoachs"]</span>
                        </a>
                        <a href="/admin/facturation" class="dashboard-admin-stat @( (_enRetardTotal > 0) ? "is-alert" : "" )">
                            <span class="dashboard-admin-stat-value">@_enRetardTotal</span>
                            <span class="dashboard-admin-stat-label">@Localizer["Home_AdminEnRetard"]</span>
                        </a>
                    </div>
                </section>

                <section class="card-modern-dashboard">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span>@Localizer["Home_AdminEnRetard"]</span>
                        </h2>
                        <a href="/admin/facturation" class="card-action-dashboard">
                            @Localizer["Home_AdminVoirFacturation"]
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>
                    @if (_enRetard.Count == 0)
                    {
                        <p class="dashboard-hint">@Localizer["Home_AdminAucunRetard"]</p>
                    }
                    else
                    {
                        <div class="dashboard-admin-table-wrap">
                            <table class="dashboard-admin-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Home_AdminSujet"]</th>
                                        <th>@Localizer["Home_AdminMontant"]</th>
                                        <th>@Localizer["Home_AdminEcheance"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in _enRetard.Take(8))
                                    {
                                        <tr>
                                            <td>
                                                <span class="dashboard-admin-type">@a.SubjectType</span>
                                                @a.Libelle
                                            </td>
                                            <td>@a.MontantDu.ToString("0.##") @a.Devise</td>
                                            <td>@(a.RenewalDate?.ToString("d") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="card-modern-dashboard">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-calendar-event" aria-hidden="true"></i>
                            <span>@Localizer["Home_AdminEcheancesBientot"]</span>
                        </h2>
                        <a href="/admin/facturation" class="card-action-dashboard">
                            @Localizer["Home_AdminVoirFacturation"]
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>
                    @if (_echeancesBientot.Count == 0)
                    {
                        <p class="dashboard-hint">@Localizer["Home_AdminAucuneEcheance"]</p>
                    }
                    else
                    {
                        <div class="dashboard-admin-table-wrap">
                            <table class="dashboard-admin-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Home_AdminSujet"]</th>
                                        <th>@Localizer["Home_AdminMontant"]</th>
                                        <th>@Localizer["Home_AdminEcheance"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in _echeancesBientot.Take(8))
                                    {
                                        <tr>
                                            <td>
                                                <span class="dashboard-admin-type">@a.SubjectType</span>
                                                @a.Libelle
                                            </td>
                                            <td>@a.MontantDu.ToString("0.##") @a.Devise</td>
                                            <td>@(a.RenewalDate?.ToString("d") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (_estJeune)
            {
                <section class="card-modern-dashboard">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-person-hearts" aria-hidden="true"></i>
                            <span>@Localizer["Home_EspaceJeune"]</span>
                        </h2>
                    </div>
                    <p class="dashboard-hint">@Localizer["Home_EspaceJeuneIntro"]</p>
                    <div class="quick-actions-dashboard">
                        <a href="/jeune/mes-progres" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-teal">
                                <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_MesProgres"]</div>
                        </a>
                        <a href="/jeune/auto-observation" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-teal">
                                <i class="bi bi-ui-checks" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_QuestionnaireAutoObservation"]</div>
                        </a>
                        <a href="/jeune/grille-observation" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-purple">
                                <i class="bi bi-clipboard2-data" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_GrilleObservation"]</div>
                        </a>
                        <a href="/candidat/cv" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-blue">
                                <i class="bi bi-file-earmark-person" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_MonCv"]</div>
                        </a>
                        <a href="/jeune/missions-disponibles" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-green">
                                <i class="bi bi-briefcase" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_MissionsDisponibles"]</div>
                        </a>
                        <a href="/jeune/mes-missions" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-orange">
                                <i class="bi bi-list-check" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_MesMissionsJeune"]</div>
                        </a>
                        <a href="/jeune/mes-astuces" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-teal">
                                <i class="bi bi-lightbulb" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_MesAstuces"]</div>
                        </a>
                        <a href="/jeune/charte" class="quick-action-btn-dashboard">
                            <div class="quick-action-icon-dashboard tone-blue">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                            </div>
                            <div class="quick-action-label-dashboard">@Localizer["Home_Charte"]</div>
                        </a>
                        @if (_consentementParentalACompleter)
                        {
                            <a href="/candidat/consentement-parental" class="quick-action-btn-dashboard">
                                <div class="quick-action-icon-dashboard tone-orange">
                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                </div>
                                <div class="quick-action-label-dashboard">
                                    @Localizer["Home_ConsentementParental"]
                                    <span class="dashboard-badge-todo">@Localizer["Home_ACompleter"]</span>
                                </div>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (_company is not null || (!_estCandidatOuCoach && !_estJeune && !_estParticulier && !_isPlatformAdmin))
            {
            <section class="card-modern-dashboard">
                <div class="card-header-modern-dashboard">
                    <h2 class="card-title-modern-dashboard">
                        <i class="bi bi-building" aria-hidden="true"></i>
                        @if (_company is not null)
                        {
                            <span>@Localizer["Home_EntreprisePrefix"] @_company.Name</span>
                        }
                        else
                        {
                            <span>@Localizer["Entreprise"]</span>
                        }
                    </h2>
                    @if (_company is not null)
                    {
                        <a href="/entreprise/modules" class="card-action-dashboard">
                            @Localizer["AjouterUnModule"]
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>

                @if (_company is null && !_estCandidatOuCoach && !_estJeune && !_estParticulier && !_isPlatformAdmin)
                {
                    <p class="dashboard-hint">@Localizer["Home_AucuneEntreprise"]</p>
                    <a href="/entreprise/creer" class="btn-primary-modern-dashboard">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        @Localizer["CreerUneEntreprise"]
                    </a>
                }
                else if (_company is not null && _companyLinks.Count == 0)
                {
                    <p class="dashboard-hint">@Localizer["Home_AucunModuleActif"]</p>
                    <a href="/entreprise/modules" class="btn-secondary-modern-dashboard">@Localizer["AjouterUnModule"]</a>
                }
                else if (_company is not null)
                {
                    <div class="quick-actions-dashboard">
                        @for (var i = 0; i < _companyLinks.Count; i++)
                        {
                            var link = _companyLinks[i];
                            <a href="@link.Href" class="quick-action-btn-dashboard">
                                <div class="quick-action-icon-dashboard @IconTone(i)">
                                    <i class="bi @IconForCode(link.Code)" aria-hidden="true"></i>
                                </div>
                                <div class="quick-action-label-dashboard">@link.Label</div>
                            </a>
                        }
                    </div>
                }
            </section>
            }

            @* Jeune : pas de section « Profil candidat » adulte — ProfilCandidat actif en base uniquement pour GDT/CV. *@
            @if (_candidateLinks.Count > 0 && !_estJeune)
            {
                <section class="card-modern-dashboard">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                            @Localizer["Home_ProfilCandidat"]
                        </h2>
                        <a href="/candidat/modules" class="card-action-dashboard">
                            @Localizer["AjouterUnModule"]
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>
                    <div class="quick-actions-dashboard">
                        @for (var i = 0; i < _candidateLinks.Count; i++)
                        {
                            var link = _candidateLinks[i];
                            <a href="@link.Href" class="quick-action-btn-dashboard">
                                <div class="quick-action-icon-dashboard @IconTone(i)">
                                    <i class="bi @IconForCode(link.Code)" aria-hidden="true"></i>
                                </div>
                                <div class="quick-action-label-dashboard">@link.Label</div>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (_particulierLinks.Count > 0)
            {
                <section class="card-modern-dashboard">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-house-heart" aria-hidden="true"></i>
                            @Localizer["Home_ProfilParticulier"]
                        </h2>
                    </div>
                    <div class="quick-actions-dashboard">
                        @for (var i = 0; i < _particulierLinks.Count; i++)
                        {
                            var link = _particulierLinks[i];
                            <a href="@link.Href" class="quick-action-btn-dashboard">
                                <div class="quick-action-icon-dashboard @IconTone(i)">
                                    <i class="bi @IconForCode(link.Code)" aria-hidden="true"></i>
                                </div>
                                <div class="quick-action-label-dashboard">@link.Label</div>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (_coachLinks.Count > 0)
            {
                <section class="card-modern-dashboard" id="coach-priorites">
                    <div class="card-header-modern-dashboard">
                        <h2 class="card-title-modern-dashboard">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            @Localizer["Home_ProfilCoach"]
                        </h2>
                        <div class="card-header-actions-dashboard">
                            <a href="#coach-priorites" class="card-action-dashboard">
                                @Localizer["Home_CoachVoirPriorites"]
                                <i class="bi bi-arrow-down" aria-hidden="true"></i>
                            </a>
                            <a href="/coach/modules" class="card-action-dashboard">
                                @Localizer["AjouterUnModule"]
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                    @if (_coachSynthese is not null)
                    {
                        <div class="dashboard-admin-stats">
                            <a href="/coach/suivis" class="dashboard-admin-stat">
                                <span class="dashboard-admin-stat-value">@_coachSynthese.JeunesSuivisActifs</span>
                                <span class="dashboard-admin-stat-label">@Localizer["Home_CoachJeunesSuivis"]</span>
                            </a>
                            <a href="/coach/suivis" class="dashboard-admin-stat @(_coachSynthese.MissionsAValider > 0 ? "is-alert" : "")">
                                <span class="dashboard-admin-stat-value">@_coachSynthese.MissionsAValider</span>
                                <span class="dashboard-admin-stat-label">@Localizer["Home_CoachMissionsAValider"]</span>
                            </a>
                            <a href="/coach/suivis" class="dashboard-admin-stat @(_coachSynthese.DossiersIncomplets > 0 ? "is-alert" : "")">
                                <span class="dashboard-admin-stat-value">@_coachSynthese.DossiersIncomplets</span>
                                <span class="dashboard-admin-stat-label">@Localizer["Home_CoachDossiersIncomplets"]</span>
                            </a>
                            <a href="/coach/suivis" class="dashboard-admin-stat @(_coachSynthese.AlertesInvitationsExpirees > 0 ? "is-alert" : "")">
                                <span class="dashboard-admin-stat-value">@_coachSynthese.AlertesInvitationsExpirees</span>
                                <span class="dashboard-admin-stat-label">@Localizer["Home_CoachAlertes"]</span>
                            </a>
                        </div>
                    }
                    @if (_coachActionsRapides is not null && CoachActionsRapidesVisibles(_coachActionsRapides))
                    {
                        <div class="quick-actions-dashboard coach-actions-rapides">
                            @if (_coachActionsRapides.ValiderMissionHref is not null)
                            {
                                <a href="@_coachActionsRapides.ValiderMissionHref" class="quick-action-btn-dashboard">
                                    <div class="quick-action-icon-dashboard tone-orange">
                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                    </div>
                                    <div class="quick-action-label-dashboard">@Localizer["Home_CoachActionValiderMission"]</div>
                                </a>
                            }
                            @if (_coachActionsRapides.GuideEntrevueHref is not null)
                            {
                                <a href="@_coachActionsRapides.GuideEntrevueHref" class="quick-action-btn-dashboard">
                                    <div class="quick-action-icon-dashboard tone-teal">
                                        <i class="bi bi-journal-richtext" aria-hidden="true"></i>
                                    </div>
                                    <div class="quick-action-label-dashboard">
                                        @(_coachActionsRapides.GuideEntrevueEstContinuer
                                            ? Localizer["Home_CoachActionContinuerEntrevue"]
                                            : Localizer["Home_CoachActionPreparerEntrevue"])
                                    </div>
                                </a>
                            }
                            @if (_coachActionsRapides.RelancerInvitationHref is not null)
                            {
                                <a href="@_coachActionsRapides.RelancerInvitationHref" class="quick-action-btn-dashboard">
                                    <div class="quick-action-icon-dashboard tone-purple">
                                        <i class="bi bi-envelope-exclamation" aria-hidden="true"></i>
                                    </div>
                                    <div class="quick-action-label-dashboard">@Localizer["Home_CoachActionRelancerInvitation"]</div>
                                </a>
                            }
                            @if (_coachActionsRapides.CloturerObjectifsHref is not null)
                            {
                                <a href="@_coachActionsRapides.CloturerObjectifsHref" class="quick-action-btn-dashboard">
                                    <div class="quick-action-icon-dashboard tone-blue">
                                        <i class="bi bi-flag" aria-hidden="true"></i>
                                    </div>
                                    <div class="quick-action-label-dashboard">@Localizer["Home_CoachActionCloturerObjectifs"]</div>
                                </a>
                            }
                        </div>
                    }
                    <div class="quick-actions-dashboard">
                        @for (var i = 0; i < _coachLinks.Count; i++)
                        {
                            var link = _coachLinks[i];
                            <a href="@link.Href" class="quick-action-btn-dashboard">
                                <div class="quick-action-icon-dashboard @IconTone(i)">
                                    <i class="bi @IconForCode(link.Code)" aria-hidden="true"></i>
                                </div>
                                <div class="quick-action-label-dashboard">@link.Label</div>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isAuthenticated;
    private bool _isPlatformAdmin;
    private bool _estCandidatOuCoach;
    private bool _estJeune;
    private bool _estParticulier;
    private bool _consentementParentalACompleter;
    private Company? _company;
    private AdminGlobalCounts? _compteurs;
    private int _enRetardTotal;
    private readonly List<AdminAbonnementFacturationView> _enRetard = [];
    private readonly List<AdminAbonnementFacturationView> _echeancesBientot = [];
    private readonly List<DashboardLink> _companyLinks = [];
    private readonly List<DashboardLink> _candidateLinks = [];
    private readonly List<DashboardLink> _coachLinks = [];
    private readonly List<DashboardLink> _particulierLinks = [];
    private CoachDashboardSynthese? _coachSynthese;
    private CoachDashboardActionsRapides? _coachActionsRapides;

    private const int HorizonEcheanceJours = 14;

    private static readonly string[] IconTones = ["tone-primary", "tone-teal", "tone-blue", "tone-purple", "tone-orange"];

    private sealed record DashboardLink(string Code, string Label, string Href);

    private static string IconTone(int index) => IconTones[index % IconTones.Length];

    private static string IconForCode(string code) => code switch
    {
        "ProfilEntreprise" => "bi-building",
        "Postes" => "bi-briefcase",
        "Recrutement" => "bi-briefcase",
        "Vivier" => "bi-people",
        "SuiviEvolutif" => "bi-clock-history",
        "Analytics" => "bi-graph-up",
        "GestionDuTemps" => "bi-hourglass-split",
        "SuiviEmployes" => "bi-clipboard2-pulse",
        "Compatibilite" => "bi-intersect",
        "Entretien" => "bi-chat-dots",
        "ProfilCandidat" => "bi-ui-checks-grid",
        "ProfilCoach" => "bi-person-badge",
        "ProfilParticulier" => "bi-house-heart",
        "PublierMission" => "bi-plus-circle",
        "MesMissionsPubliees" => "bi-journal-text",
        "MesPersonnesSuivies" => "bi-people",
        _ => "bi-grid-1x2"
    };

    private static string? HrefForCompanyModule(string code) => code switch
    {
        "ProfilEntreprise" => "/entreprise/profil",
        // Recrutement n'a plus de landing dédiée : le socle postes est toujours sous ProfilEntreprise ;
        // entretien/IA sont gated dans les pages postes elles-mêmes.
        "Recrutement" => null,
        "Vivier" => "/vivier",
        "SuiviEvolutif" => "/entreprise/historique",
        "Analytics" => "/entreprise/analytics",
        "GestionDuTemps" => "/gestion-du-temps",
        "SuiviEmployes" => "/entreprise/employes",
        _ => null
    };

    private static string? HrefForCandidateModule(string code) => code switch
    {
        "ProfilCandidat" => "/candidat/questionnaire",
        "GestionDuTemps" => "/gestion-du-temps",
        _ => null
    };

    private static string? HrefForCoachModule(string code) => code switch
    {
        "ProfilCoach" => "/coach/profil",
        "GestionDuTemps" => "/gestion-du-temps",
        _ => null
    };

    private static string? HrefForParticulierModule(string code) => code switch
    {
        "ProfilParticulier" => "/particulier/publier-mission",
        _ => null
    };

    /// <summary>
    /// Tableau de bord entièrement dynamique — mêmes vérifications que le menu principal (voir
    /// MainLayout) : IsActiveAsync/IsActiveForCandidateAsync module par module, jamais GetActiveModuleCodesAsync.
    /// Pour un <see cref="PlatformRoles.Admin"/> : pas de CTA création d'entreprise ; vue facturation
    /// (retards + échéances à 14 jours) et compteurs globaux via <see cref="IAdminService"/>.
    /// </summary>
    /// <remarks>
    /// Côté entreprise, <see cref="PersonalModuleCodes"/> est exclu de l'énumération — un module personnel
    /// (Profil Candidat) n'a pas sa place dans le tableau de bord d'une entreprise, même si une ligne
    /// <c>ModuleActivation</c> existe pour ce sujet (voir le commentaire sur <see cref="PersonalModuleCodes"/>).
    /// Jamais appliqué côté candidat : ses propres modules personnels sont précisément ce qu'il doit voir ici.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var user = (await AuthenticationStateTask).User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        _isAuthenticated = true;
        _isPlatformAdmin = user.IsInRole(PlatformRoles.Admin);

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
            return;

        if (_isPlatformAdmin)
        {
            _compteurs = await AdminService.GetCompteursGlobauxAsync(user);

            // Widgets dashboard : page courte (montants calculés seulement pour ces lignes).
            var enRetardPage = await AdminService.GetAbonnementsEnRetardAsync(user, page: 1, pageSize: 8);
            _enRetardTotal = enRetardPage.TotalCount;
            _enRetard.AddRange(enRetardPage.Items.OrderBy(a => a.RenewalDate));

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var horizon = today.AddDays(HorizonEcheanceJours);
            // Fenêtre « bientôt » : on ne parcourt qu'une page élargie (50) — pas tout le catalogue.
            var tous = await AdminService.GetAbonnementsFacturationAsync(user, page: 1, pageSize: 50);
            _echeancesBientot.AddRange(tous.Items
                .Where(a =>
                    a.Status == SubscriptionStatus.Active
                    && a.RenewalDate is DateTimeOffset r
                    && DateOnly.FromDateTime(r.UtcDateTime) >= today
                    && DateOnly.FromDateTime(r.UtcDateTime) <= horizon)
                .OrderBy(a => a.RenewalDate)
                .Take(8));
        }

        var jeuneProfile = await JeuneProfileService.TryGetByUserIdAsync(userId);
        _estJeune = jeuneProfile is not null;
        if (jeuneProfile is not null
            && JeuneProfileService.EstMineur(jeuneProfile.DateNaissance)
            && !await ConsentementParentalService.EstConsentementValideAsync(jeuneProfile.Id))
        {
            _consentementParentalACompleter = true;
        }

        var particulierProfile = await ParticulierProfileService.TryGetByUserIdAsync(userId);
        _estParticulier = particulierProfile is not null;

        var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb);
        if (companies.Count > 0)
        {
            _company = companies[0];

            // Même entrée principale que le menu latéral : le profil entreprise est toujours accessible
            // dès qu'une entreprise est associée, indépendamment de l'activation des autres modules.
            _companyLinks.Add(new DashboardLink(
                "ProfilEntreprise",
                Localizer["Module_ProfilEntreprise"],
                "/entreprise/profil"));

            // Socle postes : toujours disponible (ProfilEntreprise), jamais gated par Recrutement.
            _companyLinks.Add(new DashboardLink(
                "Postes",
                Localizer["Module_PostesEntreprise"],
                "/entreprise/postes"));

            foreach (var manifest in ModuleRegistry.AllModules)
            {
                if (PersonalModuleCodes.Codes.Contains(manifest.Code))
                    continue;
                if (manifest.Code is "ProfilEntreprise")
                    continue;
                if (!await ModuleRegistry.IsActiveAsync(_company.Id, manifest.Code, CoreDb))
                    continue;

                var href = HrefForCompanyModule(manifest.Code);
                if (href is null)
                    continue;

                _companyLinks.Add(new DashboardLink(manifest.Code, DisplayNameFor(manifest), href));
            }
        }

        // Signal d'inscription Candidat/Coach (jamais GetActiveModuleCodesAsync) : une coquille vide
        // créée par GetOrCreate* n'active pas ces modules — seul un onboarding réel le fait.
        var candidateProfileId = await CandidateSubjectResolver.GetOrCreateCandidateProfileIdAsync(userId);
        var coachProfileId = await CoachSubjectResolver.GetOrCreateCoachProfileIdAsync(userId);
        _estCandidatOuCoach =
            await ModuleRegistry.IsActiveForCandidateAsync(candidateProfileId, "ProfilCandidat", CoreDb)
            || await ModuleRegistry.IsActiveForCoachAsync(coachProfileId, "ProfilCoach", CoreDb);

        // Jeune prestataire : ne pas remplir la grille « Profil candidat » (contenu adulte emploi) — voir
        // CandidateOnboardingService : ProfilCandidat reste actif en base pour Gestion du temps / CV.
        if (!_estJeune)
        {
            foreach (var manifest in ModuleRegistry.AllModules)
            {
                if (!await ModuleRegistry.IsActiveForCandidateAsync(candidateProfileId, manifest.Code, CoreDb))
                    continue;

                var href = HrefForCandidateModule(manifest.Code);
                if (href is null)
                    continue;

                _candidateLinks.Add(new DashboardLink(manifest.Code, DisplayNameFor(manifest), href));
            }
        }

        // Un utilisateur peut cumuler plusieurs profils (voir CoachOnboardingService) — même schéma que la
        // résolution candidat ci-dessus : GetOrCreateCoachProfileIdAsync crée un CoachProfile "coquille vide"
        // pour tout visiteur authentifié du tableau de bord, même sans inscription/invitation Coach (déjà le
        // comportement existant côté candidat, reproduit ici à l'identique plutôt que corrigé isolément).
        // La section ne s'affiche que si un module Coach est effectivement actif (IsActiveForCoachAsync),
        // ce qui reste false pour cette coquille vide tant qu'aucun onboarding réel n'a eu lieu.
        foreach (var manifest in ModuleRegistry.AllModules)
        {
            if (!await ModuleRegistry.IsActiveForCoachAsync(coachProfileId, manifest.Code, CoreDb))
                continue;

            var href = HrefForCoachModule(manifest.Code);
            if (href is null)
                continue;

            _coachLinks.Add(new DashboardLink(manifest.Code, DisplayNameFor(manifest), href));
        }

        // "Mes personnes suivies" n'est pas un module (pas de ModuleManifest associé) mais une fonctionnalité
        // toujours pertinente dès que le profil Coach est actif — ajoutée en tête de grille au même titre
        // que les tuiles pilotées par module, pour que la section coach ait exactement la même mise en page
        // que les sections entreprise/candidat (une seule grille de tuiles, pas de rangée de boutons à part).
        if (_coachLinks.Count > 0)
        {
            _coachLinks.Insert(0, new DashboardLink("MesPersonnesSuivies", Localizer["Home_MesPersonnesSuivies"].Value, "/coach/suivis"));
            _coachSynthese = await CoachDashboardService.GetSyntheseAsync(userId);
            _coachActionsRapides = await CoachDashboardService.GetActionsRapidesAsync(userId);
        }

        if (_estParticulier && particulierProfile is not null
            && await ModuleRegistry.IsActiveForParticulierAsync(particulierProfile.Id, "ProfilParticulier", CoreDb))
        {
            _particulierLinks.Add(new DashboardLink("PublierMission", Localizer["Home_PublierMission"].Value, "/particulier/publier-mission"));
            _particulierLinks.Add(new DashboardLink("MesMissionsPubliees", Localizer["Home_MesMissionsPubliees"].Value, "/particulier/mes-missions"));
        }
    }

    /// <summary>
    /// Nom du module selon la culture courante — voir <see cref="ModuleManifest.DisplayNameEn"/> (cycle de
    /// bilinguisme, écart corrigé) : DisplayName (français) reste le contenu source, DisplayNameEn n'est
    /// consulté qu'ici et au tableau de bord, jamais par les écrans propres du module (hors périmètre).
    /// </summary>
    private static string DisplayNameFor(ModuleManifest manifest) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr" ? manifest.DisplayName : manifest.DisplayNameEn;

    private static bool CoachActionsRapidesVisibles(CoachDashboardActionsRapides a) =>
        a.ValiderMissionHref is not null
        || a.GuideEntrevueHref is not null
        || a.RelancerInvitationHref is not null
        || a.CloturerObjectifsHref is not null;
}
