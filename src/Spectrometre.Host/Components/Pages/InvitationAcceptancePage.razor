@page "/invitations/accepter/{Token}"
@layout Spectrometre.Host.Components.Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Identity
@using Spectrometre.Core.Invitations
@using Spectrometre.Core.Tenancy
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@using Spectrometre.Modules.Coaching.Services
@using Spectrometre.Modules.PostesRecrutement.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IInvitationService InvitationService
@inject CoachOnboardingService CoachOnboarding
@inject ICoachingService CoachingService
@inject ICompanyProvisioningService CompanyProvisioningService
@inject IPosteService PosteService
@inject CoreDbContext CoreDb
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer
<PageTitle>@Localizer["InvitationTitle"]</PageTitle>

@* Rendu statique (pas d'InteractiveServer), comme /inscription et /login : la confirmation d'invitation
   se termine par SignInManager.SignInAsync (chemin "nouveau compte") ou lit l'état d'authentification déjà
   posé par le cookie (chemin "compte existant") — les deux sont incompatibles avec un circuit interactif
   qui n'écrit/relit le cookie qu'au tout premier rendu. *@
<div class="login-page-nav-overlay" aria-hidden="true"></div>
<div class="login-page-wrapper">
    <div class="container-fluid px-3 px-md-4 px-lg-5 px-xl-4 py-5 login-container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">
                <div class="login-card invitation-card">
                    <header class="login-header">
                        <h1 class="login-title">@Localizer["InvitationTitle"]</h1>
                        <p class="login-subtitle mb-0">
                            @if (_invitation is null)
                            {
                                @Localizer["InvitationInvalideOuExpiree"]
                            }
                            else if (_existingUser is null)
                            {
                                @Localizer[IntroKey]
                            }
                            else if (_confirme)
                            {
                                @Localizer["InvitationConfirmee"]
                            }
                            else if (_isAuthenticatedAsInvitee)
                            {
                                @Localizer[IntroKey]
                            }
                            else
                            {
                                @Localizer[IntroKey]
                            }
                        </p>
                    </header>

                    <div class="p-4 p-lg-5">
                        @if (!string.IsNullOrEmpty(_message))
                        {
                            <div class="alert alert-danger">@_message</div>
                        }

                        @if (_invitation is null)
                        {
                            <div class="alert alert-danger">@Localizer["InvitationInvalideOuExpiree"]</div>
                            <div class="login-links">
                                <a href="/login" class="login-link">@Localizer["InvitationSeConnecter"]</a>
                                <a href="/" class="login-link">@Localizer["Accueil"]</a>
                            </div>
                        }
                        else if (_existingUser is null)
                        {
                            <p class="invitation-lead">@Localizer[IntroKey]</p>
                            <p class="invitation-email-lock">
                                <i class="bi bi-envelope-lock" aria-hidden="true"></i>
                                @Localizer["InvitationEmailVerrouille"]
                                <strong>@_invitation.EmailInvite</strong>
                            </p>

                            <EditForm EditContext="_editContext" OnValidSubmit="RegisterAndFinalizeAsync" FormName="invitation-inscription" method="post">
                                <ValidationSummary class="validation-summary" />

                                <h2 class="login-section-title">@Localizer["InvitationCreerVotreCompte"]</h2>
                                <hr class="login-divider" />

                                <div class="login-form-group">
                                    <label for="invitation-nom" class="login-form-label">@Localizer["Nom"]</label>
                                    <InputText id="invitation-nom" @bind-Value="_model.Nom"
                                               class="login-form-control form-control"
                                               autocomplete="family-name" />
                                </div>
                                <div class="login-form-group">
                                    <label for="invitation-prenom" class="login-form-label">@Localizer["Prenom"]</label>
                                    <InputText id="invitation-prenom" @bind-Value="_model.Prenom"
                                               class="login-form-control form-control"
                                               autocomplete="given-name" />
                                </div>
                                <div class="login-form-group">
                                    <label for="invitation-password" class="login-form-label">@Localizer["MotDePasse"]</label>
                                    <InputText id="invitation-password" @bind-Value="_model.MotDePasse" type="password"
                                               class="login-form-control form-control"
                                               autocomplete="new-password" />
                                </div>
                                <div class="login-form-group">
                                    <label for="invitation-password-confirm" class="login-form-label">@Localizer["Inscription_ConfirmationMotDePasse"]</label>
                                    <InputText id="invitation-password-confirm" @bind-Value="_model.ConfirmationMotDePasse" type="password"
                                               class="login-form-control form-control"
                                               autocomplete="new-password" />
                                </div>

                                <div class="mb-2">
                                    <button type="submit" class="login-btn login-btn-primary">
                                        @Localizer["InvitationCreerVotreCompte"]
                                    </button>
                                </div>
                            </EditForm>
                        }
                        else if (!_isAuthenticatedAsInvitee)
                        {
                            @if (_isAuthenticatedAsSomeoneElse)
                            {
                                <div class="alert alert-danger">
                                    @string.Format(Localizer["InvitationMauvaisCompte"].Value, _invitation.EmailInvite)
                                </div>
                                <div class="login-links">
                                    <a href="/logout" class="login-link" data-enhance-nav="false">@Localizer["Deconnexion"]</a>
                                </div>
                            }
                            else
                            {
                                <p class="invitation-lead">
                                    @string.Format(Localizer["InvitationUnCompteExisteDeja"].Value, _invitation.EmailInvite)
                                </p>
                                <p class="invitation-hint">@Localizer["InvitationConnectezVousPourConfirmer"]</p>
                                <a href="/login" class="login-link-register">@Localizer["InvitationSeConnecter"]</a>
                            }
                        }
                        else if (_confirme)
                        {
                            <div class="alert alert-success">@Localizer["InvitationConfirmee"]</div>
                            <a href="@DestinationApresAcceptation()" class="login-btn login-btn-primary">
                                @(_invitation!.Type switch
                                {
                                    InvitationType.CompanyEmploye => Localizer["Accueil"],
                                    InvitationType.CandidaturePoste => Localizer["Accueil"],
                                    _ => Localizer["InvitationVoirMesPersonnesSuivies"],
                                })
                            </a>
                        }
                        else
                        {
                            <p class="invitation-lead">@Localizer[IntroKey]</p>
                            <p class="invitation-email-lock">
                                <i class="bi bi-person-check" aria-hidden="true"></i>
                                <strong>@_invitation.EmailInvite</strong>
                            </p>
                            <EditForm Model="(_confirmModel ??= new())" OnValidSubmit="ConfirmerAsync" FormName="invitation-confirmation" method="post">
                                <button type="submit" class="login-btn login-btn-primary">
                                    @Localizer["InvitationConfirmer"]
                                </button>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromForm(FormName = "invitation-inscription")]
    private InscriptionModel _model { get; set; } = new();

    [SupplyParameterFromForm(FormName = "invitation-confirmation")]
    private ConfirmModel? _confirmModel { get; set; }

    private EditContext _editContext = null!;
    private ValidationMessageStore _messageStore = null!;
    private string? _message;
    private Invitation? _invitation;
    private ApplicationUser? _existingUser;
    private bool _isAuthenticatedAsInvitee;
    private bool _isAuthenticatedAsSomeoneElse;
    private bool _confirme;

    private sealed class InscriptionModel
    {
        public string Nom { get; set; } = "";
        public string Prenom { get; set; } = "";
        public string MotDePasse { get; set; } = "";
        public string ConfirmationMotDePasse { get; set; } = "";
    }

    private sealed class ConfirmModel;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += HandleValidationRequested;

        _invitation = await InvitationService.ObtenirValidePourAcceptationAsync(Token, CoreDb);
        if (_invitation is null)
            return;

        _existingUser = await UserManager.FindByEmailAsync(_invitation.EmailInvite);
        if (_existingUser is null)
            return;

        var authenticatedUserId = AuthenticationStateTask is null
            ? null
            : (await AuthenticationStateTask).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (authenticatedUserId is null)
            return;

        if (authenticatedUserId == _existingUser.Id)
            _isAuthenticatedAsInvitee = true;
        else
            _isAuthenticatedAsSomeoneElse = true;
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        _messageStore.Clear();

        if (string.IsNullOrWhiteSpace(_model.Nom))
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Nom)), Localizer["Inscription_NomRequis"].Value);
        if (string.IsNullOrWhiteSpace(_model.Prenom))
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Prenom)), Localizer["Inscription_PrenomRequis"].Value);
        if (string.IsNullOrWhiteSpace(_model.MotDePasse))
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.MotDePasse)), Localizer["Inscription_MotDePasseRequis"].Value);
        if (_model.ConfirmationMotDePasse != _model.MotDePasse)
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.ConfirmationMotDePasse)), Localizer["Inscription_MotsDePasseNeCorrespondentPas"].Value);

        _editContext.NotifyValidationStateChanged();
    }

    private async Task RegisterAndFinalizeAsync()
    {
        _message = null;

        var user = new ApplicationUser
        {
            UserName = _invitation!.EmailInvite,
            Email = _invitation.EmailInvite,
            // Contrairement à /inscription (qui envoie désormais un vrai email de confirmation via Resend,
            // voir son commentaire), pas besoin ici : l'invitation elle-même n'a pu être ouverte qu'en
            // accédant à la boîte mail visée (jeton sécurisé envoyé à _invitation.EmailInvite) — la
            // compléter EST la preuve de possession de l'adresse.
            EmailConfirmed = true,
            FirstName = _model.Prenom,
            LastName = _model.Nom,
        };

        var createResult = await UserManager.CreateAsync(user, _model.MotDePasse);
        if (!createResult.Succeeded)
        {
            _message = string.Join(" ", createResult.Errors.Select(e => e.Description));
            return;
        }

        await FinaliserSelonTypeAsync(user.Id);
        await InvitationService.MarquerAccepteeAsync(_invitation.Id, CoreDb);
        await SignInManager.SignInAsync(user, isPersistent: true);
        Navigation.NavigateTo(DestinationApresAcceptation());
    }

    private async Task ConfirmerAsync()
    {
        await FinaliserSelonTypeAsync(_existingUser!.Id);
        await InvitationService.MarquerAccepteeAsync(_invitation!.Id, CoreDb);
        _confirme = true;
    }

    /// <summary>Étendu au cycle multi-entreprise/employés et candidatures poste — voir la remarque sur <see cref="Invitation.Type"/>.</summary>
    private async Task FinaliserSelonTypeAsync(string accepteurUserId)
    {
        switch (_invitation!.Type)
        {
            case InvitationType.Coaching:
                await CoachOnboarding.CreateCoachAsync(accepteurUserId, CoreDb);
                await CoachingService.FinaliserDepuisInvitationAsync(_invitation, accepteurUserId);
                break;
            case InvitationType.CompanyEmploye:
                await CompanyProvisioningService.FinaliserEmployeDepuisInvitationAsync(_invitation, accepteurUserId, CoreDb);
                break;
            case InvitationType.CandidaturePoste:
                await PosteService.FinaliserCandidatureDepuisInvitationAsync(_invitation, accepteurUserId);
                break;
        }
    }

    private string DestinationApresAcceptation() => _invitation!.Type switch
    {
        InvitationType.CompanyEmploye => "/dashboard",
        InvitationType.CandidaturePoste => "/candidat/postes",
        _ => "/coach/suivis",
    };

    private string IntroKey => _invitation?.Type switch
    {
        InvitationType.CompanyEmploye => "InvitationManagerIntro",
        InvitationType.CandidaturePoste => "InvitationCandidaturePosteIntro",
        _ => "InvitationCoachingIntro",
    };
}
