@page "/inscription"
@layout Spectrometre.Host.Components.Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Email
@using Spectrometre.Core.Identity
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@inject UserManager<ApplicationUser> UserManager
@inject IResendEmailService ResendEmailService
@inject CompanyOnboardingService CompanyOnboarding
@inject CandidateOnboardingService CandidateOnboarding
@inject CoachOnboardingService CoachOnboarding
@inject ParticulierOnboardingService ParticulierOnboarding
@inject CoreDbContext CoreDb
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["CreerUnCompte"]</PageTitle>

@* Rendu statique (pas d'InteractiveServer), comme /login : la création du compte passe par
   UserManager.CreateAsync puis l'envoi de l'email de confirmation avant que la réponse ne commence à
   être diffusée — incompatible avec un rendu interactif. Les à-côtés purement visuels (étapes, suggestion
   de mot de passe, indicateur de robustesse, affichage conditionnel du nom d'entreprise) sont donc
   implémentés en JavaScript simple plutôt qu'en gestionnaires Blazor. *@
<div class="login-page-nav-overlay" aria-hidden="true"></div>
<div class="login-page-wrapper">
    <div class="container-fluid px-3 px-md-4 px-lg-5 px-xl-4 py-5 login-container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="login-card inscription-card">
                    <header class="login-header">
                        <h1 class="login-title">@Localizer["CreerUnCompte"]</h1>
                        <p id="inscription-subtitle" class="login-subtitle mb-0"
                           data-step1="@Localizer["Inscription_InformationsDuCompte"]"
                           data-step2="@Localizer["Inscription_ChoixDuProfil"]">
                            @Localizer["Inscription_InformationsDuCompte"]
                        </p>
                    </header>
                    <div class="p-4 p-lg-5">
                        @if (!string.IsNullOrEmpty(_message))
                        {
                            <div class="alert alert-danger">@_message</div>
                        }

                        <div id="inscription-wizard" data-step="@(_startOnStep2 ? "2" : "1")">
                            <div class="inscription-steps mb-4" aria-hidden="true">
                                <div class="inscription-step-indicator active" data-step-marker="1">
                                    <span class="inscription-step-number">1</span>
                                    <span class="inscription-step-label">@Localizer["Inscription_InformationsDuCompte"]</span>
                                </div>
                                <div class="inscription-step-line"></div>
                                <div class="inscription-step-indicator" data-step-marker="2">
                                    <span class="inscription-step-number">2</span>
                                    <span class="inscription-step-label">@Localizer["Inscription_ChoixDuProfil"]</span>
                                </div>
                            </div>

                            <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync" FormName="inscription" method="post">
                                <ValidationSummary class="validation-summary" />

                                <section id="inscription-step-1" class="inscription-step" data-inscription-step="1">
                                    <h2 class="login-section-title">@Localizer["Inscription_InformationsDuCompte"]</h2>
                                    <hr class="login-divider" />

                                    <div class="login-form-group">
                                        <label for="inscription-nom" class="login-form-label">@Localizer["Nom"]</label>
                                        <InputText id="inscription-nom" @bind-Value="_model.Nom"
                                                   class="login-form-control form-control"
                                                   autocomplete="family-name" required />
                                    </div>
                                    <div class="login-form-group">
                                        <label for="inscription-prenom" class="login-form-label">@Localizer["Prenom"]</label>
                                        <InputText id="inscription-prenom" @bind-Value="_model.Prenom"
                                                   class="login-form-control form-control"
                                                   autocomplete="given-name" required />
                                    </div>
                                    <div class="login-form-group">
                                        <label for="inscription-email" class="login-form-label">@Localizer["Email"]</label>
                                        <InputText id="inscription-email" @bind-Value="_model.Email" type="email"
                                                   class="login-form-control form-control"
                                                   autocomplete="username" required />
                                    </div>
                                    <div class="login-form-group">
                                        <label for="inscription-telephone" class="login-form-label">@Localizer["TelephoneOptionnel"]</label>
                                        <InputText id="inscription-telephone" @bind-Value="_model.Telephone" type="tel"
                                                   class="login-form-control form-control"
                                                   autocomplete="tel" />
                                    </div>
                                    <div class="login-form-group">
                                        <label for="motDePasse" class="login-form-label">@Localizer["MotDePasse"]</label>
                                        <div class="password-field-wrapper">
                                            <InputText id="motDePasse" @bind-Value="_model.MotDePasse" type="password"
                                                       class="login-form-control form-control"
                                                       autocomplete="new-password" required
                                                       oninput="spectrometreUpdateStrength(this.value)" />
                                            <button type="button" class="password-toggle-btn" data-toggle-password="motDePasse"
                                                    data-label-show="@Localizer["Inscription_AfficherMotDePasse"]"
                                                    data-label-hide="@Localizer["Inscription_MasquerMotDePasse"]"
                                                    aria-label="@Localizer["Inscription_AfficherMotDePasse"]"
                                                    title="@Localizer["Inscription_AfficherMotDePasse"]">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <button type="button" class="inscription-btn-secondary mt-2"
                                                onclick="spectrometreSuggestPassword()">
                                            @Localizer["Inscription_SuggererMotDePasseFort"]
                                        </button>
                                        <p id="forceIndicateur" class="inscription-strength hint"
                                           data-strength-labels="@StrengthLabelsData"
                                           data-strength-prefix="@Localizer["Robustesse"]">@Localizer["Robustesse"] —</p>
                                    </div>
                                    <div class="login-form-group">
                                        <label for="confirmationMotDePasse" class="login-form-label">@Localizer["Inscription_ConfirmationMotDePasse"]</label>
                                        <div class="password-field-wrapper">
                                            <InputText id="confirmationMotDePasse" @bind-Value="_model.ConfirmationMotDePasse" type="password"
                                                       class="login-form-control form-control"
                                                       autocomplete="new-password" required
                                                       data-mismatch-message="@Localizer["Inscription_MotsDePasseNeCorrespondentPas"]" />
                                            <button type="button" class="password-toggle-btn" data-toggle-password="confirmationMotDePasse"
                                                    data-label-show="@Localizer["Inscription_AfficherMotDePasse"]"
                                                    data-label-hide="@Localizer["Inscription_MasquerMotDePasse"]"
                                                    aria-label="@Localizer["Inscription_AfficherMotDePasse"]"
                                                    title="@Localizer["Inscription_AfficherMotDePasse"]">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="mb-4 mt-4">
                                        <button type="button" class="login-btn login-btn-primary"
                                                onclick="spectrometreInscriptionGoToStep(2)">
                                            @Localizer["Suivant"]
                                        </button>
                                    </div>
                                </section>

                                <section id="inscription-step-2" class="inscription-step" data-inscription-step="2" hidden>
                                    <h2 class="login-section-title">@Localizer["Inscription_ChoixDuProfil"]</h2>
                                    <hr class="login-divider" />

                                    <InputRadioGroup @bind-Value="_model.Profil">
                                        <div class="profil-choix">
                                            <label class="profil-option">
                                                <InputRadio Value="@("Entreprise")" />
                                                <span>@Localizer["Entreprise"]</span>
                                            </label>
                                            <label class="profil-option profil-desactive">
                                                <input type="radio" disabled />
                                                <span>@Localizer["Independant"] <em>(@Localizer["BientotDisponible"])</em></span>
                                            </label>
                                            <label class="profil-option">
                                                <InputRadio Value="@("Candidat")" />
                                                <span>@Localizer["Candidat"]</span>
                                            </label>
                                            <label class="profil-option">
                                                <InputRadio Value="@("Coach")" />
                                                <span>@Localizer["Coach"]</span>
                                            </label>
                                            <label class="profil-option">
                                                <InputRadio Value="@("Particulier")" />
                                                <span>@Localizer["Particulier"]</span>
                                            </label>
                                        </div>
                                        <p class="login-form-hint text-muted mt-2">@Localizer["Inscription_Particulier_Confidentialite"]</p>
                                    </InputRadioGroup>

                                    <div class="login-form-group" id="champNomEntreprise" style="display:none">
                                        <label for="inscription-entreprise" class="login-form-label">@Localizer["NomDeLEntreprise"]</label>
                                        <InputText id="inscription-entreprise" @bind-Value="_model.NomEntreprise"
                                                   class="login-form-control form-control" />
                                    </div>

                                    <div class="inscription-step-actions mb-4 mt-4">
                                        <button type="button" class="inscription-btn-secondary"
                                                onclick="spectrometreInscriptionGoToStep(1)">
                                            @Localizer["Precedent"]
                                        </button>
                                        <button type="submit" class="login-btn login-btn-primary">
                                            @Localizer["Inscription_CreerMonCompte"]
                                        </button>
                                    </div>
                                </section>

                                <div class="login-links">
                                    <a href="/login" class="login-link">@Localizer["Inscription_DejaUnCompte"]</a>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Les fonctions spectrometreSuggestPassword/spectrometreUpdateStrength/spectrometreOnProfilChange /
    // spectrometreInscriptionGoToStep vivent dans wwwroot/js/inscription.js, chargé depuis App.razor.
    private string StrengthLabelsData =>
        string.Join("|", Localizer["TresFaible"].Value, Localizer["Faible"].Value, Localizer["Moyen"].Value, Localizer["Bon"].Value, Localizer["Fort"].Value, Localizer["TresFort"].Value);

    [SupplyParameterFromForm(FormName = "inscription")]
    private InscriptionModel _model { get; set; } = new();

    private EditContext _editContext = null!;
    private ValidationMessageStore _messageStore = null!;
    private string? _message;
    private bool _startOnStep2;

    private sealed class InscriptionModel
    {
        public string Nom { get; set; } = "";
        public string Prenom { get; set; } = "";
        public string Email { get; set; } = "";
        public string? Telephone { get; set; }
        public string MotDePasse { get; set; } = "";
        public string ConfirmationMotDePasse { get; set; } = "";
        public string? Profil { get; set; }
        public string? NomEntreprise { get; set; }
    }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += HandleValidationRequested;
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        _messageStore.Clear();
        var accountOk = true;

        if (string.IsNullOrWhiteSpace(_model.Nom))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Nom)), Localizer["Inscription_NomRequis"].Value);
            accountOk = false;
        }

        if (string.IsNullOrWhiteSpace(_model.Prenom))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Prenom)), Localizer["Inscription_PrenomRequis"].Value);
            accountOk = false;
        }

        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Email)), Localizer["Inscription_EmailRequis"].Value);
            accountOk = false;
        }
        else if (!new EmailAddressAttribute().IsValid(_model.Email))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Email)), Localizer["Inscription_EmailInvalide"].Value);
            accountOk = false;
        }

        if (string.IsNullOrWhiteSpace(_model.MotDePasse))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.MotDePasse)), Localizer["Inscription_MotDePasseRequis"].Value);
            accountOk = false;
        }

        if (string.IsNullOrWhiteSpace(_model.ConfirmationMotDePasse))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.ConfirmationMotDePasse)), Localizer["Inscription_ConfirmationMotDePasseRequise"].Value);
            accountOk = false;
        }
        else if (_model.ConfirmationMotDePasse != _model.MotDePasse)
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.ConfirmationMotDePasse)), Localizer["Inscription_MotsDePasseNeCorrespondentPas"].Value);
            accountOk = false;
        }

        if (string.IsNullOrWhiteSpace(_model.Profil))
        {
            _messageStore.Add(_editContext.Field(nameof(InscriptionModel.Profil)), Localizer["Inscription_ProfilRequis"].Value);
            if (accountOk)
                _startOnStep2 = true;
        }

        _editContext.NotifyValidationStateChanged();
    }

    private async Task SubmitAsync()
    {
        _message = null;

        if (_model.Profil != "Entreprise" && _model.Profil != "Candidat" && _model.Profil != "Coach" && _model.Profil != "Particulier")
        {
            _message = Localizer["Inscription_ChoisirProfil"];
            _startOnStep2 = true;
            return;
        }

        if (_model.Profil == "Entreprise" && string.IsNullOrWhiteSpace(_model.NomEntreprise))
        {
            _message = Localizer["Inscription_NomEntrepriseRequis"];
            _startOnStep2 = true;
            return;
        }

        var user = new ApplicationUser
        {
            UserName = _model.Email,
            Email = _model.Email,
            PhoneNumber = string.IsNullOrWhiteSpace(_model.Telephone) ? null : _model.Telephone.Trim(),
            FirstName = _model.Prenom,
            LastName = _model.Nom,
        };

        var createResult = await UserManager.CreateAsync(user, _model.MotDePasse);
        if (!createResult.Succeeded)
        {
            _message = string.Join(" ", createResult.Errors.Select(e => e.Description));
            return;
        }

        if (_model.Profil == "Entreprise")
            await CompanyOnboarding.CreateCompanyAsync(_model.NomEntreprise!.Trim(), user.Id, CoreDb);
        else if (_model.Profil == "Coach")
            await CoachOnboarding.CreateCoachAsync(user.Id, CoreDb);
        else if (_model.Profil == "Particulier")
            await ParticulierOnboarding.CreateParticulierAsync(user.Id, _model.Nom.Trim(), _model.Prenom.Trim(), CoreDb);
        else
            await CandidateOnboarding.CreateCandidateAsync(user.Id, CoreDb);

        // Email de confirmation obligatoire (Identity.RequireConfirmedAccount, voir AddSpectrometreCore) :
        // le compte existe déjà à ce stade mais PasswordSignInAsync le refusera tant que EmailConfirmed est
        // faux — voir ConfirmationEmailPage.razor pour la suite du parcours. Même mécanique que mvp
        // (Register.razor) : jeton généré puis encodé en Base64Url pour circuler proprement dans une URL.
        var userId = await UserManager.GetUserIdAsync(user);
        var confirmCode = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        confirmCode = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(confirmCode));
        var callbackUrl = Navigation.GetUriWithQueryParameters(
            Navigation.ToAbsoluteUri("confirmation-email").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = confirmCode });

        var emailEnvoye = await ResendEmailService.SendConfirmationEmailAsync(_model.Email, HtmlEncoder.Default.Encode(callbackUrl));
        if (!emailEnvoye)
        {
            _message = Localizer["Inscription_ErreurEnvoiEmailConfirmation"];
            return;
        }

        Navigation.NavigateTo($"/verification-email?email={Uri.EscapeDataString(_model.Email)}");
    }
}
