@page "/login"
@using Microsoft.AspNetCore.Identity
@using Spectrometre.Core.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

@* Formulaires en rendu statique (pas d'InteractiveServer) : l'écriture du cookie d'authentification
   doit se faire avant que la réponse HTTP ne commence à être diffusée, ce qui exclut un rendu interactif.
   Deux formulaires indépendants (chacun avec ses propres champs) : un formulaire SSR nommé ne reçoit
   que les valeurs de ses propres champs, jamais celles d'un autre formulaire de la page. *@
<h2>Connexion</h2>
<EditForm Model="_loginModel" OnValidSubmit="SubmitLoginAsync" FormName="login" method="post">
    <div>
        <label>Email <InputText @bind-Value="_loginModel.Email" /></label>
    </div>
    <div>
        <label>Mot de passe <InputText @bind-Value="_loginModel.Password" type="password" /></label>
    </div>
    <button type="submit">Se connecter</button>
</EditForm>

<h2>Démonstration</h2>
<p class="hint">Raccourci pour ce cycle — pas de flux d'inscription complet (hors périmètre de ce scaffold).</p>
<EditForm Model="_registerModel" OnValidSubmit="RegisterDemoUserAsync" FormName="register-demo" method="post">
    <div>
        <label>Email <InputText @bind-Value="_registerModel.Email" /></label>
    </div>
    <div>
        <label>Mot de passe <InputText @bind-Value="_registerModel.Password" type="password" /></label>
    </div>
    <button type="submit">Créer un compte de démonstration</button>
</EditForm>

@if (!string.IsNullOrEmpty(_message))
{
    <p>@_message</p>
}

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private CredentialsModel _loginModel { get; set; } = new();

    [SupplyParameterFromForm(FormName = "register-demo")]
    private CredentialsModel _registerModel { get; set; } = new();

    private string? _message;

    private sealed class CredentialsModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private async Task SubmitLoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(_loginModel.Email, _loginModel.Password, isPersistent: true, lockoutOnFailure: false);
        if (result.Succeeded)
            Navigation.NavigateTo("/");
        else
            _message = "Échec de connexion.";
    }

    private async Task RegisterDemoUserAsync()
    {
        var user = new ApplicationUser { UserName = _registerModel.Email, Email = _registerModel.Email, EmailConfirmed = true };
        var createResult = await UserManager.CreateAsync(user, _registerModel.Password);
        if (!createResult.Succeeded)
        {
            _message = string.Join(" ", createResult.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        Navigation.NavigateTo("/");
    }
}
