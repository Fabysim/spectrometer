@page "/login"
@layout Spectrometre.Host.Components.Layout.PublicLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Identity
@using Spectrometre.Host.Resources
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Login_PageTitle"]</PageTitle>

@* Formulaires en rendu statique (pas d'InteractiveServer) : l'écriture du cookie d'authentification
   doit se faire avant que la réponse HTTP ne commence à être diffusée, ce qui exclut un rendu interactif. *@
<div class="login-page-nav-overlay" aria-hidden="true"></div>
<div class="login-page-wrapper">
    <div class="container-fluid px-3 px-md-4 px-lg-5 px-xl-4 py-5 login-container">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10 col-xxl-9">
                <div class="login-card login-card-merged">
                    <section class="login-merged-section">
                        <header class="login-header login-header-unified">
                            <div class="row g-0">
                                <div class="col-12 col-lg-6 order-2 order-lg-1 login-header-unified-pane text-center text-lg-start">
                                    <h2 class="login-title login-title-pane">@Localizer["Login_RegisterLink"]</h2>
                                    <p class="login-subtitle mb-0">@Localizer["Login_RegisterColumnSubtitle"]</p>
                                </div>
                                <div class="col-12 col-lg-6 order-1 order-lg-2 login-header-unified-pane text-center text-lg-start">
                                    <h1 class="login-title">@Localizer["Login_Title"]</h1>
                                    <p class="login-subtitle mb-0">@Localizer["Login_Subtitle"]</p>
                                </div>
                            </div>
                        </header>
                        <div class="row g-0 align-items-stretch login-merged-columns">
                            <div class="col-12 col-lg-6 order-2 order-lg-1 login-split-pane login-split-pane-register d-flex flex-column">
                                <div class="login-split-body p-4 p-lg-5 flex-grow-1 d-flex flex-column justify-content-center">
                                    <a href="/inscription" class="login-link login-link-register mb-0">@Localizer["Login_RegisterLink"]</a>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 order-1 order-lg-2 login-split-pane login-split-pane-login d-flex flex-column">
                                <div class="login-split-body p-4 p-lg-5 flex-grow-1">
                                    @if (!string.IsNullOrEmpty(_message))
                                    {
                                        <div class="alert alert-danger">@_message</div>
                                    }
                                    <EditForm Model="_loginModel" OnValidSubmit="SubmitLoginAsync" FormName="login" method="post">
                                        <h2 class="login-section-title">@Localizer["Login_SectionTitle"]</h2>
                                        <hr class="login-divider" />
                                        <div class="login-form-group">
                                            <label for="login-email" class="login-form-label">@Localizer["Login_EmailLabel"]</label>
                                            <InputText id="login-email" @bind-Value="_loginModel.Email"
                                                       class="login-form-control form-control"
                                                       autocomplete="username"
                                                       placeholder="@Localizer["Login_EmailPlaceholder"]" />
                                        </div>
                                        <div class="login-form-group">
                                            <label for="login-password" class="login-form-label">@Localizer["Login_PasswordLabel"]</label>
                                            <InputText id="login-password" @bind-Value="_loginModel.Password" type="password"
                                                       class="login-form-control form-control"
                                                       autocomplete="current-password"
                                                       placeholder="@Localizer["Login_PasswordPlaceholder"]" />
                                        </div>
                                        <div class="login-checkbox-wrapper">
                                            <InputCheckbox id="login-remember" @bind-Value="_loginModel.RememberMe" class="login-checkbox" />
                                            <label for="login-remember" class="login-checkbox-label">@Localizer["Login_RememberMe"]</label>
                                        </div>
                                        <div class="mb-4">
                                            <button type="submit" class="login-btn login-btn-primary">@Localizer["Login_SubmitButton"]</button>
                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private CredentialsModel _loginModel { get; set; } = new();

    private string? _message;

    private sealed class CredentialsModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = true;
    }

    private async Task SubmitLoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            _loginModel.Email,
            _loginModel.Password,
            isPersistent: _loginModel.RememberMe,
            lockoutOnFailure: false);
        if (result.Succeeded)
            Navigation.NavigateTo("/dashboard");
        else if (result.IsNotAllowed)
            _message = Localizer["Login_EmailNonConfirme"];
        else
            _message = Localizer["Login_EchecConnexion"];
    }
}
