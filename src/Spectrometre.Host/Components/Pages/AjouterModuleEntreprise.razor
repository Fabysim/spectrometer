@page "/entreprise/modules"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Modules
@using Spectrometre.Core.Tenancy
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICompanyProvisioningService CompanyProvisioningService
@inject CompanyOnboardingService CompanyOnboarding
@inject IModuleRegistry ModuleRegistry
@inject CoreDbContext CoreDb
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["AjouterUnModule"]</PageTitle>

<div class="modules-page">
    <header class="modules-header">
        <div>
            <h1 class="modules-title">@Localizer["AjouterUnModule"]</h1>
            @if (_company is not null)
            {
                <p class="modules-subtitle">@_company.Name</p>
            }
        </div>
        <a href="/dashboard" class="modules-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @Localizer["RetourAuTableauDeBord"]
        </a>
    </header>

    @if (_company is null)
    {
        <section class="modules-card modules-empty">
            <p class="modules-hint">@(_loading ? Localizer["Chargement"] : Localizer["AjouterModule_AucuneEntrepriseAssociee"])</p>
            @if (!_loading)
            {
                <a href="/entreprise/creer" class="modules-btn-primary">@Localizer["CreerUneEntreprise"]</a>
            }
        </section>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="modules-alert modules-alert-success" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                @_message
            </div>
        }

        <div class="modules-grid">
            <article class="modules-card @(_recrutementActif ? "is-active" : "")">
                <div class="modules-card-icon tone-primary">
                    <i class="bi bi-briefcase" aria-hidden="true"></i>
                </div>
                <h2 class="modules-card-title">@Localizer["Module_Recrutement"]</h2>
                <p class="modules-hint">@Localizer["Module_RecrutementDescription"]</p>
                @if (_recrutementActif)
                {
                    <p class="modules-status is-on">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["DejaActive"]
                    </p>
                }
                else
                {
                    <button type="button" class="modules-btn-primary" @onclick="ActiverRecrutementAsync">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        @Localizer["Activer"]
                    </button>
                }
            </article>

            <article class="modules-card @(_gestionDuTempsActif ? "is-active" : "")">
                <div class="modules-card-icon tone-teal">
                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                </div>
                <h2 class="modules-card-title">@Localizer["Module_GestionDuTemps"]</h2>
                <p class="modules-hint">@Localizer["Module_GestionDuTempsDescription"]</p>
                @if (_gestionDuTempsActif)
                {
                    <p class="modules-status is-on">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["DejaActive"]
                    </p>
                }
                else
                {
                    <button type="button" class="modules-btn-primary" @onclick="ActiverGestionDuTempsAsync">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        @Localizer["Activer"]
                    </button>
                }
            </article>

            <article class="modules-card @(_suiviEmployesActif ? "is-active" : "")">
                <div class="modules-card-icon tone-blue">
                    <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
                </div>
                <h2 class="modules-card-title">@Localizer["Module_SuiviEvaluationEmployes"]</h2>
                <p class="modules-hint">@Localizer["Module_SuiviEvaluationEmployesDescription"]</p>
                @if (_suiviEmployesActif)
                {
                    <p class="modules-status is-on">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        @Localizer["DejaActive"]
                    </p>
                }
                else
                {
                    <button type="button" class="modules-btn-primary" @onclick="ActiverSuiviEmployesAsync">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        @Localizer["Activer"]
                    </button>
                }
            </article>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _loading = true;
    private Company? _company;
    private bool _recrutementActif;
    private bool _gestionDuTempsActif;
    private bool _suiviEmployesActif;
    private string? _message;

    private const string GestionDuTempsCode = "GestionDuTemps";
    private const string SuiviEmployesCode = "SuiviEmployes";

    protected override async Task OnInitializedAsync()
    {
        var userId = await ResolveUserIdAsync();
        if (!string.IsNullOrEmpty(userId))
        {
            var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, CoreDb);
            _company = companies.Count > 0 ? companies[0] : null;
            if (_company is not null)
                await RefreshStatutsAsync();
        }

        _loading = false;
    }

    private async Task<string?> ResolveUserIdAsync()
    {
        if (AuthenticationStateTask is null) return null;
        var user = (await AuthenticationStateTask).User;
        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private async Task RefreshStatutsAsync()
    {
        if (_company is null) return;

        // « Activé » si TOUS les modules du paquet sont effectivement actifs (voir IsActiveAsync,
        // jamais GetActiveModuleCodesAsync — statut d'abonnement Essai/Active requis).
        _recrutementActif = true;
        foreach (var code in CompanyOnboardingService.RecruitmentBundleModuleCodes)
        {
            if (!await ModuleRegistry.IsActiveAsync(_company.Id, code, CoreDb))
            {
                _recrutementActif = false;
                break;
            }
        }

        _gestionDuTempsActif = await ModuleRegistry.IsActiveAsync(_company.Id, GestionDuTempsCode, CoreDb);
        _suiviEmployesActif = await ModuleRegistry.IsActiveAsync(_company.Id, SuiviEmployesCode, CoreDb);
    }

    private async Task ActiverRecrutementAsync()
    {
        if (_company is null) return;
        await CompanyOnboarding.ActivateRecruitmentBundleAsync(_company.Id, CoreDb);
        await RefreshStatutsAsync();
        _message = Localizer["Module_RecrutementActiveMessage"];
    }

    private async Task ActiverGestionDuTempsAsync()
    {
        if (_company is null) return;
        await CompanyOnboarding.ActivateGestionDuTempsAsync(_company.Id, CoreDb);
        await RefreshStatutsAsync();
        _message = Localizer["Module_GestionDuTempsActiveMessage"];
    }

    private async Task ActiverSuiviEmployesAsync()
    {
        if (_company is null) return;
        await CompanyOnboarding.ActivateSuiviEmployesAsync(_company.Id, CoreDb);
        await RefreshStatutsAsync();
        _message = Localizer["Module_SuiviEvaluationEmployesActiveMessage"];
    }
}
