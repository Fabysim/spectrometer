@page "/entreprise/creer"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject CompanyOnboardingService OnboardingService
@inject CoreDbContext CoreDb
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["CreerUneEntreprise"]</PageTitle>

<div class="creer-entreprise-page">
    <header class="creer-header">
        <div>
            <h1 class="creer-title">@Localizer["CreerUneEntreprise"]</h1>
            <p class="creer-subtitle">@Localizer["CreerEntreprise_SousTitre"]</p>
        </div>
        <a href="/dashboard" class="creer-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @Localizer["RetourAuTableauDeBord"]
        </a>
    </header>

    <section class="creer-card">
        <div class="creer-card-icon" aria-hidden="true">
            <i class="bi bi-building-add"></i>
        </div>
        <h2 class="creer-section-title">@Localizer["NomDeLEntreprise"]</h2>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="create-company" class="creer-form">
            <div class="creer-field">
                <label for="creer-name">@Localizer["NomDeLEntreprise"]</label>
                <InputText id="creer-name"
                           class="creer-input"
                           @bind-Value="_model.Name"
                           placeholder="@Localizer["NomDeLEntreprise"]" />
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="creer-alert" role="alert">@_message</div>
            }

            <div class="creer-actions">
                <a href="/dashboard" class="creer-btn-secondary">@Localizer["Annuler"]</a>
                <button type="submit" class="creer-btn-primary" disabled="@_submitting">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    @Localizer["Creer"]
                </button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly CompanyModel _model = new();
    private string? _message;
    private bool _submitting;

    private sealed class CompanyModel
    {
        public string Name { get; set; } = "";
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _message = Localizer["DonneesEntreprise_NomRequis"];
            return;
        }

        var userId = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            : null;

        if (string.IsNullOrEmpty(userId))
        {
            _message = Localizer["UtilisateurNonAuthentifie"];
            return;
        }

        _submitting = true;
        try
        {
            await OnboardingService.CreateCompanyAsync(_model.Name.Trim(), userId, CoreDb);
            Navigation.NavigateTo("/entreprise/donnees");
        }
        catch
        {
            _message = Localizer["CreerEntreprise_Erreur"];
            _submitting = false;
        }
    }
}
