@page "/logout"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Identity
@using Spectrometre.Host.Resources
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

@* Rendu statique, comme /login : SignOutAsync écrit l'annulation du cookie d'authentification, qui doit
   se faire avant que la réponse ne commence à être diffusée — incompatible avec un rendu interactif. *@
<PageTitle>@Localizer["Logout_EnCours"]</PageTitle>

<h1>@Localizer["Logout_EnCours"]</h1>

@code {
    protected override async Task OnInitializedAsync()
    {
        await SignInManager.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
