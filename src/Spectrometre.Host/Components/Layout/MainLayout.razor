@inherits LayoutComponentBase
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Localization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Modules
@using Spectrometre.Core.Tenancy
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@inject IGestionDuTempsAccessService GestionDuTempsAccessService
@inject IModuleRegistry ModuleRegistry
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ICandidateSubjectResolver CandidateSubjectResolver
@inject IDbContextFactory<CoreDbContext> CoreDbFactory
@inject IStringLocalizer<SharedResource> Localizer
@inject NavigationManager Navigation

<div class="lang-switcher">
    @* <a> ordinaire avec navigation forcée (pas un gestionnaire Blazor) : voir la remarque sur
       UseRequestLocalization dans Program.cs — un circuit interactif ne re-résout jamais sa culture en
       cours de route, seul un rechargement complet de page (nouvelle requête HTTP, nouveau circuit) le
       peut. data-enhance-nav="false" désactive la navigation "enhanced" de Blazor pour CE lien précis
       (qui ferait sinon un fetch partiel côté client au lieu d'une vraie navigation complète). *@
    <a href="@CultureLink("fr")" data-enhance-nav="false" class="@(CurrentCultureIsFrench ? "active" : "")">FR</a>
    <a href="@CultureLink("en")" data-enhance-nav="false" class="@(!CurrentCultureIsFrench ? "active" : "")">EN</a>
</div>

<nav class="main-nav">
    <a href="/">@Localizer["Accueil"]</a>
    @if (_isAuthenticated)
    {
        @if (_hasCompany)
        {
            <a href="/entreprise/profil">@Localizer["Module_ProfilEntreprise"]</a>
            @if (_companyActiveModules.Contains("PostesRecrutement")) { <a href="/entreprise/postes">@Localizer["Module_PostesEntreprise"]</a> }
            @if (_companyActiveModules.Contains("Vivier")) { <a href="/vivier">@Localizer["Module_Vivier"]</a> }
            @if (_companyActiveModules.Contains("SuiviEvolutif")) { <a href="/entreprise/historique">@Localizer["Module_HistoriqueEntreprise"]</a> }
            @if (_companyActiveModules.Contains("Analytics")) { <a href="/entreprise/analytics">@Localizer["Module_AnalyticsEntreprise"]</a> }
            <a href="/entreprise/modules">@Localizer["AjouterUnModuleEntreprise"]</a>
        }
        else
        {
            <a href="/entreprise/creer">@Localizer["CreerUneEntreprise"]</a>
        }

        @if (_candidateActiveModules.Contains("ProfilCandidat"))
        {
            <a href="/candidat/questionnaire">@Localizer["Module_QuestionnaireCandidat"]</a>
            <a href="/candidat/cv">@Localizer["Module_CurriculumVitae"]</a>
            <a href="/candidat/postes">@Localizer["Module_PostesCandidat"]</a>
            <a href="/candidat/historique">@Localizer["Module_HistoriqueCandidat"]</a>
            <a href="/candidat/modules">@Localizer["AjouterUnModuleCandidat"]</a>
        }

        @if (_showGestionDuTemps)
        {
            <a href="/gestion-du-temps">@Localizer["Module_GestionDuTemps"]</a>
            <a href="/gestion-du-temps/kanban">@Localizer["Module_Kanban"]</a>
            <a href="/gestion-du-temps/profil">@Localizer["Module_ProfilPsychosocial"]</a>
            <a href="/gestion-du-temps/reflexion">@Localizer["Module_ReflexionConsciente"]</a>
            <a href="/gestion-du-temps/synthese">@Localizer["Module_Synthese"]</a>
        }
    }
    <AuthorizeView>
        <Authorized>
            <span>@Localizer["Connecte"]</span>
            <a href="/logout">@Localizer["Deconnexion"]</a>
        </Authorized>
        <NotAuthorized>
            <a href="/login">@Localizer["Connexion"]</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isAuthenticated;
    private bool _hasCompany;
    private readonly HashSet<string> _companyActiveModules = [];
    private readonly HashSet<string> _candidateActiveModules = [];
    private bool _showGestionDuTemps;

    /// <summary>
    /// Menu entièrement dynamique : chaque lien de module (hors Gestion du temps, voir plus bas) n'apparaît
    /// que si <see cref="IModuleRegistry.IsActiveAsync"/>/<see cref="IModuleRegistry.IsActiveForCandidateAsync"/>
    /// le confirme — jamais <c>GetActiveModuleCodesAsync</c>, qui n'applique pas le gating par plan (règle du
    /// projet). Recalculé à chaque rendu du layout (pas de mise en cache inter-navigation) — coût négligeable,
    /// une poignée de requêtes simples sur le schéma core.
    /// </summary>
    /// <remarks>
    /// <see cref="IDbContextFactory{TContext}"/>, jamais le <c>CoreDbContext</c> scopé ambiant : ce layout
    /// englobe TOUTES les pages, dont certaines (ex. Accueil) exécutent elles-mêmes plusieurs requêtes async
    /// sur ce même <c>CoreDbContext</c> partagé dans le même circuit — deux composants indépendants
    /// utilisant concurremment UNE instance EF Core provoque des erreurs de bas niveau côté pilote Npgsql
    /// (constaté en test manuel). Une instance dédiée, créée puis disposée ici, élimine ce risque —
    /// même réflexe que <c>GestionDuTempsAccessService</c>, qui utilisait déjà la factory pour cette raison.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var user = (await AuthenticationStateTask).User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        _isAuthenticated = true;

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
            return;

        await using var coreDb = await CoreDbFactory.CreateDbContextAsync();

        var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, coreDb);
        if (companies.Count > 0)
        {
            _hasCompany = true;
            var companyId = companies[0].Id;
            foreach (var manifest in ModuleRegistry.AllModules)
            {
                if (manifest.Code == "GestionDuTemps") continue; // gating séparé ci-dessous (couvre aussi le cas candidat)
                if (PersonalModuleCodes.Codes.Contains(manifest.Code)) continue; // jamais pertinent pour une entreprise (voir PersonalModuleCodes)
                if (await ModuleRegistry.IsActiveAsync(companyId, manifest.Code, coreDb))
                    _companyActiveModules.Add(manifest.Code);
            }
        }

        var candidateProfileId = await CandidateSubjectResolver.GetOrCreateCandidateProfileIdAsync(userId);
        foreach (var manifest in ModuleRegistry.AllModules)
        {
            if (manifest.Code == "GestionDuTemps") continue;
            if (await ModuleRegistry.IsActiveForCandidateAsync(candidateProfileId, manifest.Code, coreDb))
                _candidateActiveModules.Add(manifest.Code);
        }

        // Même vérification que la page Gestion du temps elle-même (voir IGestionDuTempsAccessService) :
        // couvre à la fois l'activation candidat ET celle de toute entreprise gérée par l'utilisateur.
        // Ce service utilise déjà sa propre IDbContextFactory en interne, indépendante de coreDb ci-dessus.
        _showGestionDuTemps = await GestionDuTempsAccessService.HasAccessAsync(userId);
    }

    private bool CurrentCultureIsFrench => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";

    /// <summary>URL de l'endpoint /culture/set (voir Program.cs), avec la page courante comme retour — jamais construite côté client, jamais un @onclick Blazor (voir la remarque sur le sélecteur ci-dessus).</summary>
    private string CultureLink(string culture)
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"/culture/set?culture={culture}&redirectUri={Uri.EscapeDataString(returnUrl)}";
    }
}
