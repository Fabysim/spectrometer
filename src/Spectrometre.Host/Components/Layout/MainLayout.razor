@inherits LayoutComponentBase
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Localization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Spectrometre.Core.Data
@using Spectrometre.Core.Modules
@using Spectrometre.Core.Tenancy
@using Spectrometre.Host.Onboarding
@using Spectrometre.Host.Resources
@using Spectrometre.Modules.GestionDuTemps.Services
@using Spectrometre.Modules.JeunesPrestataires.Services
@using Spectrometre.Modules.Missions.Services
@inject IJeuneProfileService JeuneProfileService
@inject IParticulierProfileService ParticulierProfileService
@inject IConsentementParentalService ConsentementParentalService
@inject IGestionDuTempsAccessService GestionDuTempsAccessService
@inject IStringLocalizer<Spectrometre.Modules.Admin.Resources.AdminResource> AdminLocalizer
@inject IModuleRegistry ModuleRegistry
@inject ICompanyProvisioningService CompanyProvisioningService
@inject ICandidateSubjectResolver CandidateSubjectResolver
@inject ICoachSubjectResolver CoachSubjectResolver
@inject IDbContextFactory<CoreDbContext> CoreDbFactory
@inject IStringLocalizer<SharedResource> Localizer
@inject NavigationManager Navigation

<div class="app-shell">
    <button type="button" class="sidebar-mobile-btn" onclick="spectrometreToggleMobileSidebar()" aria-label="Menu">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>
    <div class="sidebar-mobile-overlay" id="sidebarOverlay" onclick="spectrometreToggleMobileSidebar()"></div>

    <aside class="sidebar-auth collapsed" id="appSidebar">
        <div class="sidebar-header">
            <a href="/dashboard" class="sidebar-logo" data-enhance-nav="false">
                <span class="logo-icon">S</span>
                <span class="logo-text">@Localizer["Header_Brand_Title"]</span>
            </a>
            <button type="button" class="sidebar-toggle-btn" onclick="spectrometreToggleSidebar(event)" aria-label="Menu">
                <i class="bi bi-chevron-left sidebar-toggle-icon-open" aria-hidden="true"></i>
                <i class="bi bi-chevron-right sidebar-toggle-icon-collapsed" aria-hidden="true"></i>
            </button>
            <AuthorizeView>
                <Authorized>
                    <div class="user-info">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span>@context.User.Identity?.Name</span>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <nav class="sidebar-nav">
            @if (_isAuthenticated)
            {
                @* PlatformAdmin : pas d'entrée Entreprise (ni création) — le menu admin couvre la plateforme. *@
                @if (_hasCompany && !_isPlatformAdmin)
                {
                    <div class="nav-group @(IsGroupActive("entreprise") ? "open" : "")" data-nav-group="entreprise">
                        <div class="nav-group-row">
                            <a href="/entreprise/donnees" class="nav-item-auth nav-group-primary @ActiveClass("/entreprise/donnees")">
                                <span class="nav-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                                <span>@Localizer["Entreprise"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("entreprise") ? "true" : "false")" aria-label="@Localizer["Entreprise"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <div class="nav-module-label">@Localizer["NavGroup_GestionEntreprise"]</div>
                            <a href="/entreprise/donnees" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/donnees")">
                                <span class="nav-icon"><i class="bi bi-card-text" aria-hidden="true"></i></span>
                                <span>@Localizer["DonneesDeLEntreprise"]</span>
                            </a>
                            <a href="/entreprise/profil" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/profil")">
                                <span class="nav-icon"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_ProfilEntreprise"]</span>
                            </a>
                            <a href="/entreprise/employes" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/employes")">
                                <span class="nav-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                                <span>@Localizer["GestionManagers_Titre"]</span>
                            </a>
                            @* Socle postes/candidatures : brique ProfilEntreprise, jamais gated par Recrutement. *@
                            <a href="/entreprise/postes" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/postes")">
                                <span class="nav-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_PostesEntreprise"]</span>
                            </a>

                            @* Un groupe distinct par module réellement actif, dans l'ordre canonique et stable
                               d'enregistrement des manifestes (ModuleRegistry.AllModules, voir OnInitializedAsync) —
                               jamais un ordre recalculé/aléatoire à chaque rendu. *@
                            @foreach (var manifest in ModuleRegistry.AllModules)
                            {
                                if (manifest.Code == "Vivier" && _companyActiveModules.Contains("Vivier"))
                                {
                                    <div class="nav-module-label">@ModuleLabel(manifest)</div>
                                    <a href="/vivier" class="nav-item-auth nav-sub-item @ActiveClass("/vivier")">
                                        <span class="nav-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                                        <span>@Localizer["Module_Vivier"]</span>
                                    </a>
                                }
                                else if (manifest.Code == "SuiviEvolutif" && _companyActiveModules.Contains("SuiviEvolutif"))
                                {
                                    <div class="nav-module-label">@ModuleLabel(manifest)</div>
                                    <a href="/entreprise/historique" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/historique")">
                                        <span class="nav-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                                        <span>@Localizer["Module_HistoriqueEntreprise"]</span>
                                    </a>
                                }
                                else if (manifest.Code == "Analytics" && _companyActiveModules.Contains("Analytics"))
                                {
                                    <div class="nav-module-label">@ModuleLabel(manifest)</div>
                                    <a href="/entreprise/analytics" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/analytics")">
                                        <span class="nav-icon"><i class="bi bi-graph-up" aria-hidden="true"></i></span>
                                        <span>@Localizer["Module_AnalyticsEntreprise"]</span>
                                    </a>
                                }
                                else if (manifest.Code == "SuiviEmployes" && _companyActiveModules.Contains("SuiviEmployes"))
                                {
                                    <div class="nav-module-label">@ModuleLabel(manifest)</div>
                                    <a href="/entreprise/employes" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/employes")">
                                        <span class="nav-icon"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i></span>
                                        <span>@Localizer["Module_SuiviEvaluationEmployes"]</span>
                                    </a>
                                }
                            }

                            <a href="/entreprise/modules" class="nav-item-auth nav-sub-item @ActiveClass("/entreprise/modules")">
                                <span class="nav-icon"><i class="bi bi-plus-square" aria-hidden="true"></i></span>
                                <span>@Localizer["AjouterUnModuleEntreprise"]</span>
                            </a>
                        </div>
                    </div>
                }
                else if (!_estCandidatOuCoach && !_isPlatformAdmin && !_estJeune && !_estParticulier)
                {
                    <a href="/entreprise/creer" class="nav-item-auth @ActiveClass("/entreprise/creer")">
                        <span class="nav-icon"><i class="bi bi-building-add" aria-hidden="true"></i></span>
                        <span>@Localizer["CreerUneEntreprise"]</span>
                    </a>
                }

                @if (_estJeune)
                {
                    <div class="nav-group @(IsGroupActive("jeune") ? "open" : "")" data-nav-group="jeune">
                        <div class="nav-group-row">
                            <a href="/jeune/auto-observation" class="nav-item-auth nav-group-primary @ActiveClass("/jeune/auto-observation")">
                                <span class="nav-icon"><i class="bi bi-person-hearts" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_EspaceJeune"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("jeune") ? "true" : "false")" aria-label="@Localizer["Home_EspaceJeune"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <a href="/jeune/auto-observation" class="nav-item-auth nav-sub-item @ActiveClass("/jeune/auto-observation")">
                                <span class="nav-icon"><i class="bi bi-ui-checks" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_QuestionnaireAutoObservation"]</span>
                            </a>
                            <a href="/jeune/grille-observation" class="nav-item-auth nav-sub-item @ActiveClass("/jeune/grille-observation")">
                                <span class="nav-icon"><i class="bi bi-clipboard2-data" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_GrilleObservation"]</span>
                            </a>
                            <a href="/candidat/cv" class="nav-item-auth nav-sub-item @ActiveClass("/candidat/cv")">
                                <span class="nav-icon"><i class="bi bi-file-earmark-person" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_MonCv"]</span>
                            </a>
                            <a href="/jeune/missions-disponibles" class="nav-item-auth nav-sub-item @ActiveClass("/jeune/missions-disponibles")">
                                <span class="nav-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_MissionsDisponibles"]</span>
                            </a>
                            <a href="/jeune/mes-missions" class="nav-item-auth nav-sub-item @ActiveClass("/jeune/mes-missions")">
                                <span class="nav-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_MesMissionsJeune"]</span>
                            </a>
                            @if (_consentementParentalACompleter)
                            {
                                <a href="/candidat/consentement-parental" class="nav-item-auth nav-sub-item @ActiveClass("/candidat/consentement-parental")">
                                    <span class="nav-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                                    <span>@Localizer["Home_ConsentementParental"]</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @* Jeune prestataire : ProfilCandidat reste actif en base (CreateCandidateAsync pour Gestion du temps)
                   mais l'UI « candidat adulte » (questionnaire emploi, postes, historique…) est masquée — voir
                   CandidateOnboardingService et Dashboard.razor. Seul Mon CV est exposé dans Espace jeune. *@
                @if (_candidateActiveModules.Contains("ProfilCandidat") && !_estJeune)
                {
                    <div class="nav-group @(IsGroupActive("candidat") ? "open" : "")" data-nav-group="candidat">
                        <div class="nav-group-row">
                            <a href="/candidat/questionnaire" class="nav-item-auth nav-group-primary @ActiveClass("/candidat/questionnaire")">
                                <span class="nav-icon"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_QuestionnaireCandidat"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("candidat") ? "true" : "false")" aria-label="@Localizer["Candidat"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <a href="/candidat/cv" class="nav-item-auth nav-sub-item @ActiveClass("/candidat/cv")">
                                <span class="nav-icon"><i class="bi bi-file-earmark-person" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_CurriculumVitae"]</span>
                            </a>
                            <a href="/candidat/postes" class="nav-item-auth nav-sub-item @ActiveClass("/candidat/postes")">
                                <span class="nav-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_PostesCandidat"]</span>
                            </a>
                            <a href="/candidat/historique" class="nav-item-auth nav-sub-item @ActiveClass("/candidat/historique")">
                                <span class="nav-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_HistoriqueCandidat"]</span>
                            </a>
                            <a href="/candidat/modules" class="nav-item-auth nav-sub-item @ActiveClass("/candidat/modules")">
                                <span class="nav-icon"><i class="bi bi-plus-square" aria-hidden="true"></i></span>
                                <span>@Localizer["AjouterUnModuleCandidat"]</span>
                            </a>
                        </div>
                    </div>
                }

                @if (_showGestionDuTemps)
                {
                    <div class="nav-group @(IsGroupActive("gdt") ? "open" : "")" data-nav-group="gdt">
                        <div class="nav-group-row">
                            <a href="/gestion-du-temps" class="nav-item-auth nav-group-primary @ActiveClassExact("/gestion-du-temps")">
                                <span class="nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_GestionDuTemps"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("gdt") ? "true" : "false")" aria-label="@Localizer["Module_GestionDuTemps"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <a href="/gestion-du-temps/profil" class="nav-item-auth nav-sub-item @ActiveClass("/gestion-du-temps/profil")">
                                <span class="nav-icon"><i class="bi bi-emoji-smile" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_ProfilPsychosocial"]</span>
                            </a>
                            <a href="/gestion-du-temps/reflexion" class="nav-item-auth nav-sub-item @ActiveClass("/gestion-du-temps/reflexion")">
                                <span class="nav-icon"><i class="bi bi-lightbulb" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_ReflexionConsciente"]</span>
                            </a>
                            <a href="/gestion-du-temps/organisation" class="nav-item-auth nav-sub-item @ActiveClass("/gestion-du-temps/organisation")">
                                <span class="nav-icon"><i class="bi bi-calendar-week" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_Organisation"]</span>
                            </a>
                            <a href="/gestion-du-temps/calendrier" class="nav-item-auth nav-sub-item @ActiveClass("/gestion-du-temps/calendrier")">
                                <span class="nav-icon"><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_Calendrier"]</span>
                            </a>
                            <a href="/gestion-du-temps/kanban" class="nav-item-auth nav-sub-item @ActiveClass("/gestion-du-temps/kanban")">
                                <span class="nav-icon"><i class="bi bi-kanban" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_Planification"]</span>
                            </a>
                            <a href="/gestion-du-temps/synthese" class="nav-item-auth nav-sub-item @ActiveClass("/gestion-du-temps/synthese")">
                                <span class="nav-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
                                <span>@Localizer["Module_Synthese"]</span>
                            </a>
                            @if (_showMonCoach)
                            {
                                <a href="/mon-coach" class="nav-item-auth nav-sub-item @ActiveClass("/mon-coach")">
                                    <span class="nav-icon"><i class="bi bi-person-hearts" aria-hidden="true"></i></span>
                                    <span>@Localizer["Nav_MonCoach"]</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (_estParticulier && _particulierActiveModules.Contains("ProfilParticulier"))
                {
                    <div class="nav-group @(IsGroupActive("particulier") ? "open" : "")" data-nav-group="particulier">
                        <div class="nav-group-row">
                            <a href="/particulier/publier-mission" class="nav-item-auth nav-group-primary @ActiveClass("/particulier/publier-mission")">
                                <span class="nav-icon"><i class="bi bi-house-heart" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_ProfilParticulier"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("particulier") ? "true" : "false")" aria-label="@Localizer["Particulier"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <a href="/particulier/publier-mission" class="nav-item-auth nav-sub-item @ActiveClass("/particulier/publier-mission")">
                                <span class="nav-icon"><i class="bi bi-plus-circle" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_PublierMission"]</span>
                            </a>
                            <a href="/particulier/mes-missions" class="nav-item-auth nav-sub-item @ActiveClass("/particulier/mes-missions")">
                                <span class="nav-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_MesMissionsPubliees"]</span>
                            </a>
                        </div>
                    </div>
                }

                @if (_coachActiveModules.Contains("ProfilCoach"))
                {
                    <div class="nav-group @(IsGroupActive("coach") ? "open" : "")" data-nav-group="coach">
                        <div class="nav-group-row">
                            <a href="/coach/profil" class="nav-item-auth nav-group-primary @ActiveClass("/coach/profil")">
                                <span class="nav-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_ProfilCoach"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("coach") ? "true" : "false")" aria-label="@Localizer["Coach"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <a href="/coach/suivis" class="nav-item-auth nav-sub-item @ActiveClass("/coach/suivis")">
                                <span class="nav-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                                <span>@Localizer["Home_MesPersonnesSuivies"]</span>
                            </a>
                            <a href="/coach/modules" class="nav-item-auth nav-sub-item @ActiveClass("/coach/modules")">
                                <span class="nav-icon"><i class="bi bi-plus-square" aria-hidden="true"></i></span>
                                <span>@Localizer["AjouterUnModuleCoach"]</span>
                            </a>
                        </div>
                    </div>
                }

                @if (_isPlatformAdmin)
                {
                    <div class="nav-group @(IsGroupActive("admin") ? "open" : "")" data-nav-group="admin">
                        <div class="nav-group-row">
                            <a href="/admin" class="nav-item-auth nav-group-primary @ActiveClassExact("/admin")">
                                <span class="nav-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["Administration"]</span>
                            </a>
                            <button type="button" class="nav-group-caret" onclick="spectrometreToggleNavGroup(this)" aria-expanded="@(IsGroupActive("admin") ? "true" : "false")" aria-label="@AdminLocalizer["Administration"]">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="nav-submenu">
                            <a href="/admin/entreprises" class="nav-item-auth nav-sub-item @ActiveClass("/admin/entreprises")">
                                <span class="nav-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavEntreprises"]</span>
                            </a>
                            <a href="/admin/candidats" class="nav-item-auth nav-sub-item @ActiveClass("/admin/candidats")">
                                <span class="nav-icon"><i class="bi bi-person" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavCandidats"]</span>
                            </a>
                            <a href="/admin/coachs" class="nav-item-auth nav-sub-item @ActiveClass("/admin/coachs")">
                                <span class="nav-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavCoachs"]</span>
                            </a>
                            <a href="/admin/liens-coaching" class="nav-item-auth nav-sub-item @ActiveClass("/admin/liens-coaching")">
                                <span class="nav-icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavLiensCoaching"]</span>
                            </a>
                            <a href="/admin/invitations" class="nav-item-auth nav-sub-item @ActiveClass("/admin/invitations")">
                                <span class="nav-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavInvitations"]</span>
                            </a>
                            <a href="/admin/recherche" class="nav-item-auth nav-sub-item @ActiveClass("/admin/recherche")">
                                <span class="nav-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavRecherche"]</span>
                            </a>
                            <a href="/admin/administrateurs" class="nav-item-auth nav-sub-item @ActiveClass("/admin/administrateurs")">
                                <span class="nav-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavAdministrateurs"]</span>
                            </a>
                            <a href="/admin/tarifs-modules" class="nav-item-auth nav-sub-item @ActiveClass("/admin/tarifs-modules")">
                                <span class="nav-icon"><i class="bi bi-currency-dollar" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavTarifsModules"]</span>
                            </a>
                            <a href="/admin/facturation" class="nav-item-auth nav-sub-item @ActiveClass("/admin/facturation")">
                                <span class="nav-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavFacturation"]</span>
                            </a>
                            <a href="/admin/historique" class="nav-item-auth nav-sub-item @ActiveClass("/admin/historique")">
                                <span class="nav-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                                <span>@AdminLocalizer["AdminNavHistorique"]</span>
                            </a>
                        </div>
                    </div>
                }
            }
        </nav>

        <div class="sidebar-footer">
            <a href="/dashboard" class="nav-item-auth @ActiveClass("/dashboard")">
                <span class="nav-icon"><i class="bi bi-house-door" aria-hidden="true"></i></span>
                <span>@Localizer["Accueil"]</span>
            </a>
            <AuthorizeView>
                <Authorized>
                    <a href="/logout" class="nav-item-auth" data-enhance-nav="false">
                        <span class="nav-icon"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></span>
                        <span>@Localizer["Deconnexion"]</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="nav-item-auth @ActiveClass("/login")">
                        <span class="nav-icon"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></span>
                        <span>@Localizer["Connexion"]</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    <div class="main-content-auth">
        <div class="topbar-auth">
            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                </Authorized>
            </AuthorizeView>
            <div class="lang-switcher">
                <a href="@CultureLink("fr")" data-enhance-nav="false" class="@(CurrentCultureIsFrench ? "active" : "")">FR</a>
                <a href="@CultureLink("en")" data-enhance-nav="false" class="@(!CurrentCultureIsFrench ? "active" : "")">EN</a>
            </div>
        </div>
        <div class="main-content-body">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isAuthenticated;
    private bool _hasCompany;
    private bool _estCandidatOuCoach;
    private bool _estJeune;
    private bool _estParticulier;
    private bool _consentementParentalACompleter;
    private readonly HashSet<string> _companyActiveModules = [];
    private readonly HashSet<string> _candidateActiveModules = [];
    private readonly HashSet<string> _coachActiveModules = [];
    private readonly HashSet<string> _particulierActiveModules = [];
    private bool _showGestionDuTemps;
    /// <summary>Sujet Candidat uniquement — voir IGestionDuTempsAccessService.HasCandidateAccessAsync : une entreprise avec Gestion du temps actif ne doit pas voir « Mon coach ».</summary>
    private bool _showMonCoach;
    private bool _isPlatformAdmin;

    /// <summary>
    /// Menu entièrement dynamique : chaque lien de module (hors Gestion du temps, voir plus bas) n'apparaît
    /// que si <see cref="IModuleRegistry.IsActiveAsync"/>/<see cref="IModuleRegistry.IsActiveForCandidateAsync"/>
    /// le confirme — jamais <c>GetActiveModuleCodesAsync</c>, qui ignore le statut d'abonnement (règle du
    /// projet). Recalculé à chaque rendu du layout (pas de mise en cache inter-navigation) — coût négligeable,
    /// une poignée de requêtes simples sur le schéma core.
    /// </summary>
    /// <remarks>
    /// <see cref="IDbContextFactory{TContext}"/>, jamais le <c>CoreDbContext</c> scopé ambiant : ce layout
    /// englobe TOUTES les pages, dont certaines (ex. Accueil) exécutent elles-mêmes plusieurs requêtes async
    /// sur ce même <c>CoreDbContext</c> partagé dans le même circuit — deux composants indépendants
    /// utilisant concurremment UNE instance EF Core provoque des erreurs de bas niveau côté pilote Npgsql
    /// (constaté en test manuel). Une instance dédiée, créée puis disposée ici, élimine ce risque —
    /// même réflexe que <c>GestionDuTempsAccessService</c>, qui utilisait déjà la factory pour cette raison.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var user = (await AuthenticationStateTask).User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        _isAuthenticated = true;
        // Rôle Identity porté directement par les claims du cookie d'authentification (AddRoles<IdentityRole>()
        // remplace la fabrique de principal par défaut pour inclure les rôles) — aucun aller-retour base
        // nécessaire, contrairement aux modules ci-dessous qui restent des tables métier dédiées.
        _isPlatformAdmin = user.IsInRole(Spectrometre.Core.Identity.PlatformRoles.Admin);

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
            return;

        await using var coreDb = await CoreDbFactory.CreateDbContextAsync();

        var companies = await CompanyProvisioningService.GetCompaniesForUserAsync(userId, coreDb);
        if (companies.Count > 0)
        {
            _hasCompany = true;
            var companyId = companies[0].Id;
            foreach (var manifest in ModuleRegistry.AllModules)
            {
                if (manifest.Code == "GestionDuTemps") continue; // gating séparé ci-dessous (couvre aussi le cas candidat)
                if (PersonalModuleCodes.Codes.Contains(manifest.Code)) continue; // jamais pertinent pour une entreprise (voir PersonalModuleCodes)
                if (await ModuleRegistry.IsActiveAsync(companyId, manifest.Code, coreDb))
                    _companyActiveModules.Add(manifest.Code);
            }
        }

        var candidateProfileId = await CandidateSubjectResolver.GetOrCreateCandidateProfileIdAsync(userId);
        foreach (var manifest in ModuleRegistry.AllModules)
        {
            if (manifest.Code == "GestionDuTemps") continue;
            if (await ModuleRegistry.IsActiveForCandidateAsync(candidateProfileId, manifest.Code, coreDb))
                _candidateActiveModules.Add(manifest.Code);
        }

        // Même vérification que la page Gestion du temps elle-même (voir IGestionDuTempsAccessService) :
        // couvre à la fois l'activation candidat ET celle de toute entreprise gérée par l'utilisateur.
        // Ce service utilise déjà sa propre IDbContextFactory en interne, indépendante de coreDb ci-dessus.
        _showGestionDuTemps = await GestionDuTempsAccessService.HasAccessAsync(userId);

        // « Mon coach » dérive de Gestion du temps mais UNIQUEMENT côté Candidat — une entreprise n'a pas de
        // coach, même si elle a activé Gestion du temps pour ses employés (voir la remarque sur
        // IGestionDuTempsAccessService.HasCandidateAccessAsync).
        _showMonCoach = _showGestionDuTemps && await GestionDuTempsAccessService.HasCandidateAccessAsync(userId);

        var coachProfileId = await CoachSubjectResolver.GetOrCreateCoachProfileIdAsync(userId);
        foreach (var manifest in ModuleRegistry.AllModules)
        {
            if (await ModuleRegistry.IsActiveForCoachAsync(coachProfileId, manifest.Code, coreDb))
                _coachActiveModules.Add(manifest.Code);
        }

        // Signal d'inscription Candidat/Coach (IsActive* uniquement) — une coquille vide GetOrCreate*
        // n'active pas ProfilCandidat/ProfilCoach ; le lien « Créer une entreprise » reste visible alors.
        _estCandidatOuCoach =
            await ModuleRegistry.IsActiveForCandidateAsync(candidateProfileId, "ProfilCandidat", coreDb)
            || await ModuleRegistry.IsActiveForCoachAsync(coachProfileId, "ProfilCoach", coreDb);

        // Même résolution que Dashboard.razor : un jeune (JeuneProfile créé par invitation coach) n'a ni
        // entreprise ni ProfilCandidat/ProfilCoach actif — sans ce garde-fou il retombe dans la branche
        // "aucun profil reconnu" et voit à tort le lien « Créer une entreprise ».
        var jeuneProfile = await JeuneProfileService.TryGetByUserIdAsync(userId);
        _estJeune = jeuneProfile is not null;
        if (jeuneProfile is not null
            && JeuneProfileService.EstMineur(jeuneProfile.DateNaissance)
            && !await ConsentementParentalService.EstConsentementValideAsync(jeuneProfile.Id))
        {
            _consentementParentalACompleter = true;
        }

        var particulierProfile = await ParticulierProfileService.TryGetByUserIdAsync(userId);
        _estParticulier = particulierProfile is not null;
        if (particulierProfile is not null)
        {
            foreach (var manifest in ModuleRegistry.AllModules)
            {
                if (await ModuleRegistry.IsActiveForParticulierAsync(particulierProfile.Id, manifest.Code, coreDb))
                    _particulierActiveModules.Add(manifest.Code);
            }
        }
    }

    private bool CurrentCultureIsFrench => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";

    /// <summary>Libellé de groupe pour un module dans le menu latéral — DisplayName/DisplayNameEn déjà sur chaque manifeste (voir Home.razor pour le même choix).</summary>
    private string ModuleLabel(ModuleManifest manifest) => CurrentCultureIsFrench ? manifest.DisplayName : manifest.DisplayNameEn;

    private string CurrentPath
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            var q = path.IndexOf('?', StringComparison.Ordinal);
            if (q >= 0) path = path[..q];
            return path.TrimEnd('/') is "" or "/" ? "/dashboard" : path.TrimEnd('/');
        }
    }

    private string ActiveClass(string href) =>
        CurrentPath.Equals(href, StringComparison.OrdinalIgnoreCase)
        || CurrentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    private string ActiveClassExact(string href) =>
        CurrentPath.Equals(href, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private bool IsGroupActive(string group) => group switch
    {
        "entreprise" => CurrentPath.StartsWith("/entreprise/donnees", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/entreprise/profil", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/entreprise/postes", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/entreprise/historique", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/entreprise/analytics", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/entreprise/employes", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/entreprise/modules", StringComparison.OrdinalIgnoreCase)
                        || CurrentPath.StartsWith("/vivier", StringComparison.OrdinalIgnoreCase),
        "candidat" => CurrentPath.StartsWith("/candidat", StringComparison.OrdinalIgnoreCase)
                      && !CurrentPath.Equals("/candidat/questionnaire", StringComparison.OrdinalIgnoreCase),
        "gdt" => (CurrentPath.StartsWith("/gestion-du-temps", StringComparison.OrdinalIgnoreCase)
                  && !CurrentPath.Equals("/gestion-du-temps", StringComparison.OrdinalIgnoreCase))
                 || CurrentPath.StartsWith("/mon-coach", StringComparison.OrdinalIgnoreCase),
        "coach" => CurrentPath.StartsWith("/coach/suivis", StringComparison.OrdinalIgnoreCase),
        "jeune" => CurrentPath.StartsWith("/jeune", StringComparison.OrdinalIgnoreCase)
                   || CurrentPath.StartsWith("/candidat/consentement-parental", StringComparison.OrdinalIgnoreCase)
                   || CurrentPath.StartsWith("/candidat/cv", StringComparison.OrdinalIgnoreCase),
        "particulier" => CurrentPath.StartsWith("/particulier", StringComparison.OrdinalIgnoreCase),
        "admin" => CurrentPath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase) && !CurrentPath.Equals("/admin", StringComparison.OrdinalIgnoreCase),
        _ => false
    };

    /// <summary>URL de l'endpoint /culture/set (voir Program.cs), avec la page courante comme retour — jamais construite côté client, jamais un @onclick Blazor (voir la remarque sur le sélecteur ci-dessus).</summary>
    private string CultureLink(string culture)
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"/culture/set?culture={culture}&redirectUri={Uri.EscapeDataString(returnUrl)}";
    }
}
