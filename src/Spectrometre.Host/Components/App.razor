<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="@Assets["css/home-vitrine.css"]" />
    <link rel="stylesheet" href="@Assets["css/gdt-org.css"]" />
    <link rel="stylesheet" href="@Assets["css/gdt-profil.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Spectrometre.Host.styles.css"]" />
    <link rel="icon" type="image/png" href="images/favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png" />
    <meta name="theme-color" content="#345f6d" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    @* Chargé ici plutôt que dans Inscription.razor : un <script> à l'intérieur d'une page @page ne
       s'exécute pas lors d'une navigation enrichie (enhanced navigation) de Blazor si la page est
       atteinte via un lien plutôt qu'un chargement complet, contrairement à ce qui est chargé dans le
       shell persistant ici. *@
    <script src="js/inscription.js"></script>
    <script src="js/home-vitrine.js"></script>
    <script src="js/sidebar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="js/gdt-charts.js"></script>
    <script src="js/grille-observation-chart.js"></script>
    <script src="js/gdt-helpers.js"></script>
    <script src="js/gdt-org.js"></script>
    <script src="js/download-helper.js"></script>
    <script src="js/interview-recorder.js"></script>
    <script>
        document.addEventListener('blazor:navigated', function () {
            if (typeof window._initHomeVitrine === 'function') {
                window._initHomeVitrine();
            }
        });
        window.addEventListener('popstate', function () {
            var path = window.location.pathname || '';
            if (path === '/' || path === '') {
                window.location.reload();
            }
        });
    </script>
</body>

</html>
