@page "/jeune/charte"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Spectrometre.Modules.JeunesPrestataires.Catalog
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ICharteService CharteService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<JeunesPrestatairesResource> Localizer

<PageTitle>@Localizer["Charte_Title"]</PageTitle>

<div class="jp-page">
    @if (_chargement)
    {
        <p class="jp-state">@Localizer["Chargement"]</p>
    }
    else if (_vue is null)
    {
        <section class="jp-card">
            <h1 class="jp-title">@Localizer["Charte_AccesRefuse_Titre"]</h1>
            <p>@Localizer["Charte_AccesRefuse_Message"]</p>
        </section>
    }
    else
    {
        <header class="jp-header">
            <h1 class="jp-title">@Localizer["Charte_Heading"]</h1>
            <p class="jp-subtitle">@Localizer["Charte_Intro"]</p>
            <p class="jp-subtitle" style="margin-top:0.5rem">@Localizer["Charte_Intro2"]</p>
        </header>

        @if (_vue.Acceptee && _vue.AccepteeLe is DateTimeOffset accepteeLe)
        {
            <div class="jp-badge-valid" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                @string.Format(CultureInfo.CurrentCulture, Localizer["Charte_AccepteeLe"], accepteeLe.ToLocalTime().ToString("g", CultureInfo.CurrentCulture))
            </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="jp-alert jp-alert-error" role="alert">@_message</div>
        }

        @foreach (var section in CharteCatalog.Sections)
        {
            <section class="jp-card">
                <h2 class="jp-section-title">@Localizer[$"Charte_S_{section.Key}_Titre"]</h2>
                <p class="jp-charte-corps">@Localizer[$"Charte_S_{section.Key}_Corps"]</p>
            </section>
        }

        @if (_vue.Acceptee)
        {
            <section class="jp-card">
                <h2 class="jp-section-title">@Localizer["Charte_Confirmation_Titre"]</h2>
                <p class="jp-hint">@Localizer["Charte_Confirmation_LectureSeule"]</p>
                <dl class="jp-readonly">
                    <div>
                        <dt>@Localizer["Charte_NomConfirmation"]</dt>
                        <dd>@_vue.NomConfirmation</dd>
                    </div>
                </dl>
            </section>
        }
        else
        {
            <section class="jp-card">
                <h2 class="jp-section-title">@Localizer["Charte_Confirmation_Titre"]</h2>
                <p class="jp-hint">@Localizer["Charte_Confirmation_Intro"]</p>
                <div class="jp-field">
                    <label>@Localizer["Charte_NomConfirmation"]</label>
                    <input class="jp-input" @bind="_nom" maxlength="200" />
                </div>
                <div class="jp-actions">
                    <button type="button" class="jp-btn-primary" disabled="@_busy" @onclick="AccepterAsync">
                        @Localizer["Charte_BoutonAccepter"]
                    </button>
                </div>
            </section>
        }
    }
</div>

@code {
    private bool _chargement = true;
    private CharteView? _vue;
    private string? _userId;
    private string _nom = "";
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (_userId is not null)
            _vue = await CharteService.GetAsync(_userId);
        _chargement = false;
    }

    private async Task AccepterAsync()
    {
        if (_userId is null || _busy)
            return;

        _busy = true;
        _message = null;
        var ok = await CharteService.AccepterAsync(_userId, _nom);
        if (ok)
            _vue = await CharteService.GetAsync(_userId);
        else
            _message = Localizer["Charte_ErreurAcceptation"];
        _busy = false;
    }
}
