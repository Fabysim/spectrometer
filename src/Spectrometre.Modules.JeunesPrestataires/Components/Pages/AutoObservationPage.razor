@page "/jeune/auto-observation"
@page "/coach/suivis/{SuiviUserId}/auto-observation"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Spectrometre.Modules.JeunesPrestataires.Catalog
@using Spectrometre.Modules.JeunesPrestataires.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IAutoObservationService AutoObservationService
@inject IPlanActionAutoObservationService PlanActionService
@inject IJeuneProfileService JeuneProfileService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<JeunesPrestatairesResource> Localizer

<PageTitle>@Localizer["AutoObs_PageTitle"]</PageTitle>

<div class="ao-page">
@if (_chargement)
{
    <p>@Localizer["Chargement"]</p>
}
else if (_page is null)
{
    <div class="ao-card ao-alert">
        <h2>@Localizer["AutoObs_AccesRefuse_Titre"]</h2>
        <p>@Localizer["AutoObs_AccesRefuse_Message"]</p>
    </div>
}
else if (_page.AccessMode == AutoObservationAccessMode.Jeune && _page.OrientationAFaire)
{
    <header class="ao-header">
        <h1 class="ao-title">@Localizer["Orientation_Titre"]</h1>
        <p class="ao-accroche">@Localizer["Orientation_Intro"]</p>
        <p class="ao-hint">@Localizer["Orientation_Aide"]</p>
    </header>
    <div class="ao-main ao-card">
        @foreach (var q in AutoObservationOrientationCatalog.Questions)
        {
            <div class="ao-question">
                <span class="ao-question-label">@Localizer[q.LabelResourceKey]</span>
                <div class="ao-radio-group" role="radiogroup" aria-label="@Localizer[q.LabelResourceKey]">
                    @foreach (var code in q.OptionCodes)
                    {
                        var c = code;
                        var on = _orientationReponses.GetValueOrDefault(q.Key) == c;
                        <button type="button"
                                class="ao-radio-btn @(on ? "ao-radio-btn--on" : "")"
                                role="radio"
                                aria-checked="@(on ? "true" : "false")"
                                @onclick="() => _orientationReponses[q.Key] = c">
                            @Localizer[$"Orientation_Opt_{c}"]
                        </button>
                    }
                </div>
            </div>
        }
        <div class="ao-actions">
            <button type="button" class="ao-btn-primary" @onclick="EnregistrerOrientationAsync" disabled="@(_saving || !OrientationComplete)">
                @Localizer["Orientation_Valider"]
            </button>
            <button type="button" class="ao-btn-secondary" @onclick="PasserOrientationAsync" disabled="@_saving">
                @Localizer["Orientation_Passer"]
            </button>
        </div>
        @if (_message is not null)
        {
            <p class="ao-hint">@_message</p>
        }
    </div>
}
else
{
    <header class="ao-header">
        <h1 class="ao-title">@Localizer["AutoObs_Titre"]</h1>
        <p class="ao-accroche">@AutoObservationCatalog.PageIntro</p>
        <p class="ao-hint">@AutoObservationCatalog.PageAideIntro</p>
        @if (_page.AccessMode == AutoObservationAccessMode.Coach)
        {
            <p class="ao-coach-badge">
                <i class="bi bi-eye" aria-hidden="true"></i>
                @string.Format(Localizer["AutoObs_ModeCoach"], _page.JeuneProfile.Prenoms, _page.JeuneProfile.Nom)
            </p>
            <p class="ao-hint">@Localizer["AutoObs_ProfilAccompagnement", Localizer[$"ProfilAccompagnement_{_page.JeuneProfile.ProfilAccompagnement}"]]</p>
        }
    </header>

    <div class="ao-layout">
        <aside class="ao-sidebar ao-card">
            <h2 class="ao-sidebar-title">@Localizer["AutoObs_Progression"]</h2>
            @foreach (var partie in AutoObservationCatalog.GetPartiesOrdonnees(_page.JeuneProfile.ProfilAccompagnement))
            {
            <details open class="ao-part">
                <summary>@Localizer[$"AutoObs_Partie{partie.PartNumber}"]</summary>
                <ul class="ao-section-list">
                    @foreach (var s in partie.Sections)
                    {
                        <li>
                            <button type="button" class="ao-section-btn @(_sectionKey == s.Key ? "active" : "") @(IsSaved(s.Key) ? "saved" : "")"
                                    @onclick="() => SelectSectionAsync(s.Key)">
                                @TexteCatalogue($"AutoObs_S_{s.Key}", s.Title)
                            </button>
                        </li>
                    }
                </ul>
            </details>
            }
        </aside>

        <main class="ao-main ao-card">
            @if (_sectionDef is not null)
            {
                <h2 class="ao-section-title">@TexteCatalogue($"AutoObs_S_{_sectionDef.Key}", _sectionDef.Title)</h2>
                @if (!string.IsNullOrWhiteSpace(_sectionDef.Intro))
                {
                    <p class="ao-hint">@TexteCatalogue($"AutoObs_I_{_sectionDef.Key}", _sectionDef.Intro)</p>
                }

                @if (_sectionDef.Key == "p2.s1")
                {
                    <dl class="ao-readonly">
                        <div><dt>@Localizer["Nom"]</dt><dd>@_page.JeuneProfile.Nom</dd></div>
                        <div><dt>@Localizer["Prenoms"]</dt><dd>@_page.JeuneProfile.Prenoms</dd></div>
                        <div><dt>@Localizer["DateNaissance"]</dt><dd>@_page.JeuneProfile.DateNaissance.ToString("d", CultureInfo.CurrentCulture)</dd></div>
                        <div><dt>@Localizer["Age"]</dt><dd>@string.Format(Localizer["AgeAns"], JeuneProfileService.CalculerAge(_page.JeuneProfile.DateNaissance))</dd></div>
                    </dl>
                }

                @if (_sectionDef.IsSynthesisDisplayOnly)
                {
                    <p class="ao-hint">@AutoObservationCatalog.Part2Intro</p>
                    <div class="ao-synthese-actions">
                        <button type="button" class="ao-btn-primary" @onclick="RegenererSyntheseAsync" disabled="@_saving">
                            @Localizer["AutoObs_RegenererSynthese"]
                        </button>
                    </div>
                    @if (_page.Synthese is { } synthese)
                    {
                        @if (_page.SyntheseValideeLe is DateTimeOffset valideeLe)
                        {
                            <p class="ao-hint ao-synthese-validee">@string.Format(Localizer["AutoObs_Synthese_ValideeLe"], valideeLe.ToLocalTime().ToString("g", CultureInfo.CurrentCulture))</p>
                        }
                        else
                        {
                            <p class="ao-hint ao-synthese-non-validee">@Localizer["AutoObs_Synthese_PasEncoreRelue"]</p>
                        }
                        <div class="ao-synthese">
                            @AfficherTableau(synthese.TroncCommun)
                            @if (synthese.Employabilite is { } t2a)
                            {
                                @AfficherTableau(t2a)
                            }
                            @if (synthese.Orientation is { } t2b)
                            {
                                @AfficherTableau(t2b)
                            }
                        </div>
                        @if (_page.AccessMode == AutoObservationAccessMode.Coach)
                        {
                            <div class="ao-actions">
                                <button type="button" class="ao-btn-secondary" @onclick="ValiderSyntheseAsync" disabled="@_saving">
                                    @Localizer["AutoObs_Synthese_Valider"]
                                </button>
                            </div>
                            <section class="ao-synthese-bloc">
                                <h3 class="ao-synthese-titre">@Localizer["PlanAction_Titre"]</h3>
                                <p class="ao-hint">@Localizer["PlanAction_IntroCoach"]</p>
                                <div class="ao-question">
                                    <label class="ao-question-label" for="pa-objectif">@Localizer["PlanAction_ObjectifPrincipal"]</label>
                                    <textarea id="pa-objectif" class="ao-textarea" rows="2" @bind="_planObjectif"></textarea>
                                </div>
                                <div class="ao-question">
                                    <label class="ao-question-label" for="pa-action">@Localizer["PlanAction_PremiereAction"]</label>
                                    <textarea id="pa-action" class="ao-textarea" rows="2" @bind="_planAction"></textarea>
                                </div>
                                <div class="ao-question">
                                    <label class="ao-question-label" for="pa-responsable">@Localizer["PlanAction_ResponsableSuivi"]</label>
                                    <input id="pa-responsable" class="ao-input" @bind="_planResponsable" />
                                </div>
                                <div class="ao-question">
                                    <label class="ao-question-label" for="pa-echeance">@Localizer["PlanAction_Echeance"]</label>
                                    <input id="pa-echeance" class="ao-input" type="date" @bind="_planEcheance" @bind:format="yyyy-MM-dd" />
                                </div>
                                <div class="ao-question">
                                    <label class="ao-question-label" for="pa-indicateur">@Localizer["PlanAction_IndicateurReussite"]</label>
                                    <textarea id="pa-indicateur" class="ao-textarea" rows="2" @bind="_planIndicateur"></textarea>
                                </div>
                                <div class="ao-actions">
                                    <button type="button" class="ao-btn-primary" @onclick="EnregistrerPlanAsync" disabled="@_saving">
                                        @Localizer["PlanAction_Enregistrer"]
                                    </button>
                                </div>
                            </section>
                        }
                        else if (_planLecture?.EstRempli == true)
                        {
                            <section class="ao-synthese-bloc">
                                <h3 class="ao-synthese-titre">@Localizer["PlanAction_Titre"]</h3>
                                <table class="ao-synthese-table">
                                    <tbody>
                                        <tr><th scope="row">@Localizer["PlanAction_ObjectifPrincipal"]</th><td>@AfficherPlanChamp(_planLecture.ObjectifPrincipal)</td></tr>
                                        <tr><th scope="row">@Localizer["PlanAction_PremiereAction"]</th><td>@AfficherPlanChamp(_planLecture.PremiereAction)</td></tr>
                                        <tr><th scope="row">@Localizer["PlanAction_ResponsableSuivi"]</th><td>@AfficherPlanChamp(_planLecture.ResponsableSuivi)</td></tr>
                                        <tr><th scope="row">@Localizer["PlanAction_Echeance"]</th><td>@(_planLecture.Echeance?.ToString("d", CultureInfo.CurrentCulture) ?? Localizer["ValeurNonRenseignee"].Value)</td></tr>
                                        <tr><th scope="row">@Localizer["PlanAction_IndicateurReussite"]</th><td>@AfficherPlanChamp(_planLecture.IndicateurReussite)</td></tr>
                                    </tbody>
                                </table>
                            </section>
                        }
                    }
                    else
                    {
                        <p class="ao-hint">@Localizer["AutoObs_SyntheseVide"]</p>
                    }
                }
                else
                {
                    string? currentPistePrefix = null;
                    @foreach (var q in _sectionDef.Questions)
                    {
                        @if (q.AutreKey is not null && q.Key.EndsWith(".autre", StringComparison.Ordinal))
                        {
                            continue;
                        }

                        @if (_sectionDef.Key == "p0.s7"
                             && q.Key.Length > 12
                             && q.Key.StartsWith("p0.s7.piste", StringComparison.Ordinal))
                        {
                            var dotAfterPiste = q.Key.IndexOf('.', "p0.s7.piste".Length);
                            var pistePrefix = dotAfterPiste > 0 ? q.Key[..dotAfterPiste] : null;
                            if (pistePrefix is not null && pistePrefix != currentPistePrefix)
                            {
                                currentPistePrefix = pistePrefix;
                                var pisteNum = pistePrefix["p0.s7.piste".Length..];
                                <h3 class="ao-piste-title">@string.Format(Localizer["AutoObs_Piste"], pisteNum)</h3>
                            }
                        }

                        <div class="ao-question">
                            <label class="ao-question-label">@TexteCatalogue($"AutoObs_Q_{q.Key}", q.Label)</label>
                            @switch (q.FieldType)
                            {
                                case AutoObservationFieldType.OpenText:
                                    <textarea class="ao-textarea" rows="3" disabled="@(!_canEdit)"
                                              @bind="_textValues[q.Key]"></textarea>
                                    break;
                                case AutoObservationFieldType.MultiCheckbox:
                                    <div class="ao-check-group" role="group" aria-label="@TexteCatalogue($"AutoObs_Q_{q.Key}", q.Label)">
                                        @{ var optIndex = 0; }
                                        @foreach (var opt in q.Options ?? [])
                                        {
                                            var option = opt;
                                            var i = optIndex++;
                                            var on = IsChecked(q.Key, option);
                                            var isAutre = option.StartsWith("Autre", StringComparison.Ordinal);
                                            <div class="ao-check-item">
                                                <button type="button"
                                                        class="ao-check-btn @(on ? "ao-check-btn--on" : "")"
                                                        role="checkbox"
                                                        aria-checked="@(on ? "true" : "false")"
                                                        disabled="@(!_canEdit)"
                                                        @onclick="() => ToggleMulti(q.Key, option, !on)">
                                                    @TexteCatalogue($"AutoObs_O_{q.Key}_{i}", option)
                                                </button>
                                                @if (isAutre && q.AutreKey is not null)
                                                {
                                                    <input class="ao-input ao-autre" disabled="@(!_canEdit || !on)"
                                                           @bind="_textValues[q.AutreKey]" placeholder="@Localizer["AutoObs_AutrePreciser"]" />
                                                }
                                            </div>
                                        }
                                    </div>
                                    break;
                                case AutoObservationFieldType.SingleChoice:
                                    <div class="ao-radio-group" role="radiogroup" aria-label="@TexteCatalogue($"AutoObs_Q_{q.Key}", q.Label)">
                                        @{ var radioIndex = 0; }
                                        @foreach (var opt in q.Options ?? [])
                                        {
                                            var option = opt;
                                            var i = radioIndex++;
                                            var on = _textValues.GetValueOrDefault(q.Key) == option;
                                            <button type="button"
                                                    class="ao-radio-btn @(on ? "ao-radio-btn--on" : "")"
                                                    role="radio"
                                                    aria-checked="@(on ? "true" : "false")"
                                                    disabled="@(!_canEdit)"
                                                    @onclick="() => _textValues[q.Key] = option">
                                                @TexteCatalogue($"AutoObs_O_{q.Key}_{i}", option)
                                            </button>
                                        }
                                    </div>
                                    break;
                                case AutoObservationFieldType.Scale1To5:
                                    <div class="ao-radio-group" role="radiogroup" aria-label="@TexteCatalogue($"AutoObs_Q_{q.Key}", q.Label)">
                                        <span class="ao-scale-hint">@Localizer["AutoObs_Echelle1a5"]</span>
                                        @for (var n = 1; n <= 5; n++)
                                        {
                                            var score = n;
                                            var on = _numericValues.GetValueOrDefault(q.Key) == score;
                                            <button type="button"
                                                    class="ao-radio-btn ao-radio-btn--score @(on ? "ao-radio-btn--on" : "")"
                                                    role="radio"
                                                    aria-checked="@(on ? "true" : "false")"
                                                    disabled="@(!_canEdit)"
                                                    @onclick="() => _numericValues[q.Key] = score">@score</button>
                                        }
                                    </div>
                                    break;
                                case AutoObservationFieldType.Scale1To4:
                                    <div class="ao-radio-group" role="radiogroup" aria-label="@TexteCatalogue($"AutoObs_Q_{q.Key}", q.Label)">
                                        <span class="ao-scale-hint">@Localizer["AutoObs_Echelle1a4"]</span>
                                        @for (var n = 1; n <= 4; n++)
                                        {
                                            var score = n;
                                            var on = _numericValues.GetValueOrDefault(q.Key) == score;
                                            <button type="button"
                                                    class="ao-radio-btn ao-radio-btn--score @(on ? "ao-radio-btn--on" : "")"
                                                    role="radio"
                                                    aria-checked="@(on ? "true" : "false")"
                                                    disabled="@(!_canEdit)"
                                                    @onclick="() => _numericValues[q.Key] = score">@score</button>
                                        }
                                    </div>
                                    break;
                            }
                        </div>
                    }

                    @if (_message is not null)
                    {
                        <div class="ao-alert-success" role="status">@_message</div>
                    }

                    <div class="ao-actions">
                        @if (_canEdit)
                        {
                            <button type="button" class="ao-btn-primary" @onclick="SaveSectionAsync" disabled="@_saving">
                                @Localizer["AutoObs_EnregistrerSection"]
                            </button>
                        }
                        @if (_page.AccessMode == AutoObservationAccessMode.Jeune && !_sectionDef.IsSynthesisDisplayOnly)
                        {
                            <button type="button" class="ao-btn-secondary" @onclick="DemanderAideAsync" disabled="@_saving">
                                @Localizer["AutoObs_BesoinAide"]
                            </button>
                        }
                    </div>
                    @if (_sectionSavedAt.HasValue)
                    {
                        <p class="ao-saved-at">@string.Format(Localizer["AutoObs_DerniereSauvegarde"], _sectionSavedAt.Value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture))</p>
                    }
                }
            }
        </main>
    </div>
}
</div>

@code {
    [Parameter] public string? SuiviUserId { get; set; }

    private bool _chargement = true;
    private bool _saving;
    private AutoObservationPageView? _page;
    private string _sectionKey = "p0.s1";
    private AutoObservationSectionDef? _sectionDef;
    private bool _canEdit;
    private DateTimeOffset? _sectionSavedAt;
    private string? _message;
    private string? _userId;
    private PlanActionAutoObservationView? _planLecture;
    private string? _planObjectif;
    private string? _planAction;
    private string? _planResponsable;
    private DateOnly? _planEcheance;
    private string? _planIndicateur;

    private readonly Dictionary<string, string?> _textValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int?> _numericValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _orientationReponses = new(StringComparer.Ordinal);

    private bool OrientationComplete =>
        AutoObservationOrientationCatalog.Questions.All(q =>
            _orientationReponses.TryGetValue(q.Key, out var code)
            && AutoObservationOrientationCatalog.EstReponseValide(q.Key, code));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (_userId is null)
        {
            _chargement = false;
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var sectionFromQuery = query.TryGetValue("section", out var sectionParam)
            ? sectionParam.ToString()
            : null;

        int? profileId = null;
        if (!string.IsNullOrWhiteSpace(SuiviUserId))
        {
            var profilSuivi = await JeuneProfileService.TryGetByUserIdAsync(SuiviUserId);
            profileId = profilSuivi?.Id;
        }

        _page = await AutoObservationService.TryGetPageAsync(_userId, profileId);
        if (_page is not null)
            await ChargerPlanAsync();

        if (_page is not null && !(_page.AccessMode == AutoObservationAccessMode.Jeune && _page.OrientationAFaire))
        {
            var ordonnees = AutoObservationCatalog.GetSectionsOrdonnees(_page.JeuneProfile.ProfilAccompagnement);
            _sectionKey = !string.IsNullOrWhiteSpace(sectionFromQuery)
                && AutoObservationCatalog.TryGetSection(sectionFromQuery) is not null
                ? sectionFromQuery
                : (ordonnees[0].Key);
            await LoadSectionAsync(_sectionKey);
        }

        _chargement = false;
    }

    private string TexteCatalogue(string resourceKey, string fallback)
    {
        var loc = Localizer[resourceKey];
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    private bool IsSaved(string key) =>
        _page?.SectionProgress.Any(p => p.SectionKey == key) == true;

    private async Task SelectSectionAsync(string key)
    {
        _sectionKey = key;
        _message = null;
        await LoadSectionAsync(key);
    }

    private async Task LoadSectionAsync(string key)
    {
        if (_page is null || _userId is null)
            return;

        var sectionDef = AutoObservationCatalog.TryGetSection(key);
        if (sectionDef is null)
            return;

        // Ne pas assigner _sectionDef avant d'avoir les réponses en main : entre le set synchrone et cet
        // await, Blazor peut re-rendre avec les questions de la NOUVELLE section mais les dictionnaires de
        // l'ANCIENNE (encore non vidés/repeuplés à ce stade) — @bind="_textValues[q.Key]" lève alors un
        // KeyNotFoundException pour toute clé absente. On garde _sectionDef inchangé tant que ce n'est pas prêt.
        var section = await AutoObservationService.TryGetSectionAsync(_userId, _page.JeuneProfile.Id, key);
        if (section is null)
            return;

        _canEdit = section.CanEdit;
        _sectionSavedAt = section.SavedAt;
        _textValues.Clear();
        _numericValues.Clear();

        foreach (var a in section.Answers)
        {
            if (a.TextValue is not null)
                _textValues[a.QuestionKey] = a.TextValue;
            if (a.NumericValue.HasValue)
                _numericValues[a.QuestionKey] = a.NumericValue;
        }

        foreach (var q in sectionDef.Questions)
        {
            _textValues.TryAdd(q.Key, null);
            if (q.AutreKey is not null)
                _textValues.TryAdd(q.AutreKey, null);
            if (q.FieldType is AutoObservationFieldType.Scale1To4 or AutoObservationFieldType.Scale1To5)
                _numericValues.TryAdd(q.Key, null);
        }

        _sectionDef = sectionDef;
    }

    private bool IsChecked(string key, string option)
    {
        if (!_textValues.TryGetValue(key, out var val) || string.IsNullOrWhiteSpace(val))
            return false;
        return val.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Contains(option, StringComparer.Ordinal);
    }

    private void ToggleMulti(string key, string option, bool selected)
    {
        var set = _textValues.TryGetValue(key, out var val) && !string.IsNullOrWhiteSpace(val)
            ? val.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet(StringComparer.Ordinal)
            : new HashSet<string>(StringComparer.Ordinal);

        if (selected)
            set.Add(option);
        else
            set.Remove(option);

        _textValues[key] = set.Count > 0 ? string.Join("|", set) : null;
    }

    private async Task SaveSectionAsync()
    {
        if (_page is null || _userId is null || _sectionDef is null)
            return;

        _saving = true;
        _message = null;

        var inputs = new List<AutoObservationAnswerInput>();
        foreach (var q in _sectionDef.Questions)
        {
            if (q.FieldType is AutoObservationFieldType.Scale1To4 or AutoObservationFieldType.Scale1To5)
            {
                _numericValues.TryGetValue(q.Key, out var num);
                inputs.Add(new AutoObservationAnswerInput(q.Key, null, num));
            }
            else
            {
                _textValues.TryGetValue(q.Key, out var text);
                inputs.Add(new AutoObservationAnswerInput(q.Key, text, null));
            }
            if (q.AutreKey is not null)
            {
                _textValues.TryGetValue(q.AutreKey, out var autre);
                inputs.Add(new AutoObservationAnswerInput(q.AutreKey, autre, null));
            }
        }

        var ok = await AutoObservationService.SaveSectionAsync(_userId, _page.JeuneProfile.Id, _sectionKey, inputs);
        if (ok)
        {
            _message = Localizer["AutoObs_SectionEnregistree"];
            _page = await AutoObservationService.TryGetPageAsync(_userId, _page.JeuneProfile.Id);
            await LoadSectionAsync(_sectionKey);
        }

        _saving = false;
    }

    private async Task EnregistrerOrientationAsync()
    {
        if (_page is null || _userId is null || !OrientationComplete)
            return;

        _saving = true;
        _message = null;
        var answers = AutoObservationOrientationCatalog.Questions
            .Select(q => new AutoObservationAnswerInput(q.Key, _orientationReponses[q.Key], null))
            .ToList();
        var ok = await AutoObservationService.EnregistrerOrientationAsync(_userId, _page.JeuneProfile.Id, answers);
        if (ok)
            await EntrerDansQuestionnaireApresOrientationAsync();
        else
            _message = Localizer["Orientation_Erreur"];
        _saving = false;
    }

    private async Task PasserOrientationAsync()
    {
        if (_page is null || _userId is null)
            return;

        _saving = true;
        _message = null;
        var ok = await AutoObservationService.PasserOrientationAsync(_userId, _page.JeuneProfile.Id);
        if (ok)
            await EntrerDansQuestionnaireApresOrientationAsync();
        else
            _message = Localizer["Orientation_Erreur"];
        _saving = false;
    }

    private async Task EntrerDansQuestionnaireApresOrientationAsync()
    {
        if (_page is null || _userId is null)
            return;

        _page = await AutoObservationService.TryGetPageAsync(_userId, _page.JeuneProfile.Id);
        if (_page is null)
            return;

        var ordonnees = AutoObservationCatalog.GetSectionsOrdonnees(_page.JeuneProfile.ProfilAccompagnement);
        _sectionKey = ordonnees[0].Key;
        await LoadSectionAsync(_sectionKey);
    }

    private async Task DemanderAideAsync()
    {
        if (_page is null || _userId is null)
            return;

        _saving = true;
        await AutoObservationService.DemanderAideAsync(_userId, _page.JeuneProfile.Id, _sectionKey);
        _message = Localizer["AutoObs_AideEnvoyee"];
        _saving = false;
    }

    private async Task RegenererSyntheseAsync()
    {
        if (_page is null || _userId is null)
            return;

        _saving = true;
        await AutoObservationService.RegenererSyntheseAsync(_userId, _page.JeuneProfile.Id);
        _page = await AutoObservationService.TryGetPageAsync(_userId, _page.JeuneProfile.Id);
        _saving = false;
    }

    private async Task ValiderSyntheseAsync()
    {
        if (_page is null || _userId is null)
            return;

        _saving = true;
        var ok = await AutoObservationService.ValiderSyntheseAsync(_userId, _page.JeuneProfile.Id);
        _page = await AutoObservationService.TryGetPageAsync(_userId, _page.JeuneProfile.Id);
        _message = ok ? Localizer["AutoObs_Synthese_Validee"] : Localizer["AutoObs_Synthese_ValidationImpossible"];
        _saving = false;
    }

    private async Task EnregistrerPlanAsync()
    {
        if (_page is null || _userId is null)
            return;

        _saving = true;
        var ok = await PlanActionService.SaveAsync(
            _userId,
            _page.JeuneProfile.Id,
            new PlanActionAutoObservationInput(
                _planObjectif,
                _planAction,
                _planResponsable,
                _planEcheance,
                _planIndicateur));
        _message = ok ? Localizer["PlanAction_Enregistre"] : Localizer["PlanAction_Erreur"];
        if (ok)
            await ChargerPlanAsync();
        _saving = false;
    }

    private async Task ChargerPlanAsync()
    {
        if (_page is null || _userId is null)
            return;

        if (_page.AccessMode == AutoObservationAccessMode.Coach)
        {
            var plan = await PlanActionService.GetOrCreateAsync(_userId, _page.JeuneProfile.Id);
            _planLecture = plan;
            _planObjectif = plan?.ObjectifPrincipal;
            _planAction = plan?.PremiereAction;
            _planResponsable = plan?.ResponsableSuivi;
            _planEcheance = plan?.Echeance;
            _planIndicateur = plan?.IndicateurReussite;
        }
        else
        {
            _planLecture = await PlanActionService.GetLectureAsync(_userId, _page.JeuneProfile.Id);
        }
    }

    private string AfficherPlanChamp(string? valeur) =>
        string.IsNullOrWhiteSpace(valeur) ? Localizer["ValeurNonRenseignee"] : valeur;

    private RenderFragment AfficherTableau(AutoObservationSyntheseTableau tableau) => __builder =>
    {
        <section class="ao-synthese-bloc">
            <h3 class="ao-synthese-titre">@tableau.Titre</h3>
            <table class="ao-synthese-table">
                <thead>
                    <tr>
                        <th>@Localizer["AutoObs_Synthese_Theme"]</th>
                        <th>@Localizer["AutoObs_Synthese_Contenu"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in tableau.Lignes)
                    {
                        <tr>
                            <th scope="row">@ligne.Theme</th>
                            <td>@ligne.Contenu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    };
}
